DOLLY 8
PACKAGE libdolly-input
REQUIRES HOST runtime@0

# The input@0 module's header and client (keys, text, paste, pointer and
# wheel), for programs the cc package builds: cc links every client archive in
# /usr/lib/dolly/process, and a program records input@0 only when it calls the
# client.
FROM /Dollyfile-system-build 0c72e09eba84571d4f8634cf6e7507eb1be1b9b8aa1fae61f6b0ec884b26b6fb
REQUIRES HEADER libc
REQUIRES TOOL ar
REQUIRES TOOL cc
REQUIRES TOOL rm

SOURCE /host/input/input.h 1ade3d58496a192fb6385de483ab341f9e093ba4d1b8f196dc53c2c0efeb991c /usr/include/dolly/input.h
SOURCE /host/input/input-abi.h 1dde4a7087a3aebe9b57306f34d47c942fcd90dd9f2fbab1b977301cd78ae8fb /usr/include/dolly/input-abi.h
SOURCE /host/input/client.c 384c287c684156febe5d144f7d072df437bdfd0ce0f0f435e531918f1cdc2651 /tmp/libdolly-input/client.c
SLOP cc -O1 -c /tmp/libdolly-input/client.c -o /tmp/libdolly-input/client.o
SLOP ar rcs /usr/lib/dolly/process/libdolly-input.a /tmp/libdolly-input/client.o

EXPORTS HEADER input     /usr/include/dolly/input.h
EXPORTS HEADER input-abi /usr/include/dolly/input-abi.h
EXPORTS LIB    dolly-input /usr/lib/dolly/process/libdolly-input.a
SLOP rm -rf /tmp/libdolly-input
