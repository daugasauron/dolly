PACKAGE mandoc
REQUIRES HOST runtime@0

# mandoc, the formatter of manual pages, from upstream's release archive,
# unchanged: it turns a page of man or mdoc macros into text. Slop does not
# run its configure, so config.h says what that script would find here. The
# man, apropos and makewhatis the same program can be are not installed: man
# is the core's, and prints a page of text. A package that ships upstream's
# pages uses this one to format them with text-page when it is built.
FROM /v0.1.4/Dollyfile-system-tools 7e797bdea9f6ac6b9af5435728fefaded61a3e88b7d1511d59c86d728fb79304
USE /v0.1.4/Dollyfile-zlib 5a6ca6519690be4620c58e2115f4ce8ecb594c61fa222f7633f7f1af226f50df

REQUIRES HEADER libc
REQUIRES HEADER zlib
REQUIRES LIB    z
REQUIRES TOOL   awk
REQUIRES TOOL   basename
REQUIRES TOOL   cc
REQUIRES TOOL   cp
REQUIRES TOOL   grep
REQUIRES TOOL   gzip
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   rm
REQUIRES TOOL   tar
REQUIRES TOOL   test

SOURCE /v0.1.4/dist/static/default/mandoc-1.14.6.tar.gz 8bf0d570f01e70a6e124884088870cbed7537f36328d512909eb10cd53179d9c /tmp/mandoc.tar.gz
SLOP gzip -dc /tmp/mandoc.tar.gz | tar -xf - -C /tmp

# Not found here: fts, getprogname, recallocarray, strtonum, ohash, BSD's
# word boundaries in regcomp, pledge and sandbox_init; the archive's own
