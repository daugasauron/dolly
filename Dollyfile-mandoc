FILE /tmp/mandoc.mk
    .RECIPEPREFIX := >
    S := /tmp/mandoc-1.14.6
    BIN := /usr/bin
    # The objects of upstream's Makefile for mandoc: every source but
    # configure's tests, the archive's other programs and the replacements of
    # what libc has.
    SOURCES := $(filter-out $S/test-% $S/compat_% $(addprefix $S/,cgi.c catman.c mandocd.c demandoc.c soelim.c), \
      $(wildcard $S/*.c)) $(addprefix $S/compat_,fts.c ohash.c progname.c recallocarray.c strtonum.c)
    $(BIN)/mandoc: $(SOURCES:.c=.o)
    >cc $^ -lz -o $@
    $S/%.o: $S/%.c $S/config.h
    >cc -O2 -c $< -o $@
SLOP make -j4 -f /tmp/mandoc.mk
SLOP mkdir -p /usr/share/licenses/mandoc
SLOP cp /tmp/mandoc-1.14.6/LICENSE /usr/share/licenses/mandoc/LICENSE

# man prints /usr/share/man/cat1/NAME.1 as it is, before the page of macros
# in man1. mandoc marks bold and underlined words by overstriking; a reader
# without a pager, an agent among them, wants the words alone, so awk takes
# the overstrikes out.
FILE /usr/bin/text-page
    #!/bin/slop
    # text-page PAGE...: each manual page as plain text in /usr/share/man/cat1.
    for page in "$@"; do
      text="/usr/share/man/cat1/$(basename "$page")"
      mandoc -T utf8 "$page" | LC_ALL=C.UTF-8 awk '{ gsub(/.\b/, ""); print }' > "$text"
      test -s "$text" || exit 1
    done

# A letter outside ASCII loses its overstrike whole.
FILE /tmp/text-page-check.1
    .TH CHECK 1
    .SH NAME
    check \- caf\['e]
    .SH DESCRIPTION
    \fBcaf\['e]\fR
SLOP text-page /tmp/text-page-check.1 && grep -c 'café' /usr/share/man/cat1/text-page-check.1 | grep -qx 2
SLOP rm /usr/share/man/cat1/text-page-check.1
SLOP text-page /tmp/mandoc-1.14.6/mandoc.1 && grep -q 'format manual pages' /usr/share/man/cat1/mandoc.1

EXPORTS TOOL mandoc
EXPORTS TOOL text-page
FILE /usr/share/licenses/mandoc/LICENSE
FILE /usr/share/man/cat1/mandoc.1
