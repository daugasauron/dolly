{
  "name": "dolly",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:dollyfiles": "node scripts/lint-dollyfiles.mjs",
    "abi": "node scripts/dolly-abi.mjs inspect build/dolly-process-0.wasm && node scripts/dolly-abi.mjs inspect build/dolly-kernel-plugin-0.wasm",
    "build:runtime": "./scripts/build.sh",
    "routes": "node scripts/generate-routes.mjs",
    "image": "node scripts/build-image.mjs",
    "snapshot": "npm run routes && node scripts/build-system-snapshot.mjs",
    "snapshot:reproducible": "npm run routes && node scripts/verify-snapshot-reproducibility.mjs",
    "census": "node scripts/platform-census.mjs",
    "fingerprint": "node scripts/capability-fingerprint.mjs",
    "pi:census": "node scripts/pi-runtime-census.mjs",
    "build": "npm run build:runtime && npm run snapshot",
    "test": "npm run build && node --test test/*.test.mjs && ./scripts/test-browser.sh",
    "publish": "./scripts/package-pages.sh",
    "export:static": "node scripts/export-static.mjs",
    "export:pages": "node scripts/export-cloudflare-pages.mjs",
    "serve": "node scripts/serve.mjs",
    "build:webgpu": "node scripts/build-webgpu-assets.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@mlc-ai/web-llm": "0.2.84"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
