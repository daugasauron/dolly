#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
invocation_dir="$(pwd -P)"
source "${project_dir}/config/source-pins.sh"
image="${DOLLY_EMSDK_IMAGE}"
compiler=emcc

if [[ "${1:-}" == "--cxx" ]]; then
  compiler=em++
  shift
fi

case "${invocation_dir}" in
  "${project_dir}") container_workdir=/src ;;
  "${project_dir}"/*) container_workdir="/src/${invocation_dir#"${project_dir}"/}" ;;
  *)
    echo "dolly-cc: run from inside ${project_dir}" >&2
    exit 64
    ;;
esac

mkdir -p "${project_dir}/build" "${project_dir}/.cache/emscripten"

if command -v podman >/dev/null 2>&1; then
  container=(podman run --rm --userns=keep-id \
    -v "${project_dir}:/src" \
    -v "${project_dir}/.cache/emscripten:/emsdk/upstream/emscripten/cache" \
    -w "${container_workdir}" "${image}")
elif command -v docker >/dev/null 2>&1; then
  container=(docker run --rm -u "$(id -u):$(id -g)" \
    -v "${project_dir}:/src" \
    -v "${project_dir}/.cache/emscripten:/emsdk/upstream/emscripten/cache" \
    -w "${container_workdir}" "${image}")
else
  echo "dolly-cc: podman or docker is required" >&2
  exit 1
fi

if [[ ! -f "${project_dir}/build/dolly-0.wasm" || \
      "${project_dir}/abi/dolly-0.wat" -nt "${project_dir}/build/dolly-0.wasm" ]]; then
  "${container[@]}" /emsdk/upstream/bin/wasm-as /src/abi/dolly-0.wat \
    --enable-memory64 \
    --enable-reference-types \
    --enable-threads \
    --disable-compact-imports \
    -o /src/build/dolly-0.wasm
fi

compile_only=false
output=
mapped_args=()
arguments=("$@")

map_project_path() {
  mapped_path="$1"
  if [[ "${mapped_path}" == "${project_dir}"/* ]]; then
    mapped_path="/src/${mapped_path#"${project_dir}"/}"
  fi
}

index=0
while ((index < ${#arguments[@]})); do
  argument="${arguments[index]}"
  case "${argument}" in
    -c|-E|-M|-MM|-S)
      compile_only=true
      ;;
    -o)
      if ((index + 1 >= ${#arguments[@]})); then
        echo "dolly-cc: -o requires a path" >&2
        exit 64
      fi
      output="${arguments[index + 1]}"
      map_project_path "${output}"
      mapped_args+=("-o" "${mapped_path}")
      index=$((index + 2))
      continue
      ;;
    -o*)
      output="${argument#-o}"
      map_project_path "${output}"
      mapped_args+=("-o${mapped_path}")
      index=$((index + 1))
      continue
      ;;
  esac

  map_project_path "${argument}"
  mapped_args+=("${mapped_path}")
  index=$((index + 1))
done

target_flags=(
  -m64
  -O2
  -fPIC
  -fvisibility=hidden
  -matomics
  -mbulk-memory
  -I/src/include
  -Dmain=dolly_main
  -Dexit=dolly_exit
  -Dfclose=dolly_fclose
  -Dsystem=dolly_system
  -Dpopen=dolly_popen
  -Dpclose=dolly_pclose
  -D__assert_fail=dolly_assert_fail
  -Datexit=dolly_atexit
  -Dchmod=dolly_chmod
  -Dumask=dolly_umask
  -Dgetpass=dolly_getpass
  -Dgetrandom=dolly_getrandom
  -Dfork=dolly_fork
  -Dexecve=dolly_execve
  -Dexecvp=dolly_execvp
  -Dexecl=dolly_execl
  -Dexeclp=dolly_execlp
  -Dwaitpid=dolly_waitpid
  -Dwait=dolly_wait_any
  -Dkill=dolly_kill
  -Dsetsid=dolly_setsid
  -Dgetpgid=dolly_getpgid
  -Dtcgetpgrp=dolly_tcgetpgrp
  -Dalarm=dolly_alarm
  -Dsleep=dolly_sleep
  -Dsetitimer=dolly_setitimer
  -Dselect=dolly_select
  -D_exit=dolly__exit
  -Dsocket=dolly_socket
  -Dconnect=dolly_connect
  -Drecv=dolly_recv
  -Dsetsockopt=dolly_setsockopt
  -Dshutdown=dolly_shutdown
  -Dgethostbyname=dolly_gethostbyname
  -Dgetservbyname=dolly_getservbyname
)
if [[ "${compiler}" == em++ ]]; then
  # Renaming C++'s special `main` identifier removes its implicit C linkage.
  target_flags+=(-include dolly/abi.h)
fi
link_flags=()
if [[ "${compile_only}" == false ]]; then
  if [[ -z "${output}" ]]; then
    echo "dolly-cc: command links require an explicit -o FILE.wasm" >&2
    exit 64
  fi
  link_flags=(-sSIDE_MODULE=2 -sSHARED_MEMORY=1 -sEXPORTED_FUNCTIONS=_dolly_main)
fi

"${container[@]}" "${compiler}" "${target_flags[@]}" "${mapped_args[@]}" "${link_flags[@]}"

if [[ "${compile_only}" == false ]]; then
  if [[ "${output}" == /* ]]; then
    output_path="${output}"
  else
    output_path="${invocation_dir}/${output}"
  fi
  node "${project_dir}/scripts/dolly-abi.mjs" stamp \
    "${project_dir}/build/dolly-0.wasm" \
    "${output_path}"
  node "${project_dir}/scripts/dolly-abi.mjs" validate-command \
    "${project_dir}/build/dolly-0.wasm" \
    "${output_path}"
fi
