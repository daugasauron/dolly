    #include <dolly/html.h>
    #include <errno.h>
    #include <stdio.h>
    #include <string.h>
    
    static const char usage[] =
        "usage: html [FILE]\n"
        "Shows FILE, or standard input, an HTML document of at most 1 MiB, in a popup\n"
        "of the page: its text, headings, lists, tables and forms, in the page's style.\n"
        "When the user submits a form, prints its fields on one line as a browser posts\n"
        "them (application/x-www-form-urlencoded) and exits 0; exits 1 when the user\n"
        "closes the popup, 2 on an error.\n";
    static char document[DOLLY_HTML_DOCUMENT_MAX + 1];
    static char fields[DOLLY_HTML_FIELDS_MAX];
    
    int main(int argc, char **argv) {
      if (argc == 2 && strcmp(argv[1], "--help") == 0) {
        fputs(usage, stdout);
        return 0;
      }
      if (argc > 2) {
        fputs(usage, stderr);
        return 2;
      }
      FILE *input = argc == 2 ? fopen(argv[1], "rb") : stdin;
      if (input == NULL) {
        fprintf(stderr, "html: %s: %s\n", argv[1], strerror(errno));
        return 2;
      }
      const size_t size = fread(document, 1, sizeof(document), input);
      if (ferror(input)) {
        fprintf(stderr, "html: %s\n", strerror(errno));
        return 2;
      }
      if (size == 0 || size > DOLLY_HTML_DOCUMENT_MAX) {
        fprintf(stderr, "html: the document is %s\n", size == 0 ? "empty" : "over 1 MiB");
        return 2;
      }
      const int result = dolly_html_show(document, size, fields, sizeof(fields));
      if (result == -ECANCELED) return 1;
      if (result < 0) {
        fprintf(stderr, "html: %s\n", strerror(-result));
        return 2;
      }
      printf("%.*s\n", result, fields);
      return 0;
    }
