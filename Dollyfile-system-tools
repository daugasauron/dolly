FILE /tmp/sbase/dolly.mk
    TOOLS = basename cksum cmp comm cut date dd dirname expand expr false fold \
            grep head join kill ln md5sum mktemp nl od paste pathchk \
            printenv printf readlink rmdir sed seq sha256sum sleep sort split \
            strings tail tee tr true \
            tsort uname unexpand uniq wc which
    .RECIPEPREFIX := >
    dolly-bin: $(TOOLS)
    >mv $(TOOLS) /bin
    >mv $(TOOLS:=.1) /usr/share/man/man1
