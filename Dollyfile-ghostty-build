# The Unicode tables' generators run as programs of this Zig: Zig's page
# allocator on WebAssembly grows the memory itself, behind libc's sbrk, so
# their root gives them libc's.
FILE /tmp/ghostty/generator.zig
    const std = @import("std");
    pub const os = struct {
        pub const heap = struct {
            pub const page_allocator = std.heap.c_allocator;
        };
    };
    pub const main = @import("generate").main;

# Zig emits Ghostty VT and compiler_rt as C; cc compiles them. zig.h passes
# usize as uint64_t *, and @returnAddress would import an Emscripten helper.
# The Unicode tables are generated first, as Ghostty's build does
# (src/build/UnicodeTables.zig, uucode's build.zig): uucode's generator reads
# the UCD and writes its tables, over which Ghostty's two print theirs.
FILE /tmp/ghostty/Makefile
    .RECIPEPREFIX := >
    ZIGFLAGS := -OReleaseSmall -target wasm64-emscripten -mcpu=generic+atomics -fsingle-threaded -ofmt=c
    CFLAGS := -O2 -std=c99 -fno-strict-aliasing -Wno-incompatible-pointer-types -I /usr/lib/zig
    UUCODE_CONFIG := --dep storage.zig -Mconfig.zig=/usr/src/uucode/src/config.zig \
      --dep config.zig -Mstorage.zig=/usr/src/uucode/src/storage.zig \
      --dep config.zig --dep storage.zig -Mbuild_config=/usr/src/ghostty/src/build/uucode_config.zig
    GENERATORS := /tmp/ghostty/uucode-generate /tmp/ghostty/props-generate /tmp/ghostty/symbols-generate
    all: /usr/lib/libghostty-vt.a /usr/lib/libdisplay.so
    /tmp/ghostty/uucode-generate.c:
    >zig build-exe $(ZIGFLAGS) -lc --name uucode-generate --dep generate -Mroot=/tmp/ghostty/generator.zig \
    >  --dep config.zig --dep storage.zig --dep build_config -Mgenerate=/usr/src/uucode/src/generate.zig \
    >  $(UUCODE_CONFIG) -femit-bin=$@
    /tmp/ghostty/props-generate.c /tmp/ghostty/symbols-generate.c: /tmp/ghostty/uucode-tables.zig
    >zig build-exe $(ZIGFLAGS) -lc --name $(basename $(@F)) --dep generate -Mroot=/tmp/ghostty/generator.zig \
    >  --dep uucode -Mgenerate=/usr/src/ghostty/src/unicode/$(subst -generate.c,_uucode.zig,$(@F)) \
    >  --dep types.zig --dep config.zig --dep tables -Muucode=/usr/src/uucode/src/root.zig \
    >  -Mtypes.zig=/usr/src/uucode/src/types.zig \
    >  --dep types.zig $(UUCODE_CONFIG) \
    >  --dep config.zig --dep storage.zig --dep build_config -Mtables=/tmp/ghostty/uucode-tables.zig -femit-bin=$@
    $(GENERATORS): %: %.c /tmp/ghostty/compiler_rt.o
