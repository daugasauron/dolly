DOLLY 6
APPLICATION default
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST download@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST packages@0
REQUIRES HOST snapshot@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0

# The image people open: a shell, its text tools, the terminal, curl and amy.
# It holds no compiler; amy installs what a session needs. The host modules
# are those packages may need, since an image's list is fixed.
INSTALL https://daugasauron.com/Dollyfile-core e8581da534b671de9f115d7a4837ffbadfc316aebcdeeba5c932e64981967de5
INSTALL https://daugasauron.com/Dollyfile-posix 97d16ba5a51aa6f4c3ed13d1e3921b33b7ac7e792c3c71ff4a6732158cad58c0
INSTALL https://daugasauron.com/Dollyfile-display 84733e046492ba68709e6c0a609089a7bc422fb176ba05a755018d0b1f977402
INSTALL https://daugasauron.com/Dollyfile-curl 6d75bce4f5187a0ee6306b010ffea3610485cd2ad37586b0a0227e5cab67925a
INSTALL https://daugasauron.com/Dollyfile-amy 7648c662c71265a06fee1338d3b45a42421ef7f7d69966391ed9a1fb0729a375
# The page's file exchange. system-tools builds them and no package holds them yet.
COPY https://daugasauron.com/Dollyfile-system-tools 5bddfea881c9ea62e51317c45c69a29d62f2f750d1092537eb9c7f54a203186e /bin/download /bin/download
COPY https://daugasauron.com/Dollyfile-system-tools 5bddfea881c9ea62e51317c45c69a29d62f2f750d1092537eb9c7f54a203186e /bin/upload /bin/upload
COPY https://daugasauron.com/Dollyfile-system-tools 5bddfea881c9ea62e51317c45c69a29d62f2f750d1092537eb9c7f54a203186e /usr/share/man/cat1/download.1 /usr/share/man/cat1/download.1
COPY https://daugasauron.com/Dollyfile-system-tools 5bddfea881c9ea62e51317c45c69a29d62f2f750d1092537eb9c7f54a203186e /usr/share/man/cat1/upload.1 /usr/share/man/cat1/upload.1
REQUIRES TOOL foreground
REQUIRES TOOL test
REQUIRES TOOL echo

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) echo "Dolly: $HOME/.dollyrc exited with status $status; continuing." >&2 ;;
      esac
    fi
    /bin/foreground -i /bin/slop
    echo
    echo 'Dolly: image entry exited; entering the recovery Slop shell.'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    echo 'DOLLY: a small Unix-like machine inside this browser tab.'
    echo 'Files and programs stay in the tab; Ctrl+Shift+S saves the session.'
    echo 'This image is small. amy list shows what it can install, for example:'
    echo '  amy install cc       the C and C++ compiler and Make'
    echo '  amy install git      Git'
    echo '  amy install python   CPython and pip'
    echo 'help describes the shell, man NAME a command.'
    echo

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
