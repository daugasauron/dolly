DOLLY 6
APPLICATION default
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST download@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST packages@0
REQUIRES HOST snapshot@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0

# The image people open: a shell, its text tools, the terminal, curl and amy.
# It holds no compiler; amy installs what a session needs. The host modules
# are those packages may need, since an image's list is fixed.
INSTALL https://daugasauron.com/Dollyfile-core 72c35e70564b060317519e33df1d182215266bb8b2c21166b871aa89f33606fb
INSTALL https://daugasauron.com/Dollyfile-posix 50cc7ea77c72158e9c7f8a3d34dbe8421ea5d72670d55c99bb823f425d3f1d46
INSTALL https://daugasauron.com/Dollyfile-display 1e29a6e6219a049255cbbf3455b65476c65f030cd3ec30483527ebf70468a685
INSTALL https://daugasauron.com/Dollyfile-curl 9f3e4eef2b3fd503f571b8c59531aaae7b6322d8c22abc7356e0ecd8f1bba6a7
INSTALL https://daugasauron.com/Dollyfile-amy 86d3bfbb7e492a63505f9794034d0e8df3321991d701f0db0ce9740d3fcba7ba
# The page's file exchange. system-tools builds them and no package holds them yet.
COPY https://daugasauron.com/Dollyfile-system-tools c882c26d141d48009fbd2c3c8495a330f24b355095e6694e1b55b6c185578706 /bin/download /bin/download
COPY https://daugasauron.com/Dollyfile-system-tools c882c26d141d48009fbd2c3c8495a330f24b355095e6694e1b55b6c185578706 /bin/upload /bin/upload
COPY https://daugasauron.com/Dollyfile-system-tools c882c26d141d48009fbd2c3c8495a330f24b355095e6694e1b55b6c185578706 /usr/share/man/cat1/download.1 /usr/share/man/cat1/download.1
COPY https://daugasauron.com/Dollyfile-system-tools c882c26d141d48009fbd2c3c8495a330f24b355095e6694e1b55b6c185578706 /usr/share/man/cat1/upload.1 /usr/share/man/cat1/upload.1
REQUIRES TOOL foreground
REQUIRES TOOL test
REQUIRES TOOL echo

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) echo "Dolly: $HOME/.dollyrc exited with status $status; continuing." >&2 ;;
      esac
    fi
    /bin/foreground -i /bin/slop
    echo
    echo 'Dolly: image entry exited; entering the recovery Slop shell.'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    echo 'DOLLY: a small Unix-like machine inside this browser tab.'
    echo 'Files and programs stay in the tab; Ctrl+Shift+S saves the session.'
    echo 'This image is small. amy list shows what it can install, for example:'
    echo '  amy install cc       the C and C++ compiler and Make'
    echo '  amy install git      Git'
    echo '  amy install python   CPython and pip'
    echo 'help describes the shell, man NAME a command.'
    echo

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
