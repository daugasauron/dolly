DOLLY 6
APPLICATION default
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST download@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST packages@0
REQUIRES HOST snapshot@0
REQUIRES HOST sockets@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0

# The image people open: a shell, its text tools, the terminal, curl and amy.
# It holds no compiler; amy installs what a session needs. The host modules
# are those packages may need, since an image's list is fixed.
INSTALL https://daugasauron.com/Dollyfile-core 0e51359be38df7cf4ef63fd6f7eaa1f54225ec45fbfcdd9232adbfa315af1a37
INSTALL https://daugasauron.com/Dollyfile-posix 752d3d5a80a4d561c1e3ed5b6d24138a0b7cb6ad300aacbb90286bd34a67c1de
INSTALL https://daugasauron.com/Dollyfile-display 1eccd55b6363ac17661681e9df46495a7fd3e7469d45486dc1a37ec16ab82124
INSTALL https://daugasauron.com/Dollyfile-curl f8b7c9cbe8cb0b3b03226f830406805fbb98d33837a36d2c3f6f8386bdbefee2
INSTALL https://daugasauron.com/Dollyfile-amy eaa71a8db6831e3dc9b4deb0a4f902f26b7f0825a1d94514a0ccadf96fd8ab20
# The page's file exchange. system-tools builds them and no package holds them yet.
COPY https://daugasauron.com/Dollyfile-system-tools bd54fde46734089b841b63c7ea3a9c2edbdfc3a400c20c70615f68f7fa16b16f /bin/download /bin/download
COPY https://daugasauron.com/Dollyfile-system-tools bd54fde46734089b841b63c7ea3a9c2edbdfc3a400c20c70615f68f7fa16b16f /bin/upload /bin/upload
COPY https://daugasauron.com/Dollyfile-system-tools bd54fde46734089b841b63c7ea3a9c2edbdfc3a400c20c70615f68f7fa16b16f /usr/share/man/cat1/download.1 /usr/share/man/cat1/download.1
COPY https://daugasauron.com/Dollyfile-system-tools bd54fde46734089b841b63c7ea3a9c2edbdfc3a400c20c70615f68f7fa16b16f /usr/share/man/cat1/upload.1 /usr/share/man/cat1/upload.1
REQUIRES TOOL foreground
REQUIRES TOOL test
REQUIRES TOOL echo

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) echo "Dolly: $HOME/.dollyrc exited with status $status; continuing." >&2 ;;
      esac
    fi
    /bin/foreground -i /bin/slop
    echo
    echo 'Dolly: image entry exited; entering the recovery Slop shell.'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    echo 'DOLLY: a small Unix-like machine inside this browser tab.'
    echo 'Files and programs stay in the tab; Ctrl+Shift+S saves the session.'
    echo 'This image is small. amy list shows what it can install, for example:'
    echo '  amy install cc       the C and C++ compiler and Make'
    echo '  amy install git      Git'
    echo '  amy install python   CPython and pip'
    echo 'help describes the shell, man NAME a command.'
    echo

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
