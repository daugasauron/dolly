REQUIRES HOST upload@0

# The image people open: a shell, its text tools, the terminal, curl, amy, ps
# and the page's file exchange.
# It holds no compiler; amy installs what a session needs, and has nena
# enable the host modules a package needs beyond these (nena@0).
INSTALL /v0.1.7/Dollyfile-core eda40e39821dad0950a249cff23bddafe3b31ea1e57e9e17216705f925d4c1e3
INSTALL /v0.1.7/Dollyfile-posix 4058459f4998f9c3fc435e673f27c3e631dd22f1cc74a7edcc4628bb0acb71fc
INSTALL /v0.1.7/Dollyfile-display 3335bd4643ab8a00323d4cc52c70d6b2046b9a72a50915bf62cb2f16027238ef
INSTALL /v0.1.7/Dollyfile-curl 693306760fc3c4b365f5ce1d2ca439c9c667b2b17d4fd5e705a6fc1921a62782
INSTALL /v0.1.7/Dollyfile-amy 03ca170c4efb455703857c121f142b4e662f4b52e750cc665d4bb9357e6b197e
INSTALL /v0.1.7/Dollyfile-nena edfcb65befaa874e39303cb8cf152e5a10ae3a94443d67d85fb07204ac424db4
INSTALL /v0.1.7/Dollyfile-transfer 36dfb52420cd1a91da0061291507faff97f88ab3313de5092ff03cfad10ad214
INSTALL /v0.1.7/Dollyfile-ps 39cdf2bfaa3fb52f3c161672634f9600381754e6f006971896d6f79b6b345b77
REQUIRES TOOL foreground
REQUIRES TOOL test
REQUIRES TOOL echo

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) echo "Dolly: $HOME/.dollyrc exited with status $status; continuing." >&2 ;;
      esac
    fi
    /bin/foreground -i /bin/slop
    echo
    echo 'Dolly: image entry exited; entering the recovery Slop shell.'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    echo 'DOLLY: a small Unix-like machine inside this browser tab.'
    echo 'Files and programs stay in the tab; Ctrl+Shift+S saves the session.'
    echo 'This image is small. amy list shows what it can install, for example:'
    echo '  amy install cc       the C and C++ compiler and Make'
    echo '  amy install git      Git'
    echo '  amy install python   CPython and pip'
    echo 'help describes the shell, man NAME a command.'
    echo

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
