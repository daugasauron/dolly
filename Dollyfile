DOLLY 6
APPLICATION default
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST download@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST packages@0
REQUIRES HOST snapshot@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0

# The image people open: a shell, its text tools, the terminal, curl and amy.
# It holds no compiler; amy installs what a session needs. The host modules
# are those packages may need, since an image's list is fixed.
INSTALL https://daugasauron.com/Dollyfile-core 409ad96e6c53e7ac096b665a42c3bbed1a11251af347252423e5d4375f800eea
INSTALL https://daugasauron.com/Dollyfile-posix 117ea8ca86cc0bc31bfb7dc4eb0be114033019242b1a116212c321f97f1c6693
INSTALL https://daugasauron.com/Dollyfile-display c64a1fd4ffb44196a0d9283a849f3a7febc9e608160be3a303bb110a4d4967c1
INSTALL https://daugasauron.com/Dollyfile-curl f133c087e1d1a05abed96a54d88c0e5f4cf11e8d1897f21c1392ae93a1d58e6a
INSTALL https://daugasauron.com/Dollyfile-amy 4f28ee373f316a2b9e9a957d087f7fd0c55f59590f6394ea4961dcaf7ec7b855
# The page's file exchange. system-tools builds them and no package holds them yet.
COPY https://daugasauron.com/Dollyfile-system-tools 90721b2609286ae992dbb6473f68e48bc38b79acef06433a2136868e67f1c513 /bin/download /bin/download
COPY https://daugasauron.com/Dollyfile-system-tools 90721b2609286ae992dbb6473f68e48bc38b79acef06433a2136868e67f1c513 /bin/upload /bin/upload
COPY https://daugasauron.com/Dollyfile-system-tools 90721b2609286ae992dbb6473f68e48bc38b79acef06433a2136868e67f1c513 /usr/share/man/cat1/download.1 /usr/share/man/cat1/download.1
COPY https://daugasauron.com/Dollyfile-system-tools 90721b2609286ae992dbb6473f68e48bc38b79acef06433a2136868e67f1c513 /usr/share/man/cat1/upload.1 /usr/share/man/cat1/upload.1
REQUIRES TOOL foreground
REQUIRES TOOL test
REQUIRES TOOL echo

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) echo "Dolly: $HOME/.dollyrc exited with status $status; continuing." >&2 ;;
      esac
    fi
    /bin/foreground -i /bin/slop
    echo
    echo 'Dolly: image entry exited; entering the recovery Slop shell.'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    echo 'DOLLY: a small Unix-like machine inside this browser tab.'
    echo 'Files and programs stay in the tab; Ctrl+Shift+S saves the session.'
    echo 'This image is small. amy list shows what it can install, for example:'
    echo '  amy install cc       the C and C++ compiler and Make'
    echo '  amy install git      Git'
    echo '  amy install python   CPython and pip'
    echo 'help describes the shell, man NAME a command.'
    echo

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
