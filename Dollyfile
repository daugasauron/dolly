DOLLY 6
APPLICATION default
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST download@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST packages@0
REQUIRES HOST snapshot@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0

# The image people open: a shell, its text tools, the terminal, curl and amy.
# It holds no compiler; amy installs what a session needs. The host modules
# are those packages may need, since an image's list is fixed.
INSTALL https://daugasauron.com/Dollyfile-core a2c1c5ab927c564e5d58a92f0ea5df91d50063ab04f27297bf7b3bf6f3bb989a
INSTALL https://daugasauron.com/Dollyfile-posix 1d70c2ae98d02bcf350a7dc9832680e3a9debcd2cac8ea0779899e1a0e8497b8
INSTALL https://daugasauron.com/Dollyfile-display d547b5c74e9f642c301d9099928c4ef723066a5b608d0a0f53f20fea9e6fe60e
INSTALL https://daugasauron.com/Dollyfile-curl cd2db72b456eb4ee9506a5f0c8d9f5309bf7c1864ecd6702d98aabda37073c80
INSTALL https://daugasauron.com/Dollyfile-amy 12447608a824f33fc8c39baccc50df73593cf910c421bf0e1880c452fb085403
# The page's file exchange. system-tools builds them and no package holds them yet.
COPY https://daugasauron.com/Dollyfile-system-tools 033b2114cbbfa1bb23907c7a47587aa89c1002c997516a41d9413731ad101739 /bin/download /bin/download
COPY https://daugasauron.com/Dollyfile-system-tools 033b2114cbbfa1bb23907c7a47587aa89c1002c997516a41d9413731ad101739 /bin/upload /bin/upload
COPY https://daugasauron.com/Dollyfile-system-tools 033b2114cbbfa1bb23907c7a47587aa89c1002c997516a41d9413731ad101739 /usr/share/man/cat1/download.1 /usr/share/man/cat1/download.1
COPY https://daugasauron.com/Dollyfile-system-tools 033b2114cbbfa1bb23907c7a47587aa89c1002c997516a41d9413731ad101739 /usr/share/man/cat1/upload.1 /usr/share/man/cat1/upload.1
REQUIRES TOOL foreground
REQUIRES TOOL test
REQUIRES TOOL echo

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) echo "Dolly: $HOME/.dollyrc exited with status $status; continuing." >&2 ;;
      esac
    fi
    /bin/foreground -i /bin/slop
    echo
    echo 'Dolly: image entry exited; entering the recovery Slop shell.'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    echo 'DOLLY: a small Unix-like machine inside this browser tab.'
    echo 'Files and programs stay in the tab; Ctrl+Shift+S saves the session.'
    echo 'This image is small. amy list shows what it can install, for example:'
    echo '  amy install cc       the C and C++ compiler and Make'
    echo '  amy install git      Git'
    echo '  amy install python   CPython and pip'
    echo 'help describes the shell, man NAME a command.'
    echo

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
