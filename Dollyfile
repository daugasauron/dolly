DOLLY 6
APPLICATION default
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST download@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST packages@0
REQUIRES HOST snapshot@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0

# The image people open: a shell, its text tools, the terminal, curl and amy.
# It holds no compiler; amy installs what a session needs. The host modules
# are those packages may need, since an image's list is fixed.
INSTALL https://daugasauron.com/Dollyfile-core c30c24927347c10c63f943b9a018dd8098a4fbd6f244d8306dde2a2fc2d1c04a
INSTALL https://daugasauron.com/Dollyfile-posix c919c4898da3cc7a9b69ec1dab7c483c2e366356fc5ef65aafdbdd8bba77b5b1
INSTALL https://daugasauron.com/Dollyfile-display 72d4069767c943457fa1d5201ef6d1e1a81abd07f332d760ec1550e821381dc4
INSTALL https://daugasauron.com/Dollyfile-curl 7d7c6679f06c387f4fcb41737636c55b759c442d8fa3ac991e25431dfc22912a
INSTALL https://daugasauron.com/Dollyfile-amy d5c9b5e7f4fbfbe0760c83b534164c625128e0dff0d04bdd99d1fe2029be2b4c
# The page's file exchange. system-tools builds them and no package holds them yet.
COPY https://daugasauron.com/Dollyfile-system-tools 9e7a31d4a6d9a6aef96afa39e11d12d4c8595f3ac9d481cc8a791e9c606a74d3 /bin/download /bin/download
COPY https://daugasauron.com/Dollyfile-system-tools 9e7a31d4a6d9a6aef96afa39e11d12d4c8595f3ac9d481cc8a791e9c606a74d3 /bin/upload /bin/upload
COPY https://daugasauron.com/Dollyfile-system-tools 9e7a31d4a6d9a6aef96afa39e11d12d4c8595f3ac9d481cc8a791e9c606a74d3 /usr/share/man/cat1/download.1 /usr/share/man/cat1/download.1
COPY https://daugasauron.com/Dollyfile-system-tools 9e7a31d4a6d9a6aef96afa39e11d12d4c8595f3ac9d481cc8a791e9c606a74d3 /usr/share/man/cat1/upload.1 /usr/share/man/cat1/upload.1
REQUIRES TOOL foreground
REQUIRES TOOL test
REQUIRES TOOL echo

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) echo "Dolly: $HOME/.dollyrc exited with status $status; continuing." >&2 ;;
      esac
    fi
    /bin/foreground -i /bin/slop
    echo
    echo 'Dolly: image entry exited; entering the recovery Slop shell.'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    echo 'DOLLY: a small Unix-like machine inside this browser tab.'
    echo 'Files and programs stay in the tab; Ctrl+Shift+S saves the session.'
    echo 'This image is small. amy list shows what it can install, for example:'
    echo '  amy install cc       the C and C++ compiler and Make'
    echo '  amy install git      Git'
    echo '  amy install python   CPython and pip'
    echo 'help describes the shell, man NAME a command.'
    echo

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
