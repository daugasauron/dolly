DOLLY 3
IMAGE bhop

FROM HOST /Dollyfile-gamedev 774d394bf17978137c472fc6f7778e8c806f7653eb75c32d4154a7b576a49c5b
COPY FROM HOST /Dollyfile-sdl2-build d77797c44cab1f3503ace167c4695ad1ebe81ddd0365bb2ae06cfb9807bfd2ba /usr/include/SDL2 /usr/include/SDL2
COPY FROM HOST /Dollyfile-sdl2-build d77797c44cab1f3503ace167c4695ad1ebe81ddd0365bb2ae06cfb9807bfd2ba /usr/lib/libSDL2.a /usr/lib/libSDL2.a
COPY FROM HOST /Dollyfile-sdl2-build d77797c44cab1f3503ace167c4695ad1ebe81ddd0365bb2ae06cfb9807bfd2ba /usr/share/licenses/SDL2 /usr/share/licenses/SDL2
EXPORTS HEADER sdl2 /usr/include/SDL2
EXPORTS LIB SDL2 /usr/lib/libSDL2.a
USE HOST /modules/bhop.dm a6955bad698d4e7df540427083ad0d4d7bdbe70a1c4604cd4642e144e8fc93c9

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
    fi
    /bin/foreground -i /usr/bin/bhop-agent
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    printf '\033[33mDOLLY / AIRTIME: FOUNDRY\033[0m\n'
    printf 'Tab hides the agent UI; backtick toggles human/agent controls; Enter opens a prompt.\n'
    printf 'Settings connects OpenRouter or local Codex. Review attempts exports captured frames.\n'
    printf 'WASD moves. Space and scroll up/down jump. R restarts; F returns to a checkpoint.\n'
    printf 'Release W in air, then strafe A/D while turning the mouse in the same direction.\n'
    printf '32 jumps: yard, turbine hall, reactor, silos. Yellow pads collapse; cyan checkpoints are safe.\n'
    printf '1-4 practices a section without saving a best time; R starts a full run.\n'
    printf 'Edit /usr/src/dolly/bhop/bhop.c; make -f /usr/src/dolly/bhop/bhop.mk all check.\n\n'

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
