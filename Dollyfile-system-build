  /usr/share/man/man1
SLOP for name in ar c++ cat cc cd clear cp dollyfile file foreground help ld ls man mkdir mv pwd rm slop stat touch; do \
  "/bin/$name" --help > "/usr/share/man/cat1/$name.1"; \
  done
SLOP help >> /usr/share/man/cat1/slop.1
# echo prints its operands, --help among them, as POSIX says.
