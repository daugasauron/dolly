DOLLY 8
PACKAGE clip
REQUIRES HOST runtime@0
REQUIRES HOST clipboard@0

# clip copies its standard input to the page's clipboard (clipboard@0), which offers it to
# the browser's while the user acts on the page: the end of a pipeline, or tmux's copy-pipe.
FROM /Dollyfile-system-build 0c72e09eba84571d4f8634cf6e7507eb1be1b9b8aa1fae61f6b0ec884b26b6fb
USE /Dollyfile-libdolly-clipboard 99746a8bd9b9eb136098753ccc526ac94a14540e6d26082ae8748eb6e3fa08a6
REQUIRES HEADER libc
REQUIRES HEADER clipboard
REQUIRES TOOL cc
REQUIRES TOOL rm

FILE /tmp/clip/clip.c
    #include <dolly/clipboard.h>
    #include <stdio.h>
    #include <string.h>
    
    int main(int argc, char **argv) {
      if (argc != 1) {
        const int help = strcmp(argv[1], "--help") == 0;
        fprintf(help ? stdout : stderr, "usage: clip < TEXT\nCopies its standard input, at most %u KiB of UTF-8, to the page's clipboard.\n",
                DOLLY_CLIPBOARD_CAPACITY >> 10);
        return help ? 0 : 2;
      }
      static char text[DOLLY_CLIPBOARD_CAPACITY + 1];
      const size_t length = fread(text, 1, sizeof text, stdin);
      if (length > DOLLY_CLIPBOARD_CAPACITY) {
        fputs("clip: more than the clipboard holds\n", stderr);
        return 1;
      }
      uint64_t lease;
      int result = dolly_clipboard_acquire(&lease);
      if (result == 0) result = dolly_clipboard_write(lease, text, length);
      if (result < 0) {
        fprintf(stderr, "clip: %s\n", strerror(-result));
        return 1;
      }
      return 0;
    }
SLOP cc -O1 /tmp/clip/clip.c -o /usr/bin/clip
EXPORTS TOOL clip
SLOP clip --help > /usr/share/man/cat1/clip.1
FILE /usr/share/man/cat1/clip.1
SLOP rm -rf /tmp/clip
