REQUIRES HEADER libc
REQUIRES TOOL cc
REQUIRES TOOL rm

SOURCE /v0.1.6/dist/static/default/commands/amy.c 2599efe4c8f614d5b634222d16b3dc5a46a0a6d091dcc8bcf6adc9f5d3f12433 /tmp/amy/amy.c
SLOP cc -O2 /tmp/amy/amy.c -o /bin/amy

EXPORTS TOOL amy
SLOP amy --help > /usr/share/man/cat1/amy.1
FILE /usr/share/man/cat1/amy.1
SLOP rm -rf /tmp/amy
