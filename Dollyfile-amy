DOLLY 7
PACKAGE amy
REQUIRES HOST runtime@0
REQUIRES HOST http@0
REQUIRES HOST packages@0

# amy and the recipe engine it runs (the dollyfile package): what a session needs
# to install packages. amy reads the package index of an image directory, by
# default the one the page loads its images from.
FROM /v0.1.6/Dollyfile-system-build 2ff106b9223deabbae812860e276f909d55a2193f12854e2a1ed27bea3710d54
INSTALL /v0.1.6/Dollyfile-dollyfile 4286c8056e626c65f188547d9098b0858390e5608cefed55b43aebdd98b8025f
REQUIRES HEADER libc
REQUIRES HEADER http
REQUIRES TOOL cc
REQUIRES TOOL rm

SOURCE /v0.1.6/dist/static/default/commands/amy.c d4f8e2ee356013b7dbab3253a95e95f4966db426af5291efaf46b091a5aac968 /tmp/amy/amy.c
SLOP cc -O2 /tmp/amy/amy.c -o /bin/amy

EXPORTS TOOL amy
SLOP amy --help > /usr/share/man/cat1/amy.1
FILE /usr/share/man/cat1/amy.1
SLOP rm -rf /tmp/amy
