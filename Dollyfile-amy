DOLLY 7
PACKAGE amy
REQUIRES HOST runtime@0
REQUIRES HOST http@0
REQUIRES HOST packages@0

# amy and the recipe engine it runs (the dollyfile package): what a session needs
# to install packages. amy reads the package index of an image directory, by
# default the one the page loads its images from.
FROM /v0.1.6/Dollyfile-system-build 47fc8a7a105ecc1b7de1859851073c27fe52d8d446cef744dc78ccf6ad9575a9
INSTALL /v0.1.6/Dollyfile-dollyfile ff031a5e534f1f48c2db36ccb0a809bc41d27dffc7badecfab76a301633036dd
REQUIRES HEADER libc
REQUIRES HEADER http
REQUIRES TOOL cc
REQUIRES TOOL rm

SOURCE /v0.1.6/dist/static/default/commands/amy.c f7c5e9328434e22fe728f110a3a0f1073230d7ad7701b1f8ed41027853302a2c /tmp/amy/amy.c
SLOP cc -O2 /tmp/amy/amy.c -o /bin/amy

EXPORTS TOOL amy
SLOP amy --help > /usr/share/man/cat1/amy.1
FILE /usr/share/man/cat1/amy.1
SLOP rm -rf /tmp/amy
