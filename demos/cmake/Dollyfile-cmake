DOLLY 7
PACKAGE cmake
REQUIRES HOST runtime@0
REQUIRES HOST http@0

# CMake bootstrapped from upstream's source inside Dolly, on the libuv package,
# which it links statically (USE); cmake-build installs it for the CMake builds
# that start from it.
FROM /v0.1.4/Dollyfile-system-tools a76845818fc0a13aea061f36003eb48fe8e5ca139b6e9668d43cf63198bcd60a
USE /v0.1.4/demos/cmake/Dollyfile-libuv 40e2a56d86369147b172efd0e861e6fa6d20086f95a353359f4d6f678ec730a7
# Configuring runs the C compiler and building runs make.
INSTALL /v0.1.4/Dollyfile-cc f3b9c5184a4243217cdb69917e2af12c78c7bea46eb889c25f73b46a3c74fd82
REQUIRES HEADER libc
REQUIRES HEADER runtime
REQUIRES HEADER cpp
REQUIRES HEADER uv
REQUIRES LIB c++
REQUIRES LIB c++abi
REQUIRES LIB uv
REQUIRES LIB curl
REQUIRES LIB z
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL cp
REQUIRES TOOL tar
REQUIRES TOOL rm
REQUIRES TOOL sh
REQUIRES TOOL gzip
REQUIRES TOOL mkdir
REQUIRES TOOL cat
REQUIRES TOOL dirname
REQUIRES TOOL diff
REQUIRES TOOL echo
REQUIRES TOOL false
REQUIRES TOOL grep
REQUIRES TOOL printf
REQUIRES TOOL pwd
REQUIRES TOOL sed
REQUIRES TOOL test
REQUIRES TOOL tr
REQUIRES TOOL true
REQUIRES TOOL uname
REQUIRES TOOL which

SOURCE /v0.1.4/dist/static/cmake/cmake.tar.gz e49a4a2cd7ed5ff7fb2b8a7bf3a0ce1a61b7dd444b20604075e2152f158c4a41 /tmp/cmake/source.tar.gz
SLOP gzip -dc /tmp/cmake/source.tar.gz | tar -xf - -C /

FILE /tmp/cmake/build.slop
    set -ex
    cd /tmp/cmake/source
    CC=cc CXX=c++ CFLAGS=-O0 CXXFLAGS='-O0 -std=c++17' slop bootstrap \
      --prefix=/usr --parallel=1 --bootstrap-system-libuv \
      --system-libuv --system-curl --system-zlib --no-qt-gui --no-debugger \
      -- -DBUILD_TESTING=OFF -DBUILD_CursesDialog=OFF -DCMAKE_USE_OPENSSL=OFF \
      -DCMake_INSTALL_COMPONENTS=ON \
      -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_FLAGS_DEBUG=-O0 -DCMAKE_CXX_FLAGS_DEBUG=-O0
    make cmake
    ./bin/cmake --install . --component cmake
    ./bin/cmake --install . --component Unspecified
    cmake --version
SLOP slop -e /tmp/cmake/build.slop
SLOP rm -rf /tmp/cmake

EXPORTS TOOL   cmake
EXPORTS FOLDER cmake-data /usr/share/cmake-4.4
FILE /usr/share/licenses/cmake/LICENSE.rst
FILE /usr/share/licenses/libuv/LICENSE
FILE /usr/share/man/cat1/cmake.1
    cmake: CMake bootstrapped from upstream's source inside Dolly, with the cc
    package it configures and builds with.
    
      cmake -S . -B build           configures, for Unix Makefiles
      cmake --build build           builds through make
      cmake --help                  every option
    
    The platform is Dolly's (Platform/Dolly.cmake): CMAKE_SYSTEM_NAME is Dolly.
    Upstream's documentation: https://cmake.org/cmake/help/latest/
