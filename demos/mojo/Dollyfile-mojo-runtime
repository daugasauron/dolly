      static uint32_t known[6];
      if (!known[0]) {
        if (dolly_gpu_capabilities(&g) < 72) return errno ? -errno : -EIO;
        memcpy(known, g.reply + 44, 20);
        memcpy(known + 5, g.reply + 68, 4);
      }
      memcpy(limits, known, sizeof known);
      return 0;
    }

