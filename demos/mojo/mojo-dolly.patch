diff --git a/AsyncRT/lib/Support/Semaphore.cpp b/AsyncRT/lib/Support/Semaphore.cpp
index 02b2237..23ef1d1 100644
--- a/AsyncRT/lib/Support/Semaphore.cpp
+++ b/AsyncRT/lib/Support/Semaphore.cpp
@@ -108,6 +108,15 @@ bool Semaphore::Impl::wait() {
 }
 
 bool Semaphore::Impl::wait(int64_t timeoutNS) {
+#if defined(__dolly__)
+  // The libc of a Dolly process without threads has no sem_timedwait: what
+  // cannot be taken now is tried once more when the time is over.
+  if (sem_trywait(&sema) == 0)
+    return false;
+  struct timespec timeout = {timeoutNS / 1000000000, timeoutNS % 1000000000};
+  nanosleep(&timeout, nullptr);
+  return sem_trywait(&sema) != 0;
+#endif
   // Get the current time - the timeout on sem_timedwait is an absolute timeout
   // since the epoch.
   struct timespec ts;
