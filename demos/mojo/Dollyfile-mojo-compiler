DOLLY 7
PACKAGE mojo-compiler
REQUIRES HOST runtime@0

# The Mojo compiler as mojo-build built it in Dolly, with the standard library
# and the package gpu it precompiled, and what a program links against, as
# mojo-runtime built it: mojo build NAME.mojo makes a Dolly executable.
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build a2cda2942a6ddf61f73340142bd53da615e56991e7be10426268d9263579ccf3 /opt/mojo/bin/mojo /usr/bin/mojo
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build a2cda2942a6ddf61f73340142bd53da615e56991e7be10426268d9263579ccf3 /opt/mojo/lib/mojo /usr/lib/mojo
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build a2cda2942a6ddf61f73340142bd53da615e56991e7be10426268d9263579ccf3 /usr/share/licenses/mojo /usr/share/licenses/mojo
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-runtime 76738d7595babd5932b996db2947951f7b9998b619ab16c6a11464d898b14a06 /usr/lib/libmojo-rt.a /usr/lib/libmojo-rt.a
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-runtime 76738d7595babd5932b996db2947951f7b9998b619ab16c6a11464d898b14a06 /usr/lib/libmojo-gpu.a /usr/lib/libmojo-gpu.a
# mojo build links what it compiles with the C toolchain.
INSTALL /v0.1.2/Dollyfile-cc 1ee4d7e9d50a9740a041891ce347ed8856dae350c9ab0aefe2cfdf719be76964
# Where the compiler looks for packages, and what it hands cc to link a
# program: the runtime in place of upstream's shared CompilerRT, and the
# libraries of the package gpu, of which a link takes what the program uses.
# A program with a kernel needs gpu@0, which this package does not declare:
# it runs in an image that does.
FILE /etc/modular/modular.cfg
    [mojo-max]
    package_root = /usr
    import_path = /usr/lib/mojo
    compilerrt_path = /usr/lib/libmojo-rt.a
    shared_libs = -lmojo-gpu,-ldolly-gpu
EXPORTS TOOL mojo
EXPORTS LIB mojo-rt  /usr/lib/libmojo-rt.a
EXPORTS LIB mojo-gpu /usr/lib/libmojo-gpu.a
EXPORTS FOLDER mojo-packages /usr/lib/mojo
EXPORTS FOLDER mojo-licenses /usr/share/licenses/mojo
