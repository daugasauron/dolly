COPY /v0.1.3/demos/mojo/Dollyfile-mojo-build 54e834622d8ae768670cdba14011e77bf605f296673d35990364b8259f78320e /usr/share/licenses/mojo /usr/share/licenses/mojo
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-runtime a832b58dd21b5a8ff477a89bc684d85ef790a034731ac2d0fb2bb2c940a36267 /usr/lib/libmojo-rt.a /usr/lib/libmojo-rt.a
