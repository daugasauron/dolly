# The Mojo compiler as mojo-build built it in Dolly, with the standard library
# and the package gpu it precompiled, and what a program links against, as
# mojo-runtime built it: mojo build NAME.mojo makes a Dolly executable.
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-build 7b0134dedd2f154abc04cc8665f7cd8999a17bab8e65c9d91f387c61d2a2678c /opt/mojo/bin/mojo /usr/bin/mojo
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-build 7b0134dedd2f154abc04cc8665f7cd8999a17bab8e65c9d91f387c61d2a2678c /opt/mojo/lib/mojo /usr/lib/mojo
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-build 7b0134dedd2f154abc04cc8665f7cd8999a17bab8e65c9d91f387c61d2a2678c /usr/share/licenses/mojo /usr/share/licenses/mojo
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-runtime 1238fca2e58d621e40168df7e4009e7533a365cf1e3d1a32f388c9d13fb9557a /usr/lib/libmojo-rt.a /usr/lib/libmojo-rt.a
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-runtime 1238fca2e58d621e40168df7e4009e7533a365cf1e3d1a32f388c9d13fb9557a /usr/lib/libmojo-gpu.a /usr/lib/libmojo-gpu.a
# mojo build links what it compiles with the C toolchain.
