COPY /v0.1.4/demos/mojo/Dollyfile-mojo-build 16318ae2c9634190cceef0fd2dfa12df01bb6cd2d882854a3fead85572a4301d /opt/mojo/lib/mojo /usr/lib/mojo
COPY /v0.1.4/demos/mojo/Dollyfile-mojo-build 16318ae2c9634190cceef0fd2dfa12df01bb6cd2d882854a3fead85572a4301d /usr/share/licenses/mojo /usr/share/licenses/mojo
COPY /v0.1.4/demos/mojo/Dollyfile-mojo-runtime f85b55bbde00df868fe1a6f88a495a95aabed4925e538da0824e9eb048d8cc40 /usr/lib/libmojo-rt.a /usr/lib/libmojo-rt.a
