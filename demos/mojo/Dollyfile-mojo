# The Mojo compiler as mojo-build built it in Dolly, with the standard library
# and the package gpu it precompiled, and what a program links against, as
# mojo-runtime built it: mojo build NAME.mojo makes a Dolly executable.
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-build ae92093d9acfd1af47ea93adcc8a0195e4e9e9bed50b20ed7f9b88afc1be7629 /opt/mojo/bin/mojo /usr/bin/mojo
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-build ae92093d9acfd1af47ea93adcc8a0195e4e9e9bed50b20ed7f9b88afc1be7629 /opt/mojo/lib/mojo /usr/lib/mojo
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-build ae92093d9acfd1af47ea93adcc8a0195e4e9e9bed50b20ed7f9b88afc1be7629 /usr/share/licenses/mojo /usr/share/licenses/mojo
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-runtime 9b49cb411bea8c8b17db4d5a211204ac0585ba65bed718c55e48220be6031343 /usr/lib/libmojo-rt.a /usr/lib/libmojo-rt.a
COPY /v0.1.3/demos/mojo/Dollyfile-mojo-runtime 9b49cb411bea8c8b17db4d5a211204ac0585ba65bed718c55e48220be6031343 /usr/lib/libmojo-gpu.a /usr/lib/libmojo-gpu.a
# mojo build links what it compiles with the C toolchain.
INSTALL /v0.1.3/Dollyfile-cc 9b2ee0e1f23927fb8f8837a7523e077dfb21e33a8b686d7e9379df05ca00387a
# Where the compiler looks for packages, and what it hands cc to link a
# program: the runtime in place of upstream's shared CompilerRT, and the
# libraries of the package gpu, of which a link takes what the program uses.
# A program with a kernel needs gpu@0, which this package does not declare:
# it runs in an image that does.
FILE /etc/modular/modular.cfg
    [mojo-max]
    package_root = /usr
    import_path = /usr/lib/mojo
    compilerrt_path = /usr/lib/libmojo-rt.a
    shared_libs = -lmojo-gpu,-ldolly-gpu
EXPORTS TOOL mojo
EXPORTS LIB mojo-rt  /usr/lib/libmojo-rt.a
EXPORTS LIB mojo-gpu /usr/lib/libmojo-gpu.a
EXPORTS FOLDER mojo-packages /usr/lib/mojo
EXPORTS FOLDER mojo-licenses /usr/share/licenses/mojo
