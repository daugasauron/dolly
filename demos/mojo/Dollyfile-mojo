COPY /v0.1.4/demos/mojo/Dollyfile-mojo-build 68e693586acb310b13fcdabf66173045fae032cfc1fb539d9d420363db7e4de5 /opt/mojo/lib/mojo /usr/lib/mojo
COPY /v0.1.4/demos/mojo/Dollyfile-mojo-build 68e693586acb310b13fcdabf66173045fae032cfc1fb539d9d420363db7e4de5 /usr/share/licenses/mojo /usr/share/licenses/mojo
COPY /v0.1.4/demos/mojo/Dollyfile-mojo-runtime 02279e7f6a5cd03274b911e9f181fe8ba7c1afc86fa39c7a0f627eccdb4ec91f /usr/lib/libmojo-rt.a /usr/lib/libmojo-rt.a
COPY /v0.1.4/demos/mojo/Dollyfile-mojo-runtime 02279e7f6a5cd03274b911e9f181fe8ba7c1afc86fa39c7a0f627eccdb4ec91f /usr/lib/libmojo-gpu.a /usr/lib/libmojo-gpu.a
# mojo build links what it compiles with the C toolchain.
INSTALL /v0.1.4/Dollyfile-libdolly-gpu 1308d574fd8b030fac77cf9814dc9925d2737be130a6401b9929c80e13307bf2
INSTALL /v0.1.4/Dollyfile-cc dadb1af6ae3450a3a48bf4c955fe40d012a9a20d6dc3eca63c4f2737ab4080cc
# Where the compiler looks for packages, and what it hands cc to link a
# program: the runtime in place of upstream's shared CompilerRT, and the
# libraries of the package gpu, of which a link takes what the program uses.
# A program with a kernel needs gpu@0, which this package does not declare:
# it runs in an image that does.
FILE /etc/modular/modular.cfg
    [mojo-max]
    package_root = /usr
    import_path = /usr/lib/mojo
    compilerrt_path = /usr/lib/libmojo-rt.a
    shared_libs = -lmojo-gpu,-ldolly-gpu
EXPORTS TOOL mojo
EXPORTS LIB mojo-rt  /usr/lib/libmojo-rt.a
EXPORTS LIB mojo-gpu /usr/lib/libmojo-gpu.a
EXPORTS FOLDER mojo-packages /usr/lib/mojo
EXPORTS FOLDER mojo-licenses /usr/share/licenses/mojo
FILE /usr/share/man/cat1/mojo.1
    mojo: the Mojo compiler built inside Dolly, with its standard library, the
    package gpu and the cc package it links with.
    
      mojo build NAME.mojo && ./NAME     compiles a program for Dolly, then runs it
      mojo precompile -o P.mojoc DIR     makes a package; -I finds it
      mojo doc, mojo demangle            as upstream's
    
    mojo run and mojo NAME.mojo run a program through a JIT, which a WebAssembly
    process cannot do: they refuse and print the line above. mojo repl and mojo
    debug need LLDB, which is not built, and mojo format a formatter that is not
    installed. The only target is Dolly's (wasm64). A program that imports gpu
    runs where the image has gpu@0, as mojo-gpu does; elsewhere it is refused
    with status 126. The compiler runs on one thread.
