COPY /v0.1.3/demos/mojo/Dollyfile-mojo-build f17c5ee8f04480eae81c5bcd5675189141b1b5e7596cb4e899636a4142c908e6 /usr/share/licenses/mojo /usr/share/licenses/mojo
