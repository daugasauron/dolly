DOLLY 7
APPLICATION mojo
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST download@0
REQUIRES HOST gpu@0
REQUIRES HOST http@0
REQUIRES HOST snapshot@0
REQUIRES HOST upload@0

# A shell with the Mojo compiler that mojo-build built in Dolly and what its
# programs link against: mojo build NAME.mojo makes a Dolly executable.
FROM /v0.1.2/demos/mojo/Dollyfile-mojo-runtime d5abff16680f85273af061cccb7ae8f29cefc7ec46b571499dcde8b0d603c52b
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build a37ff0f2996f64651f8fc9c3431511a4d72d6f832221ae0fc4dfc2e59de864ec /opt/mojo/bin/mojo /usr/bin/mojo
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build a37ff0f2996f64651f8fc9c3431511a4d72d6f832221ae0fc4dfc2e59de864ec /opt/mojo/lib/mojo /usr/lib/mojo
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build a37ff0f2996f64651f8fc9c3431511a4d72d6f832221ae0fc4dfc2e59de864ec /usr/share/licenses/mojo /usr/share/licenses/mojo
REQUIRES TOOL cc
REQUIRES LIB mojo-rt
REQUIRES LIB mojo-gpu
REQUIRES LIB dolly-gpu
# Where the compiler looks for packages, and what it hands cc to link a
# program: the runtime in place of upstream's shared CompilerRT, and the
# libraries of the package gpu, of which a link takes what the program uses.
FILE /etc/modular/modular.cfg
    [mojo-max]
    package_root = /usr
    import_path = /usr/lib/mojo
    compilerrt_path = /usr/lib/libmojo-rt.a
    shared_libs = -lmojo-gpu,-ldolly-gpu
EXPORTS TOOL mojo
EXPORTS FOLDER mojo-packages /usr/lib/mojo
EXPORTS FOLDER mojo-licenses /usr/share/licenses/mojo

# Programs to start from: the target's test programs, as they are tested.
SOURCE /v0.1.2/dist/static/mojo/examples/hello.mojo d4e226386de30b33dba73929f423f9c820f482edc771bdd2b0a625b204fd25e5 /home/dolly/mojo/hello.mojo
SOURCE /v0.1.2/dist/static/mojo/examples/saxpy.mojo 15035ff21b6e8a5c00ba7f7ac62ab28f33663fa1df00e54ab7ecf0c6cee4d891 /home/dolly/mojo/saxpy.mojo
SOURCE /v0.1.2/dist/static/mojo/examples/mandelbrot.mojo 08b7af85c9f3ee75311940c02c7392d327622faa3741b51ee5b627dbdbb16d6c /home/dolly/mojo/mandelbrot.mojo
FOLDER /home/dolly/mojo
FILE /home/dolly/.dollyrc
    echo 'DOLLY / MOJO: the Mojo compiler, compiled inside Dolly, and WebGPU.'
    echo '  cd ~/mojo && mojo build mandelbrot.mojo && ./mandelbrot    kernels on the GPU'
    echo '  mojo build hello.mojo && ./hello'
    echo 'There is no mojo run here: build, then run.'
    echo

# The compiler and the link work here; a kernel runs where there is a GPU.
REQUIRES TOOL mkdir
REQUIRES TOOL test
SLOP mkdir /tmp/mojo-check
SLOP CWD /home/dolly/mojo slop -c 'mojo build -o /tmp/mojo-check/hello hello.mojo && test "$(/tmp/mojo-check/hello)" = "hello from mojo"'
SLOP CWD /home/dolly/mojo slop -c 'mojo build -o /tmp/mojo-check/saxpy saxpy.mojo && mojo build -o /tmp/mojo-check/mandelbrot mandelbrot.mojo'

ENTRY /bin/foreground -i /bin/slop
