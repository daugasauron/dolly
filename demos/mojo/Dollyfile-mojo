COPY /v0.1.4/demos/mojo/Dollyfile-mojo-build 5d5047987412101ef84b9a06c38838413d2dd7825214aff99bcba813045c922e /usr/share/licenses/mojo /usr/share/licenses/mojo
COPY /v0.1.4/demos/mojo/Dollyfile-mojo-runtime f149034053c46894bf120a1d5c77bb1ac0276c3a32a1ca875051d2e9b071c886 /usr/lib/libmojo-rt.a /usr/lib/libmojo-rt.a
