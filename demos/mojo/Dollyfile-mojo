# The Mojo compiler as mojo-build built it in Dolly, with the standard library
# and the package gpu it precompiled, and what a program links against, as
# mojo-runtime built it: mojo build NAME.mojo makes a Dolly executable.
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build af68142810c89e9f9e9413edd36d30bd15a32f7e603ed7b58536ba59c64fd136 /opt/mojo/bin/mojo /usr/bin/mojo
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build af68142810c89e9f9e9413edd36d30bd15a32f7e603ed7b58536ba59c64fd136 /opt/mojo/lib/mojo /usr/lib/mojo
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-build af68142810c89e9f9e9413edd36d30bd15a32f7e603ed7b58536ba59c64fd136 /usr/share/licenses/mojo /usr/share/licenses/mojo
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-runtime 0d34ab7c2e5b6476086dfec1d423cf62808c52cf1c2fb9824ca28f27eead8456 /usr/lib/libmojo-rt.a /usr/lib/libmojo-rt.a
COPY /v0.1.2/demos/mojo/Dollyfile-mojo-runtime 0d34ab7c2e5b6476086dfec1d423cf62808c52cf1c2fb9824ca28f27eead8456 /usr/lib/libmojo-gpu.a /usr/lib/libmojo-gpu.a
# mojo build links what it compiles with the C toolchain.
INSTALL /v0.1.2/Dollyfile-cc 3c6df9b9fba2eb38d3fbce1af8149ea307c6f4d6cca10a134c0707998681a7ab
# Where the compiler looks for packages, and what it hands cc to link a
# program: the runtime in place of upstream's shared CompilerRT, and the
# libraries of the package gpu, of which a link takes what the program uses.
# A program with a kernel needs gpu@0, which this package does not declare:
# it runs in an image that does.
FILE /etc/modular/modular.cfg
    [mojo-max]
    package_root = /usr
    import_path = /usr/lib/mojo
    compilerrt_path = /usr/lib/libmojo-rt.a
    shared_libs = -lmojo-gpu,-ldolly-gpu
EXPORTS TOOL mojo
EXPORTS LIB mojo-rt  /usr/lib/libmojo-rt.a
EXPORTS LIB mojo-gpu /usr/lib/libmojo-gpu.a
EXPORTS FOLDER mojo-packages /usr/lib/mojo
EXPORTS FOLDER mojo-licenses /usr/share/licenses/mojo
