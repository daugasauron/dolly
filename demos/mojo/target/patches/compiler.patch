diff --git a/Mojo/lib/Target/Dolly/DollyTraits.h b/Mojo/lib/Target/Dolly/DollyTraits.h
new file mode 100644
index 0000000..c63da5f
--- /dev/null
+++ b/Mojo/lib/Target/Dolly/DollyTraits.h
@@ -0,0 +1,76 @@
+//===----------------------------------------------------------------------===//
+// Added for Dolly, a POSIX-like userspace for wasm64 in the browser.
+//
+// Licensed under the Apache License v2.0 with LLVM Exceptions:
+// https://llvm.org/LICENSE.txt
+//===----------------------------------------------------------------------===//
+
+//
+// Dolly: a POSIX-like userspace for wasm64 in the browser. Programs are
+// wasm64 objects that Dolly's `cc` links against its process sysroot.
+// WebGPU: compute kernels emitted as WGSL for Dolly's `gpu@0`.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef KGEN_TARGET_DOLLY_DOLLYTRAITS_H
+#define KGEN_TARGET_DOLLY_DOLLYTRAITS_H
+
+#include "Target/TargetTraits.h"
+
+#include "llvm/TargetParser/Triple.h"
+
+namespace M::KGEN {
+
+struct DollyTraits final : TargetTraits {
+  llvm::StringRef name() const override { return "dolly"; }
+  bool matches(const llvm::Triple &triple) const override {
+    return triple.getArch() == llvm::Triple::wasm64 &&
+           triple.getOSName() == "dolly";
+  }
+  llvm::StringRef defaultCPU(const llvm::Triple &) const override {
+    return "generic";
+  }
+  /// LLVM has no Dolly OS. Dolly's libc archives are built for this triple,
+  /// as its C compiler does; it is not the platform's name.
+  std::string codegenTriple(llvm::StringRef) const override {
+    return "wasm64-unknown-emscripten";
+  }
+  llvm::StringRef getAsmExtension() const override { return ".s"; }
+  llvm::StringRef getLLVMExtension() const override { return ".ll"; }
+  llvm::StringRef getObjectExtension() const override { return ".o"; }
+
+  static const DollyTraits &get();
+
+protected:
+  bool isBaseTarget() const override { return true; }
+};
+
+struct WebGPUTraits final : TargetTraits {
+  llvm::StringRef name() const override { return "webgpu"; }
+  bool matches(const llvm::Triple &triple) const override {
+    return triple.getArch() == llvm::Triple::wasm32 &&
+           triple.getOSName() == "webgpu";
+  }
+  bool isGPU() const override { return true; }
+  llvm::StringRef defaultCPU(const llvm::Triple &) const override {
+    return "generic";
+  }
+  /// A kernel is optimized as 32-bit LLVM IR (WGSL has no 64-bit integers
+  /// and its pointers index buffers) and then printed as WGSL.
+  std::string codegenTriple(llvm::StringRef) const override {
+    return "wasm32-unknown-unknown";
+  }
+  bool emitsOffloadObjectFile() const override { return false; }
+  llvm::StringRef getAsmExtension() const override { return ".wgsl"; }
+  llvm::StringRef getLLVMExtension() const override { return ".webgpu.ll"; }
+  llvm::StringRef getObjectExtension() const override { return ".wgsl"; }
+
+  static const WebGPUTraits &get();
+
+protected:
+  bool isBaseTarget() const override { return true; }
+};
+
+} // namespace M::KGEN
+
+#endif // KGEN_TARGET_DOLLY_DOLLYTRAITS_H
diff --git a/Support/include/Support/MDialect/MAttrs.td b/Support/include/Support/MDialect/MAttrs.td
index b720fd1..fa62243 100644
