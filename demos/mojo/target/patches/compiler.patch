@@ -391,6 +391,10 @@ def M_TargetInfoAttr : MAttr<"TargetInfo", "target"> {
 
     /// Returns the operating system for the triple.
     StringRef getOS() const {
+      // LLVM names the operating systems it knows. Dolly is not one of them
+      // and is not to be mistaken for one.
