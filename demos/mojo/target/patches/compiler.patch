@@ -22,6 +22,7 @@
 #include "llvm/IR/LegacyPassManager.h"
 #include "llvm/IR/PassManager.h"
 #include "llvm/Linker/Linker.h"
+#include "llvm/MC/MCSymbolWasm.h"
 #include "llvm/Target/TargetLoweringObjectFile.h"
 #include "llvm/Target/TargetMachine.h"
 #include "llvm/TargetParser/Triple.h"
@@ -34,6 +35,33 @@ void SymbolAndMCInfo::clear() {
   mcInfos.clear();
 }
 
+/// Wasm code names its function table by a symbol of the context it was
+/// generated in; the object is printed in this linker's context, which makes
+/// that symbol too. Left alone, the object declares __indirect_function_table
+/// twice and no linker takes it.
+static void adoptWasmFunctionTable(llvm::MachineFunction &mf,
+                                   llvm::MCContext &printed) {
+  for (llvm::MachineBasicBlock &block : mf) {
+    for (llvm::MachineInstr &instruction : block) {
+      for (llvm::MachineOperand &operand : instruction.operands()) {
+        if (!operand.isMCSymbol() ||
+            operand.getMCSymbol()->getName() != "__indirect_function_table")
+          continue;
+        auto *generated =
+            static_cast<llvm::MCSymbolWasm *>(operand.getMCSymbol());
+        auto *table = static_cast<llvm::MCSymbolWasm *>(
+            printed.getOrCreateSymbol(generated->getName()));
+        if (!table->isFunctionTable()) {
+          table->setFunctionTable(printed.getTargetTriple().isArch64Bit());
+          if (generated->omitFromLinkingSection())
+            table->setOmitFromLinkingSection();
+        }
+        operand.ChangeToMCSymbol(table, operand.getTargetFlags());
+      }
+    }
+  }
+}
