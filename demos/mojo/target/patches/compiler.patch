     }
 
diff --git a/Support/lib/MArchTarget/MArchTargetMinimal.cpp b/Support/lib/MArchTarget/MArchTargetMinimal.cpp
index a96d1af..0a5eea9 100644
--- a/Support/lib/MArchTarget/MArchTargetMinimal.cpp
+++ b/Support/lib/MArchTarget/MArchTargetMinimal.cpp
@@ -78,8 +78,10 @@ M::getFeaturesFromClang(std::shared_ptr<clang::TargetOptions> opts,
 
   // AARCH64 CPU features are not parsed by `CreateTargetInfo`. We have to query
   // them and add them here manually.
+  // "generic" names a CPU of other architectures too.
   if (std::optional<llvm::AArch64::CpuInfo> cpuInfo =
-          llvm::AArch64::parseCpu(cpu)) {
+          llvm::Triple(opts->Triple).isAArch64() ? llvm::AArch64::parseCpu(cpu)
+                                                 : std::nullopt) {
     std::vector<std::string> updatedFeaturesVec;
     auto exts = cpuInfo->DefaultExtensions;
     std::vector<StringRef> cpuFeats;
@@ -115,6 +117,16 @@ M::getFeaturesFromClang(std::shared_ptr<clang::TargetOptions> opts,
       features.emplace_back(feature.drop_front());
   }
 
+  // Every object of Dolly's C compiler has the first two beyond the generic
+  // CPU: a process shares its memory with its threads, and its C++ unwinds.
+  // Mojo's coroutines resume through calls that must be tail calls, which
+  // every browser with 64-bit memories has.
+  if (llvm::Triple(opts->Triple).getOSName() == "dolly") {
+    features.emplace_back("atomics");
+    features.emplace_back("exception-handling");
+    features.emplace_back("tail-call");
+  }
+
   llvm::sort(features);
   // The per-architecture blocks above append what clang already resolved, so a
   // CPU's base ISA can appear twice.
