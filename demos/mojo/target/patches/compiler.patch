         machineModInfoPass->getMMI().insertFunction(fn, std::move(mf));
 
         // Restore function linkage types.
@@ -282,6 +312,9 @@ MCLinker::getModuleToPrintOneSplit(llvm::TargetMachine &llvmTargetMachine) {
