FILE /usr/src/dolly/raylib/rcore_dolly.c
    // raylib's platform backend for Dolly, built into raylib's own rcore.c as its
    // custom platform (rcore-dolly.c includes rcore.c, then this file):
    //   - the window is display@0's surface, sized as InitWindow asks; a frame is
    //     presented in SwapScreenBuffer and paced by the page's animation frames;
    //   - keys, text, the pointer and the wheel come from input@0 in PollInputEvents;
    //   - fingers come from touch@0 where the page has a touchscreen for the program;
    //   - the clock is CLOCK_MONOTONIC.
    // A hidden window (FLAG_WINDOW_HIDDEN), or a program that already holds the
    // display (it composes raylib's frame into its own, or opened it through
    // <dolly/raylib.h>), has raylib render to memory only: the program presents
    // the frame and hands raylib its key events through DollyRaylibInputEvent.
    #include <dolly/display.h>
    #include <dolly/input.h>
    #include <dolly/touch.h>
    #include <time.h>
    
    typedef struct {
        int window;                         // raylib holds the display and the input
        dolly_display_surface surface;
        uint64_t input;
        uint64_t touch;                     // 0 without fingers
        uint32_t animationFrame;
        double start;
    } PlatformData;
    
    static PlatformData platform = { 0 };
    
    // A key or button pressed and released between two frames still reads as
    // pressed for one frame: its release waits for the next PollInputEvents.
    static char keyReleaseNext[MAX_KEYBOARD_KEYS] = { 0 };
    static char buttonReleaseNext[MAX_MOUSE_BUTTONS] = { 0 };
    static char touchReleaseNext = 0;
    
    static double MonotonicSeconds(void)
    {
        struct timespec now = { 0 };
        clock_gettime(CLOCK_MONOTONIC, &now);
        return (double)now.tv_sec + (double)now.tv_nsec*1e-9;
    }
    
    // KeyboardEvent.code of a key record, as raylib's KeyboardKey.
    static int KeyFromCode(const char *code, int length)
    {
        static const struct { const char *code; int key; } keys[] = {
            { "Space", KEY_SPACE }, { "Quote", KEY_APOSTROPHE }, { "Comma", KEY_COMMA }, { "Minus", KEY_MINUS },
            { "Period", KEY_PERIOD }, { "Slash", KEY_SLASH }, { "Semicolon", KEY_SEMICOLON }, { "Equal", KEY_EQUAL },
            { "BracketLeft", KEY_LEFT_BRACKET }, { "Backslash", KEY_BACKSLASH }, { "BracketRight", KEY_RIGHT_BRACKET },
            { "Backquote", KEY_GRAVE }, { "Escape", KEY_ESCAPE }, { "Enter", KEY_ENTER }, { "Tab", KEY_TAB },
            { "Backspace", KEY_BACKSPACE }, { "Insert", KEY_INSERT }, { "Delete", KEY_DELETE },
            { "ArrowRight", KEY_RIGHT }, { "ArrowLeft", KEY_LEFT }, { "ArrowDown", KEY_DOWN }, { "ArrowUp", KEY_UP },
            { "PageUp", KEY_PAGE_UP }, { "PageDown", KEY_PAGE_DOWN }, { "Home", KEY_HOME }, { "End", KEY_END },
            { "CapsLock", KEY_CAPS_LOCK }, { "ScrollLock", KEY_SCROLL_LOCK }, { "NumLock", KEY_NUM_LOCK },
            { "PrintScreen", KEY_PRINT_SCREEN }, { "Pause", KEY_PAUSE },
            { "ShiftLeft", KEY_LEFT_SHIFT }, { "ControlLeft", KEY_LEFT_CONTROL }, { "AltLeft", KEY_LEFT_ALT },
            { "MetaLeft", KEY_LEFT_SUPER }, { "ShiftRight", KEY_RIGHT_SHIFT }, { "ControlRight", KEY_RIGHT_CONTROL },
            { "AltRight", KEY_RIGHT_ALT }, { "MetaRight", KEY_RIGHT_SUPER }, { "ContextMenu", KEY_KB_MENU },
            { "NumpadDecimal", KEY_KP_DECIMAL }, { "NumpadDivide", KEY_KP_DIVIDE }, { "NumpadMultiply", KEY_KP_MULTIPLY },
            { "NumpadSubtract", KEY_KP_SUBTRACT }, { "NumpadAdd", KEY_KP_ADD }, { "NumpadEnter", KEY_KP_ENTER },
            { "NumpadEqual", KEY_KP_EQUAL },
        };
        if ((length == 4) && (strncmp(code, "Key", 3) == 0) && (code[3] >= 'A') && (code[3] <= 'Z')) return KEY_A + (code[3] - 'A');
        if ((length == 6) && (strncmp(code, "Digit", 5) == 0) && (code[5] >= '0') && (code[5] <= '9')) return KEY_ZERO + (code[5] - '0');
        if ((length == 7) && (strncmp(code, "Numpad", 6) == 0) && (code[6] >= '0') && (code[6] <= '9')) return KEY_KP_0 + (code[6] - '0');
        if ((length >= 2) && (length <= 3) && (code[0] == 'F'))
        {
            int number = atoi(code + 1);
            if ((number >= 1) && (number <= 12)) return KEY_F1 + number - 1;
        }
        for (size_t i = 0; i < sizeof(keys)/sizeof(keys[0]); i++)
        {
            if (((int)strlen(keys[i].code) == length) && (strncmp(keys[i].code, code, length) == 0)) return keys[i].key;
        }
        return KEY_NULL;
    }
    
    static void QueueCharacter(int codepoint)
    {
        if (CORE.Input.Keyboard.charPressedQueueCount < MAX_CHAR_PRESSED_QUEUE)
        {
            CORE.Input.Keyboard.charPressedQueue[CORE.Input.Keyboard.charPressedQueueCount] = codepoint;
            CORE.Input.Keyboard.charPressedQueueCount++;
        }
    }
    
    // One input@0 record into raylib's keyboard, character and mouse state.
    void DollyRaylibInputEvent(const dolly_input_event *event)
    {
        if (event->type == DOLLY_INPUT_EVENT_KEY)
        {
            int key = KeyFromCode((const char *)event->data + event->key_length, event->code_length);
            if ((key <= KEY_NULL) || (key >= MAX_KEYBOARD_KEYS)) return;
            if (event->action == DOLLY_KEY_ACTION_RELEASE)
            {
                if (CORE.Input.Keyboard.previousKeyState[key] == 0) keyReleaseNext[key] = 1;
                else CORE.Input.Keyboard.currentKeyState[key] = 0;
            }
            else
            {
                if (event->action == DOLLY_KEY_ACTION_REPEAT) CORE.Input.Keyboard.keyRepeatInFrame[key] = 1;
                else
                {
                    CORE.Input.Keyboard.currentKeyState[key] = 1;
                    if (CORE.Input.Keyboard.keyPressedQueueCount < MAX_KEY_PRESSED_QUEUE)
                    {
                        CORE.Input.Keyboard.keyPressedQueue[CORE.Input.Keyboard.keyPressedQueueCount] = key;
                        CORE.Input.Keyboard.keyPressedQueueCount++;
                    }
                }
                if (key == CORE.Input.Keyboard.exitKey) CORE.Window.shouldClose = true;
            }
        }
        else if (event->type == DOLLY_INPUT_EVENT_TEXT)
        {
            const unsigned char *text = event->data + event->key_length + event->code_length;
            for (int offset = 0; offset < event->text_length;)
            {
                int size = 0;
                int codepoint = GetCodepointNext((const char *)text + offset, &size);
                if (size <= 0) break;
                QueueCharacter(codepoint);
                offset += size;
            }
        }
        else if (event->type == DOLLY_INPUT_EVENT_POINTER)
        {
            // A browser numbers left, middle, right, back, forward; raylib left, right, middle, side, extra, forward, back.
            static const int buttons[] = { MOUSE_BUTTON_LEFT, MOUSE_BUTTON_MIDDLE, MOUSE_BUTTON_RIGHT, MOUSE_BUTTON_BACK, MOUSE_BUTTON_FORWARD };
            unsigned int button = event->flags >> 8;
            CORE.Input.Mouse.currentPosition = (Vector2){ (float)event->x, (float)event->y };
            CORE.Input.Touch.position[0] = CORE.Input.Mouse.currentPosition;
            if ((button < 5) && (event->action != DOLLY_POINTER_ACTION_DRAG))
            {
                int mouse = buttons[button];
                if (event->action == DOLLY_POINTER_ACTION_PRESS) CORE.Input.Mouse.currentButtonState[mouse] = 1;
                else if (CORE.Input.Mouse.previousButtonState[mouse] == 0) buttonReleaseNext[mouse] = 1;
                else CORE.Input.Mouse.currentButtonState[mouse] = 0;
                CORE.Input.Touch.currentTouchState[0] = CORE.Input.Mouse.currentButtonState[MOUSE_BUTTON_LEFT];
            }
        }
        else if (event->type == DOLLY_INPUT_EVENT_SCROLL)
        {
            // Thousandths of a pixel, line or page toward later content; raylib counts lines up.
            float lines = (float)event->y/1000.0f;
            if (event->action == DOLLY_SCROLL_UNIT_PIXEL) lines /= 100.0f;
            else if (event->action == DOLLY_SCROLL_UNIT_PAGE) lines *= 3.0f;
            CORE.Input.Mouse.currentWheelMove.y -= lines;
        }
        else if (event->type == DOLLY_INPUT_EVENT_FOCUS)
        {
            if (event->action) CORE.Window.flags &= ~FLAG_WINDOW_UNFOCUSED;
            else CORE.Window.flags |= FLAG_WINDOW_UNFOCUSED;
        }
    }
    
    // One touch@0 record into raylib's touch points as its own touch platforms
    // keep them: the fingers down in the order they came, each change a gesture
    // event, and the first finger also the mouse.
    static void DollyRaylibTouchRecord(const dolly_touch_record *record)
    {
        int index = 0;
        while ((index < CORE.Input.Touch.pointCount) && (CORE.Input.Touch.pointId[index] != (int)record->id)) index++;
        if (index == CORE.Input.Touch.pointCount)
        {
            if ((record->phase != DOLLY_TOUCH_DOWN) || (index == MAX_TOUCH_POINTS)) return;
            CORE.Input.Touch.pointId[index] = (int)record->id;
            CORE.Input.Touch.pointCount++;
        }
        CORE.Input.Touch.position[index] = (Vector2){ (float)record->x, (float)record->y };
    #if SUPPORT_GESTURES_SYSTEM
        GestureEvent gesture = { 0 };
        gesture.touchAction = (record->phase == DOLLY_TOUCH_DOWN)? TOUCH_ACTION_DOWN :
            (record->phase == DOLLY_TOUCH_MOVE)? TOUCH_ACTION_MOVE : (record->phase == DOLLY_TOUCH_UP)? TOUCH_ACTION_UP : TOUCH_ACTION_CANCEL;
        gesture.pointCount = CORE.Input.Touch.pointCount;
        for (int i = 0; i < gesture.pointCount; i++)
        {
            gesture.pointId[i] = CORE.Input.Touch.pointId[i];
            gesture.position[i] = (Vector2){ CORE.Input.Touch.position[i].x/(float)GetScreenWidth(),
                CORE.Input.Touch.position[i].y/(float)GetScreenHeight() };
        }
        ProcessGestureEvent(gesture);
    #endif
        if ((record->phase == DOLLY_TOUCH_UP) || (record->phase == DOLLY_TOUCH_CANCEL))
        {
            for (int i = index; i < CORE.Input.Touch.pointCount - 1; i++)
            {
                CORE.Input.Touch.pointId[i] = CORE.Input.Touch.pointId[i + 1];
                CORE.Input.Touch.position[i] = CORE.Input.Touch.position[i + 1];
            }
            CORE.Input.Touch.pointCount--;
        }
        // A tap inside one frame still reads as down for a frame, as keys do.
        if (CORE.Input.Touch.pointCount > 0) CORE.Input.Touch.currentTouchState[MOUSE_BUTTON_LEFT] = 1;
        else if (CORE.Input.Touch.previousTouchState[MOUSE_BUTTON_LEFT] == 0) touchReleaseNext = 1;
        else CORE.Input.Touch.currentTouchState[MOUSE_BUTTON_LEFT] = 0;
        if (index == 0) CORE.Input.Mouse.currentPosition = (Vector2){ (float)record->x, (float)record->y };
    }
    
