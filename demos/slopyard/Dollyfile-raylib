    // Presents raylib's frame and waits for the page's next animation frame.
    void SwapScreenBuffer(void)
    {
        if (!platform.window) return;
        dolly_display_frame frame = { 0 };
        if ((dolly_display_begin_frame(platform.surface.generation, &frame) == 0) &&
            (frame.pixel_format == DOLLY_DISPLAY_PIXEL_RGBA8) && ((int)frame.width == CORE.Window.render.width) &&
            ((int)frame.height == CORE.Window.render.height) && ((size_t)frame.stride*frame.height <= frame.capacity))
        {
            rlCopyFramebuffer(0, 0, CORE.Window.render.width, CORE.Window.render.height, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8, frame.pixels);
            dolly_display_present(platform.surface.generation, frame.buffer_index);
        }
        dolly_display_wait_frame(platform.surface.generation, &platform.animationFrame, 100.0);
    }
    
