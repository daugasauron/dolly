    void PollInputEvents(void)
    {
    #if SUPPORT_GESTURES_SYSTEM
        UpdateGestures();
    #endif
        CORE.Input.Keyboard.keyPressedQueueCount = 0;
        CORE.Input.Keyboard.charPressedQueueCount = 0;
        for (int i = 0; i < MAX_KEYBOARD_KEYS; i++)
        {
            CORE.Input.Keyboard.previousKeyState[i] = CORE.Input.Keyboard.currentKeyState[i];
            CORE.Input.Keyboard.keyRepeatInFrame[i] = 0;
            if (keyReleaseNext[i]) CORE.Input.Keyboard.currentKeyState[i] = keyReleaseNext[i] = 0;
        }
        for (int i = 0; i < MAX_MOUSE_BUTTONS; i++)
        {
            CORE.Input.Mouse.previousButtonState[i] = CORE.Input.Mouse.currentButtonState[i];
            if (buttonReleaseNext[i]) CORE.Input.Mouse.currentButtonState[i] = buttonReleaseNext[i] = 0;
        }
        CORE.Input.Mouse.previousPosition = CORE.Input.Mouse.currentPosition;
        CORE.Input.Mouse.previousWheelMove = CORE.Input.Mouse.currentWheelMove;
        CORE.Input.Mouse.currentWheelMove = (Vector2){ 0.0f, 0.0f };
        for (int i = 0; i < MAX_TOUCH_POINTS; i++) CORE.Input.Touch.previousTouchState[i] = CORE.Input.Touch.currentTouchState[i];
        if (touchReleaseNext) CORE.Input.Touch.currentTouchState[MOUSE_BUTTON_LEFT] = touchReleaseNext = 0;
    
        if (!platform.window) return;
        dolly_input_event event;
        while (dolly_input_next_event(platform.input, &event, 0.0) > 0) DollyRaylibInputEvent(&event);
        int count = DOLLY_TOUCH_READ_RECORDS;
        while (platform.touch && (count == DOLLY_TOUCH_READ_RECORDS))
        {
            dolly_touch_record records[DOLLY_TOUCH_READ_RECORDS];
            count = dolly_touch_read(platform.touch, records, DOLLY_TOUCH_READ_RECORDS, 0.0);
            for (int i = 0; i < count; i++) DollyRaylibTouchRecord(&records[i]);
            if (count < 0)
            {
                dolly_touch_release(platform.touch);
                platform.touch = 0;
            }
        }
    }
    
    int InitPlatform(void)
    {
        if (rlGetVersion() != RL_OPENGL_SOFTWARE)
        {
            TRACELOG(LOG_FATAL, "PLATFORM: DOLLY: raylib must be built with its software renderer (GRAPHICS_API_OPENGL_SOFTWARE)");
            return -1;
        }
        platform.start = MonotonicSeconds();
    
        // A hidden window (FLAG_WINDOW_HIDDEN), or a program that holds the display
        // already, presents raylib's frames itself.
        if (!(CORE.Window.flags & FLAG_WINDOW_HIDDEN) && (dolly_display_acquire(&platform.surface) == 0))
        {
            if (dolly_input_acquire(&platform.input) != 0)
            {
                dolly_display_release(platform.surface.generation);
                TRACELOG(LOG_WARNING, "PLATFORM: DOLLY: no input: raylib renders to memory");
            }
            else
            {
                platform.window = 1;
                // Fingers where the page has a touchscreen for the program; without
                // one the program goes on with the mouse and keys.
                if (dolly_touch_acquire(&platform.touch) != 0) platform.touch = 0;
                CORE.Window.display.width = (int)platform.surface.width;
                CORE.Window.display.height = (int)platform.surface.height;
                if (CORE.Window.screen.width == 0) CORE.Window.screen.width = (int)platform.surface.width;
                if (CORE.Window.screen.height == 0) CORE.Window.screen.height = (int)platform.surface.height;
                if (((int)platform.surface.width != CORE.Window.screen.width) || ((int)platform.surface.height != CORE.Window.screen.height))
                {
                    if (dolly_display_set_size(platform.surface.generation, (uint32_t)CORE.Window.screen.width,
                        (uint32_t)CORE.Window.screen.height, &platform.surface) != 0)
