DOLLY 7
PACKAGE llvm
REQUIRES HOST runtime@0

# The compiler llvm-cc built inside Dolly, beside the seed's: llvm-cc and
# llvm-c++ run it as cc and c++ run the seed compiler, on the same headers
# and libraries.
COPY /v0.1.3/demos/llvm/Dollyfile-llvm-cc c936018bf4c38e8fef81d9f9167d50997e785c610790214ac0b3fd907cb0e702 /usr/libexec/dolly/process-bin/compiler /usr/lib/llvm/compiler
INSTALL /v0.1.3/Dollyfile-cc 9b2ee0e1f23927fb8f8837a7523e077dfb21e33a8b686d7e9379df05ca00387a
FILE /usr/bin/llvm-cc
    #!/bin/slop
    /usr/lib/llvm/compiler --dolly-toolchain-mode=c "$@"
FILE /usr/bin/llvm-c++
    #!/bin/slop
    /usr/lib/llvm/compiler --dolly-toolchain-mode=c++ "$@"
EXPORTS TOOL llvm-cc
EXPORTS TOOL llvm-c++
EXPORTS FILE llvm-compiler /usr/lib/llvm/compiler
