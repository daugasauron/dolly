DOLLY 7
PACKAGE llvm
REQUIRES HOST runtime@0
# opt and llc load pass plugins (-rdynamic), through the loader of dso@0.
REQUIRES HOST dso@0

# LLVM 24 from the tree whose archives the seed's compiler links: its tools,
# every library, the headers and llvm-config, as llvm-build installed them
# under /usr/lib/llvm. The package keeps only the exports below. Programs that
# build against LLVM compile with cc and c++.
FROM /v0.1.4/demos/llvm/Dollyfile-llvm-build 79f72a6a41414724a34ac41686d27c0491c33f90533369912103e8b7358d82e9
INSTALL /v0.1.4/Dollyfile-cc 1e00616eeda62fce8d1e5198534152a32cc50e6452f8004a0f4f9ce4c190efd3
SLOP slop -c 'for tool in llvm-ar llvm-ranlib llvm-nm llvm-objdump llvm-readobj llvm-readelf llvm-objcopy llvm-strip \
  llvm-size llvm-strings llvm-symbolizer llvm-addr2line llvm-dwarfdump llvm-cxxfilt llvm-mc llvm-as llvm-dis llvm-link \
  opt llc llvm-config; do ln -s ../lib/llvm/bin/$tool /usr/bin/$tool; done'
EXPORTS FOLDER llvm /usr/lib/llvm
EXPORTS TOOL llvm-ar
EXPORTS TOOL llvm-ranlib
EXPORTS TOOL llvm-nm
EXPORTS TOOL llvm-objdump
EXPORTS TOOL llvm-readobj
EXPORTS TOOL llvm-readelf
EXPORTS TOOL llvm-objcopy
EXPORTS TOOL llvm-strip
EXPORTS TOOL llvm-size
EXPORTS TOOL llvm-strings
EXPORTS TOOL llvm-symbolizer
EXPORTS TOOL llvm-addr2line
EXPORTS TOOL llvm-dwarfdump
EXPORTS TOOL llvm-cxxfilt
EXPORTS TOOL llvm-mc
EXPORTS TOOL llvm-as
EXPORTS TOOL llvm-dis
EXPORTS TOOL llvm-link
EXPORTS TOOL opt
EXPORTS TOOL llc
EXPORTS TOOL llvm-config
SOURCE /v0.1.4/dist/static/llvm/licenses/llvm 8d85c1057d742e597985c7d4e6320b015a9139385cff4cbae06ffc0ebe89afee /usr/share/licenses/llvm/LICENSE.TXT
FILE /usr/share/licenses/llvm/LICENSE.TXT
FILE /usr/share/man/cat1/llvm.1
    llvm: LLVM 24 as built inside Dolly, from the sources and the tree whose
    archives the seed's compiler (cc) links, for the WebAssembly target.
    
      llvm-objdump -d main.o         disassembles; llvm-nm, llvm-readobj, llvm-ar,
                                     llvm-objcopy, llvm-dwarfdump and others beside it
      cc -S -emit-llvm main.c -o main.ll
      opt -O2 main.ll -o main.bc     the IR optimizer; llc compiles IR to an object
      c++ $(llvm-config --cxxflags) -include endian.h tool.cpp \
        $(llvm-config --ldflags --libs core) -o tool
    
    Libraries and headers are in /usr/lib/llvm. LLVM's headers include
    <endian.h> by platform name, hence -include endian.h.
    Upstream's documentation: https://llvm.org/docs/
