DOLLY 7
PACKAGE llvm
REQUIRES HOST runtime@0

# The compiler llvm-cc built inside Dolly, beside the seed's: llvm-cc and
# llvm-c++ run it as cc and c++ run the seed compiler, on the same headers
# and libraries.
COPY /v0.1.4/demos/llvm/Dollyfile-llvm-cc 8aed9b904ebc5fac52a1866fd4ce1da67fd7110579cab10c3ad97964f0553a24 /usr/libexec/dolly/process-bin/compiler /usr/lib/llvm/compiler
INSTALL /v0.1.4/Dollyfile-cc 77e8b6612a3ba8107139c05e3d4672bdc240af4d1a64f3c6e427ad2c2c3f2d71
FILE /usr/bin/llvm-cc
    #!/bin/slop
    /usr/lib/llvm/compiler --dolly-toolchain-mode=c "$@"
FILE /usr/bin/llvm-c++
    #!/bin/slop
    /usr/lib/llvm/compiler --dolly-toolchain-mode=c++ "$@"
EXPORTS TOOL llvm-cc
EXPORTS TOOL llvm-c++
EXPORTS FILE llvm-compiler /usr/lib/llvm/compiler
SOURCE /v0.1.4/dist/static/llvm/licenses/llvm 8d85c1057d742e597985c7d4e6320b015a9139385cff4cbae06ffc0ebe89afee /usr/share/licenses/llvm/LICENSE.TXT
SOURCE /v0.1.4/dist/static/llvm/licenses/clang ebcd9bbf783a73d05c53ba4d586b8d5813dcdf3bbec50265860ccc885e606f47 /usr/share/licenses/clang/LICENSE.TXT
SOURCE /v0.1.4/dist/static/llvm/licenses/lld f7891568956e34643eb6a0db1462db30820d40d7266e2a78063f2fe233ece5a0 /usr/share/licenses/lld/LICENSE.TXT
FILE /usr/share/licenses/llvm/LICENSE.TXT
FILE /usr/share/licenses/clang/LICENSE.TXT
FILE /usr/share/licenses/lld/LICENSE.TXT
FILE /usr/share/man/cat1/llvm-cc.1
    llvm-cc, llvm-c++: Clang and LLD of LLVM 24 as built inside Dolly by its
    own cc, from the seed compiler's pinned sources, beside the cc package.
    
      llvm-cc main.c -o main        as cc main.c -o main
      llvm-c++ main.cpp -o main     as c++
    
    They take the options cc and c++ take. The image that links them checks
    that they give the seed compiler's bytes for two programs and a sample of
    LLVM's own sources. cc stays the seed's.
