DOLLY 7
PACKAGE llvm
REQUIRES HOST runtime@0

# The compiler llvm-cc built inside Dolly, beside the seed's: llvm-cc and
# llvm-c++ run it as cc and c++ run the seed compiler, on the same headers
# and libraries.
COPY /v0.1.0/demos/llvm/Dollyfile-llvm-cc 684760aeff54d81c24fdb8e374fecdbd2db66df49d940ebc7a8802c9d51f40a7 /usr/libexec/dolly/process-bin/compiler /usr/lib/llvm/compiler
INSTALL /v0.1.0/Dollyfile-cc 9aecfac363a2d4e8b810805534a9c079a565f975e8911056a779c2542820e6f7
FILE /usr/bin/llvm-cc
    #!/bin/slop
    /usr/lib/llvm/compiler --dolly-toolchain-mode=c "$@"
FILE /usr/bin/llvm-c++
    #!/bin/slop
    /usr/lib/llvm/compiler --dolly-toolchain-mode=c++ "$@"
EXPORTS TOOL llvm-cc
EXPORTS TOOL llvm-c++
EXPORTS FILE llvm-compiler /usr/lib/llvm/compiler
