# llvm-c++ run it as cc and c++ run the seed compiler, on the same headers
# and libraries.
COPY /v0.1.3/demos/llvm/Dollyfile-llvm-cc e88931685a0b784213cafee9870b056336c67d9a853697e5e7847c4e7bacc4a6 /usr/libexec/dolly/process-bin/compiler /usr/lib/llvm/compiler
