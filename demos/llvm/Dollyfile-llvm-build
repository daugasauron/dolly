DOLLY 7
TOOLCHAIN llvm-build
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST download@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST input@0
REQUIRES HOST sockets@0
REQUIRES HOST upload@0

# Build-only: the libraries of Clang, LLD and the WebAssembly backend that the
# seed compiler links, compiled inside Dolly by its own c++.
FROM /v0.1.1/demos/llvm/Dollyfile-llvm-tablegen 60ea08945b7df2e0deb5c7480b7150d0d2f833788c0155e895d50ec749549d9f
REQUIRES TOOL llvm-tblgen
REQUIRES TOOL clang-tblgen
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL python
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL patch
REQUIRES TOOL time
REQUIRES TOOL find
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

SOURCE /v0.1.1/dist/static/llvm/llvm-project.tar.gz 033390c4520e51f261eb7572f0a1b4a1592121a1c8c1fc0c3db4845b079a8882 /tmp/llvm-project.tar.gz
SLOP time slop -c 'gzip -dc /tmp/llvm-project.tar.gz | tar -xf - -C /'
SLOP rm /tmp/llvm-project.tar.gz
SOURCE /v0.1.1/dist/static/llvm/llvm-host-triple.patch ec739fd5932c1040d07344a8511bae4da4157ff2bcafa348f06a555b71a10981 /tmp/llvm-host-triple.patch
SLOP patch -p1 -d /tmp/llvm-project -i /tmp/llvm-host-triple.patch

# Configured as llvm-tablegen is, and further:
# - A snapshot keeps no file times, so its Make tree cannot continue here: the
#   TableGen tools it kept run again, as the seed's native ones do.
# - The staged tree has no .git; the seed's revision is given.
# - Clang's headers define CLANG_ABI for ELF, Mach-O, Windows and Emscripten;
#   CLANG_BUILD_STATIC is their configuration for archives only.
# - LLVM's warning set includes -Wimplicit-fallthrough, whose visitor recurses
#   once per case label: SemaARM.cpp has 6,020 in a row, 1.4 MB of browser
#   stack where Chrome gives a process 950 KB.
FILE /usr/lib/llvm-build/Dolly.cmake
    set(CMAKE_BUILD_TYPE Release CACHE STRING "")
    set(CMAKE_C_FLAGS "-std=gnu17" CACHE STRING "")
    set(CMAKE_CXX_FLAGS "-include endian.h -DCLANG_BUILD_STATIC" CACHE STRING "")
    set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON CACHE BOOL "")
    set(CMAKE_RULE_MESSAGES OFF CACHE BOOL "")
    set(LLVM_ENABLE_WARNINGS OFF CACHE BOOL "")
    set(LLVM_ENABLE_PROJECTS "clang;lld" CACHE STRING "")
    set(LLVM_TARGETS_TO_BUILD WebAssembly CACHE STRING "")
    set(LLVM_HOST_TRIPLE wasm64-unknown-emscripten CACHE STRING "")
    set(LLVM_DEFAULT_TARGET_TRIPLE wasm64-unknown-emscripten CACHE STRING "")
    set(LLVM_TABLEGEN /usr/bin/llvm-tblgen CACHE STRING "")
    set(CLANG_TABLEGEN /usr/bin/clang-tblgen CACHE STRING "")
    set(LLVM_FORCE_VC_REVISION 4bfd08c2d769736841ae4f5705d76fa6daa39027 CACHE STRING "")
    set(LLVM_FORCE_VC_REPOSITORY https://github.com/llvm/llvm-project.git CACHE STRING "")
    foreach(option THREADS TERMINFO LIBEDIT LIBPFM ZLIB ZSTD LIBXML2 CURL BINDINGS)
      set(LLVM_ENABLE_${option} OFF CACHE STRING "")
    endforeach()
    foreach(option TESTS EXAMPLES BENCHMARKS DOCS)
      set(LLVM_INCLUDE_${option} OFF CACHE BOOL "")
    endforeach()
    set(LLVM_BUILD_LLVM_DYLIB OFF CACHE BOOL "")
    set(LLVM_LINK_LLVM_DYLIB OFF CACHE BOOL "")
SLOP time cmake -C /usr/lib/llvm-build/Dolly.cmake -S /tmp/llvm-project/llvm -B /tmp/llvm-build

# The seed's targets (scripts/build-toolchain.sh). Four jobs fit the 32-process
# cap; -k reports every failing unit of an hour's build, not only the first.
SLOP CWD /tmp/llvm-build time make -k -j4 clangFrontendTool clangCodeGen clang-resource-headers lldWasm LLVMWebAssemblyCodeGen
# The archives, Clang's resource directory, and the configured and generated
# headers a program including LLVM, Clang or LLD needs, by build-tree path.
SLOP CWD /tmp/llvm-build slop -c 'mkdir -p /usr/lib/llvm-build/lib && cp lib/*.a /usr/lib/llvm-build/lib && cp -R lib/clang /usr/lib/llvm-build/lib'
SLOP CWD /tmp/llvm-build slop -c 'for f in $(find include tools/clang/include tools/lld/include -name CMakeFiles -prune -o -type f \( -name "*.inc" -o -name "*.def" -o -name "*.h" \) -print); do mkdir -p "/usr/lib/llvm-build/${f%/*}"; cp "$f" "/usr/lib/llvm-build/$f"; done'

FOLDER /usr/lib/llvm-build

ENTRY /bin/foreground -i /bin/slop
