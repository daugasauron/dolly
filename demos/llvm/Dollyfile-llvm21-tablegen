DOLLY 7
TOOLCHAIN llvm21-tablegen
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST sockets@0

# Build-only: LLVM 21 with every default target, the version Zig 0.16 links,
# configured by CMake inside Dolly, and its TableGen tools.
FROM /v0.1.3/demos/cmake/Dollyfile-cmake-build 14e6249f3fd8ee59b51364d0c27cfd5112ace82876102315ca0bc04b32964ac5
# LLVM's CMake requires a Python 3 interpreter.
INSTALL /v0.1.3/demos/python/Dollyfile-python 3f734ba310761fe5b38c939224a6fd04e6105064d1a832bb66843a59113510e5
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL python
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL patch
REQUIRES TOOL time
REQUIRES TOOL cp
REQUIRES TOOL rm

SOURCE /v0.1.3/dist/static/llvm21/llvm-project.tar.gz 3ee6a2d60e18c9e702777b830edafb97564a752b6dfa7fd4face6e16122c5abc /tmp/llvm-project.tar.gz
SLOP time slop -c 'gzip -dc /tmp/llvm-project.tar.gz | tar -xf - -C /'
SLOP rm /tmp/llvm-project.tar.gz
# LLVM runs config.guess even when LLVM_HOST_TRIPLE is given; it knows no Dolly host.
SOURCE /v0.1.3/dist/static/llvm21/llvm-host-triple.patch ec739fd5932c1040d07344a8511bae4da4157ff2bcafa348f06a555b71a10981 /tmp/llvm-host-triple.patch
SLOP patch -p1 -d /tmp/llvm-project -i /tmp/llvm-host-triple.patch

# As the seed's LLVM is configured (llvm-tablegen), with every target Zig
# requires (its cmake/Findllvm.cmake) and installed under /usr/lib/llvm21.
FILE /usr/lib/llvm21-build/Dolly.cmake
    set(CMAKE_BUILD_TYPE Release CACHE STRING "")
    set(CMAKE_C_FLAGS "-std=gnu17" CACHE STRING "")
    set(CMAKE_CXX_FLAGS "-include endian.h -DCLANG_BUILD_STATIC" CACHE STRING "")
    set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON CACHE BOOL "")
    set(CMAKE_RULE_MESSAGES OFF CACHE BOOL "")
    set(CMAKE_INSTALL_PREFIX /usr/lib/llvm21 CACHE STRING "")
    set(LLVM_ENABLE_WARNINGS OFF CACHE BOOL "")
    set(LLVM_ENABLE_PROJECTS "clang;lld" CACHE STRING "")
    set(LLVM_TARGETS_TO_BUILD "AArch64;AMDGPU;ARM;AVR;BPF;Hexagon;Lanai;LoongArch;Mips;MSP430;NVPTX;PowerPC;RISCV;SPIRV;Sparc;SystemZ;VE;WebAssembly;X86;XCore" CACHE STRING "")
    set(LLVM_HOST_TRIPLE wasm64-unknown-emscripten CACHE STRING "")
    set(LLVM_DEFAULT_TARGET_TRIPLE wasm64-unknown-emscripten CACHE STRING "")
    foreach(option THREADS TERMINFO LIBEDIT LIBPFM ZLIB ZSTD LIBXML2 CURL BINDINGS)
      set(LLVM_ENABLE_${option} OFF CACHE STRING "")
    endforeach()
    foreach(option TESTS EXAMPLES BENCHMARKS DOCS)
      set(LLVM_INCLUDE_${option} OFF CACHE BOOL "")
    endforeach()
    set(LLVM_BUILD_LLVM_DYLIB OFF CACHE BOOL "")
    set(LLVM_LINK_LLVM_DYLIB OFF CACHE BOOL "")
SLOP time cmake -C /usr/lib/llvm21-build/Dolly.cmake -S /tmp/llvm-project/llvm -B /tmp/llvm-build

# Each job is three processes (Slop, c++, compiler); -j8 exceeds the 32-process cap.
SLOP CWD /tmp/llvm-build time make -j4 llvm-min-tblgen llvm-tblgen clang-tblgen
SLOP CWD /tmp/llvm-build cp bin/llvm-min-tblgen bin/llvm-tblgen bin/clang-tblgen /usr/bin
SLOP rm -rf /tmp/llvm-build /tmp/llvm-project

EXPORTS TOOL llvm-min-tblgen
EXPORTS TOOL llvm-tblgen
EXPORTS TOOL clang-tblgen
FOLDER /usr/lib/llvm21-build
SLOP llvm-tblgen --version

ENTRY /bin/foreground -i /bin/slop
