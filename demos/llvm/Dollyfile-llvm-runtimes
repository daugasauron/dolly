DOLLY 6
PACKAGE llvm-runtimes
REQUIRES HOST runtime@0

# Build-only: libc++, libc++abi, libunwind and the compiler-rt builtins as the
# process SDK ships them from the Emscripten container, built by Dolly's c++ and
# cc from the same pinned sources (tasks/20260930-232236-llvm-in-dolly). A link
# takes them instead only when it names the directory: -L/usr/lib/llvm-runtimes.
FROM https://daugasauron.com/Dollyfile-system-tools 76204eed7416daabd1c8978f628b45da16f77d27d23d4f1473c508c5c750a309
REQUIRES TOOL c++
REQUIRES TOOL cc
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL sed
REQUIRES TOOL ln
REQUIRES TOOL tar
REQUIRES TOOL time

SOURCE https://daugasauron.com/dist/static/llvm/runtimes.tar 436306d45c3f319da9afbcdaaa181f6dfb1482ada1d34149752e7294d0c40bcd /tmp/runtimes.tar
SLOP tar -xf /tmp/runtimes.tar -C /

# Sources, flags and member order of the -ww-wasmexcept and -wasmsjlj-ww variants
# in Emscripten 6.0.8's tools/system_libs.py; the -mt variants are the same bytes.
FILE /tmp/llvm-runtimes/Makefile
    .RECIPEPREFIX := >
    S := /tmp/llvm-runtimes/system/lib
    B := /tmp/llvm-runtimes/build
    L := /usr/lib/llvm-runtimes
    # What Emscripten's Clang driver gives cc1 and Dolly's does not: static code,
    # hidden visibility, -g as DWARF 4 and the container's file names.
    CC1 := -mrelocation-model static -pic-level 0 \
      -gkey-instructions -debug-info-kind=constructor -dwarf-version=4 -debugger-tuning=gdb \
      -fdebug-compilation-dir=/emsdk/emscripten \
      -fdebug-prefix-map=/tmp/llvm-runtimes=/emsdk/emscripten \
      -fdebug-prefix-map=/usr/include=/emsdk/emscripten/cache/sysroot/include \
      -fdebug-prefix-map=/usr/lib/clang=/emsdk/upstream/lib/clang \
      -fmacro-prefix-map=/tmp/llvm-runtimes=/emsdk/emscripten
    FLAGS := -Wall -Werror -DNDEBUG -fvisibility=hidden $(addprefix -Xclang ,$(CC1))
    CXXFLAGS := $(FLAGS) -Oz -std=c++23 -I$S/libcxx/src
    LIBCXX := $(filter-out %/int128_builtins.cpp,$(wildcard $S/libcxx/src/*.cpp $S/libcxx/src/filesystem/*.cpp \
      $S/libcxx/src/ryu/*.cpp)) $(addprefix $S/libcxx/src/experimental/,chrono_exception.cpp keep.cpp log_hardening_failure.cpp)
    LIBCXXABI := $(addprefix $S/libcxxabi/src/,abort_message.cpp cxa_aux_runtime.cpp cxa_default_handlers.cpp \
      cxa_demangle.cpp cxa_guard.cpp cxa_handlers.cpp cxa_virtual.cpp cxa_thread_atexit.cpp fallback_malloc.cpp \
      stdlib_new_delete.cpp stdlib_exception.cpp stdlib_stdexcept.cpp stdlib_typeinfo.cpp private_typeinfo.cpp \
      cxa_exception_js_utils.cpp cxa_exception_storage.cpp cxa_exception.cpp cxa_personality.cpp)
    BUILTINS := $(filter-out $(addprefix %/,gcc_personality_v0.c extendbfsf2.c truncdfbf2.c truncxfbf2.c truncsfbf2.c \
      trunctfbf2.c crtbegin.c crtend.c divxc3.c extendhfxf2.c extendxftf2.c fixxfdi.c fixxfti.c fixunsxfdi.c fixunsxfsi.c \
      fixunsxfti.c floatdixf.c floattixf.c floatundixf.c floatuntixf.c mulxc3.c powixf2.c trunctfxf2.c truncxfhf2.c), \
      $(wildcard $S/compiler-rt/lib/builtins/*.c)) $(wildcard $S/compiler-rt/lib/profile/*.c $S/compiler-rt/lib/profile/*.cpp) \
      $(addprefix $S/compiler-rt/,emscripten_setjmp.c emscripten_exception_builtins.c __trap.c)
    ASSEMBLY := $(addprefix $S/compiler-rt/,stack_ops.S stack_limits.S __c_longjmp.S emscripten_tempret.s)
    BUILTINS_FLAGS := $(FLAGS) -O2 -fno-builtin -DCOMPILER_RT_HAS_ATOMICS=1 -Wno-unused-but-set-variable -D__WASM_SJLJ__ \
      -Xclang -fno-unroll-loops -Xclang -fignore-exceptions -I$S/libc -I$S/compiler-rt/include
    objects = $(sort $(addprefix $B/$1/,$(addsuffix .o,$(basename $(notdir $2)))))
    all: $(addprefix $L/,libc++-ww-wasmexcept.a libc++abi-ww-wasmexcept.a libunwind-ww-wasmexcept.a libclang_rt.builtins-wasmsjlj-ww.a)
    $L/libc++-ww-wasmexcept.a: $(call objects,libc++,$(LIBCXX))
    $L/libc++abi-ww-wasmexcept.a: $(call objects,libc++abi,$(LIBCXXABI))
    $L/libunwind-ww-wasmexcept.a: $B/libunwind/Unwind-wasm.o
    $L/libclang_rt.builtins-wasmsjlj-ww.a: $(call objects,builtins,$(BUILTINS) $(ASSEMBLY))
    # -pthread links name the -mt variants: the same bytes, so the same files.
    $L/%.a:
    >ar rc $@ $^
    >ln -s $(notdir $@) $(subst -ww,-mt,$@)
    define compile
    $B/$1/$(basename $(notdir $2)).o: $2
    >$3 -Xclang -main-file-name -Xclang $(notdir $2) -c $$< -o $$@
    endef
    $(foreach source,$(LIBCXX),$(eval $(call compile,libc++,$(source),c++ $(CXXFLAGS) -DLIBCXX_BUILDING_LIBCXXABI=1 \
      -D_LIBCPP_BUILDING_LIBRARY -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -Wno-unqualified-std-cast-call \
      -Wno-unknown-warning-option -DLIBC_NAMESPACE=__llvm_libc -I$S/llvm-libc)))
    $(foreach source,$(LIBCXXABI),$(eval $(call compile,libc++abi,$(source),c++ $(CXXFLAGS) -D_LIBCXXABI_USE_FUTEX \
      -D_LIBCPP_BUILDING_LIBRARY -D_LIBCXXABI_BUILDING_LIBRARY -DLIBCXXABI_NON_DEMANGLING_TERMINATE \
      -Wno-unused-but-set-variable -I$S/libunwind/include)))
    $(eval $(call compile,libunwind,$S/libunwind/src/Unwind-wasm.c,cc $(FLAGS) -Oz -D_LIBUNWIND_HIDE_SYMBOLS \
      -Wno-c23-extensions -I$S/libunwind/include))
    $(foreach source,$(BUILTINS),$(eval $(call compile,builtins,$(source),$(if $(filter %.cpp,$(source)),c++,cc) $(BUILTINS_FLAGS))))
    # cc has no assembler entry. The LLVM assembler it embeds takes the same
    # text as file-scope asm.
    $B/builtins/%.o: $B/builtins/%.s
    >echo '__asm__(' > $(@:.o=.c)
    >sed -e 's/["\\]/\\&/g' -e 's/.*/"&\\n"/' $< >> $(@:.o=.c)
    >echo ');' >> $(@:.o=.c)
    >cc $(BUILTINS_FLAGS) -c $(@:.o=.c) -o $@
    # cc -E leaves out the exception-handling feature that cc -c compiles with.
    $B/builtins/%.s: $S/compiler-rt/%.S
    >cc -E -P $(BUILTINS_FLAGS) -Xclang -target-feature -Xclang +exception-handling $< -o $@
    $B/builtins/%.s: $S/compiler-rt/%.s
    >cp $< $@
SLOP mkdir -p /usr/lib/llvm-runtimes /tmp/llvm-runtimes/build/libc++ /tmp/llvm-runtimes/build/libc++abi /tmp/llvm-runtimes/build/libunwind /tmp/llvm-runtimes/build/builtins
SLOP CWD /tmp/llvm-runtimes time make -j2

EXPORTS FOLDER llvm-runtimes /usr/lib/llvm-runtimes
