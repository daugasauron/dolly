DOLLY 7
PACKAGE llvm21
REQUIRES HOST runtime@0

# LLVM 21 with every default target, Clang and LLD as libraries and headers,
# and llvm-config, under /usr/lib/llvm21: what Zig 0.16 links. Built by its
# CMake inside Dolly with the TableGen tools of llvm21-tablegen.
FROM /v0.1.3/demos/llvm/Dollyfile-llvm21-tablegen 3cabcf96137cbeb2ee926ff14598c544928198e49b7430037deabe809dbe7c5b
REQUIRES TOOL llvm-tblgen
REQUIRES TOOL clang-tblgen
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL python
REQUIRES TOOL time
REQUIRES TOOL rm
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL patch

SOURCE /v0.1.3/dist/static/llvm21/llvm-project.tar.gz 3042fa04776a40e02e800b71105d7c8199b9c5dd7b951a715d0edd208238daed /tmp/llvm-project.tar.gz
SLOP time slop -c 'gzip -dc /tmp/llvm-project.tar.gz | tar -xf - -C /'
SLOP rm /tmp/llvm-project.tar.gz
SOURCE /v0.1.3/dist/static/llvm21/llvm-host-triple.patch ec739fd5932c1040d07344a8511bae4da4157ff2bcafa348f06a555b71a10981 /tmp/llvm-host-triple.patch
SLOP patch -p1 -d /tmp/llvm-project -i /tmp/llvm-host-triple.patch
# Upstream's a558d656 from LLVM 22: LLVM 21's RDF gives std::less state, which
# this libc++ (LLVM 24's) refuses.
SOURCE /v0.1.3/dist/static/llvm21/llvm21-std-specializations.patch 7ca034008e6a5d4d95d305f883eb82b9107be62e294d7f14532327ad88022695 /tmp/llvm21-std-specializations.patch
SLOP patch -p1 -d /tmp/llvm-project -i /tmp/llvm21-std-specializations.patch
# Licences of the three projects whose libraries this package holds.
SOURCE /v0.1.3/dist/static/llvm21/licenses/llvm 8d85c1057d742e597985c7d4e6320b015a9139385cff4cbae06ffc0ebe89afee /usr/share/licenses/llvm21/llvm/LICENSE.TXT
SOURCE /v0.1.3/dist/static/llvm21/licenses/clang ebcd9bbf783a73d05c53ba4d586b8d5813dcdf3bbec50265860ccc885e606f47 /usr/share/licenses/llvm21/clang/LICENSE.TXT
SOURCE /v0.1.3/dist/static/llvm21/licenses/lld f7891568956e34643eb6a0db1462db30820d40d7266e2a78063f2fe233ece5a0 /usr/share/licenses/llvm21/lld/LICENSE.TXT
FOLDER /usr/share/licenses/llvm21

# The TableGen tools llvm21-tablegen built run again here: a snapshot keeps no
# file times, so its Make tree cannot continue.
FILE /usr/lib/llvm21-build/tools.cmake
    include(/usr/lib/llvm21-build/Dolly.cmake)
    set(LLVM_TABLEGEN /usr/bin/llvm-tblgen CACHE STRING "")
    set(CLANG_TABLEGEN /usr/bin/clang-tblgen CACHE STRING "")
    # No shared libraries: they link with version scripts, which Dolly's
    # wasm-ld has not. (Without PIC, LLVM links its programs with -fno-pie.)
    foreach(tool LLVM_TOOL_LTO LLVM_TOOL_REMARKS_SHLIB CLANG_TOOL_LIBCLANG CLANG_TOOL_CLANG_SHLIB)
      set(${tool}_BUILD OFF CACHE BOOL "")
    endforeach()
SLOP time cmake -C /usr/lib/llvm21-build/tools.cmake -S /tmp/llvm-project/llvm -B /tmp/llvm-build
# -k reports every failing unit of a long build, not only the first.
SLOP CWD /tmp/llvm-build time make -k -j4 install-llvm-libraries install-llvm-headers install-llvm-config \
  install-clang-libraries install-clang-headers install-lld-headers install-lldCommon install-lldELF install-lldCOFF install-lldMachO install-lldMinGW install-lldWasm
SLOP rm -rf /tmp/llvm-build /tmp/llvm-project

EXPORTS FOLDER llvm21 /usr/lib/llvm21
SLOP /usr/lib/llvm21/bin/llvm-config --version --targets-built
