DOLLY 7
PACKAGE llvm22
REQUIRES HOST runtime@0

# LLVM 22 with every default target, Clang and LLD as libraries and headers,
# and llvm-config, under /usr/lib/llvm22: what Zig 0.17 links. Built by its
# CMake inside Dolly with the TableGen tools of llvm22-tablegen.
FROM /v0.1.4/demos/llvm/Dollyfile-llvm22-tablegen 1a972922166e0a227a08a0e73e28b442d31293b8b473b2f06745f732b35717f0
REQUIRES TOOL llvm-tblgen
REQUIRES TOOL clang-tblgen
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL python
REQUIRES TOOL time
REQUIRES TOOL rm
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL patch

SOURCE /v0.1.4/dist/static/llvm22/llvm-project.tar.gz d2b6b682f06a79130bd7a2de9a88f45a80a81abb44b37bad57f018c0d2c8f9ed /tmp/llvm-project.tar.gz
SLOP time slop -c 'gzip -dc /tmp/llvm-project.tar.gz | tar -xf - -C /'
SLOP rm /tmp/llvm-project.tar.gz
SOURCE /v0.1.4/dist/static/llvm22/llvm-host-triple.patch ec739fd5932c1040d07344a8511bae4da4157ff2bcafa348f06a555b71a10981 /tmp/llvm-host-triple.patch
SLOP patch -p1 -d /tmp/llvm-project -i /tmp/llvm-host-triple.patch
# Licences of the three projects whose libraries this package holds.
SOURCE /v0.1.4/dist/static/llvm22/licenses/llvm 8d85c1057d742e597985c7d4e6320b015a9139385cff4cbae06ffc0ebe89afee /usr/share/licenses/llvm22/llvm/LICENSE.TXT
SOURCE /v0.1.4/dist/static/llvm22/licenses/clang ebcd9bbf783a73d05c53ba4d586b8d5813dcdf3bbec50265860ccc885e606f47 /usr/share/licenses/llvm22/clang/LICENSE.TXT
SOURCE /v0.1.4/dist/static/llvm22/licenses/lld f7891568956e34643eb6a0db1462db30820d40d7266e2a78063f2fe233ece5a0 /usr/share/licenses/llvm22/lld/LICENSE.TXT
FOLDER /usr/share/licenses/llvm22

# The TableGen tools llvm22-tablegen built run again here: a snapshot keeps no
# file times, so its Make tree cannot continue.
FILE /usr/lib/llvm22-build/tools.cmake
    include(/usr/lib/llvm22-build/Dolly.cmake)
    set(LLVM_TABLEGEN /usr/bin/llvm-tblgen CACHE STRING "")
    set(CLANG_TABLEGEN /usr/bin/clang-tblgen CACHE STRING "")
    # No shared libraries: they link with version scripts, which Dolly's
    # wasm-ld has not. (Without PIC, LLVM links its programs with -fno-pie.)
    foreach(tool LLVM_TOOL_LTO LLVM_TOOL_REMARKS_SHLIB CLANG_TOOL_LIBCLANG CLANG_TOOL_CLANG_SHLIB)
      set(${tool}_BUILD OFF CACHE BOOL "")
    endforeach()
SLOP time cmake -C /usr/lib/llvm22-build/tools.cmake -S /tmp/llvm-project/llvm -B /tmp/llvm-build
# -k reports every failing unit of a long build, not only the first.
SLOP CWD /tmp/llvm-build time make -k -j4 install-llvm-libraries install-llvm-headers install-llvm-config \
  install-clang-libraries install-clang-headers install-lld-headers install-lldCommon install-lldELF install-lldCOFF install-lldMachO install-lldMinGW install-lldWasm
SLOP rm -rf /tmp/llvm-build /tmp/llvm-project

EXPORTS FOLDER llvm22 /usr/lib/llvm22
SLOP /usr/lib/llvm22/bin/llvm-config --version --targets-built
