FROM https://daugasauron.com/demos/local-llm/Dollyfile-pi-local f56d898c8fda864ba2f6d6cec3f2ea26dcea982669dd6811086b069fb4bbf392
INSTALL https://daugasauron.com/demos/neovim/Dollyfile-nvim 611149999ffe6c643a2c2cbf05e3df02f69a96978ab54cfd21da637cc110389a
REQUIRES TOOL pi
