# The row that names system in this image's record of its recipes: site path and pin.
system=$(grep '/Dollyfile-system ' /etc/dolly/recipes.lock)
for name in hello tool; do
  sed "s|@SYSTEM@|$system|" "/usr/share/dollyfile-studio/examples/$name.in" > "/usr/share/dollyfile-studio/examples/Dollyfile-$name"
done
