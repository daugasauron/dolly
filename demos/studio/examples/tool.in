DOLLY 7
APPLICATION hello-tool
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST download@0
REQUIRES HOST http@0
REQUIRES HOST snapshot@0
REQUIRES HOST upload@0

FROM @SYSTEM@

FILE /tmp/hello-tool/hello.c
    #include <stdio.h>
    int main(int argc, char **argv) {
      printf("Hello, %s!\n", argc > 1 ? argv[1] : "Dolly");
      return 0;
    }
SLOP cc -std=c17 -O1 /tmp/hello-tool/hello.c -o /usr/bin/hello
EXPORTS TOOL hello
SLOP hello agent
SLOP rm -rf /tmp/hello-tool

ENTRY /bin/foreground -i /bin/slop
