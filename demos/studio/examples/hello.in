DOLLY 7
APPLICATION hello
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST download@0
REQUIRES HOST http@0
REQUIRES HOST snapshot@0
REQUIRES HOST upload@0

FROM @SYSTEM@

FILE /usr/share/hello.txt
    Hello from my custom Dolly image!

FILE /etc/dolly/hello.slop
    cat /usr/share/hello.txt
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/hello.slop
