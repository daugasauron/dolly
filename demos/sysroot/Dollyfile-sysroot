DOLLY 6
PACKAGE sysroot
REQUIRES HOST runtime@0

# Build-only: the process sysroot's Emscripten libraries (musl libc, dlmalloc,
# the standalone glue, the stubs) and Dolly's own parts of it, as the Emscripten
# container builds them and the seed ships them, compiled by Dolly's cc from the
# same sources (tasks/20260930-232236-llvm-in-dolly). Nothing links them.
FROM https://daugasauron.com/Dollyfile-system-tools 90721b2609286ae992dbb6473f68e48bc38b79acef06433a2136868e67f1c513
REQUIRES TOOL cc
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL sed
REQUIRES TOOL tar
REQUIRES TOOL time

SOURCE https://daugasauron.com/dist/static/sysroot/sources.tar 298d04ea5b9b0c57c97f6563fe065a6c78541d16d287f7d82e1adfc2edb3db39 /tmp/sysroot.tar
SLOP tar -xf /tmp/sysroot.tar -C /

# units.mk names each archive's sources (tools/system_libs.py at the pin); the
# flags here are that file's for the -ww and -mt variants.
FILE /tmp/sysroot/Makefile
    .RECIPEPREFIX := >
    include units.mk dolly/clients.mk
    S := /tmp/sysroot/system/lib
    B := /tmp/sysroot/build
    L := /usr/lib/sysroot
    # Emscripten's -g, which is DWARF 4 where Dolly's is 5, and the container's
    # file names. It builds these without Wasm exceptions, which cc always enables.
    CC1 := -gkey-instructions -debug-info-kind=constructor -dwarf-version=4 -debugger-tuning=gdb \
      -fdebug-compilation-dir=/emsdk/emscripten -target-feature -exception-handling
    # cc renames the dl functions for programs; here libc defines them.
    FLAGS := -w -DNDEBUG -Udlopen -Udlsym -Udlerror -Udlclose \
      -fno-pic -fvisibility=hidden -fno-unroll-loops -fignore-exceptions \
      $(addprefix -Xclang ,$(CC1)) -ffile-prefix-map=/tmp/sysroot=/emsdk/emscripten \
      -fdebug-prefix-map=/usr/include=/emsdk/emscripten/cache/sysroot/include \
      -fdebug-prefix-map=/usr/lib/clang=/emsdk/upstream/lib/clang
    INTERNAL := $(addprefix -I$S/,libc/musl/arch/emscripten libc/musl/arch/generic libc/musl/src/internal \
      libc/musl/src/include libc/musl/include libc pthread)
    MUSL := -std=c99 -D_XOPEN_SOURCE=700 $(INTERNAL)
    # Shared memory without pthreads (Wasm Workers) and with them, as emcc defines the two.
    ww := -D__EMSCRIPTEN_SHARED_MEMORY__=1 -D__EMSCRIPTEN_WASM_WORKERS__=1
    mt := -pthread -D__EMSCRIPTEN_SHARED_MEMORY__=1 -D__EMSCRIPTEN_PTHREADS__=1
    flags-libc-ww := $(FLAGS) $(MUSL) -Os -Xclang -fno-inline-functions -fno-builtin $(ww)
    flags-libc-mt := $(FLAGS) $(MUSL) -Os -Xclang -fno-inline-functions -fno-builtin $(mt)
    flags-libdlmalloc-ww := $(FLAGS) -O2 -fno-builtin $(ww)
    flags-libdlmalloc-mt := $(FLAGS) -O2 -fno-builtin $(mt)
    STANDALONE := $(FLAGS) $(MUSL) -Os -fno-builtin -DEMSCRIPTEN_STANDALONE_WASM -DEMSCRIPTEN_MEMORY_GROWTH
    flags-libstandalonewasm-ww-memgrow := $(STANDALONE) $(ww)
    flags-libstandalonewasm-mt-memgrow := $(STANDALONE) $(mt)
    flags-libstubs := $(FLAGS) -O2 -I$S/libc/musl/src/include -Xclang -target-feature -Xclang -atomics
    WW := libc-ww libdlmalloc-ww libstandalonewasm-ww-memgrow libstubs
    MT := libc-mt libdlmalloc-mt libstandalonewasm-mt-memgrow
    modules := $(sort $(foreach entry,$(clients),$(firstword $(subst :, ,$(entry)))))
    all: $(WW:%=$L/%.a) $(MT:%=$L/threads/%.a) $L/crt1.o $L/libdolly-process.a $(modules:%=$L/libdolly-%.a) \
      $(addprefix $L/threads/,crt1.o libdolly-process.a libdolly-runtime.a)
    # Members in name order, vmlock.o first: Emscripten's objectfile_sort_key.
    first = $(filter $1,$2) $(filter-out $1,$2)
    member = $(or $(patsubst $1:%,%,$(filter $1:%,$(renamed))),$(basename $(notdir $1)).o)
    # A .S unit is preprocessed here and assembled by the rule below.
    define unit
    $B/$1/$(if $(filter %.S,$2),$(basename $(notdir $2)).s,$(call member,$2)): $S/$2
    >cc $(if $(filter %.S,$2),-E -P,-c) $$(flags-$1) $(if $(filter $2,$(O2)),-O2) $$< -o $$@
    endef
    # Dolly's own parts define what these members do, so the seed's two libc
    # archives are Emscripten's without them (scripts/prepare-process-sysroot.sh,
    # scripts/build-process-threads.sh).
    removed-libc-ww := raise sigaction pthread_sigmask sigtimedwait setitimer getitimer
    removed-libc-mt := $(removed-libc-ww) pthread_create pthread_join pthread_detach pthread_cancel \
      pthread_setcanceltype library_pthread emscripten_futex_wait emscripten_futex_wake pthread_kill sched_yield
    kept = $(filter-out $(addprefix %/,$(addsuffix .c,$(removed-$1))),$($1))
    define library
    $(foreach source,$(call kept,$1),$(eval $(call unit,$1,$(source))))
    $L/$2$1.a: $(call first,%/vmlock.o,$(sort $(foreach source,$(call kept,$1),$B/$1/$(call member,$(source)))))
    >ar rc $$@ $$^
    endef
    $(foreach name,$(WW),$(eval $(call library,$(name))))
    $(foreach name,$(MT),$(eval $(call library,$(name),threads/)))
    # cc has no assembler entry. The LLVM assembler it embeds takes the same
    # text as file-scope asm, except a target_features section: the compiler
    # writes its own, so the two bulk-memory units lose the one they declare.
    $B/%.o: $B/%.s
    >echo '__asm__(""' > $(@:.o=.c)
    >sed -e '/custom_section.target_features/,$$d' -e 's/["\\]/\\&/g' -e 's/.*/"&\\n"/' $< >> $(@:.o=.c)
    >echo ');' >> $(@:.o=.c)
    >cc $(flags-$(notdir $(@D))) -c $(@:.o=.c) -o $@
    # Dolly's own parts, as scripts/build.sh compiles them: the start file, the
    # libc adapter with the thread stubs it takes from musl, and each host
    # module's client.
    D := /tmp/sysroot/dolly
    P := $B/own
    OWN := -O1 -fno-pic -fvisibility=hidden
    $L/crt1.o: $D/src/process/crt1.c
    >cc $(OWN) -c $< -o $@
    $P/process-%.o: $D/src/process/%.c
    >cc $(OWN) -c $< -o $@
    define internal
    $P/process-$1.o: $2
    >cc $(OWN) $(INTERNAL) -c $$< -o $$@
    endef
    $(eval $(call internal,pthread-self,$S/pthread/pthread_self_stub.c))
    $(eval $(call internal,pthread-stub,$D/src/process/pthread-stubs.c))
    mutexattr := pthread_mutexattr_init pthread_mutexattr_settype pthread_mutexattr_destroy
    $(eval $(call internal,default-attr,$S/libc/musl/src/thread/default_attr.c))
    $(foreach name,$(mutexattr),$(eval $(call internal,$(name),$S/libc/musl/src/thread/$(name).c)))
    $L/libdolly-process.a: $(patsubst %,$P/process-%.o,libc-adapter mmap time poll signal pthread-self default-attr \
      pthread-stub $(mutexattr))
    define client
    $P/process-$1-$(basename $(notdir $2)).o: $D/$2
    >cc $(OWN) -c $$< -o $$@
    $L/libdolly-$1.a: $P/process-$1-$(basename $(notdir $2)).o
    endef
    $(foreach entry,$(clients),$(eval $(call client,$(firstword $(subst :, ,$(entry))),$(lastword $(subst :, ,$(entry))))))
    # With threads (scripts/build-process-threads.sh).
    T := $B/own-mt
    flags-own-mt := $(OWN) $(mt)
    $T/%.o: $D/src/process/%.c
    >cc $(OWN) $(INTERNAL) $(mt) -c $< -o $@
    $T/threads-start.s: $D/src/process/threads-start.S
    >cc -E -P $(flags-own-mt) $< -o $@
    $L/threads/crt1.o: $D/src/process/crt1.c
    >cc $(OWN) $(INTERNAL) $(mt) -c $< -o $@
    $L/threads/libdolly-process.a: $(addprefix $T/,libc-adapter.o mmap.o time.o poll.o signal.o threads.o threads-start.o)
    $L/threads/libdolly-runtime.a: $T/runtime-adapter.o
    $L/libdolly-process.a $(modules:%=$L/libdolly-%.a) $L/threads/libdolly-process.a $L/threads/libdolly-runtime.a:
    >ar rc $@ $^
SLOP mkdir -p /usr/lib/sysroot/threads /tmp/sysroot/build/libc-ww /tmp/sysroot/build/libc-mt /tmp/sysroot/build/libdlmalloc-ww /tmp/sysroot/build/libdlmalloc-mt /tmp/sysroot/build/libstandalonewasm-ww-memgrow /tmp/sysroot/build/libstandalonewasm-mt-memgrow /tmp/sysroot/build/libstubs /tmp/sysroot/build/own /tmp/sysroot/build/own-mt
SLOP CWD /tmp/sysroot time make -j2

EXPORTS FOLDER sysroot /usr/lib/sysroot
# The base holds the licences of musl and of Emscripten's own files.
FILE /usr/share/licenses/musl/COPYRIGHT
FILE /usr/share/licenses/emscripten/LICENSE
