# Lean 4.35's programs, lean, lake and leanc, linked from the libraries the
# first lean (lean-stage0) compiled: Init and Std (lean-std), Lean
# (lean-meta), and here Lake's and LeanExport's, as upstream links them
# (lean-dolly.mk), with the C++ runtime compiled again from src/. Lake
# compiles a package's C with cc and links it with libuv.
FROM /v0.1.4/demos/lean/Dollyfile-lean-stage0 0097c4b9f634e2a40c500af9ca982de5d1b76a7fb17d098d24ceee37da0f985e
INSTALL /v0.1.4/demos/lean/Dollyfile-lean-std 6ee38e9ae9897f5b81e18a00dd536020dd92a45ad1bcbe0cbfb2c7d347f78cce
INSTALL /v0.1.4/demos/lean/Dollyfile-lean-meta 56f733eb96bdae3d475790d5d690ffb1f515d9ea76360b26df28c1611a243ede
INSTALL /v0.1.4/Dollyfile-cc 1e00616eeda62fce8d1e5198534152a32cc50e6452f8004a0f4f9ce4c190efd3
