DOLLY 7
PACKAGE lean
REQUIRES HOST runtime@0
REQUIRES HOST stack@0
REQUIRES HOST threads@0

# Lean 4.35's programs, lean, lake and leanc, linked from the libraries the
# first lean (lean-stage0) compiled: Init and Std (lean-std), Lean
# (lean-meta), and here Lake's and LeanExport's, as upstream links them
# (lean-dolly.mk), with the C++ runtime compiled again from src/. Lake
# compiles a package's C with cc and links it with libuv.
FROM /v0.1.4/demos/lean/Dollyfile-lean-stage0 934a1a7f9b550865745a090fa0070e4d62e599ebfd5a870132a666f536dc72d2
INSTALL /v0.1.4/demos/lean/Dollyfile-lean-std 4056ece9c0607ae8e1e02daaf60b80307d830dd745bfad44adc3cde205efad46
INSTALL /v0.1.4/demos/lean/Dollyfile-lean-meta bcedc5c096db33f69feae57f82e77347a8fe76b6f16e892ccbe822f805bdbe47
INSTALL /v0.1.4/Dollyfile-cc 9bdb5e3c920d18e3312adfd1e606bc00bcb8154a5a6913f8aae45f4d09a88059
INSTALL /v0.1.4/demos/cmake/Dollyfile-libuv f58546adf1eb4b5d68de738443f32f81dc77ac68a543c392545a5ee071a6d042

REQUIRES HEADER libc
REQUIRES HEADER uv
REQUIRES LIB uv
REQUIRES TOOL ar
REQUIRES TOOL c++
REQUIRES TOOL cc
REQUIRES TOOL cp
REQUIRES TOOL find
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL patch
REQUIRES TOOL rm
REQUIRES TOOL sed
REQUIRES TOOL stack-wrap
REQUIRES TOOL tar
REQUIRES TOOL tr
REQUIRES TOOL xargs

SOURCE /v0.1.4/dist/static/lean/lean.tar.gz ef83239912f7c218c5f0e937de704b7da807b9802b05216414b59b9dec42e0da /tmp/lean.tar.gz
SOURCE /v0.1.4/dist/static/lean/port.tar 1716710f88ccdd478709b75533ef1686ff39e381ad7d66ff65caff992e2dd1a6 /tmp/lean-port.tar
# Stage 1 reads only src/.
SLOP gzip -dc /tmp/lean.tar.gz | tar -xf - -C / && rm -r /tmp/lean.tar.gz /tmp/lean/stage0
SLOP tar -xf /tmp/lean-port.tar -C /
SLOP CWD /tmp/lean patch -p1 < dolly/lean-dolly.patch
# One job: the kernel holds Lean's libraries, 2.4 GB, and at four jobs the
# lean processes that import them exceeded a 9 GB build.
SLOP CWD /tmp/lean make -f dolly/lean-dolly.mk STAGE=1 LIBRARIES='LeanExport Lake Leanc' \
  LEAN=/usr/lib/lean-stage0/lean GITHASH=eb6cafb7290e8bd5f2937522d8d804f58f02bafc libraries install

# lean runs a program and checks a proof; lake makes a package and builds
# its program with cc.
FILE /tmp/lean-check/squares.lean
    def main : IO Unit := IO.println s!"{((List.range 10).map (· ^ 2)).foldl (· + ·) 0}"
FILE /tmp/lean-check/proof.lean
    theorem byOmega (x y : Nat) (h : x < y) : x + 1 ≤ y := by omega
SLOP CWD /tmp/lean-check test "$(lean --run squares.lean)" = 285
SLOP CWD /tmp/lean-check lean proof.lean
SLOP CWD /tmp/lean-check lake new greeting && cd greeting && lake build && test "$(.lake/build/bin/greeting)" = 'Hello, world!'
# Lean has no manual pages: lean's and lake's help are theirs.
SLOP mkdir -p /usr/share/man/cat1 && lean --help > /usr/share/man/cat1/lean.1 && lake --help > /usr/share/man/cat1/lake.1

