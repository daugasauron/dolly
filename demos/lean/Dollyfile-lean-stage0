DOLLY 8
TOOLCHAIN lean-stage0
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST dso@0
REQUIRES HOST input@0
REQUIRES HOST stack@0
REQUIRES HOST threads@0

# The first lean of Lean's bootstrap: upstream's stage0/, its copy of the
# C++ runtime and the C the release before emitted, compiled inside Dolly
# (lean-dolly.mk, lean-dolly.patch) and rewritten by stack-wrap; lean-std,
# lean-meta and lean compile the release with it.
FROM /Dollyfile-system-tools 9bf7b939f6f7618b08e3af8d670717747e9a38311a736479bcc002db79e2c112
INSTALL /Dollyfile-stack-wrap 29c90c3a5038840cdb5982b59b1f960c3be1c2e3b90a9d2f58036e9bd38ac16b
INSTALL /demos/cmake/Dollyfile-libuv 2d91965d63419bff43e498266df5969b176d1bea9bc666806e7239fdd1566a14

REQUIRES HEADER libc
REQUIRES HEADER uv
REQUIRES LIB uv
REQUIRES TOOL ar
REQUIRES TOOL c++
REQUIRES TOOL cc
REQUIRES TOOL find
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL patch
REQUIRES TOOL sed
REQUIRES TOOL stack-wrap
REQUIRES TOOL tar

SOURCE /dist/static/lean/lean.tar.gz ef83239912f7c218c5f0e937de704b7da807b9802b05216414b59b9dec42e0da /tmp/lean.tar.gz
SOURCE /dist/static/lean/port.tar b98085e118db528bb5b28bb24b5c2c74e5caff7a582025f05e77492cd2337dae /tmp/lean-port.tar
SLOP gzip -dc /tmp/lean.tar.gz | tar -xf - -C / && rm /tmp/lean.tar.gz
SLOP tar -xf /tmp/lean-port.tar -C /
SLOP CWD /tmp/lean/stage0 patch -p1 < ../dolly/lean-dolly.patch
SLOP CWD /tmp/lean make -f dolly/lean-dolly.mk -j4
SLOP mkdir -p /usr/lib/lean-stage0 && cp /tmp/lean/build/stage0/bin/lean /usr/lib/lean-stage0/lean
SLOP /usr/lib/lean-stage0/lean --version

FILE /usr/lib/lean-stage0/lean

ENTRY /bin/foreground -i /bin/slop
