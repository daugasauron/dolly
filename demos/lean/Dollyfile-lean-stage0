# The first lean of Lean's bootstrap: upstream's stage0/, its copy of the
# C++ runtime and the C the release before emitted, compiled inside Dolly
# (lean-dolly.mk, lean-dolly.patch) and rewritten by stack-wrap; lean-std,
# lean-meta and lean compile the release with it.
FROM /v0.1.5/Dollyfile-system-tools e45f4762017fb1ce740df1350a5c451d34642bbf1c24e0752f8e841fb109f20c
INSTALL /v0.1.5/Dollyfile-stack-wrap d5685e9304b556ce1a035dd269ddf0aeb30cd9b310183847118bcff0c276505e
INSTALL /v0.1.5/demos/cmake/Dollyfile-libuv 0e1be37cf30c4838b5681bad7511d1145bb307e57e44cb8fb40d677b9ce4352c

REQUIRES HEADER libc
REQUIRES HEADER uv
REQUIRES LIB uv
REQUIRES TOOL ar
REQUIRES TOOL c++
REQUIRES TOOL cc
REQUIRES TOOL find
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL patch
REQUIRES TOOL sed
REQUIRES TOOL stack-wrap
REQUIRES TOOL tar

SOURCE /v0.1.5/dist/static/lean/lean.tar.gz ef83239912f7c218c5f0e937de704b7da807b9802b05216414b59b9dec42e0da /tmp/lean.tar.gz
SOURCE /v0.1.5/dist/static/lean/port.tar 1716710f88ccdd478709b75533ef1686ff39e381ad7d66ff65caff992e2dd1a6 /tmp/lean-port.tar
SLOP gzip -dc /tmp/lean.tar.gz | tar -xf - -C / && rm /tmp/lean.tar.gz
SLOP tar -xf /tmp/lean-port.tar -C /
SLOP CWD /tmp/lean/stage0 patch -p1 < ../dolly/lean-dolly.patch
SLOP CWD /tmp/lean make -f dolly/lean-dolly.mk -j4
SLOP mkdir -p /usr/lib/lean-stage0 && cp /tmp/lean/build/stage0/bin/lean /usr/lib/lean-stage0/lean
SLOP /usr/lib/lean-stage0/lean --version

FILE /usr/lib/lean-stage0/lean

ENTRY /bin/foreground -i /bin/slop
