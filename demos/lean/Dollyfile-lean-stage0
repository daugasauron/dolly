# lean-meta and lean compile the release with it.
FROM /v0.1.4/Dollyfile-system-tools 1da009342a42fc8b1297513c7c43ba47d2ea58c709afa237a79782232d92defd
INSTALL /v0.1.4/Dollyfile-stack-wrap 916cc6a07d32ac014c07b39b50055ab8842968dd1c4232d696b6a910ac4f7101
INSTALL /v0.1.4/demos/cmake/Dollyfile-libuv 017cc4d0be7d41097b92a77cf9230d9e7112e8f917985de01b208175207864de

REQUIRES HEADER libc
REQUIRES HEADER uv
REQUIRES LIB uv
REQUIRES TOOL ar
