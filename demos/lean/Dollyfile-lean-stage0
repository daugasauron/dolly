# The first lean of Lean's bootstrap: upstream's stage0/, its copy of the
# C++ runtime and the C the release before emitted, compiled inside Dolly
# (lean-dolly.mk, lean-dolly.patch) and rewritten by stack-wrap; lean-std,
# lean-meta and lean compile the release with it.
FROM /v0.1.7/Dollyfile-system-tools bce9e1cff97e322dfd8158cff9090a7e556b714d9b54169baf7fb5e03c969956
INSTALL /v0.1.7/Dollyfile-stack-wrap 8a41372afb6fe8310afb20a394396c03c2597c5f2456b357946551f3febfcfea
INSTALL /v0.1.7/demos/cmake/Dollyfile-libuv 246bf85f3874b74052bf594c194947365115f8c5dc7a2e1914338285966a10c2

REQUIRES HEADER libc
REQUIRES HEADER uv
REQUIRES LIB uv
REQUIRES TOOL ar
REQUIRES TOOL c++
REQUIRES TOOL cc
REQUIRES TOOL find
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL patch
REQUIRES TOOL sed
REQUIRES TOOL stack-wrap
REQUIRES TOOL tar

SOURCE /v0.1.7/dist/static/lean/lean.tar.gz ef83239912f7c218c5f0e937de704b7da807b9802b05216414b59b9dec42e0da /tmp/lean.tar.gz
SOURCE /v0.1.7/dist/static/lean/port.tar b98085e118db528bb5b28bb24b5c2c74e5caff7a582025f05e77492cd2337dae /tmp/lean-port.tar
SLOP gzip -dc /tmp/lean.tar.gz | tar -xf - -C / && rm /tmp/lean.tar.gz
SLOP tar -xf /tmp/lean-port.tar -C /
SLOP CWD /tmp/lean/stage0 patch -p1 < ../dolly/lean-dolly.patch
SLOP CWD /tmp/lean make -f dolly/lean-dolly.mk -j4
SLOP mkdir -p /usr/lib/lean-stage0 && cp /tmp/lean/build/stage0/bin/lean /usr/lib/lean-stage0/lean
SLOP /usr/lib/lean-stage0/lean --version

FILE /usr/lib/lean-stage0/lean

ENTRY /bin/foreground -i /bin/slop
