# lean-meta and lean compile the release with it.
FROM /v0.1.4/Dollyfile-system-tools d05eab32629208de16683f7ae4e2490501bcd220bf6ffd5ad9b9494d28ac6c6b
INSTALL /v0.1.4/Dollyfile-stack-wrap 8eef863c9e7bcdacf7c9bc6e4d6e9b507ade7ba6beff582e04da92a92eabbc72
INSTALL /v0.1.4/demos/cmake/Dollyfile-libuv 43c8da3fce2006a9eb4ef9c88f7b399ef4eff41f09676cec2d033a137525a5ee

REQUIRES HEADER libc
REQUIRES HEADER uv
REQUIRES LIB uv
