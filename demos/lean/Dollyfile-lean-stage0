# lean-meta and lean compile the release with it.
FROM /v0.1.4/Dollyfile-system-tools 9eacc2ba76a3e499b5938ed0c70b33eb5adffe144de20f4f3d381fb78247a768
INSTALL /v0.1.4/Dollyfile-stack-wrap 5c309002bec30f44d17e0f376a9f92593d1b2286483480896af74f6f84b9e7c2
INSTALL /v0.1.4/demos/cmake/Dollyfile-libuv 55162f114144d4e7e65c03dd8b7bc501b6a026279ab6cc9e17580fcc8d185ff0

REQUIRES HEADER libc
REQUIRES HEADER uv
REQUIRES LIB uv
REQUIRES TOOL ar
