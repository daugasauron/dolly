# The first lean of Lean's bootstrap: upstream's stage0/, its copy of the
# C++ runtime and the C the release before emitted, compiled inside Dolly
# (lean-dolly.mk, lean-dolly.patch) and rewritten by stack-wrap; lean-std,
# lean-meta and lean compile the release with it.
FROM /v0.1.4/Dollyfile-system-tools dd061ff77d48703a124b94f2b3752b227acb27fd1fdb4926e748c71593f3f91e
INSTALL /v0.1.4/Dollyfile-stack-wrap 1882610519e0623501a64065754db1ab0b37458213f91ac329f9c777e38f7eb5
INSTALL /v0.1.4/demos/cmake/Dollyfile-libuv 0a45f087aae88a3ad46d5c755fc4104a4d6d336fb5da3a05fd351025cdef3691

REQUIRES HEADER libc
REQUIRES HEADER uv
REQUIRES LIB uv
REQUIRES TOOL ar
REQUIRES TOOL c++
REQUIRES TOOL cc
REQUIRES TOOL find
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL patch
REQUIRES TOOL sed
REQUIRES TOOL stack-wrap
