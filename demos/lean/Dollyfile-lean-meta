DOLLY 8
PACKAGE lean-meta
REQUIRES HOST runtime@0

# Lean's Lean library, the compiler and elaborator that a Lean program
# imports to work with Lean itself, compiled by the first lean (lean-stage0)
# as lean-std is: its .olean files and libLean.a, which every Lean program
# links, as upstream's flags name it.
FROM /demos/lean/Dollyfile-lean-stage0 dfb1875acfb04fc763b103d67fdae8829bc15795278c609307d87e63e932b575
INSTALL /demos/lean/Dollyfile-lean-std 6db244799d717bc428bbc16bfcb1b85551c4f322ecabbedd9ad44db209c13575
REQUIRES TOOL ar
REQUIRES TOOL cc
REQUIRES TOOL find
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL rm
REQUIRES TOOL sed
REQUIRES TOOL tar
REQUIRES TOOL tr
REQUIRES TOOL xargs

SOURCE /dist/static/lean/lean.tar.gz ef83239912f7c218c5f0e937de704b7da807b9802b05216414b59b9dec42e0da /tmp/lean.tar.gz
SOURCE /dist/static/lean/port.tar b98085e118db528bb5b28bb24b5c2c74e5caff7a582025f05e77492cd2337dae /tmp/lean-port.tar
# Stage 1 reads only src/.
SLOP gzip -dc /tmp/lean.tar.gz | tar -xf - -C / && rm -r /tmp/lean.tar.gz /tmp/lean/stage0
SLOP tar -xf /tmp/lean-port.tar -C /
# Three jobs: the last modules import most of Lean, and four of them at once
# exceeded a 9 GB build.
SLOP CWD /tmp/lean make -f dolly/lean-dolly.mk -j3 STAGE=1 LIBRARIES=Lean LEAN=/usr/lib/lean-stage0/lean

FOLDER /usr/lib/lean/Lean
FILE /usr/lib/lean/Lean.olean
FILE /usr/lib/lean/Lean.olean.server
FILE /usr/lib/lean/Lean.olean.private
FILE /usr/lib/lean/Lean.ir
FILE /usr/lib/lean/Lean.ir.sig
FILE /usr/lib/lean/Lean.ilean
FILE /usr/lib/lean/libLean.a
