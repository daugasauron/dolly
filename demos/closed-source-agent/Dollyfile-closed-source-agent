# anykey PROMPT discards earlier input, shows PROMPT and prints the one key it
# then reads from the terminal; Ctrl+C is status 130.
FILE /tmp/anykey.c
    #include <string.h>
    #include <termios.h>
    #include <unistd.h>
    int main(int argc, char **argv) {
      struct termios cooked, raw;
      if (argc != 2 || tcgetattr(0, &cooked) != 0) return 2;
      raw = cooked;
      raw.c_lflag &= ~(ICANON | ECHO | ISIG);
      raw.c_cc[VMIN] = 1;
      raw.c_cc[VTIME] = 0;
      if (tcsetattr(0, TCSAFLUSH, &raw) != 0) return 1;
      write(2, argv[1], strlen(argv[1]));
      char key;
      const long count = read(0, &key, 1);
      tcsetattr(0, TCSAFLUSH, &cooked);
      if (count != 1) return 1;
      if (key == 3) return 130;
      return write(1, &key, 1) == 1 ? 0 : 1;
    }
SLOP cc -O1 /tmp/anykey.c -o /usr/bin/anykey
EXPORTS TOOL anykey

# secretenv NAME PROMPT COMMAND [ARG...] discards earlier input, shows PROMPT,
# reads a line from the terminal without showing it and runs COMMAND with NAME
# set to it, in that environment only; an empty line leaves NAME unset, Ctrl+C
# is status 130.
FILE /tmp/secretenv.c
    #include <spawn.h>
    #include <stdlib.h>
    #include <string.h>
    #include <sys/wait.h>
    #include <termios.h>
    #include <unistd.h>
    extern char **environ;
    int main(int argc, char **argv) {
      struct termios cooked, raw;
      if (argc < 4 || tcgetattr(0, &cooked) != 0) return 2;
      raw = cooked;
      raw.c_lflag &= ~(ICANON | ECHO | ISIG);
      raw.c_cc[VMIN] = 1;
      raw.c_cc[VTIME] = 0;
      if (tcsetattr(0, TCSAFLUSH, &raw) != 0) return 1;
      write(2, argv[2], strlen(argv[2]));
      char secret[512], byte = 0;
      size_t length = 0;
      while (read(0, &byte, 1) == 1 && byte != '\r' && byte != '\n' && byte != 3) {
        if (byte == 127 || byte == '\b') length -= length > 0;
        else if (byte > ' ' && length + 1 < sizeof(secret)) secret[length++] = byte;
      }
      secret[length] = '\0';
      tcsetattr(0, TCSANOW, &cooked);
      write(2, "\n", 1);
      if (byte == 3) return 130;
      if (length > 0 && setenv(argv[1], secret, 1) != 0) return 1;
      pid_t child;
      int status;
      if (posix_spawnp(&child, argv[3], NULL, NULL, argv + 3, environ) != 0) return 127;
      if (waitpid(child, &status, 0) != child) return 1;
      return WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
    }
SLOP cc -O1 /tmp/secretenv.c -o /usr/bin/secretenv
EXPORTS TOOL secretenv

FILE /usr/share/doc/closed-source-agent/NOTICE
    THIS IMAGE RUNS CLAUDE CODE
    ---------------------------
    Claude Code is Anthropic's command-line coding agent. It is Anthropic's
    software and not part of Dolly; Dolly is not affiliated with or endorsed by
    Anthropic.
    - Continuing downloads Claude Code 2.1.112 (April 2026, 18.7 MB) from the
      npm registry into this browser session, checks its digest and runs it
      unchanged. This site serves nothing of it. Its use is subject to
      Anthropic's terms: https://code.claude.com/docs/en/legal-and-compliance
    - Its interface works here with your own Anthropic API key, in its minimal
      mode (--bare): no hooks, LSP, plugin sync, attribution, auto-memory,
      background prefetches, keychain reads or CLAUDE.md discovery, and only
      the Read, Edit and Bash tools. The key is asked for once, is not shown
      and is given to Claude Code alone. Usage is billed to you. Requests go
      from this browser to Anthropic; the site serving Dolly does not receive
      them.
    - Signing in with a Claude or Console account does not work in a browser:
      started as published, Claude Code stops at "Unable to connect to
      Anthropic services" before its sign-in screen, and its /login needs a
      local callback server that nothing here can run.
    - Print mode works: export ANTHROPIC_API_KEY=... and then
      closed-source-agent -p 'your request'
    - A saved or exported session contains the downloaded package and what
      Claude Code stored of your sign-in (the last 20 characters of the key).
    - Limits: an old release (the last that is JavaScript), run on Janis
      instead of Node; its Bash tool finds no shell here; a wrong key shows
      the API's error only after about three minutes of its own retries.

# Shows the notice, downloads Claude Code into the session (once), checks the
# pinned digest of the tarball and runs it unchanged: with the arguments given,
# or without any as the notice's key chose.
FILE /usr/bin/closed-source-agent
    #!/bin/slop
    package=/opt/claude-code/package
    start=
    if test $# -eq 0 || ! test -s $package/cli.js; then
      clear
      cat /usr/share/doc/closed-source-agent/NOTICE
      keys=$'\nEnter (or any other key): download and start with an API key (--bare)\np: start as published        Ctrl+C: leave without downloading\n'
      test $# -eq 0 || keys=$'\nAny key: download and run it with your arguments        Ctrl+C: leave\n'
      start=$(anykey "$keys") || exit $?
    fi
    if ! test -s $package/cli.js; then
      printf '\nDownloading Claude Code 2.1.112 from registry.npmjs.org ...\n'
      curl -fsS https://registry.npmjs.org/@anthropic-ai/claude-code/-/claude-code-2.1.112.tgz -o /tmp/claude-code.tgz || exit 1
      if test "$(sha256sum /tmp/claude-code.tgz | cut -d ' ' -f 1)" != 84379969ea53a0e5fd231a8f77debe4c7cb17dd971f4809d10d33f9aeca5de09; then
        printf 'closed-source-agent: the download does not match the pinned SHA-256; nothing was unpacked.\n' >&2
        rm -f /tmp/claude-code.tgz
        exit 1
      fi
      mkdir -p /opt/claude-code && gzip -dc /tmp/claude-code.tgz > /tmp/claude-code.tar && tar -xf /tmp/claude-code.tar -C /opt/claude-code || exit 1
      rm -f /tmp/claude-code.tgz /tmp/claude-code.tar
    fi
    export USE_BUILTIN_RIPGREP=0
    if test $# -gt 0 || test "$start" = p; then
      janis $package/cli.js "$@"
    elif test -n "$ANTHROPIC_API_KEY"; then
      janis $package/cli.js --bare
    else
      secretenv ANTHROPIC_API_KEY $'\nAnthropic API key (not shown; Enter alone starts without one): ' janis $package/cli.js --bare
    fi
EXPORTS TOOL closed-source-agent

FILE /etc/dolly/init.slop
    cd /workspace
    /bin/foreground -i /usr/bin/closed-source-agent
    printf '\nDolly: image entry exited; entering the recovery Slop shell. closed-source-agent starts it again.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
