SOURCE /v0.1.3/dist/static/gtk/glib-2.90.1.tar.xz 93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396 /tmp/glib.tar.xz
SOURCE /v0.1.3/dist/static/gtk/glib-dolly.patch f7cf8e258bd3cedd3ed89eeecd2b4cd98e9d90f6d308857895b843e9684d1d54 /tmp/glib-dolly.patch
SLOP CWD /tmp xz -dc glib.tar.xz | tar -xf -
SLOP patch -p1 -d /tmp/glib-2.90.1 -i /tmp/glib-dolly.patch
# No tests, translations, introspection data or kernel facilities Dolly has
# not; the wraps would download, so Meson finds the packages above.
SLOP meson setup /tmp/glib-build /tmp/glib-2.90.1 --wrap-mode=nodownload --prefix=/usr --libdir=lib \
  --buildtype=release -Ddefault_library=static -Dtests=false -Dintrospection=disabled -Dnls=disabled \
  -Dselinux=disabled -Dxattr=false -Dlibmount=disabled -Dman-pages=disabled -Ddtrace=disabled \
  -Dsystemtap=disabled -Dsysprof=disabled -Dlibelf=disabled -Dglib_debug=disabled
SLOP meson compile -C /tmp/glib-build && meson install --no-rebuild -C /tmp/glib-build
SLOP sed 's/^Libs: \(.*\)$/Libs: \1 --dolly-cast-emulation/' /usr/lib/pkgconfig/gobject-2.0.pc > /tmp/gobject.pc && \
  mv /tmp/gobject.pc /usr/lib/pkgconfig/gobject-2.0.pc
# Upstream's Python tools start with #!/usr/bin/env; Dolly's env is /bin/env.
SLOP CWD /usr/bin for script in glib-mkenums glib-genmarshal gdbus-codegen gtester-report; do \
  sed '1s|.*|#!/usr/bin/python3|' $script > /tmp/$script && mv /tmp/$script $script; done
SLOP CWD /usr/bin for program in glib-compile-resources glib-compile-schemas gio gresource gsettings; do \
  wasm-opt --fpcast-emu $program -o $program.emulated && mv $program.emulated $program; done

# A GObject type, a signal its handler takes fewer parameters of, one through
# the generic marshaller (libffi), a sort through a cast, a thread, a main
# loop and GIO reading a file.
FILE /tmp/glib-check.c
    #include <gio/gio.h>
    #include <stdio.h>
    #include <string.h>
    #define PROBE_TYPE (probe_get_type())
    G_DECLARE_FINAL_TYPE(Probe, probe, PROBE, OBJECT, GObject)
    struct _Probe { GObject parent; int seen; };
    G_DEFINE_FINAL_TYPE(Probe, probe, G_TYPE_OBJECT)
    static guint touched, weighed;
    static void probe_class_init(ProbeClass *klass) {
      (void)klass;
      touched = g_signal_new("touched", PROBE_TYPE, G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL, G_TYPE_NONE, 1, G_TYPE_INT);
      weighed = g_signal_new("weighed", PROBE_TYPE, G_SIGNAL_RUN_LAST, 0, NULL, NULL, NULL,
                             G_TYPE_INT, 3, G_TYPE_INT, G_TYPE_DOUBLE, G_TYPE_STRING);
    }
    static void probe_init(Probe *self) { self->seen = 0; }
    static void on_touched(Probe *self) { self->seen = 1; }
    static int on_weighed(Probe *self, int number, double scale, const char *word, gpointer data) {
      (void)self;
      return number * (int)scale + (int)strlen(word) + GPOINTER_TO_INT(data);
    }
    static gint by_number(gconstpointer left, gconstpointer right) { return GPOINTER_TO_INT(left) - GPOINTER_TO_INT(right); }
    static gpointer twice(gpointer data) { return GINT_TO_POINTER(GPOINTER_TO_INT(data) * 2); }
    static gboolean quit(gpointer loop) { g_main_loop_quit(loop); return G_SOURCE_REMOVE; }
    int main(void) {
      Probe *probe = g_object_new(PROBE_TYPE, NULL);
      int weight = 0;
      g_signal_connect(probe, "touched", G_CALLBACK(on_touched), NULL);
      g_signal_connect(probe, "weighed", G_CALLBACK(on_weighed), GINT_TO_POINTER(1));
      g_signal_emit(probe, touched, 0, 7);
      g_signal_emit(probe, weighed, 0, 20, 2.0, "go", &weight);
      GList *list = g_list_sort(g_list_prepend(g_list_prepend(NULL, GINT_TO_POINTER(2)), GINT_TO_POINTER(1)), by_number);
      list = g_list_sort(list, by_number);
      GThread *thread = g_thread_new("twice", twice, GINT_TO_POINTER(21));
      GMainLoop *loop = g_main_loop_new(NULL, FALSE);
      g_timeout_add(10, quit, loop);
      g_main_loop_run(loop);
      char *contents = NULL;
      gboolean read = g_file_load_contents(g_file_new_for_path("/tmp/glib-check.c"), NULL, &contents, NULL, NULL, NULL);
      if (probe->seen != 1 || weight != 43 || GPOINTER_TO_INT(list->data) != 1 ||
          GPOINTER_TO_INT(g_thread_join(thread)) != 42 || !read || !strstr(contents, "GLIB-OK")) return 1;
      return puts("GLIB-OK") < 0;
    }
SLOP cc -O1 -pthread /tmp/glib-check.c -o /tmp/glib-check $(pkg-config --cflags --libs gio-2.0) && \
  /tmp/glib-check | grep -qx GLIB-OK

