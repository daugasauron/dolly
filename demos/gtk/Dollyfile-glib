# GLib from upstream's release, built by its own Meson with one patch
# (glib-dolly.patch: g_unix_fd_query_path is not supported here, as on Hurd).
# A program that links GLib is threaded, calls through libffi (dso@0's FFI)
# and calls functions through pointers cast to types of other parameters,
# which traps in WebAssembly: GObject's pkg-config file asks cc for
# --dolly-cast-emulation (Binaryen's wasm-opt --fpcast-emu after the link),
# and this package's own programs are passed through it here.
FROM /v0.1.4/demos/tools/Dollyfile-tools-build 26870be0014aad916d555ebb2383536a5a5d8f60b52bd17b9243080688642360
USE /v0.1.4/demos/tools/Dollyfile-meson f3157fc4c9361d1dcc71d0e5afa12ecb8a1066ee93f94963bc70a1bb2f3f0bcb
