DOLLY 8
PACKAGE libepoxy
REQUIRES HOST runtime@0
REQUIRES HOST sockets@0
REQUIRES HOST threads@0

# libepoxy, the OpenGL function pointer dispatch (GTK's and Blender's), from
# upstream's release, unchanged, built by its own Meson as a static library,
# for programs the cc package builds: GL, with EGL and GLX dispatch. It finds
# the GL functions when it is called. Its pkg-config file requires x11 and
# egl, so it brings the x11-libs and mesa packages.
FROM /demos/tools/Dollyfile-tools-build 3c416d0813c5baabb63ce16ebbd9abda02d78c2f86dcb2bbb351a19ffcb32139
INSTALL /demos/x11/Dollyfile-x11-libs 35717a8ff71126fc72d47fd6e4aa806e834865ad25f185db21013d98176ac100
INSTALL /demos/ghostty-gtk/Dollyfile-mesa bcc95cf5c5fee6f218d201a12e25605facdb7b7f28bd266b5850f944200e288c
USE /demos/tools/Dollyfile-meson 1b12743f4d6bbb9cd96b6088dd4b61d4de8915f4df0a52414ae2177726dde8b9
USE /demos/tools/Dollyfile-pkgconf 26fb05d3178c786e45f1d9a6f399dcf78b78949f337e8da3c6591ce74352a7b0
USE /demos/tools/Dollyfile-xz 459f0cc5ab2cda8ede96f9c9434f947f97b7e5faef4bfd3543abcb2be3e8e909
USE /demos/tools/Dollyfile-tar 4df2a7797074d14dc168e125e4b743fa7afdebd695a4f3055ac881ae1dc86ff1
REQUIRES HEADER egl
REQUIRES TOOL   cp
REQUIRES TOOL   meson
REQUIRES TOOL   mkdir
REQUIRES TOOL   pkg-config
REQUIRES TOOL   rm
REQUIRES TOOL   tar
REQUIRES TOOL   xz

SOURCE /dist/static/gtk/libepoxy-1.5.10.tar.xz 072cda4b59dd098bba8c2363a6247299db1fa89411dc221c8b81b8ee8192e623 /tmp/libepoxy.tar.xz
SLOP CWD /tmp xz -dc libepoxy.tar.xz | tar -xf -
SLOP CWD /tmp meson setup libepoxy-build libepoxy-1.5.10 --wrap-mode=nodownload --prefix=/usr --libdir=lib \
  --buildtype=release -Ddefault_library=static -Ddocs=false -Dtests=false -Dglx=yes -Degl=yes -Dx11=true
SLOP meson compile -C /tmp/libepoxy-build && meson install --no-rebuild -C /tmp/libepoxy-build
SLOP mkdir -p /usr/share/licenses/libepoxy
SLOP cp /tmp/libepoxy-1.5.10/COPYING /usr/share/licenses/libepoxy/COPYING

EXPORTS LIB    epoxy /usr/lib/libepoxy.a
EXPORTS HEADER epoxy /usr/include/epoxy
FILE /usr/lib/pkgconfig/epoxy.pc
FILE /usr/share/licenses/libepoxy/COPYING
SLOP rm -rf /tmp/libepoxy-1.5.10 /tmp/libepoxy-build /tmp/libepoxy.tar.xz
