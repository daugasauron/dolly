INSTALL /v0.1.3/demos/tools/Dollyfile-tar 6548dec0620c36a1eb12e53375f9870c052d37d7bf7d4d1ffae347f0547c63ce
INSTALL /v0.1.3/demos/tools/Dollyfile-binaryen bbe369e92dc93978c3fcb397f79bf673266776d72ad05000d873df5ab4144777
INSTALL /v0.1.3/demos/python/Dollyfile-libffi 315a79d7d7d96139320262278e575dd8e26a74880baf8d0f3effe81d42086b73
INSTALL /v0.1.3/demos/gtk/Dollyfile-pcre2 fb7566213751b7b7a1f59a1a4bde58a30cd169ca8a89a167533433335a9636e9
