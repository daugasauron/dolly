# Khronos's EGL and KHR headers, as Mesa's release carries them: libepoxy's
# EGL dispatch includes them, and GTK's X11 backend has EGL code.
SOURCE /v0.1.3/dist/static/gtk/khronos-headers.tar 0873dc0d3a69057385df77ef9a1433cbc91f00acfb56de2509362af2e46397b8 /tmp/gtk/khronos-headers.tar
SLOP CWD /tmp/gtk for archive in *.tar.xz; do xz -dc $archive | tar -xf -; done
SLOP CWD /tmp/gtk for archive in *.tar.gz; do gzip -dc $archive | tar -xf -; done
SLOP tar -xf /tmp/gtk/khronos-headers.tar -C /
SLOP patch -p1 -d /tmp/gtk/fontconfig-2.18.3 -i /tmp/gtk/fontconfig-dolly.patch
SLOP patch -p1 -d /tmp/gtk/gtk-4.24.1 -i /tmp/gtk/gtk-dolly.patch

# The fonts and their shaping: FreeType, FriBidi (whose table generators hold
# more static data than cc's 16 MiB of initial memory), HarfBuzz and expat.
SLOP CWD /tmp/gtk meson setup build-freetype freetype-2.14.3 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static \
  -Dharfbuzz=disabled -Dpng=disabled -Dbrotli=disabled -Dbzip2=disabled -Dzlib=enabled
SLOP meson compile -C /tmp/gtk/build-freetype && meson install --no-rebuild -C /tmp/gtk/build-freetype
SLOP CWD /tmp/gtk meson setup build-fribidi fribidi-1.0.17 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Ddocs=false -Dtests=false -Dbin=false \
  -Dc_link_args=-Wl,--initial-memory=67108864
SLOP meson compile -C /tmp/gtk/build-fribidi && meson install --no-rebuild -C /tmp/gtk/build-fribidi
SLOP CWD /tmp/gtk meson setup build-harfbuzz harfbuzz-14.6.0 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Dtests=disabled -Ddocs=disabled \
  -Dintrospection=disabled -Dcairo=disabled -Dicu=disabled -Dglib=enabled -Dgobject=enabled \
  -Dutilities=disabled -Dbenchmark=disabled -Dfreetype=enabled
SLOP meson compile -C /tmp/gtk/build-harfbuzz && meson install --no-rebuild -C /tmp/gtk/build-harfbuzz
SLOP cmake -S /tmp/gtk/expat-2.8.5 -B /tmp/gtk/build-expat -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=OFF -DEXPAT_BUILD_TOOLS=OFF \
  -DEXPAT_BUILD_EXAMPLES=OFF -DEXPAT_BUILD_TESTS=OFF -DEXPAT_SHARED_LIBS=OFF -DEXPAT_BUILD_DOCS=OFF
SLOP cmake --build /tmp/gtk/build-expat -j4 && cmake --install /tmp/gtk/build-expat

# gperf 3.1, whose library is plain C and C++ (later releases need gnulib's
# configure), written in C++14: fontconfig's build runs it.
FILE /tmp/gtk/gperf.mk
    .RECIPEPREFIX := >
    G := /tmp/gtk/gperf-3.1
    B := /tmp/gtk/build-gperf
    FLAGS := -O2 -I$(B) -I$(G)/lib
    OBJ := lib/getline lib/getopt lib/getopt1 lib/hash src/bool-array src/hash-table src/input \
      src/keyword-list src/keyword src/main src/options src/output src/positions src/search src/version
    all: /usr/bin/gperf
    $(B)/config.h:
    >mkdir -p $(B)
    >printf '#define HAVE_DYNAMIC_ARRAY 1\n#define PACKAGE_VERSION "3.1"\n' > $@
    $(B)/%.o: $(G)/%.cc $(B)/config.h
    >mkdir -p $(@D)
    >c++ -std=gnu++14 $(FLAGS) -c $< -o $@
    $(B)/%.o: $(G)/%.c $(B)/config.h
    >mkdir -p $(@D)
    >cc $(FLAGS) -c $< -o $@
    /usr/bin/gperf: $(addprefix $(B)/,$(addsuffix .o,$(OBJ)))
    >c++ $^ -o $@
SLOP make -j4 -f /tmp/gtk/gperf.mk
SLOP CWD /tmp/gtk meson setup build-fontconfig fontconfig-2.18.3 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Dtests=disabled -Ddoc=disabled \
  -Dtools=disabled -Dcache-build=disabled -Dnls=disabled -Dxml-backend=expat
SLOP meson compile -C /tmp/gtk/build-fontconfig && meson install --no-rebuild -C /tmp/gtk/build-fontconfig

# The images GTK loads, and its drawing: pixman without the SIMD of other
# machines, cairo over Xlib (MIT-SHM is asked of the server and Dolly's has
# none), graphene and libepoxy.
SLOP cmake -S /tmp/gtk/libpng-1.6.59 -B /tmp/gtk/build-png -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=OFF -DPNG_SHARED=OFF -DPNG_TESTS=OFF -DPNG_TOOLS=OFF
SLOP cmake --build /tmp/gtk/build-png -j4 && cmake --install /tmp/gtk/build-png
SLOP cmake -S /tmp/gtk/libjpeg-turbo-3.2.0 -B /tmp/gtk/build-jpeg -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=OFF -DENABLE_SHARED=OFF -DWITH_SIMD=OFF -DWITH_TURBOJPEG=OFF
SLOP cmake --build /tmp/gtk/build-jpeg -j4 && cmake --install /tmp/gtk/build-jpeg
SLOP cmake -S /tmp/gtk/tiff-4.7.2 -B /tmp/gtk/build-tiff -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=OFF -Dtiff-tools=OFF -Dtiff-tests=OFF \
  -Dtiff-contrib=OFF -Dtiff-docs=OFF -Djbig=OFF -Dlerc=OFF -Dlzma=OFF -Dzstd=OFF -Dwebp=OFF -Dlibdeflate=OFF
SLOP cmake --build /tmp/gtk/build-tiff -j4 && cmake --install /tmp/gtk/build-tiff
SLOP CWD /tmp/gtk meson setup build-pixman pixman-0.46.4 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Dloongson-mmi=disabled -Dmmx=disabled \
  -Dsse2=disabled -Dssse3=disabled -Dvmx=disabled -Darm-simd=disabled -Dneon=disabled -Da64-neon=disabled \
  -Dmips-dspr2=disabled -Drvv=disabled -Dgnu-inline-asm=disabled -Dopenmp=disabled -Dtimers=false \
  -Dgtk=disabled -Dlibpng=disabled -Dtests=disabled -Ddemos=disabled
SLOP meson compile -C /tmp/gtk/build-pixman && meson install --no-rebuild -C /tmp/gtk/build-pixman
SLOP CWD /tmp/gtk meson setup build-cairo cairo-1.18.6 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Ddwrite=disabled -Dfontconfig=enabled \
  -Dfreetype=enabled -Dpng=enabled -Dquartz=disabled -Dtee=disabled -Dxcb=disabled -Dxlib=enabled \
  -Dzlib=enabled -Dtests=disabled -Dlzo=disabled -Dglib=enabled -Dspectre=disabled -Dsymbol-lookup=disabled
SLOP meson compile -C /tmp/gtk/build-cairo && meson install --no-rebuild -C /tmp/gtk/build-cairo

# The X extension libraries GTK's X11 backend links beyond x11-build's: each
# compiles its src directory, as x11-build's own do.
FILE /tmp/gtk/xlibs.slop
    cd /tmp/gtk
    for spec in libXrandr-1.5.5:Xrandr:1.5.5:x11_xext_xrender_randrproto libXdamage-1.1.7:Xdamage:1.1.7:x11_xfixes_damageproto \
        libXcomposite-0.4.7:Xcomposite:0.4.7:x11_xfixes_compositeproto libXinerama-1.1.6:Xinerama:1.1.6:x11_xext_xineramaproto \
        libXcursor-1.2.3:Xcursor:1.2.3:x11_xrender_xfixes; do
      source=${spec%%:*}; rest=${spec#*:}; name=${rest%%:*}; rest=${rest#*:}; version=${rest%%:*}
      requires=$(echo ${rest#*:} | tr _ ' ')
      mkdir -p build-$name
      for c in $source/src/*.c; do
        cc -O2 -DHAVE_XFIXES '-DICONDIR="/usr/share/icons"' '-DXCURSORPATH="~/.icons:/usr/share/icons:/usr/share/pixmaps"' \
          -I$source/include/X11/Xcursor -I$source/include -I$source/include/X11/extensions \
          -c $c -o build-$name/$(basename $c .c).o || exit 1
      done
      ar rcs /usr/lib/lib$name.a build-$name/*.o
      if test -d $source/include/X11/extensions; then cp $source/include/X11/extensions/*.h /usr/include/X11/extensions/
      else mkdir -p /usr/include/X11/Xcursor && cp $source/include/X11/Xcursor/Xcursor.h /usr/include/X11/Xcursor/; fi
      lower=$(echo $name | tr A-Z a-z)
      printf '%s\n' 'prefix=/usr' "Name: $lower" "Description: $lower" "Version: $version" "Requires: $requires" \
        "Libs: -L/usr/lib -l$name" 'Cflags: -I/usr/include' > /usr/lib/pkgconfig/$lower.pc
    done
SLOP slop /tmp/gtk/xlibs.slop
SLOP CWD /tmp/gtk meson setup build-graphene graphene-1.10.8 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Dintrospection=disabled -Dtests=false \
  -Dinstalled_tests=false -Dgobject_types=true -Dsse2=false -Darm_neon=false -Dgcc_vector=false
SLOP meson compile -C /tmp/gtk/build-graphene && meson install --no-rebuild -C /tmp/gtk/build-graphene
SLOP CWD /tmp/gtk meson setup build-epoxy libepoxy-1.5.10 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Ddocs=false -Dtests=false
SLOP meson compile -C /tmp/gtk/build-epoxy && meson install --no-rebuild -C /tmp/gtk/build-epoxy

# gdk-pixbuf with its PNG and JPEG loaders built in (no glycin, which is Rust's
# processes, and no MIME sniffing database), pango, and GTK with its X11
# backend alone; GTK's library is built static (gtk-dolly.patch).
SLOP CWD /tmp/gtk meson setup build-pixbuf gdk-pixbuf-2.44.8 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Dpng=enabled -Djpeg=enabled \
  -Dtiff=disabled -Dgif=disabled -Dglycin=disabled -Dothers=disabled -Dbuiltin_loaders=png,jpeg \
  -Dintrospection=disabled -Dman=false -Dtests=false -Dinstalled_tests=false -Dthumbnailer=disabled \
  -Dgtk_doc=false -Dgio_sniffing=false
SLOP meson compile -C /tmp/gtk/build-pixbuf && meson install --no-rebuild -C /tmp/gtk/build-pixbuf
SLOP CWD /tmp/gtk meson setup build-pango pango-1.58.2 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Dintrospection=disabled \
  -Dbuild-testsuite=false -Dbuild-examples=false -Dfontconfig=enabled -Dfreetype=enabled -Dcairo=enabled \
  -Dlibthai=disabled -Dxft=disabled -Ddocumentation=false -Dman-pages=false -Dsysprof=disabled
SLOP meson compile -C /tmp/gtk/build-pango && meson install --no-rebuild -C /tmp/gtk/build-pango
SLOP CWD /tmp/gtk meson setup build-gtk gtk-4.24.1 --wrap-mode=nodownload --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=static -Dx11-backend=true -Dwayland-backend=false \
  -Dbroadway-backend=false -Dwin32-backend=false -Dmacos-backend=false -Dandroid-backend=false \
  -Dmedia-gstreamer=disabled -Dprint-cpdb=disabled -Dprint-cups=disabled -Dvulkan=disabled \
  -Dcloudproviders=disabled -Dsysprof=disabled -Dtracker=disabled -Dcolord=disabled -Df16c=disabled \
  -Daccesskit=disabled -Dintrospection=disabled -Ddocumentation=false -Dscreenshots=false \
  -Dman-pages=false -Dbuild-demos=false -Dbuild-testsuite=false -Dbuild-examples=false -Dbuild-tests=false
SLOP meson compile -C /tmp/gtk/build-gtk && meson install --no-rebuild -C /tmp/gtk/build-gtk

# A GTK program links, cast-emulated; a window needs an X server to open on.
FILE /tmp/gtk/check.c
    #include <gtk/gtk.h>
    int main(void) { return gtk_get_major_version() == 4 ? 0 : 1; }
SLOP cc -O1 -pthread /tmp/gtk/check.c -o /tmp/gtk/check $(pkg-config --cflags --libs gtk4) && /tmp/gtk/check

SLOP CWD /tmp/gtk for source in freetype-2.14.3:LICENSE.TXT fribidi-1.0.17:COPYING harfbuzz-14.6.0:COPYING \
  expat-2.8.5:COPYING fontconfig-2.18.3:COPYING libpng-1.6.59:LICENSE libjpeg-turbo-3.2.0:LICENSE.md \
  tiff-4.7.2:LICENSE.md pixman-0.46.4:COPYING cairo-1.18.6:COPYING-MPL-1.1 graphene-1.10.8:LICENSE.txt \
  libepoxy-1.5.10:COPYING gdk-pixbuf-2.44.8:COPYING pango-1.58.2:COPYING gtk-4.24.1:COPYING; do \
  name=${source%%-[0-9]*}; mkdir -p /usr/share/licenses/$name && cp ${source%%:*}/${source#*:} /usr/share/licenses/$name/; done
FOLDER /usr/lib/pkgconfig
FOLDER /usr/include
FOLDER /usr/lib
FOLDER /usr/share/licenses
ENTRY /bin/foreground -i /bin/slop
