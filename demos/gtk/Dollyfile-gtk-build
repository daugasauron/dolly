# GTK 4 and the libraries under it, each from its upstream release by its own
# build, over the libpng, FreeType, expat, libjpeg-turbo, libtiff, pixman,
# libepoxy and Mesa packages: Meson for FriBidi, HarfBuzz, fontconfig (whose
# build runs the gperf package), cairo, graphene, gdk-pixbuf, pango and GTK
# (its X11 backend alone, over x11-build's X libraries). Mesa's EGL and KHR
# headers serve GTK's EGL code; its libraries, a
# program that draws with OpenGL itself (Ghostty). Static libraries in
# /usr/lib, as a GTK program links them; GLib's pkg-config file has cc
# cast-emulate every GObject program, those these builds run among them.
FROM /demos/x11/Dollyfile-x11-build abcf4da3570a80974a718f2ec018c0490cc4484b2796dc6a3a0bccb7557be3f3
