DOLLY 7
PACKAGE emacs
REQUIRES HOST runtime@0

# GNU Emacs 31.1 for the terminal. demos/emacs/prepare-emacs.sh patches and
# configures the release outside; Dolly compiles every object and dumps it.
FROM /v0.1.4/Dollyfile-system c3e545ab3353e106923a64aaa5255d0cc6c5f98a7d2ab240a3489086d66ca6db
REQUIRES HEADER libc
REQUIRES TOOL   cc
REQUIRES TOOL   ar
REQUIRES TOOL   make
REQUIRES TOOL   sh
REQUIRES TOOL   sed
REQUIRES TOOL   awk
REQUIRES TOOL   gzip
REQUIRES TOOL   tar
REQUIRES TOOL   find
REQUIRES TOOL   xargs
REQUIRES TOOL   cp
REQUIRES TOOL   mkdir
REQUIRES TOOL   rm

SOURCE /v0.1.4/dist/static/emacs/emacs.tar.gz 464698bdbb30356fa709dde331130bef592dd16d94fdb0dd1fbb0a059fba0184 /tmp/emacs.tar.gz
SLOP gzip -dc /tmp/emacs.tar.gz | tar -xf - -C /

# Built at -O0, Emacs needs more stack at its first prompt than a Worker gives
# a fresh Chromium's baseline code: it asks for the deeper one (docs/browser-stack.md).
FILE /tmp/emacs-stack.c
    __asm__(".section .custom_section.dolly.process.stack,\"\",@\n.byte 1\n");
SLOP cat /tmp/emacs-stack.c >> /tmp/emacs/src/emacs.c

# Dolly's tar does not restore archive times. One time for every file lets
# Make treat the generated files the release ships as current.
FILE /tmp/emacs-release-time.c
    #include <fcntl.h>
    #include <stdio.h>
    #include <sys/stat.h>
    
    int main(int argc, char **argv) {
      const struct timespec release[2] = {{1787529600, 0}, {1787529600, 0}};
      for (int index = 1; index < argc; index++) {
        if (utimensat(AT_FDCWD, argv[index], release, 0) != 0) {
          perror(argv[index]);
          return 1;
        }
      }
      return 0;
    }
SLOP cc /tmp/emacs-release-time.c -o /tmp/emacs-release-time
SLOP find /tmp/emacs -type f -exec /tmp/emacs-release-time {} +

# The release's byte-compiled Lisp is used as shipped: bootstrapping it from
# source interprets the loadup files and overflows a browser Worker's stack.
SLOP make -C /tmp/emacs/lib -j4
SLOP make -C /tmp/emacs/lib-src -j4
SLOP make -C /tmp/emacs/src -j4

# Install as upstream's make install lays it out, which needs tar -c, and
# compress what it compresses: the Lisp sources whose bytecode is installed,
# the public suffix list and the info pages. Emacs reads them through gzip.
SLOP mkdir -p /usr/libexec/emacs/31.1/wasm64-unknown-emscripten /usr/share/emacs/31.1 \
  /usr/share/emacs/site-lisp /usr/share/licenses/emacs
SLOP cp /tmp/emacs/src/emacs /usr/bin/emacs
SLOP cp /tmp/emacs/lib-src/etags /usr/bin/etags
SLOP cp /tmp/emacs/lib-src/hexl /usr/libexec/emacs/31.1/wasm64-unknown-emscripten/hexl
SLOP cp /tmp/emacs/src/emacs.pdmp \
  "/usr/libexec/emacs/31.1/wasm64-unknown-emscripten/emacs-$(/tmp/emacs/src/emacs --fingerprint).pdmp"
SLOP cp -R /tmp/emacs/lisp /usr/share/emacs/31.1/lisp
SLOP cp -R /tmp/emacs/etc /usr/share/emacs/31.1/etc
SLOP cp -R /tmp/emacs/info /usr/share/info
SLOP find /usr/share/emacs/31.1/lisp -name '*.elc' | sed 's/c$//' | xargs gzip -9n
SLOP gzip -9n /usr/share/emacs/31.1/etc/publicsuffix.txt
SLOP find /usr/share/info -name '*.info' -exec gzip -9n {} +
SLOP find /usr/share/emacs/31.1 -name 'Makefile*' -exec rm -f {} +
SLOP cp /tmp/emacs/COPYING /usr/share/licenses/emacs/COPYING

# The mode is on for what it skips: Emacs's XTVERSION probe, whose 0.1 s wait
# is shorter than the terminal's reply. Dolly's terminal reports no mouse.
FILE /usr/share/emacs/site-lisp/site-start.el
    ;;; -*- lexical-binding: t -*-
    (xterm-mouse-mode 1)

EXPORTS TOOL   emacs
EXPORTS TOOL   etags
EXPORTS FOLDER emacs-data    /usr/share/emacs
EXPORTS FOLDER emacs-libexec /usr/libexec/emacs
EXPORTS FOLDER emacs-info    /usr/share/info
FILE /usr/share/licenses/emacs/COPYING

FILE /tmp/emacs-check.el
    ;;; -*- lexical-binding: t -*-
    (require 'cl-lib)
    (with-temp-file "/tmp/emacs-check.txt" (insert "Dolly 日本語\n"))
    (cl-assert (equal (with-temp-buffer (insert-file-contents "/tmp/emacs-check.txt")
                        (buffer-string))
                      "Dolly 日本語\n"))
    (cl-assert (equal (shell-command-to-string "printf SLOP-CHILD") "SLOP-CHILD"))
    (cl-assert (= (call-process "/bin/slop" nil nil nil "-c" "exit 3") 3))
    (let* ((fired nil)
           (process (make-process :name "check" :buffer (generate-new-buffer "check")
                                  :command '("/bin/slop" "-c" "sleep 1; printf ASYNC; exit 4"))))
      (run-with-timer 0.2 nil (lambda () (setq fired t)))
      (while (process-live-p process) (accept-process-output process 0.1))
      (cl-assert fired)
      (cl-assert (= (process-exit-status process) 4))
      (cl-assert (equal (with-current-buffer (process-buffer process) (buffer-substring 1 6))
                        "ASYNC")))
    (require 'find-func)
    (cl-assert (string-suffix-p "/subr.el.gz" (find-library-name "subr")))
    (cl-assert (with-temp-buffer (insert-file-contents (find-library-name "subr"))
                 (search-forward ";;; subr.el ---" nil t)))
    (garbage-collect)
    (princ (format "%s %s\n" emacs-version system-type))
SLOP timeout 120 emacs --batch -l /tmp/emacs-check.el
FILE /usr/share/man/cat1/emacs.1
    emacs: GNU Emacs 31.1 for the terminal, with etags.
    
      emacs FILE           edits FILE; C-x C-s saves, C-x C-c leaves
      emacs --batch ...    runs Lisp without a terminal
    
    M-! and M-x compile run Slop commands; M-x shell does not: Slop has no -i.
    C-g stops Lisp only when it makes a system call. There are no
    pseudo-terminals, network processes, emacsclient or Lisp threads here, and
    no Lisp packages are installed from the network. Its manual is inside it:
    C-h r, and C-h t for the tutorial.
