DOLLY 6
PACKAGE emacs
REQUIRES HOST runtime@0

# GNU Emacs 31.1 for the terminal. demos/emacs/prepare-emacs.sh patches and
# configures the release outside; Dolly compiles every object and dumps it.
FROM https://daugasauron.com/Dollyfile-system 922b7c34867c2f5d309c67e28d2da1f81157dd5b3ae50677b3e48d0a51dfd156
REQUIRES HEADER libc
REQUIRES TOOL   cc
REQUIRES TOOL   ar
REQUIRES TOOL   make
REQUIRES TOOL   sh
REQUIRES TOOL   sed
REQUIRES TOOL   awk
REQUIRES TOOL   gzip
REQUIRES TOOL   tar
REQUIRES TOOL   find
REQUIRES TOOL   xargs
REQUIRES TOOL   cp
REQUIRES TOOL   mkdir
REQUIRES TOOL   rm

SOURCE https://daugasauron.com/dist/static/emacs/emacs.tar.gz b152cfe40981dbb0ee1764c3ace278346fbd9aff6d2cb94ebbd22485c478ba1a /tmp/emacs.tar.gz
SLOP gzip -dc /tmp/emacs.tar.gz | tar -xf - -C /

# Dolly's tar does not restore archive times. One time for every file lets
# Make treat the generated files the release ships as current.
FILE /tmp/emacs-release-time.c
    #include <fcntl.h>
    #include <stdio.h>
    #include <sys/stat.h>
    
    int main(int argc, char **argv) {
      const struct timespec release[2] = {{1787529600, 0}, {1787529600, 0}};
      for (int index = 1; index < argc; index++) {
        if (utimensat(AT_FDCWD, argv[index], release, 0) != 0) {
          perror(argv[index]);
          return 1;
        }
      }
      return 0;
    }
SLOP cc /tmp/emacs-release-time.c -o /tmp/emacs-release-time
SLOP find /tmp/emacs -type f -exec /tmp/emacs-release-time {} +

# The release's byte-compiled Lisp is used as shipped: bootstrapping it from
# source interprets the loadup files and overflows a browser Worker's stack.
SLOP make -C /tmp/emacs/lib -j4
SLOP make -C /tmp/emacs/lib-src -j4
SLOP make -C /tmp/emacs/src -j4

# Install as upstream's make install lays it out, which needs tar -c. Lisp
# sources whose bytecode is installed are left out: upstream compresses them,
# and Dolly's gzip only decompresses.
SLOP mkdir -p /usr/libexec/emacs/31.1/wasm64-unknown-emscripten /usr/share/emacs/31.1 \
  /usr/share/emacs/site-lisp /usr/share/licenses/emacs
SLOP cp /tmp/emacs/src/emacs /usr/bin/emacs
SLOP cp /tmp/emacs/lib-src/etags /usr/bin/etags
SLOP cp /tmp/emacs/lib-src/hexl /usr/libexec/emacs/31.1/wasm64-unknown-emscripten/hexl
SLOP cp /tmp/emacs/src/emacs.pdmp \
  "/usr/libexec/emacs/31.1/wasm64-unknown-emscripten/emacs-$(/tmp/emacs/src/emacs --fingerprint).pdmp"
SLOP cp -R /tmp/emacs/lisp /usr/share/emacs/31.1/lisp
SLOP cp -R /tmp/emacs/etc /usr/share/emacs/31.1/etc
SLOP cp -R /tmp/emacs/info /usr/share/info
SLOP find /usr/share/emacs/31.1/lisp -name '*.elc' | sed 's/c$//' | xargs rm -f
SLOP find /usr/share/emacs/31.1 -name 'Makefile*' -exec rm -f {} +
SLOP cp /tmp/emacs/COPYING /usr/share/licenses/emacs/COPYING

