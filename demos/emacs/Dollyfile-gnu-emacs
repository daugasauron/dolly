DOLLY 6
APPLICATION gnu-emacs
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST download@0
REQUIRES HOST http@0
REQUIRES HOST snapshot@0
REQUIRES HOST upload@0

FROM https://daugasauron.com/Dollyfile-system 1fd0b654197fa9af7dc874d353b25cbd9756f8f989f0bcb4ff7fbf6b79bb95de
INSTALL https://daugasauron.com/demos/emacs/Dollyfile-emacs ddd856454b24522eadb3139161035b7d0172bcdae6cccad0ad9f668b2c04e3b6

FILE /usr/share/emacs/welcome.txt
    GNU Emacs inside Dolly
    C-x C-f opens a file; C-x C-s saves it; C-g cancels.
    M-! runs a Slop command; M-x shell and M-x compile run Slop too.
    C-x C-c returns to Slop. Run emacs to open the editor again.
    Files live in the sandbox. Ctrl+Shift+S saves your session in this browser.
    No pseudoterminals, network processes or package downloads.

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/emacs /usr/share/emacs/welcome.txt
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
