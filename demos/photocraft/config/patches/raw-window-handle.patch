+/// Raw display handle for Dolly, whose programs draw on one page.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct DollyDisplayHandle {}
+
+impl DollyDisplayHandle {
+    /// Create a new display handle.
+    pub fn new() -> Self {
+        Self {}
+    }
+}
+
+/// Raw window handle for Dolly: the page's canvas, held by a display@0 lease.
+#[non_exhaustive]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct DollyWindowHandle {
+    /// The display lease's generation.
+    pub generation: u64,
+}
+
+impl DollyWindowHandle {
+    /// Create a new handle for the display lease `generation`.
+    pub fn new(generation: u64) -> Self {
+        Self { generation }
+    }
+}
