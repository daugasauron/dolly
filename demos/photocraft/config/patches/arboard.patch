+//! Dolly: the page's clipboard, as text (clipboard@0). The program holds it from the first
+//! `Clipboard` it opens; a copy is offered to the browser's clipboard while the user acts on the
+//! page, and a paste the user makes into the page is read from it. Without the module, or beside
+//! a program that holds it, there is no clipboard to open.
+
+#[cfg(feature = "image-data")]
+use crate::common::ImageData;
+use crate::common::Error;
+use std::{
+	borrow::Cow,
+	path::{Path, PathBuf},
+	sync::atomic::{AtomicU64, Ordering},
+};
+
+// <dolly/clipboard.h>, from the libdolly-clipboard package, which cc links.
+const CAPACITY: usize = 262144;
+unsafe extern "C" {
+	fn dolly_clipboard_acquire(generation: *mut u64) -> i32;
+	fn dolly_clipboard_write(generation: u64, text: *const u8, length: usize) -> i32;
+	fn dolly_clipboard_read(generation: u64, text: *mut u8, capacity: usize) -> i64;
+}
+
+// The lease, taken once for the process.
+static LEASE: AtomicU64 = AtomicU64::new(0);
+
+fn failure(what: &str, error: i64) -> Error {
+	Error::Unknown { description: format!("Dolly's clipboard {what}: errno {}", -error) }
+}
+
+pub(crate) struct Clipboard {
+	lease: u64,
+}
+
+impl Clipboard {
+	pub(crate) fn new() -> Result<Clipboard, Error> {
+		let mut lease = LEASE.load(Ordering::Acquire);
+		if lease == 0 {
+			if unsafe { dolly_clipboard_acquire(&mut lease) } != 0 {
+				return Err(Error::ClipboardNotSupported);
+			}
+			LEASE.store(lease, Ordering::Release);
+		}
+		Ok(Clipboard { lease })
+	}
+
+	fn write(&self, text: &str) -> Result<(), Error> {
+		match unsafe { dolly_clipboard_write(self.lease, text.as_ptr(), text.len()) } {
+			0 => Ok(()),
+			error => Err(failure("took no copy", error.into())),
+		}
+	}
+}
+
+pub(crate) struct Get<'clipboard> {
+	clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Get<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { clipboard }
+	}
+
+	pub(crate) fn text(self) -> Result<String, Error> {
+		let mut text = vec![0u8; CAPACITY];
+		let length = unsafe { dolly_clipboard_read(self.clipboard.lease, text.as_mut_ptr(), CAPACITY) };
+		if length < 0 {
+			return Err(failure("could not be read", length));
+		}
+		text.truncate((length as usize).min(CAPACITY));
+		if text.is_empty() {
+			return Err(Error::ContentNotAvailable);
+		}
+		String::from_utf8(text).map_err(|_| Error::ConversionFailure)
+	}
+
+	pub(crate) fn html(self) -> Result<String, Error> {
+		Err(Error::ContentNotAvailable)
+	}
+
+	#[cfg(feature = "image-data")]
+	pub(crate) fn image(self) -> Result<ImageData<'static>, Error> {
+		Err(Error::ContentNotAvailable)
+	}
+
+	pub(crate) fn file_list(self) -> Result<Vec<PathBuf>, Error> {
+		Err(Error::ContentNotAvailable)
+	}
+}
+
+pub(crate) struct Set<'clipboard> {
+	clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Set<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { clipboard }
+	}
+
+	pub(crate) fn text(self, data: Cow<'_, str>) -> Result<(), Error> {
+		self.clipboard.write(&data)
+	}
+
+	// The clipboard holds text: HTML is offered as its alternative text.
+	pub(crate) fn html(self, html: Cow<'_, str>, alt: Option<Cow<'_, str>>) -> Result<(), Error> {
+		self.clipboard.write(alt.as_deref().unwrap_or(&html))
+	}
+
+	#[cfg(feature = "image-data")]
+	pub(crate) fn image(self, _data: ImageData) -> Result<(), Error> {
+		Err(Error::ClipboardNotSupported)
+	}
+
+	pub(crate) fn file_list(self, _file_list: &[impl AsRef<Path>]) -> Result<(), Error> {
+		Err(Error::ClipboardNotSupported)
+	}
+}
+
+pub(crate) struct Clear<'clipboard> {
+	clipboard: &'clipboard mut Clipboard,
+}
+
+impl<'clipboard> Clear<'clipboard> {
+	pub(crate) fn new(clipboard: &'clipboard mut Clipboard) -> Self {
+		Self { clipboard }
+	}
+
+	pub(crate) fn clear(self) -> Result<(), Error> {
+		self.clipboard.write("")
+	}
+}
