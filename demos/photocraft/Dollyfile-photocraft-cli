DOLLY 7
PACKAGE photocraft-cli
REQUIRES HOST runtime@0
REQUIRES HOST threads@0

# PhotoCraft's headless command line, compiled by Cargo from its pinned sources, offline:
# it converts and inspects images and PSD files, runs its commands and batches, and serves them to
# agents over MCP. Its GPU renderer, a feature, is left out: wgpu has no backend here yet.
FROM /v0.1.5/demos/rust/Dollyfile-rust-build 08eef24c6ba0616729512c37892fd93b06c09c7e5f7740faf487035d56f1322f
REQUIRES TOOL cargo
REQUIRES TOOL cat
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL mkdir
REQUIRES TOOL mv
REQUIRES TOOL cp
REQUIRES TOOL rm

SOURCE /v0.1.5/dist/static/photocraft/sources-00.part 4f86f475ec804f3bff04151abe280a21e0d12ec77895dff130acb5fc8896f075 /tmp/photocraft-sources-00.part
SOURCE /v0.1.5/dist/static/photocraft/sources-01.part fb44d2123d66b8d9dc0f714096b0bda861cf757a0592bf5b39a241d19e49125d /tmp/photocraft-sources-01.part
SOURCE /v0.1.5/dist/static/photocraft/sources-02.part 1fa72404717c7d560ebf537177c1afab5ed8c57de08580415dba523a0d52a662 /tmp/photocraft-sources-02.part
SOURCE /v0.1.5/dist/static/photocraft/sources-03.part 9c7134ae0836ef773167c24ad3630513f885ce5ba4a853d4d152e173876a6f94 /tmp/photocraft-sources-03.part
SLOP cat /tmp/photocraft-sources-00.part /tmp/photocraft-sources-01.part /tmp/photocraft-sources-02.part /tmp/photocraft-sources-03.part | gzip -dc - | tar -xf - -C /
SLOP rm /tmp/photocraft-sources-00.part /tmp/photocraft-sources-01.part /tmp/photocraft-sources-02.part /tmp/photocraft-sources-03.part 
SLOP CWD /tmp/photocraft-sources/photocraft cargo build -j 4 --offline -p photocraft-cli --no-default-features --target-dir /tmp/photocraft-build
SLOP mkdir -p /usr/share/licenses/photocraft /usr/share/dolly/builds
SLOP mv /tmp/photocraft-build/debug/photocraft-cli /usr/bin/photocraft-cli
