DOLLY 8
APPLICATION photocraft-photos
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST snapshot@0
REQUIRES HOST gpu@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0
REQUIRES HOST download@0
REQUIRES HOST clipboard@0
REQUIRES HOST sockets@0

# PhotoCraft on the page with Hokusai's Great Wave open; quitting it leaves a shell where
# photocraft opens pictures again and photocraft-cli works on them without a window.
INSTALL /Dollyfile-core 166a616e6fa02fcb50ce0f30f5483b0ce42b418474b1cab6fcf0734fb1bc1b85
INSTALL /Dollyfile-posix 943bc6bf48ff57429ec1e3277886e915298aff2e0df4a389fa775df2232d01c0
INSTALL /Dollyfile-display 73f7656db001d9683469bef6425e779344eef58116465f2c14c2abec17a0d0e8
INSTALL /demos/photocraft/Dollyfile-photocraft 2cffccfdb42d46242bdc49a3519912e18ce692c7dbd7f12f6e8f82a2e19473b0
REQUIRES TOOL photocraft
SLOP mkdir -p /home/dolly/Pictures && cp /usr/share/photocraft/pictures/great-wave.jpg /home/dolly/Pictures/
FILE /home/dolly/Pictures/great-wave.jpg

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/photocraft /home/dolly/Pictures/great-wave.jpg
    printf '\nPhotoCraft has quit. photocraft opens it again; photocraft-cli --help says what it does without a window.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
