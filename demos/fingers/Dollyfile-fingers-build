DOLLY 7
PACKAGE fingers-build
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST audio@0
REQUIRES HOST touch@0

# fingers, an SDL2 program that reads SDL's finger events and nothing of
# Dolly's: SDL2 is linked into it and needed by no one who installs it.
FROM /v0.1.4/Dollyfile-system-tools 9e92bff6994c7f6342c6c2ac38a20c8d47f6adca8e78eebb26a97c2c73c0e8f0
USE /v0.1.4/demos/sdl2/Dollyfile-sdl2 9f7a142f80381ec677e80d1284a54c051a7ad40993bc420dac587c0560626850
REQUIRES HEADER libc
REQUIRES HEADER sdl2
REQUIRES LIB SDL2
REQUIRES TOOL cc
REQUIRES TOOL rm

SOURCE /v0.1.4/dist/static/fingers/fingers.c b5e8e9665911c1563d61d15c7d6231547af4930f599e2d32ff527241164b8ae2 /tmp/fingers/fingers.c
SLOP cc -O1 -I/usr/include/SDL2 /tmp/fingers/fingers.c -o /usr/bin/fingers -lSDL2 -lm
EXPORTS TOOL fingers
FILE /usr/share/man/cat1/fingers.1
    fingers: a figure that one finger moves and two fingers zoom and move, on
    a touchscreen; each finger is marked with its id while it is down. Escape
    ends it.
    
      fingers [WIDTH HEIGHT]
    
    It draws at the terminal's size in pixels, or WIDTH by HEIGHT, and reads
    SDL2's finger events, which Dolly's SDL2 makes of touch@0's records.
COPY /v0.1.4/demos/sdl2/Dollyfile-sdl2 9f7a142f80381ec677e80d1284a54c051a7ad40993bc420dac587c0560626850 /usr/share/licenses/SDL2 /usr/share/licenses/SDL2
SLOP rm -rf /tmp/fingers
