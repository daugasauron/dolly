DOLLY 7
PACKAGE sdl2-mixer
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST audio@0
REQUIRES HOST touch@0

# SDL_mixer from upstream's release archive, unchanged, built by its CMake
# project with the decoders it carries: WAV, AIFF and VOC, Ogg Vorbis
# (stb_vorbis), MP3 (minimp3), FLAC (dr_flac) and MIDI (Timidity, given
# instrument patches). MOD, Opus, WavPack, GME, FluidSynth and the external
# music command need more than it carries and are off. It plays through the
# sdl2 package's audio@0 driver: libSDL2_mixer.a with its header, pkg-config
# file and CMake package, for programs the cc package builds with SDL2.
FROM /v0.1.4/demos/cmake/Dollyfile-cmake-build 226ed8de3ef929eeb776ad270077fac08e7dffe05de46c3ffe408914adf41521
INSTALL /v0.1.4/demos/sdl2/Dollyfile-sdl2 0b63439652d5c58f163fd712a87af52f049f277d072e029e989d11152d4e6ca6
REQUIRES HEADER libc
REQUIRES HEADER sdl2
REQUIRES LIB SDL2
REQUIRES TOOL cc
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/sdl2-mixer/source.tar 1fe1f322d9579a1395fe80732380b691dec80bb060b6ce5481db59ac1b1e57b8 /tmp/sdl2-mixer/source.tar
SLOP tar -xf /tmp/sdl2-mixer/source.tar -C /
SLOP cmake -S /tmp/sdl2-mixer/source -B /tmp/sdl2-mixer/build \
  -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=OFF \
  -DSDL2MIXER_VENDORED=OFF -DSDL2MIXER_DEPS_SHARED=OFF -DSDL2MIXER_SAMPLES=OFF -DSDL2MIXER_CMD=OFF \
  -DSDL2MIXER_MOD=OFF -DSDL2MIXER_OPUS=OFF -DSDL2MIXER_WAVPACK=OFF -DSDL2MIXER_MIDI_FLUIDSYNTH=OFF
SLOP cmake --build /tmp/sdl2-mixer/build
SLOP cmake --install /tmp/sdl2-mixer/build

EXPORTS LIB SDL2_mixer /usr/lib/libSDL2_mixer.a
EXPORTS HEADER sdl2-mixer /usr/include/SDL2/SDL_mixer.h
EXPORTS FOLDER sdl2-mixer-cmake /usr/lib/cmake/SDL2_mixer
FILE /usr/lib/pkgconfig/SDL2_mixer.pc
FILE /usr/share/licenses/SDL2_mixer/LICENSE.txt
SLOP rm -rf /tmp/sdl2-mixer
