DOLLY 8
PACKAGE imgui-x11
REQUIRES HOST runtime@0
REQUIRES HOST sockets@0

# Dear ImGui's SDL2 example as an X client, over the sdl2-x11 package: SDL2
# with upstream's X11 video driver in place of Dolly's, so it draws on the
# server DISPLAY names. ImGui and the example are the imgui package's
# sources, unchanged.
FROM /demos/x11/Dollyfile-x11-build 36d336b3007df32264e38238c807ca96aa03d73016dca9ce6ac466b137815544
USE /demos/sdl2/Dollyfile-sdl2-x11 deb87d8c2e9304535fff33328e245bd09c76fc4a4b8017f01b978983b1631749
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL c++
REQUIRES TOOL mkdir
REQUIRES TOOL cp
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/imgui/source.tar b2e714273ba9e28e383dcfcde11630181c5aff0dbd196c4efe4d99b0b71186f2 /tmp/imgui.tar
SLOP tar -xf /tmp/imgui.tar -C /
SLOP mkdir -p /usr/lib/imgui-x11
SLOP CWD /tmp/imgui/source c++ -O2 -I. -Ibackends -I/usr/include/sdl2-x11/SDL2 \
  imgui.cpp imgui_draw.cpp imgui_tables.cpp imgui_widgets.cpp imgui_demo.cpp \
  backends/imgui_impl_sdl2.cpp backends/imgui_impl_sdlrenderer2.cpp examples/example_sdl2_sdlrenderer2/main.cpp \
  -L/usr/lib/sdl2-x11 -lSDL2 -lXcursor -lXrandr -lXi -lXfixes -lXrender -lXext -lX11 -lxcb -lXau -ldolly-sockets -lm \
  -o /usr/lib/imgui-x11/imgui-x11
FILE /usr/lib/imgui-x11/imgui-x11
# Upstream's example asks for an accelerated renderer; SDL's software one is
# the renderer here, which /usr/bin/imgui-x11 names where the caller names none.
FILE /usr/bin/imgui-x11
    #!/bin/slop
    export SDL_RENDER_DRIVER="${SDL_RENDER_DRIVER:-software}"
    exec /usr/lib/imgui-x11/imgui-x11 "$@"
SLOP mkdir -p /usr/share/licenses/imgui-x11
SLOP cp /usr/share/licenses/sdl2-x11/LICENSE.txt /usr/share/licenses/imgui-x11/SDL2-LICENSE.txt
SLOP cp /usr/share/licenses/imgui/LICENSE.txt /usr/share/licenses/imgui-x11/imgui-LICENSE.txt
SLOP rm -rf /tmp/imgui /tmp/imgui.tar

EXPORTS TOOL imgui-x11
FILE /usr/share/licenses/imgui-x11/SDL2-LICENSE.txt
FILE /usr/share/licenses/imgui-x11/imgui-LICENSE.txt
FOLDER /usr/share/licenses/libXcursor
FOLDER /usr/share/licenses/libXrandr
FOLDER /usr/share/licenses/libXi
FOLDER /usr/share/licenses/libXfixes
FOLDER /usr/share/licenses/libXrender
FOLDER /usr/share/licenses/libXext
FOLDER /usr/share/licenses/libX11
FOLDER /usr/share/licenses/libxcb
FOLDER /usr/share/licenses/libXau
FILE /usr/share/man/cat1/imgui-x11.1
    imgui-x11: Dear ImGui's demo window (upstream's example_sdl2_sdlrenderer2)
    as an X client. Run it where DISPLAY names an X server.
