DOLLY 7
PACKAGE sdl2
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST audio@0
REQUIRES HOST touch@0

FROM /v0.1.4/demos/cmake/Dollyfile-cmake-build ba362c5a4c3d4b5716e89f9e3cbec8b267598f98f7328f8a4fdff48d16263adb
INSTALL /v0.1.4/Dollyfile-libdolly-audio 50ba4d674119a046f0711a81dab6280b3d05273a2646cf271f76c74de103c53d
INSTALL /v0.1.4/Dollyfile-libdolly-touch 7695131d1c4e578bf3dd825048a0df6c69f377dbbbdb0aabc6c4cb8f16d12f0f
REQUIRES HEADER libc
REQUIRES HEADER audio
REQUIRES HEADER display
REQUIRES HEADER input
REQUIRES HEADER touch
REQUIRES TOOL cc
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL tar
REQUIRES TOOL rm

SOURCE /v0.1.4/dist/static/sdl2/source.tar fcd2ae74c5a7324eacd403d8cd4d719092268df8b470e3e552df5aebf54f3ce0 /tmp/sdl2/source.tar
SLOP tar -xf /tmp/sdl2/source.tar -C /
SLOP cmake -S /tmp/sdl2/source -B /tmp/sdl2/build \
  -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS_RELEASE=-O1 \
  -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TEST=OFF -DSDL_TESTS=OFF \
  -DSDL_HAPTIC=OFF -DSDL_SENSOR=OFF \
  -DSDL_OSS=OFF -DSDL_ALSA=OFF -DSDL_JACK=OFF -DSDL_ESD=OFF -DSDL_PIPEWIRE=OFF -DSDL_PULSEAUDIO=OFF \
  -DSDL_ARTS=OFF -DSDL_NAS=OFF -DSDL_SNDIO=OFF -DSDL_LIBSAMPLERATE=OFF \
  -DSDL_THREADS=OFF -DSDL_LOADSO=OFF -DSDL_POWER=OFF -DSDL_HIDAPI=OFF \
  -DSDL_ASSEMBLY=OFF -DSDL_GCC_ATOMICS=ON -DSDL_SYSTEM_ICONV=OFF \
  -DSDL_OPENGL=OFF -DSDL_OPENGLES=OFF -DSDL_VULKAN=OFF -DSDL_RENDER_METAL=OFF
SLOP cmake --build /tmp/sdl2/build
SLOP cmake --install /tmp/sdl2/build

# The joystick subsystem is SDL's dummy driver, which finds no game controllers.
# Audio plays through audio@0 (SDL_dollyaudio.c): SDL starts no threads here,
# so the video driver's event pump runs the application's callback.
EXPORTS HEADER sdl2 /usr/include/SDL2
EXPORTS LIB SDL2 /usr/lib/libSDL2.a
# SDL2Config.cmake names both libraries.
EXPORTS LIB SDL2main /usr/lib/libSDL2main.a
EXPORTS FOLDER sdl2-cmake /usr/lib/cmake/SDL2
# SDL_ttf's and SDL_image's pkg-config files require it.
FILE /usr/lib/pkgconfig/sdl2.pc
FILE /usr/share/licenses/SDL2/LICENSE.txt
SLOP rm -rf /tmp/sdl2
