DOLLY 6
PACKAGE sdl2
REQUIRES HOST runtime@0
REQUIRES HOST display@0

FROM https://daugasauron.com/demos/cmake/Dollyfile-cmake-build 2b9dba05f9212db81e349aff9cd03ba03315e6a6a7dded756c9329472854d09f
REQUIRES HEADER libc
REQUIRES HEADER display
REQUIRES TOOL cc
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL tar
REQUIRES TOOL rm

SOURCE https://daugasauron.com/dist/static/sdl2/source.tar f74539a9e7f3f83e164ea820b1a6eebef3595a4b6f6b67d4dbfbd3dc4bf0ac12 /tmp/sdl2/source.tar
SLOP tar -xf /tmp/sdl2/source.tar -C /
SLOP cmake -S /tmp/sdl2/source -B /tmp/sdl2/build \
  -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS_RELEASE=-O1 \
  -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TEST=OFF -DSDL_TESTS=OFF \
  -DSDL_AUDIO=OFF -DSDL_JOYSTICK=OFF -DSDL_HAPTIC=OFF -DSDL_SENSOR=OFF \
  -DSDL_THREADS=OFF -DSDL_LOADSO=OFF -DSDL_POWER=OFF -DSDL_HIDAPI=OFF \
  -DSDL_ASSEMBLY=OFF -DSDL_GCC_ATOMICS=ON -DSDL_SYSTEM_ICONV=OFF \
  -DSDL_OPENGL=OFF -DSDL_OPENGLES=OFF -DSDL_VULKAN=OFF -DSDL_RENDER_METAL=OFF
SLOP cmake --build /tmp/sdl2/build
SLOP cmake --install /tmp/sdl2/build

EXPORTS HEADER sdl2 /usr/include/SDL2
EXPORTS LIB SDL2 /usr/lib/libSDL2.a
# SDL2Config.cmake names both libraries.
EXPORTS LIB SDL2main /usr/lib/libSDL2main.a
EXPORTS FOLDER sdl2-cmake /usr/lib/cmake/SDL2
FILE /usr/share/licenses/SDL2/LICENSE.txt
SLOP rm -rf /tmp/sdl2
