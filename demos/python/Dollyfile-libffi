SOURCE /v0.1.3/dist/static/python/libffi.tar f1edc3a00490ab6d673adb1202b0d779fdbff33bd28ab8382e39847e64109bce /tmp/libffi.tar
SLOP tar \
  -xf /tmp/libffi.tar \
  -C /

