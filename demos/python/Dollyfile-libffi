FILE /tmp/libffi/Makefile
    .RECIPEPREFIX := >
    CC := cc
    AR := ar
    ROOT := /usr/src/libffi
    CFLAGS := -O1 -std=c17 -DHAVE_CONFIG_H -I$(ROOT) -I$(ROOT)/include -I$(ROOT)/src
    NAMES := prep_cif types raw_api java_raw_api tramp dolly
    OBJECTS := $(addprefix /tmp/libffi/,$(addsuffix .o,$(NAMES)))
    all: /usr/lib/libffi.a
    /tmp/libffi/%.o: $(ROOT)/src/%.c
    >$(CC) $(CFLAGS) -c $< -o $@
    /usr/lib/libffi.a: $(OBJECTS)
    >$(AR) rcs $@ $^
SLOP make \
