REQUIRES TOOL python

SLOP python -c 'import numpy, pandas, matplotlib.pyplot, seaborn, jinja2, openpyxl, tabulate'
# The font list Matplotlib writes on its first import, which takes 6 s, kept
# for every session.
FOLDER /home/dolly/.matplotlib

FILE /etc/dolly/init.slop
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) echo "Dolly: $HOME/.dollyrc exited with status $status; continuing." >&2 ;;
      esac
    fi
    /bin/foreground -i /bin/slop
    echo
    echo 'Dolly: image entry exited; entering the recovery Slop shell.'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    echo 'DOLLY: Python 3.14 with NumPy, pandas, Matplotlib and seaborn, in this tab.'
    echo 'python3 runs a script; savefig writes a figure to a file, download FILE saves it.'
    echo 'pip install builds what else a script needs; amy list shows the packages.'
    echo

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
