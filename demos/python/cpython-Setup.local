# Serial process-shaped command invocation over Dolly's stable spawn/wait ABI.
_dolly_process Modules/dolly_process.o

# Python access to Dolly's brokered HTTP client; _dolly_transport uses it.
_dolly_http Modules/dolly_http.o

# Upstream libffi 3.5.2 has a wasm64 ABI. Dolly supplies its typed indirect
# call backend through process-local dolly-process-0 operations, so _ctypes is
# an ordinary built-in module without Emscripten JavaScript-library imports.
_ctypes _ctypes/_ctypes.c _ctypes/callbacks.c _ctypes/callproc.c _ctypes/stgdict.c _ctypes/cfield.c -lffi -DHAVE_FFI_PREP_CIF_VAR -DHAVE_FFI_PREP_CLOSURE_LOC -DHAVE_FFI_CLOSURE_ALLOC

# The static libraries of the sqlite, bzip2 and xz packages, which the recipe
# USEs. configure runs without them, so this line states the serialize API the
# sqlite package keeps.
_sqlite3 _sqlite/blob.c _sqlite/connection.c _sqlite/cursor.c _sqlite/microprotocols.c _sqlite/module.c _sqlite/prepare_protocol.c _sqlite/row.c _sqlite/statement.c _sqlite/util.c -DPY_SQLITE_HAVE_SERIALIZE -lsqlite3
_bz2 _bz2module.c -lbz2
_lzma _lzmamodule.c -llzma

# CPython's bundled _decimal accelerator is omitted: its portable libmpdec path
# is a pathological cold compile in the embedded compiler, while decimal.py
# already falls back to the upstream-compatible pure-Python implementation.
*disabled*
_decimal
