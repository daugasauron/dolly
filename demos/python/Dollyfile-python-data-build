# its wrap builds it offline, unchanged.
SOURCE /v0.1.4/dist/static/python-data/qhull-8.0.2.tar.gz 8774e9a12c70b0180b95d6b0b563c5aa4bea8d5960c15e18ae3b6d2521d64f8b /tmp/python-data/packagecache/qhull-8.0.2.tgz

# The build tools, for this build alone: the site-packages FOLDER of the
# python package is not repeated, so nothing installed there now is kept.
SLOP pip install --no-index --no-deps --no-compile --find-links /tmp/python-data \
  meson-python cython pyproject-metadata packaging pybind11 setuptools setuptools-scm cppy versioneer

# install NAME VERSION [PIP-OPTION…]: NAME==VERSION from the staged files into
# /opt/python-data/NAME, whatever / holds (--ignore-installed), then into /
# for the libraries built after it.
FILE /tmp/python-data/install
    name="$1" version="$2"
    shift 2
    pip install --no-index --find-links /tmp/python-data --no-build-isolation --no-deps --no-compile \
      --no-cache-dir --ignore-installed --no-warn-script-location --root "/opt/python-data/$name" "$@" \
      "$name==$version" || exit 1
    cp -R "/opt/python-data/$name/." /

SLOP slop /tmp/python-data/install numpy 2.5.4
SLOP slop /tmp/python-data/install tzdata 2026.6
SLOP slop /tmp/python-data/install python-dateutil 4.0.0
SLOP slop /tmp/python-data/install pandas 3.0.5
SLOP slop /tmp/python-data/install packaging 26.3
SLOP slop /tmp/python-data/install pyparsing 3.3.3
SLOP slop /tmp/python-data/install cycler 0.12.1
SLOP slop /tmp/python-data/install fonttools 4.68.0
SLOP slop /tmp/python-data/install kiwisolver 1.5.1
# contourpy's default werror=true fails on what Clang 24 reports in pybind11's
# headers (-Wunused-template).
SLOP slop /tmp/python-data/install contourpy 1.4.0 --config-settings=setup-args=-Dwerror=false
# Pillow's FreeType module links -lfreetype alone, and the freetype package's
# static library needs libpng and zlib, which its freetype2.pc requires: the
# linker takes them from LDFLAGS.
SLOP LDFLAGS='-lpng16 -lz' slop /tmp/python-data/install pillow 13.0.0
# Pillow links libjpeg, whose licence asks for its README beside the program.
SLOP mkdir -p /opt/python-data/pillow/usr/share/licenses/libjpeg
SLOP cp /usr/share/licenses/libjpeg/README /opt/python-data/pillow/usr/share/licenses/libjpeg/README
# Matplotlib's own FreeType, 2.6.1, calls its autofitter through a function
# pointer of another signature (af_dummy_hints_apply takes two parameters, the
# call passes three), which Wasm traps: it links the freetype package's 2.14.3
# instead, statically (prefer_static), with the libpng and zlib that one reads.
# Dolly's compiler links no LTO bitcode: Matplotlib's default b_lto is refused.
SLOP MESON_PACKAGE_CACHE_DIR=/tmp/python-data/packagecache slop /tmp/python-data/install matplotlib 3.10.9 \
  --config-settings=setup-args=-Db_lto=false --config-settings=setup-args=-Dsystem-freetype=true \
  --config-settings=setup-args=-Dprefer_static=true
# Its extensions link FreeType, libpng and Qhull, whose licences its wheel does not carry.
SLOP gzip -dc /tmp/python-data/packagecache/qhull-8.0.2.tgz | tar -xf - -C /tmp/python-data
SLOP mkdir -p /opt/python-data/matplotlib/usr/share/licenses/qhull /opt/python-data/matplotlib/usr/share/licenses/libpng
SLOP cp -R /usr/share/licenses/freetype /opt/python-data/matplotlib/usr/share/licenses/freetype
SLOP cp /usr/share/licenses/libpng/LICENSE /opt/python-data/matplotlib/usr/share/licenses/libpng/LICENSE
SLOP cp /tmp/python-data/qhull-8.0.2/COPYING.txt /opt/python-data/matplotlib/usr/share/licenses/qhull/COPYING.txt
SLOP slop /tmp/python-data/install seaborn 0.13.2
# What pandas reads and writes besides CSV: HTML through Jinja's templates, Excel
# with openpyxl, Markdown with tabulate.
SLOP slop /tmp/python-data/install markupsafe 3.0.3
SLOP slop /tmp/python-data/install jinja2 3.1.6
SLOP slop /tmp/python-data/install et-xmlfile 2.0.0
SLOP slop /tmp/python-data/install openpyxl 3.1.5
SLOP slop /tmp/python-data/install tabulate 0.10.0
SLOP python -c 'import numpy, pandas, seaborn, matplotlib.pyplot as plt; plt.plot([0, 1], [1, 0]); plt.title("Dolly"); plt.savefig("/tmp/python-data/check.png")'

FOLDER /opt/python-data

ENTRY /bin/foreground -i /bin/slop
