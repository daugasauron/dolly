# Pi with a shell, POSIX tools and curl, and no compiler: the README's "Pi with npm",
# whose page installs four device host modules: display, input, download for
# the download tool of Pi's Dolly extension (Janis links its client), and html
# for its ask_user and show_html tools (the html command). The recipe engine
# lets an npm user build an image FROM it (dolly-build).
INSTALL /v0.1.4/Dollyfile-core b72d2302643b3568c0b20f14e41dbd08b36a3aa5e80820ad634a65f4757ac5d4
INSTALL /v0.1.4/Dollyfile-dollyfile 1f04b0af622c71b2e1a1a920e4ed6aca00f7fe8aa0e36dfe65c86843164ed69b
INSTALL /v0.1.4/Dollyfile-posix 38c9be94acbfd9da923370e687f84871aa2504bd10a255434d0ff7f7f70537f3
INSTALL /v0.1.4/Dollyfile-display b8b2424fb5422d01d328e379e1229d03ea830a4e3ba3fb27694620499696b3f8
INSTALL /v0.1.4/Dollyfile-curl a24c19b1bfb7c1129f1d0c861a8988b07270356e41effff81144cf89d01f2d2f
INSTALL /v0.1.4/demos/pi/Dollyfile-pi-dolly f5fe80af510ab68b3b989d6e947e5be8f114a23f5e261d5a3717f104f33bda2d
REQUIRES TOOL foreground
REQUIRES TOOL printf
REQUIRES TOOL pi

FILE /etc/dolly/init.slop
    /bin/foreground -i /usr/bin/pi
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
