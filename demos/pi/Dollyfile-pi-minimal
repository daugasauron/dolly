INSTALL /v0.1.4/demos/pi/Dollyfile-pi-dolly b4f85bfaaa79b97aca067583f520a359ca8082f3eff99650ae37d0f94806e40c
REQUIRES TOOL foreground
REQUIRES TOOL printf
REQUIRES TOOL pi

FILE /etc/dolly/init.slop
