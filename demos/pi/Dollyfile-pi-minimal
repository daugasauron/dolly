# Pi with a shell, POSIX tools and curl, and no compiler: the README's "Pi with npm",
# whose page installs four device host modules: display, input, download for
# the download tool of Pi's Dolly extension (Janis links its client), and html
# for its ask_user and show_html tools (the html command). The recipe engine
# lets an npm user build an image FROM it (dolly-build).
INSTALL /v0.1.4/Dollyfile-core d9a6ded58be5760a37c2963b858027b56905685eb4a85a26e861af10183f791d
INSTALL /v0.1.4/Dollyfile-dollyfile 69f3aff9a072190ae39aed0839f142fa57dd45b582f61642a276948302889d7b
INSTALL /v0.1.4/Dollyfile-posix 1fd6e356d27b694e97bdacc7b7211a77fa0d6fd97c3c9e9ace44f647de8fd6d1
INSTALL /v0.1.4/Dollyfile-display 1d674695fea46322becc1f53250ec4cb44159bf29be3aea86b3cc4e9b55f8b87
INSTALL /v0.1.4/Dollyfile-curl dc5bdc1baaf5131b6943ad4f3c31e6d37120c4e1bf68c2f8191e3f359dea0158
INSTALL /v0.1.4/demos/pi/Dollyfile-pi-dolly cf4a1be77161a41f21f79c62a310bd9150c4818c861a929cc654dbc3e4594877
REQUIRES TOOL foreground
REQUIRES TOOL printf
REQUIRES TOOL pi

FILE /etc/dolly/init.slop
    cd /workspace
    /bin/foreground -i /usr/bin/pi
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
