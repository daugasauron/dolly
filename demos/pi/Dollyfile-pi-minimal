# Pi with a shell, POSIX tools and curl, and no compiler: the README's "Pi with npm",
# whose page installs four device host modules: display, input, download for
# the download tool of Pi's Dolly extension (Janis links its client), and html
# for its ask_user and show_html tools (the html command). The recipe engine
# lets an npm user build an image FROM it (dolly-build).
INSTALL /v0.1.4/Dollyfile-core b1a4ab4ae54420f12cd6f410dfedfe5eb6dbfef361f8b5baf4108bc379e41e75
INSTALL /v0.1.4/Dollyfile-dollyfile e4c928d99da31ddd16c8c285a3a3e104cd74d5094f94ca7c3db35bfaaf956c7d
INSTALL /v0.1.4/Dollyfile-posix 047a8933732c6ea8053dfb41b98813055157e20a7e3ea9f97a1cf9a51c5439d0
INSTALL /v0.1.4/Dollyfile-display cee9e8aa8510dc548e054c6b4437047c997d828cf7d1d4a08ad8e0216fa1497f
INSTALL /v0.1.4/Dollyfile-curl 0b359fe54713f7b735702be014933245b3aea43460ad99aba9efc020a6aaaec3
INSTALL /v0.1.4/demos/pi/Dollyfile-pi-dolly 2c7c33d4342e06b88a52b3d49557c5088752ffa712929032ba091b58c50bfbe2
REQUIRES TOOL foreground
REQUIRES TOOL printf
REQUIRES TOOL pi

FILE /etc/dolly/init.slop
    cd /workspace
    /bin/foreground -i /usr/bin/pi
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
