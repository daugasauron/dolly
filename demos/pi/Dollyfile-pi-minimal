# Pi with a shell, POSIX tools and curl, and no compiler: the README's "Pi with npm",
# whose page installs three device host modules: display, input, and download for
# the download tool of Pi's Dolly extension (Janis links its client).
INSTALL /v0.1.4/Dollyfile-core dbeb018f3e39279e9554b4a0d0afa025f8f43c9dc17a11c6fce9eba530c1c019
INSTALL /v0.1.4/Dollyfile-posix 379b5b82a150d330f6e4d6aa402d853faf37bd421c45a5ef15b396d551351484
INSTALL /v0.1.4/Dollyfile-display cca69b2ccfa2cf09502730f3679bc3babc377aaafd27ec4bac3c01efe657c85c
INSTALL /v0.1.4/Dollyfile-curl f0631c76f683fac00061f511c51afdbc64e07bfe37db5f77c8a6acfaf1c0345e
INSTALL /v0.1.4/demos/pi/Dollyfile-pi-dolly 06d6a277c4dd3d86e09ef070ac91d6ed5797e6bbda25aa102465dbb63c1b1ff6
REQUIRES TOOL foreground
REQUIRES TOOL printf
REQUIRES TOOL pi

FILE /etc/dolly/init.slop
    cd /workspace
    /bin/foreground -i /usr/bin/pi
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
