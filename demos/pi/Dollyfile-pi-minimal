# Pi with a shell, POSIX tools and curl, and no compiler: the README's "Pi with npm",
# whose page installs three device host modules: display, input, and download for
# the download tool of Pi's Dolly extension (Janis links its client).
INSTALL /v0.1.4/Dollyfile-core d4c3df8ec605c6cd03ea679c90f0622d966fda1ac0105846d29a654fb7098e66
INSTALL /v0.1.4/Dollyfile-posix dc9f71ebff9d1ad1a25d479b50672d80d274f84fba4247afc15b42be407bbb09
INSTALL /v0.1.4/Dollyfile-display 2ae61a72bcb7e656a73fb01dc6449136f1bbf7ac14db837e6815f073ed372abc
INSTALL /v0.1.4/Dollyfile-curl bf57f4839dae640ba9fc181b04c85ce0cc7c2ab2c39a11df19e1c7bb71183540
INSTALL /v0.1.4/demos/pi/Dollyfile-pi-dolly 1960b6b078077f97bec38fa26495524ba9497600b3c9c175d30284e329c3b101
REQUIRES TOOL foreground
REQUIRES TOOL printf
REQUIRES TOOL pi

FILE /etc/dolly/init.slop
    cd /workspace
    /bin/foreground -i /usr/bin/pi
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
