FILE /home/dolly/.pi/agent/skills/explore-data/profile.py
    import sys
    import pandas as pd
    
    def load(path):
        if path.endswith((".xlsx", ".xls")):
            return pd.read_excel(path)
        return pd.read_csv(path, sep=None, engine="python")
    
    def with_dates(table):
        for name in table.select_dtypes(["str", "object"]):
            parsed = pd.to_datetime(table[name], errors="coerce", format="mixed")
            if parsed.notna().all():
                table[name] = parsed
        return table
    
    for path in sys.argv[1:]:
        table = with_dates(load(path))
        print(f"{path}: {len(table)} rows, {table.shape[1]} columns, {table.duplicated().sum()} duplicate rows")
        for name, column in table.items():
            values = column.dropna()
            ordered = column.dtype.kind in "iufM" and len(values)
            span = f"{values.min()} to {values.max()}" if ordered else ", ".join(map(str, values.unique()[:5]))
            print(f"  {name}: {column.dtype}, {column.isna().sum()} missing, {column.nunique()} distinct; {span}")
        numeric = table.select_dtypes("number")
        if not numeric.empty:
            print(numeric.describe().round(2).to_string())

