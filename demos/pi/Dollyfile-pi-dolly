    #!/bin/slop
    # pi-key VARIABLE [ARGUMENT...]: starts pi with an API key in VARIABLE, the
    # environment variable Pi reads for a provider, read without showing it.
    case "$1" in
      [A-Z]*_KEY|[A-Z]*_TOKEN) ;;
      *) printf 'usage: pi-key VARIABLE [ARGUMENT...], such as pi-key ANTHROPIC_API_KEY\n' >&2; exit 2 ;;
    esac
    name=$1
    shift
    secretenv "$name" "$name (not shown): " pi "$@"
EXPORTS TOOL pi-key
FILE /usr/share/man/cat1/pi-key.1
    pi-key VARIABLE [ARGUMENT...]: reads an API key without showing it and starts
    pi with the arguments and the key in VARIABLE, the environment variable Pi
    reads for the provider, in that one process: ANTHROPIC_API_KEY,
    OPENROUTER_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, the list in
    $PI_PACKAGE_DIR/docs/providers.md. Pi's own /login shows a key as it is typed.
      pi-key OPENROUTER_API_KEY
