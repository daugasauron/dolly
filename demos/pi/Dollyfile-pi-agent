REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST download@0
REQUIRES HOST http@0
REQUIRES HOST nena@0
REQUIRES HOST packages@0
REQUIRES HOST snapshot@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0

FROM /v0.1.4/demos/pi/Dollyfile-pi-runtime 8b7ebf54747755e8defc98a815ec65860dd83938b9f257246bdb6f9653e516cf
INSTALL /v0.1.4/Dollyfile-amy a71c461d0ec2a8be4f3cdf85f17ced7334a175de5a42c5fa8521b0a28268e397
# nena enables the host modules a package needs beyond these, as in default.
INSTALL /v0.1.4/Dollyfile-nena af6011f6b2da19616bd61fd049540295623fc32a2d787d00d8e0c88b727a6ff6
REQUIRES TOOL foreground
REQUIRES TOOL test
REQUIRES TOOL printf
REQUIRES TOOL pi
# The platform's documents, for the agent: /usr/share/doc/dolly.
INSTALL /v0.1.4/Dollyfile-dolly-docs da58ddfdb3956f439c7ee72b354ec1fefef4a78f0ee6485471e8435b1aa38b12

FILE /etc/dolly/init.slop
    cd /workspace
    if test -f "$HOME/.dollyrc"; then
      /bin/foreground /bin/slop -e "$HOME/.dollyrc"
      status=$?
      case "$status" in
        0|130) ;;
        *) printf 'Dolly: %s exited with status %s; continuing.\n' "$HOME/.dollyrc" "$status" >&2 ;;
      esac
    fi
    for attempt in 1 2 3; do
      /bin/foreground -i /usr/bin/pi
      status=$?
      case "$status" in 0|130) break ;; esac
      if test "$attempt" -lt 3; then
        printf '\nDolly: restarting Pi after unexpected status %s (%s/2).\n' "$status" "$attempt"
      fi
    done
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

FILE /home/dolly/.dollyrc
    printf '\033[33mDOLLY / PI\033[0m\n'
    printf 'Pi and every command run inside the browser Wasm sandbox.\n'
    printf 'Try: ask Pi about /workspace | ! ls | ! git status | /help\n\n'

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
