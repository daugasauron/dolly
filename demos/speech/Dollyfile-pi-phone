EXPORTS FILE pi-menu /etc/dolly/pi.menu
FILE /home/dolly/.pi/agent/extensions/phone-menu.js

# voice runs Pi above its one button, Menu, and types into Pi's terminal;
# phone-menu.js, Pi's extension, shows the menu and tells voice what it needs.
FILE /etc/dolly/init.slop
    for attempt in 1 2 3; do
      /bin/foreground -i /usr/bin/voice /etc/dolly/pi.menu -- /usr/bin/pi
      status=$?
      case "$status" in 0|130) break ;; esac
    done
    printf '\nDolly: Pi has ended; this is the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
