# voice runs Pi above its buttons and types into Pi's terminal.
FILE /etc/dolly/init.slop
    cd /workspace
    for attempt in 1 2 3; do
      /bin/foreground -i /usr/bin/voice /etc/dolly/pi.menu -- /usr/bin/pi
      status=$?
      case "$status" in 0|130) break ;; esac
    done
    printf '\nDolly: Pi has ended; this is the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
