REQUIRES TOOL foreground
REQUIRES TOOL pi
INSTALL /v0.1.3/demos/speech/Dollyfile-voice 3016f972d4f2f071de9bfbb5709c90d6de0c1c559e6b5141750852d4da2068e9
SOURCE /v0.1.3/dist/static/speech/pi.menu 1ed86c976443a7ae51821afba49e1b7a17cdf07bb40bb68c186a37a28f75349b /etc/dolly/pi.menu
EXPORTS FILE pi-menu /etc/dolly/pi.menu

# voice has the buttons and types; Pi has the terminal.
FILE /etc/dolly/init.slop
    cd /workspace
    /usr/bin/voice /etc/dolly/pi.menu &
    for attempt in 1 2 3; do
      /bin/foreground -i /usr/bin/pi
      status=$?
      case "$status" in 0|130) break ;; esac
    done
    printf '\nDolly: Pi has ended; this is the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
