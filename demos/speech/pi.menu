# The buttons voice shows below Pi. "[NAME] caption" begins a page and
# "LABEL = TEXT" is a button that types TEXT: \r Enter, \e Escape, \t Tab,
# \xHH a byte, \w a wait of 0.4 s. After the text, one of
#   :speak       listen, then type what was said
#   :page NAME   show another page

# Menu's key is F12, which phone-menu.js (a Pi extension) takes for itself:
# the menu is Pi's, and it shows the keys page when it opens one of Pi's lists.
[main] Menu: speak, send, models, thinking and all of Pi's commands.
Menu = \e[24~

[keys] Pi asks: the arrows and Enter answer it, Done is the Menu again.
↑ = \e[A
↓ = \e[B
Enter = \r
Esc = \e
Done = :page main
