# The buttons voice shows below Pi. "[NAME] caption" begins a page and
# "LABEL = TEXT" is a button that types TEXT: \r Enter, \e Escape, \t Tab,
# \xHH a byte, \w a wait of 0.4 s. After the text, one of
#   :speak       listen, then type what was said
#   :page NAME   show another page

# Speak listens; then Stop types what was heard into Pi's editor, Send types
# it and Enter, Clear drops it. Clear's key is F11 and Menu's F12, which
# phone-menu.js (a Pi extension) takes for itself: Clear empties Pi's editor,
# and the menu is Pi's, which shows the keys page when it opens one of Pi's lists.
[main] Speak to Pi, Send or Clear its editor; Menu holds models and commands.
Speak = :speak
Send = \r
Clear = \e[23~
Menu = \e[24~

[keys] Pi asks: the arrows and Enter answer it; Done goes back.
↑ = \e[A
↓ = \e[B
Enter = \r
Esc = \e
Done = :page main
