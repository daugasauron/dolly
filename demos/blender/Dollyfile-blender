# Blender 5.3.0 from upstream's release archive, built by its own CMake
# project inside Dolly: its window on the page, and `blender -b` with its
# Python (the python package's CPython 3.14) and Cycles on the CPU.
# blender-dolly.patch names Dolly's files to the build and adds their enum
# values; the archive places them (prepare-sources.sh).
# - blender_lite.cmake, upstream's configuration with every optional library
#   off, then Cycles and pugixml (OpenImageIO's static library needs it) on.
# - WITH_GHOST_DOLLY: the window system is ghost/GHOST_SystemDolly, on
#   display@0, input@0 and clipboard@0. WITH_WEBGPU_BACKEND: the GPU module
#   draws through webgpu/ on gpu@0, with glslang (blender-deps) and the
#   spirv-wgsl package; no OpenGL or Vulkan backend.
# - Dolly claims no x86 or ARM: Cycles builds its scalar kernel and its own
#   BVH (Embree off, as in the lite configuration).
# - PYTHON_LINKFLAGS, by default ELF's -Xlinker -export-dynamic: what
#   libpython's built-in modules link, and cc --dolly-cast-emulation, since
#   Blender defines Python methods taking no arguments with one parameter,
#   which CPython calls with two. Such a program loads only extension modules
#   linked so too, and is a host of none without -rdynamic.
# - Brotli for FreeType, which Blender puts on the link line only with its
#   precompiled libraries.
FROM /demos/blender/Dollyfile-blender-deps 370445b077bd8b70ab0cbd93e254b32e13825637d96f5b298944cc2de6101bcc
INSTALL /demos/python/Dollyfile-python b67e91c0799a7d53057d277c506a28ef912f95597caf298b621c263593e9f88b
USE /demos/godot/Dollyfile-spirv-wgsl 066737c06839e6e3f0625903e9d299d3d4f9f5a867d62817b81f672b7685c867
USE /Dollyfile-libdolly-gpu e3d09def5ec1b5113da429c6165bc288646fbd48dda2bdb6471e22e2d8867b3f
USE /Dollyfile-libdolly-display afbf05e4d39eda376f6195f86762fb635a3effb3f2e5414ef1ffa70b298af919
USE /Dollyfile-libdolly-input b49e7c2e3af3ce6f77b321bf959634101ec8fa2fb62fa071e4acad8ecd3d42b3
USE /Dollyfile-libdolly-clipboard 99746a8bd9b9eb136098753ccc526ac94a14540e6d26082ae8748eb6e3fa08a6
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL patch
REQUIRES TOOL python3
REQUIRES TOOL wasm-opt

SOURCE /dist/static/blender/blender.tar.gz 5ddc7af7a05d10d42c7ece68fc620dd160b85eaf1482f70a97cf066a57fe039a /tmp/blender.tar.gz
SLOP gzip -dc /tmp/blender.tar.gz | tar -xf - -C /
SLOP rm /tmp/blender.tar.gz
SLOP CWD /tmp/blender/source patch -p1 -i /tmp/blender/blender-dolly.patch
SLOP time cmake -S /tmp/blender/source -B /tmp/blender/build \
  -C /tmp/blender/source/build_files/cmake/config/blender_lite.cmake \
  -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -DCMAKE_C_FLAGS=-pthread -DCMAKE_CXX_FLAGS=-pthread \
  "-DPYTHON_LINKFLAGS=--dolly-cast-emulation -lffi -llzma -lbz2 -lsqlite3 -lcurl -L/usr/lib/python3.14/embed -lpyexpat -lHacl_HMAC -lHacl_Hash_BLAKE2 -lHacl_Hash_MD5 -lHacl_Hash_SHA1 -lHacl_Hash_SHA2 -lHacl_Hash_SHA3" \
  "-DCMAKE_EXE_LINKER_FLAGS=-lbrotlidec-static -lbrotlicommon-static" \
  -DWITH_HEADLESS=OFF -DWITH_GHOST_DOLLY=ON -DWITH_GHOST_WAYLAND=OFF -DWITH_GHOST_X11=OFF -DWITH_GHOST_SDL=OFF \
  -DWITH_OPENGL_BACKEND=OFF -DWITH_VULKAN_BACKEND=OFF -DWITH_WEBGPU_BACKEND=ON \
  -DWITH_INPUT_NDOF=OFF -DWITH_INPUT_IME=OFF -DWITH_XR_OPENXR=OFF \
  -DWITH_CYCLES=ON -DWITH_TBB=ON -DWITH_PUGIXML=ON -DWITH_ASSERT_RELEASE=OFF \
  -DPYTHON_VERSION=3.14 -DWITH_PYTHON_INSTALL=OFF -DWITH_INSTALL_PORTABLE=OFF \
  -DWITH_LIBS_PRECOMPILED=OFF -DWITH_LINKER_LLD=OFF -DWITH_LINKER_MOLD=OFF -DWITH_COMPILER_CCACHE=OFF \
  -DWITH_DOC_MANPAGE=OFF -DWITH_CPU_CHECK=OFF -DWITH_GTESTS=OFF
SLOP time make -C /tmp/blender/build -j4
SLOP cmake --install /tmp/blender/build

# Its Python, the default scene, and that scene rendered by Cycles to a PNG.
SLOP CWD /tmp test "$(blender -b --python-expr 'import bpy, sys; print("check", bpy.app.version_string, sys.platform, [o.name for o in bpy.data.objects])' | grep check)" = \
  "check 5.3.0 dolly ['Camera', 'Cube', 'Light']"
FILE /tmp/blender/render.py
    import bpy
    scene = bpy.context.scene
    scene.render.engine = "CYCLES"
    scene.cycles.samples = 4
    scene.render.resolution_percentage = 10
    scene.render.filepath = "/tmp/blender/render.png"
    bpy.ops.render.render(write_still=True)
SLOP CWD /tmp time blender -b --python /tmp/blender/render.py
SLOP test -s /tmp/blender/render.png

EXPORTS TOOL blender
FOLDER /usr/share/blender
FOLDER /usr/share/doc/blender
