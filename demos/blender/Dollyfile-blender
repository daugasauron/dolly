# NumPy, which the glTF add-on and others import, as Blender's own releases
# carry it: built as the numpy package's (demos/python) and linked with cc
# --dolly-cast-emulation, into Blender's scripts/modules, which its Python
# searches before python's site-packages, where the numpy package serves python.
USE /demos/tools/Dollyfile-meson e388b70e271dd313d88f9ef1de369f9dde67e1598f77f56bb15fb89eaebb447f
SOURCE /dist/static/python-data/numpy-2.5.4.tar.gz 9a94cf751c9ad8ebaa835bcd3d40dacf8534ad086b88c38029b65123c7999d2a /tmp/numpy/numpy-2.5.4.tar.gz
SOURCE /dist/static/python-data/meson_python-0.22.1-py3-none-any.whl 258fde948cf45aab5df23fcc9e17a9050ee73d4e1002fe6cf86519f61c414778 /tmp/numpy/meson_python-0.22.1-py3-none-any.whl
SOURCE /dist/static/python-data/cython-3.3.1-py3-none-any.whl 61abc7feedd20dac6c4ff7ab3a30e17136a067b242ab9253e2b4a6d9a72c2b61 /tmp/numpy/cython-3.3.1-py3-none-any.whl
SOURCE /dist/static/python-data/pyproject_metadata-0.12.1-py3-none-any.whl f7162d580a96386a8eb096da06215f981f547d1490f03055ef99e323bc2da427 /tmp/numpy/pyproject_metadata-0.12.1-py3-none-any.whl
SOURCE /dist/static/python-data/packaging-26.3-py3-none-any.whl d7193f7c8e4e93f444fde0262bf90af30e16fa0ad0ad44cb553c87339b23cd1c /tmp/numpy/packaging-26.3-py3-none-any.whl
SLOP pip install --no-index --no-deps --no-compile --find-links /tmp/numpy meson-python cython pyproject-metadata packaging
SLOP LDFLAGS=--dolly-cast-emulation pip install --no-index --no-build-isolation --no-deps --no-compile --no-cache-dir \
  --root /tmp/numpy/root /tmp/numpy/numpy-2.5.4.tar.gz
SLOP mkdir -p /usr/share/blender/5.3/scripts/modules
SLOP CWD /tmp/numpy/root/usr/lib/python3.14/site-packages cp -R numpy numpy-2.5.4.dist-info /usr/share/blender/5.3/scripts/modules
SLOP rm -rf /tmp/numpy

SOURCE /dist/static/blender/blender.tar.gz 5e7a49c109b58004f1361b6c88882114e4e0694842d68f3a9270733d42d03571 /tmp/blender.tar.gz
SLOP gzip -dc /tmp/blender.tar.gz | tar -xf - -C /
SLOP rm /tmp/blender.tar.gz
SLOP CWD /tmp/blender/source patch -p1 -i /tmp/blender/blender-dolly.patch
SLOP time cmake -S /tmp/blender/source -B /tmp/blender/build \
  -C /tmp/blender/source/build_files/cmake/config/blender_lite.cmake \
  -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -DCMAKE_C_FLAGS=-pthread -DCMAKE_CXX_FLAGS=-pthread \
  "-DPYTHON_LINKFLAGS=-rdynamic --dolly-cast-emulation -lffi -llzma -lbz2 -lsqlite3 -lcurl -L/usr/lib/python3.14/embed -lpyexpat -lHacl_Hash_BLAKE2 -lHacl_Hash_MD5 -lHacl_Hash_SHA1 -lHacl_Hash_SHA2 -lHacl_Hash_SHA3" \
  "-DCMAKE_EXE_LINKER_FLAGS=-lbrotlidec -lbrotlicommon" \
  -DWITH_HEADLESS=OFF -DWITH_GHOST_DOLLY=ON -DWITH_GHOST_WAYLAND=OFF -DWITH_GHOST_X11=OFF -DWITH_GHOST_SDL=OFF \
  -DWITH_OPENGL_BACKEND=OFF -DWITH_VULKAN_BACKEND=OFF -DWITH_WEBGPU_BACKEND=ON \
  -DWITH_INPUT_NDOF=OFF -DWITH_INPUT_IME=OFF -DWITH_XR_OPENXR=OFF \
  -DWITH_CYCLES=ON -DWITH_TBB=ON -DWITH_PUGIXML=ON -DWITH_ASSERT_RELEASE=OFF \
  -DPYTHON_VERSION=3.14 -DWITH_PYTHON_INSTALL=OFF -DWITH_INSTALL_PORTABLE=OFF \
  -DWITH_LIBS_PRECOMPILED=OFF -DWITH_LINKER_LLD=OFF -DWITH_LINKER_MOLD=OFF -DWITH_COMPILER_CCACHE=OFF \
  -DWITH_DOC_MANPAGE=OFF -DWITH_CPU_CHECK=OFF -DWITH_GTESTS=OFF
SLOP time make -C /tmp/blender/build -j4
SLOP cmake --install /tmp/blender/build

# Its Python with NumPy, the default scene, and that scene rendered by Cycles to a PNG.
SLOP CWD /tmp test "$(blender -b --python-expr 'import bpy, sys, numpy; print("check", bpy.app.version_string, sys.platform, numpy.__version__, [o.name for o in bpy.data.objects])' | grep check)" = \
  "check 5.3.0 dolly 2.5.4 ['Camera', 'Cube', 'Light']"
FILE /tmp/blender/render.py
    import bpy
    scene = bpy.context.scene
    scene.render.engine = "CYCLES"
    scene.cycles.samples = 4
    scene.render.resolution_percentage = 10
    scene.render.filepath = "/tmp/blender/render.png"
    bpy.ops.render.render(write_still=True)
SLOP CWD /tmp time blender -b --python /tmp/blender/render.py
SLOP test -s /tmp/blender/render.png

