# The interpreter links and runs with the options Dollyfile-blender gives
# Blender's link, an hour of compiling before that link, beside the expat
# package, which OpenColorIO links there.
FILE /tmp/embed.c
    #include <Python.h>
    #include <expat.h>
    int main(void) {
      XML_ParserFree(XML_ParserCreate(NULL));
      Py_Initialize();
      int status = PyRun_SimpleString("import sqlite3, hashlib, pyexpat, bz2, lzma, urllib.request");
      Py_Finalize();
      return status != 0;
    }
SLOP cc -pthread /tmp/embed.c -I/usr/include/python3.14 -o /tmp/embed -lpython3.14 --dolly-cast-emulation \
  -lffi -llzma -lbz2 -lsqlite3 -lcurl -L/usr/lib/python3.14/embed -lpyexpat -lHacl_Hash_BLAKE2 \
  -lHacl_Hash_MD5 -lHacl_Hash_SHA1 -lHacl_Hash_SHA2 -lHacl_Hash_SHA3 -lexpat -lz -lm
SLOP /tmp/embed

ENTRY /bin/foreground -i /bin/slop
