DOLLY 7
PACKAGE zsh
REQUIRES HOST runtime@0

# zsh from upstream's release, ported to spawn: Dolly has no fork
# (README.md, zsh-dolly.patch). It is configured outside, as Emacs is
# (prepare-zsh.sh); Dolly compiles every object and links in the modules
# zsh links statically, through Binaryen's cast emulation: zsh calls its
# hooks, builtins and callbacks through pointers of a common type.
FROM /v0.1.5/demos/tools/Dollyfile-tools-build 9f9cfa93f7bc4ddd5fc5cbd9ced4d2100cd41349f9f2b6f75ab9d8e26a57da62
USE /v0.1.5/demos/tmux/Dollyfile-libterminfo d8c41cff39f20a7af7864cc66660a9ee44927b511963b3784b53d11373db1c50
USE /v0.1.5/demos/tools/Dollyfile-binaryen 480e8afc4a00c4024e5ab9d5597c40b621cc58f1a4dad5c2e887d52048e7c74a

REQUIRES HEADER libc
REQUIRES HEADER termcap
REQUIRES LIB    terminfo
REQUIRES TOOL   cat
REQUIRES TOOL   cc
REQUIRES TOOL   cmp
REQUIRES TOOL   cp
REQUIRES TOOL   gzip
REQUIRES TOOL   head
REQUIRES TOOL   ls
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   printenv
REQUIRES TOOL   sleep
REQUIRES TOOL   sort
REQUIRES TOOL   tail
REQUIRES TOOL   tar
REQUIRES TOOL   text-page
REQUIRES TOOL   tr
REQUIRES TOOL   wasm-opt

SOURCE /v0.1.5/dist/static/zsh/zsh.tar.gz 1e03835f23390df4f26923a0f60e94e611d3d659fa97711d8b37a526f856f01d /tmp/zsh.tar.gz
SLOP gzip -dc /tmp/zsh.tar.gz | tar -xf - -C /

FILE /tmp/zsh.mk
    .RECIPEPREFIX := >
    .DELETE_ON_ERROR:
    MAKEFLAGS += -r
    S := /tmp/zsh/Src
    # zsh's objects and the modules configure links in (Src/Makemod and the
    # modules' Makefiles), compiled as its COMPILE rule does, with the GNU
    # extensions zsh turns on for Linux and musl (setresuid, setresgid).
    MAIN := main builtin compat cond context exec glob hashtable hashnameddir hist init input \
      jobs lex linklist loop math mem module options params parse pattern prompt signals \
      signames sort string subst text utils openssh_bsd_setres_id
    MODULES := Builtins/rlimits Builtins/sched Modules/datetime Modules/langinfo \
      Modules/parameter Modules/termcap Modules/zutil Zle/compctl Zle/complete Zle/compcore \
      Zle/compmatch Zle/compresult Zle/complist Zle/computil Zle/zleparameter \
      $(addprefix Zle/,zle_bindings zle_hist zle_keymap zle_main zle_misc zle_move zle_params \
        zle_refresh zle_thingy zle_tricky zle_utils zle_vi zle_word textobjects)
    all: /usr/bin/zsh
    $(S)/%.o: $(S)/%.c
    >cc -c -I$(dir $<) -I$(S) -I$(S)/Zle -DHAVE_CONFIG_H -D_GNU_SOURCE -O2 -o $@ $<
    /usr/bin/zsh: $(addprefix $(S)/,$(addsuffix .o,$(MAIN) $(MODULES)))
    >cc --dolly-cast-emulation $^ -lterminfo -lm -o $@
SLOP make -j4 -f /tmp/zsh.mk

# What a fork did, by spawn: programs, pipelines through builtins and
# programs, command substitution, a function in a pipeline, a subshell that
# keeps its directory, a background job, exec; assignments for one command
# stay out of the shell, and a missing command is a status.
FILE /tmp/zsh-check.zsh
    ls -d /tmp /usr; print "after ls $?"
    print -l c a b | sort | head -n 2
    x=$(print inside); print "subst $x"
    FOO=bar printenv FOO; print "FOO here [$FOO]"
    nosuchcommand 2> /dev/null; print "status $?"
    print to-file > /tmp/zsh-check.txt; cat /tmp/zsh-check.txt
    f() { print "in f $1" }; f arg | tr a-z A-Z
    (cd /usr && pwd); [[ $PWD != /usr ]] && print "outer stays"
    for i in 1 2 3; do print $i; done | tail -n 1
    ls /usr | while read d; do n=$((n + 1)); done; (( n > 0 )) && print "read in the shell"
    sleep 1 & wait; print waited
    zsh -fc 'exec print exec-done'
    zsh -fc 'print $$; exec zsh -fc "print \$\$"' | { read a; read b; [[ $a == $b ]] && print "exec keeps the pid" }
    zsh -fc 'print $$; zsh -fc "print \$\$"' | { read a; read b; [[ $a == $b ]] && print "the last command too" }
    zsh -fc 'exec zsh -fc "exit 3"'; print "exec status $?"
FILE /tmp/zsh-check.expected
    /tmp
    /usr
    after ls 0
    a
    b
    subst inside
    bar
    FOO here []
    status 127
    to-file
    IN F ARG
    /usr
    outer stays
    3
    read in the shell
    waited
    exec-done
    exec keeps the pid
    the last command too
    exec status 3
SLOP zsh -f /tmp/zsh-check.zsh > /tmp/zsh-check.out 2>&1 && cmp /tmp/zsh-check.out /tmp/zsh-check.expected

# The functions zsh looks for in its FPATH: completion, prompts, line editing.
SLOP mkdir -p /usr/share/zsh/5.9.2/functions
SLOP cp /tmp/zsh/Completion/compinit /tmp/zsh/Completion/compaudit /tmp/zsh/Completion/compdump /tmp/zsh/Completion/compinstall /usr/share/zsh/5.9.2/functions/
SLOP for f in /tmp/zsh/Completion/Base/*/* /tmp/zsh/Completion/Unix/*/* /tmp/zsh/Completion/Zsh/*/* /tmp/zsh/Functions/Misc/* /tmp/zsh/Functions/Prompts/* /tmp/zsh/Functions/Zle/*; do cp $f /usr/share/zsh/5.9.2/functions/; done
SLOP zsh -fc 'autoload -Uz compinit && compinit -D && (( ${#_comps} > 1000 ))'

SLOP mkdir -p /usr/share/licenses/zsh
SLOP cp /tmp/zsh/LICENCE /usr/share/licenses/zsh/LICENCE
SLOP text-page /tmp/zsh/Doc/zsh.1
EXPORTS TOOL zsh
EXPORTS FOLDER zsh-functions /usr/share/zsh/5.9.2/functions
FILE /usr/share/licenses/zsh/LICENCE
# zsh links libterminfo statically and carries its licence.
FILE /usr/share/licenses/netbsd-curses/COPYING
FILE /usr/share/man/cat1/zsh.1
