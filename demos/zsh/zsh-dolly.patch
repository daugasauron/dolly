 #include "zsh.mdh"
 #include "exec.pro"
 
+#ifdef __dolly__
+/*
+ * Dolly has no fork or exec: every program starts by posix_spawn from the
+ * shell itself. execute() runs in the shell, its exec
+ * a spawn whose pid is left in spawned and its exits the command's status.
+ * The redirections of a command that would have had a process of its own
+ * are made and undone around the spawn, as for a builtin; shell code that
+ * needs a process of its own runs in a new zsh, which is given what a forked
+ * child has of the shell (spawn_state()).
+ */
+#include <spawn.h>
+
+static pid_t spawned;
+
+static int
+spawn_program(const char *path, char *const *argv, char *const *envp,
+	      int input, int output)
+{
+    posix_spawn_file_actions_t actions;
+    posix_spawnattr_t attributes;
+    sigset_t every, none;
+    pid_t pid;
+    int error, fd;
+
+    /* What a forked child closes before exec is not inherited. */
+    for (fd = 10; fd <= max_zsh_fd; fd++) {
+	int type = fdtable[fd] & FDT_TYPE_MASK;
+	if (fdtable[fd] != FDT_UNUSED &&
+	    (type == FDT_INTERNAL || type == FDT_XTRACE))
+	    fcntl(fd, F_SETFD, FD_CLOEXEC);
+    }
+    posix_spawn_file_actions_init(&actions);
+    if (input != -1)
+	posix_spawn_file_actions_adddup2(&actions, input, 0);
+    if (output != -1)
+	posix_spawn_file_actions_adddup2(&actions, output, 1);
+    /* The child's signals start as entersubsh() leaves them for exec. */
+    sigfillset(&every);
+    sigemptyset(&none);
+    posix_spawnattr_init(&attributes);
+    posix_spawnattr_setflags(&attributes,
+			     POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK);
+    posix_spawnattr_setsigdefault(&attributes, &every);
+    posix_spawnattr_setsigmask(&attributes, &none);
+    error = posix_spawn(&pid, path, &actions, &attributes, argv, envp);
+    posix_spawnattr_destroy(&attributes);
+    posix_spawn_file_actions_destroy(&actions);
+    if (error) {
+	errno = error;
+	return -1;
+    }
+    spawned = pid;
+    return 0;
+}
+
+/* zexecve()'s exec: one that started returns from it at once. */
+#define execve(path, argv, envp) \
+    do { if (spawn_program(path, argv, envp, -1, -1) == 0) return 0; } while (0)
+
+/*
+ * A parameter as typeset -p prints it, a hidden value too, but for the
+ * positional parameters and the special ones that hide their values
+ * (zsh/parameter's).
+ */
+static void
+spawn_parameter(HashNode hn, int printflags)
+{
+    if (strcmp(hn->nam, "argv") &&
+	(hn->flags & (PM_SPECIAL|PM_HIDEVAL)) != (PM_SPECIAL|PM_HIDEVAL))
+	printparamnode(hn, printflags);
+}
+
+/* An option's state as a command, but for those a process has of its own. */
+static void
+spawn_option(HashNode hn, UNUSED(int printflags))
+{
+    int optno = ((Optname) hn)->optno;
+
+    /* A negative number is an alias for the inverse of an option. */
+    if (optno > 0 && optno != INTERACTIVE && optno != LOGINSHELL &&
+	optno != MONITOR && optno != PRIVILEGED && optno != RESTRICTED &&
+	optno != SHINSTDIN && optno != SINGLECOMMAND && optno != USEZLE)
+	printf("%s %s\n", isset(optno) ? "setopt" : "unsetopt", hn->nam);
+}
+
+/*
+ * What a forked child has of the shell, as commands in a file the new zsh
+ * sources and removes before its script (init.c): its parameters, functions
+ * and aliases, as typeset -p, functions and alias -L print them, then its
+ * emulation and options. An `expanded' script was parsed here, aliases and
+ * all: the new zsh parses it with aliases off. Returns the file, or NULL.
+ */
+static char *
+spawn_state(int expanded)
+{
+    static int count;
+    char *path = zhalloc(64);
+    int fd, saved;
+
+    sprintf(path, "/tmp/.zsh-state.%ld.%d", (long) getpid(), ++count);
+    if ((fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_NOCTTY, 0600)) == -1)
+	return NULL;
+    fflush(stdout);
+    saved = dup(1);
+    dup2(fd, 1);
+    close(fd);
+    scanhashtable(paramtab, 1, 0, 0, spawn_parameter,
+		  PRINT_TYPESET | PRINT_INCLUDEVALUE);
+    scanhashtable(shfunctab, 1, 0, DISABLED, shfunctab->printnode, 0);
+    scanhashtable(aliastab, 1, 0, DISABLED, aliastab->printnode, PRINT_LIST);
+    scanhashtable(sufaliastab, 1, 0, DISABLED, sufaliastab->printnode,
+		  PRINT_LIST);
+    printf("emulate %s\n", EMULATION(EMULATE_CSH) ? "csh" :
+	   EMULATION(EMULATE_KSH) ? "ksh" : EMULATION(EMULATE_SH) ? "sh" : "zsh");
+    scanhashtable(optiontab, 1, 0, 0, spawn_option, 0);
+    if (expanded)
+	printf("unsetopt aliases\n");
+    fflush(stdout);
+    dup2(saved, 1);
+    close(saved);
+    return path;
+}
+
+/*
+ * A new zsh for shell code: `script' run with -c, its $0 and positional
+ * parameters the shell's and then `args', `input' and `output' its standard
+ * input and output where not -1; `expanded' if the script was parsed here.
+ * Returns its pid, or -1.
+ */
+
+static pid_t
+spawn_shell(char *script, int expanded, LinkList args, int input, int output)
+{
+    char *self = findcmd("zsh", 1, 0), **argv, **envp, **pp, *state;
+    LinkNode node;
+    /* zsh -f -c script $0, then args or the positional parameters, NULL. */
+    int count = 6 + (args ? countlinknodes(args) : arrlen(pparams));
+    int variables = arrlen(environ);
+
+    expanded = expanded && isset(ALIASESOPT);
+    if (!(state = spawn_state(expanded))) {
+	zerr("cannot write the shell's state: %e", errno);
+	return -1;
+    }
+    if (expanded)
+	script = dyncat("setopt aliases\n", script);
+    envp = (char **) zhalloc((variables + 2) * sizeof(char *));
+    memcpy(envp, environ, variables * sizeof(char *));
+    envp[variables] = dyncat("ZSH_SPAWN_STATE=", state);
+    envp[variables + 1] = NULL;
+
+    argv = pp = (char **) zhalloc(count * sizeof(char *));
+    *pp++ = self ? dupstring(unmeta(self)) : "/usr/bin/zsh";
+    *pp++ = "-f";
+    *pp++ = "-c";
+    *pp++ = dupstring(unmeta(script));
+    *pp++ = dupstring(unmeta(argzero));
+    if (args)
+	for (node = firstnode(args); node; incnode(node))
+	    *pp++ = dupstring(unmeta((char *) getdata(node)));
+    else {
+	char **p;
+	for (p = pparams; *p; p++)
+	    *pp++ = dupstring(unmeta(*p));
+    }
+    *pp = NULL;
+    spawned = 0;
+    if (spawn_program(argv[0], argv, envp, input, output) == -1) {
+	zerr("cannot start %s: %e", argv[0], errno);
+	unlink(state);
+	return -1;
+    }
+    return spawned;
+}
+
+/* The parent's part of execcmd_fork(): the job has the process. */
+static void
+spawn_record(pid_t pid, char *text, int how, struct timeval *bgtime)
+{
+    if (how & Z_ASYNC)
+	lastpid = (zlong) pid;
+    addproc(pid, text, 0, bgtime, -1, -1);
+    pipecleanfilelist(jobtab[thisjob].filelist, 1);
+}
