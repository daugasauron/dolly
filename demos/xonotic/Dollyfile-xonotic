# The player's starting settings: the low effects preset, measured at 31 fps
# against 13 for the normal preset in the software rasterizer. The engine
# rewrites this file with the player's own settings on exit.
FILE /home/dolly/.xonotic/data/config.cfg
    exec effects-low.cfg
    seta vid_soft 1
    seta vid_soft_threads 1
    seta vid_fullscreen 0
    seta vid_width 1024
    seta vid_height 768
    seta cl_allow_uid2name 0
    seta cl_allow_uidtracking 0
FILE /usr/bin/xonotic
    #!/bin/slop
    /usr/bin/xonotic-sdl -xonotic -basedir /usr/share/xonotic +vid_soft 1 "$@"
EXPORTS TOOL xonotic
EXPORTS FOLDER xonotic-data /usr/share/xonotic

FILE /etc/dolly/xonotic.slop
    /bin/foreground /usr/bin/xonotic
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/xonotic.slop
