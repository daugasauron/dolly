DOLLY 8
PACKAGE gmqcc
REQUIRES HOST runtime@0

# gmqcc, the QuakeC compiler Xonotic's game logic is written for, from the
# source of the pinned Xonotic release, compiled as upstream's Makefile does.
FROM /Dollyfile-system 7aac66b2c9e3e6edeb04db08740317411b45cf8caaee5850ada5fab70a67c54d
REQUIRES TOOL c++
REQUIRES TOOL tar

SOURCE /dist/static/xonotic/gmqcc.tar c2519d5c292708aa1628631ddb241aa06c1c8b0238a622429f5754142fde524a /tmp/gmqcc.tar
SLOP tar -xf /tmp/gmqcc.tar -C /
# __DATE__ and __TIME__ are the newest file time of Xonotic 0.8.6's source release, for reproducible builds.
SLOP CWD /tmp/gmqcc SOURCE_DATE_EPOCH=1687230584 slop -c 'for unit in ast code conout fold ftepp intrin ir lexer main opts parser stat utf8 util; do c++ -O3 -std=c++11 -c $unit.cpp -o $unit.o || exit 1; done'
SLOP CWD /tmp/gmqcc c++ ast.o code.o conout.o fold.o ftepp.o intrin.o ir.o lexer.o main.o opts.o parser.o stat.o utf8.o util.o -o /usr/bin/gmqcc

EXPORTS TOOL gmqcc
FILE /usr/share/licenses/gmqcc/LICENSE
FILE /usr/share/man/cat1/gmqcc.1
    gmqcc: the QuakeC compiler of Xonotic 0.8.6, built inside Dolly.
    
      gmqcc -std=gmqcc -o progs.dat progs.src    compiles a QuakeC program
      gmqcc --help                                every option
    
    The xonotic-build image rebuilds Xonotic's game logic with it.
    Upstream: https://github.com/graphitemaster/gmqcc
