DOLLY 7
PACKAGE llama
REQUIRES HOST runtime@0
REQUIRES HOST gpu@0

# dolly-llama, linked on the llama-cpp package: llama.cpp with its WebGPU
# backend, serving the model it is given over stdin and stdout. A model package
# brings the GGUF.
FROM /v0.1.4/Dollyfile-system-tools 1da009342a42fc8b1297513c7c43ba47d2ea58c709afa237a79782232d92defd
USE /v0.1.4/demos/local-llm/Dollyfile-llama-cpp 2d22ca4268721dfca73a4c721f16debebd95790fa908e47a84c66765b54d4731
REQUIRES HEADER llama
REQUIRES LIB llama
REQUIRES LIB llama-common
REQUIRES LIB ggml
REQUIRES LIB ggml-base
REQUIRES LIB ggml-cpu
REQUIRES LIB ggml-webgpu
REQUIRES LIB dolly-webgpu
REQUIRES LIB dolly-gpu
REQUIRES TOOL c++
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/llama/engine.tar 320eac803d1b96305f6422c9d2257e60ea539e27aec0c7ce670721d77c705ed1 /tmp/llm-engine.tar
SLOP tar -xf /tmp/llm-engine.tar -C /
SLOP c++ -std=c++20 -O1 -I/usr/include/dolly-llm /tmp/dolly-llama/main.cpp \
  -L/usr/lib/dolly-llm -lllama-common -lllama -lggml -lggml-webgpu -ldolly-webgpu -lggml-cpu -lggml-base -ldolly-gpu -lm -o /usr/bin/dolly-llama
# The program carries llama.cpp's and Dawn's headers' licences.
SLOP mkdir -p /usr/share/licenses/dolly-llama
SLOP cp -R /usr/share/licenses/dolly-llm/. /usr/share/licenses/dolly-llama
SLOP rm -rf /tmp/dolly-llama /tmp/llm-engine.tar

EXPORTS TOOL dolly-llama
FOLDER /usr/share/licenses/dolly-llama
FILE /usr/share/man/cat1/dolly-llama.1
    dolly-llama: llama.cpp on WebGPU, serving a GGUF model to Pi (provider webgpu).
    
      dolly-llama MODEL.gguf    serves the model
      dolly-llama --check       prints the shader kind this adapter gets
    
    Each line of standard input is a request as llama-server takes it at
    /v1/chat/completions; standard output is the event stream it would answer
    with, and a field it does not implement is an error naming it. It uses the
    adapter gpu@0 grants: with shader-f16 llama.cpp's WGSL as upstream wrote it,
    without it the f16 shader code widened to f32. The chat template, tool
    calls, stop tokens and sampling defaults are the GGUF's own. Pi's /model,
    /thinking and /local choose and tune the model.
