DOLLY 8
PACKAGE pi-llm
REQUIRES HOST runtime@0
REQUIRES HOST download@0
REQUIRES HOST gpu@0
REQUIRES HOST html@0
REQUIRES HOST http@0
REQUIRES HOST threads@0
REQUIRES HOST upload@0

# Pi with its provider for the models dolly-llama runs in the tab on gpu@0:
# /local installs and switches models, and Pi's /model chooses among them. It
# installs no model and chooses none: pi-local bundles Qwen3.5-2B and chooses it.
FROM /Dollyfile-system-build 0c72e09eba84571d4f8634cf6e7507eb1be1b9b8aa1fae61f6b0ec884b26b6fb
INSTALL /demos/pi/Dollyfile-pi-dolly 2ba6d10124edde0781ba6b4b59f32ad72d676dec47bd2e3749c0f604bf70384c
INSTALL /demos/local-llm/Dollyfile-llama c7a231b757aa831f183b831b585ad01a3f560cff272734891de434a8e3815cf5

REQUIRES TOOL tar
REQUIRES TOOL dolly-llama

SOURCE /dist/static/llama/provider.tar 68b75b1b327c2c3000ef964e4a1f00ec7fb4536abae00baa7622d6734aaecce2 /tmp/llm-provider.tar
SLOP tar -xf /tmp/llm-provider.tar -C /

EXPORTS FOLDER local-llm /usr/lib/dolly-llm
EXPORTS FILE local-model-provider /home/dolly/.pi/agent/extensions/local-model-provider.js
# /local lists the release's models by their descriptions, each the same file
# as its model package's.
FILE /usr/share/dolly/llm/lfm2.5.json
FILE /usr/share/dolly/llm/minicpm5-2b.json
FILE /usr/share/dolly/llm/qwen3.5-2b.json
FILE /usr/share/dolly/llm/qwen3.5-4b.json
