DOLLY 7
PACKAGE llama-cpp
REQUIRES HOST runtime@0
REQUIRES HOST gpu@0

# llama.cpp from upstream's source, unchanged, built with Dolly's CMakeLists.txt
# in place of upstream's (README.md): llama, its common library (chat templates,
# tool-call parsers, samplers) and ggml with its CPU and WebGPU backends, with
# webgpu.cpp, the WebGPU C API that backend calls, over gpu@0. For programs the
# cc package builds: they link the archives in /usr/lib/dolly-llm with
# -ldolly-gpu, which the package brings, and need gpu@0.
FROM /v0.1.4/demos/cmake/Dollyfile-cmake-build 51dbf8a61e3fe58c515d8c130a99a690b9c34840d975b7f2617c5a73240c8d7d
INSTALL /v0.1.4/Dollyfile-libdolly-gpu 25092110c8431e747d1c1bbf83a96e8855b6d2b40ca8cea68df8a750f06858db
REQUIRES HEADER gpu
REQUIRES LIB dolly-gpu
REQUIRES TOOL ar
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL cmake
REQUIRES TOOL make
REQUIRES TOOL tar
REQUIRES TOOL rm

SOURCE /v0.1.4/dist/static/llama/source.tar b008360243cca6d71ce6364c0bd8fe60dfcb9ed7dc5202e08efeb9bc9a72d78e /tmp/llama-source.tar
SLOP tar -xf /tmp/llama-source.tar -C /
SLOP cmake -S /tmp/llama -B /tmp/llama/build \
  -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS_RELEASE=-O1 -DCMAKE_CXX_FLAGS_RELEASE=-O1 \
  -DCMAKE_C_COMPILER=cc -DCMAKE_CXX_COMPILER=c++ -DCMAKE_INSTALL_PREFIX=/usr
SLOP cmake --build /tmp/llama/build --target llama ggml-webgpu llama-common
SLOP cmake --install /tmp/llama/build
SLOP c++ -std=c++20 -O1 -I/usr/include/dolly-llm -c /tmp/llama/webgpu.cpp -o /tmp/llama/webgpu.o
SLOP ar rcs /usr/lib/dolly-llm/libdolly-webgpu.a /tmp/llama/webgpu.o
SLOP rm -rf /tmp/llama /tmp/llama-source.tar

EXPORTS LIB llama /usr/lib/dolly-llm/libllama.a
EXPORTS LIB llama-common /usr/lib/dolly-llm/libllama-common.a
EXPORTS LIB ggml /usr/lib/dolly-llm/libggml.a
EXPORTS LIB ggml-base /usr/lib/dolly-llm/libggml-base.a
EXPORTS LIB ggml-cpu /usr/lib/dolly-llm/libggml-cpu.a
EXPORTS LIB ggml-webgpu /usr/lib/dolly-llm/libggml-webgpu.a
EXPORTS LIB dolly-webgpu /usr/lib/dolly-llm/libdolly-webgpu.a
EXPORTS HEADER llama /usr/include/dolly-llm
EXPORTS FOLDER llama-licenses /usr/share/licenses/dolly-llm
