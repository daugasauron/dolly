DOLLY 6
TOOLCHAIN local-llm-build
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST download@0
REQUIRES HOST gpu@0
REQUIRES HOST http@0
REQUIRES HOST upload@0

FROM https://daugasauron.com/demos/local-llm/Dollyfile-llama-build 900a2607c6de1cca4fbeafa0775069ce22f61b6d6784ad67bda94a65833b2b2d
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL tar
REQUIRES HEADER llama
REQUIRES LIB llama
REQUIRES LIB llama-common
REQUIRES LIB ggml
REQUIRES LIB ggml-base
REQUIRES LIB ggml-cpu
REQUIRES LIB ggml-webgpu

SOURCE https://daugasauron.com/dist/static/llama/engine.tar 341e2c92f126edd1f8ba58da8eb89ffe34da55baea8fff320b75a2224cfdf525 /tmp/llm-engine.tar
SLOP tar -xf /tmp/llm-engine.tar -C /
SLOP c++ -std=c++20 -O1 -I/usr/include/dolly-llm -I/usr/src/dolly-llm/include \
  /usr/src/dolly-llm/main.cpp /usr/src/dolly-llm/webgpu.cpp \
  -L/usr/lib/dolly-llm -lllama-common -lllama -lggml -lggml-webgpu -lggml-cpu -lggml-base -ldolly-gpu -lm -o /usr/bin/dolly-llama

EXPORTS TOOL dolly-llama
EXPORTS FOLDER local-llm-sources /usr/src/dolly-llm

ENTRY /bin/foreground -i /bin/slop
