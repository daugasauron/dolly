DOLLY 7
PACKAGE zig-llvm
REQUIRES HOST runtime@0
REQUIRES HOST http@0
# What Zig builds runs threads unless it is single-threaded: zig build's runner.
REQUIRES HOST threads@0

# Zig 0.16 with its LLVM backend: zig-llvm-build's objects linked, as
# upstream's CMake build links zig2, with Zig's C++ glue (zigcpp) and LLVM,
# Clang and LLD 21, which the build uses and installers do not get.
FROM /v0.1.4/demos/zig/Dollyfile-zig-llvm-build 3140734724ecdd75d4ca146ea77a2ef0bc1c3d75be18615b22bd30b4fc4de725
USE /v0.1.4/demos/llvm/Dollyfile-llvm21 4663a3d2b00f189dca6d5c8fc16a23cb84a370a065bfaab46ca43a38550eef24
# Zig links a program for this target with cc (config/zig-0.16.0-dolly-native.patch).
INSTALL /v0.1.4/Dollyfile-cc 106380f3bc697b56a23cbbf9290de059a8e76d15da8615b65c8398dfd3c7872d
REQUIRES TOOL   c++
REQUIRES TOOL   ar

# zigcpp, with upstream's flags (CMakeLists.txt, "zigcpp target") and the
# endian.h that llvm21's build includes for LLVM's headers.
SLOP CWD /usr/lib/zig-llvm-build slop -c 'for unit in zig_llvm zig_llvm-ar zig_clang_driver zig_clang_cc1_main zig_clang_cc1as_main; do \
  c++ -c -O2 -std=c++17 -fno-exceptions -fno-rtti -fvisibility-inlines-hidden \
  -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS -D_GNU_SOURCE \
  -DLLVM_BUILD_STATIC -DCLANG_BUILD_STATIC -include endian.h -I /usr/lib/llvm21/include $unit.cpp -o $unit.o; done'
SLOP CWD /usr/lib/zig-llvm-build ar rcs libzigcpp.a zig_llvm.o zig_llvm-ar.o zig_clang_driver.o zig_clang_cc1_main.o zig_clang_cc1as_main.o
# Every LLVM library: wasm-ld takes archives in any order. The stack is what
# upstream gives the compiler it ships (46 MB, build.zig) rounded up; with
# 58 MB of data that is 128 MB of initial memory.
SLOP CWD /usr/lib/zig-llvm-build slop -c 'c++ -o /usr/bin/zig -Wl,-z,stack-size=50331648 -Wl,--initial-memory=134217728 zig2.o compiler_rt.o libzigcpp.a -L /usr/lib/llvm21/lib \
  -lclangFrontendTool -lclangCodeGen -lclangFrontend -lclangDriver -lclangSerialization -lclangSema -lclangStaticAnalyzerFrontend -lclangStaticAnalyzerCheckers -lclangStaticAnalyzerCore -lclangAnalysis -lclangASTMatchers -lclangAST -lclangParse -lclangAPINotes -lclangBasic -lclangEdit -lclangLex -lclangRewriteFrontend -lclangRewrite -lclangCrossTU -lclangIndex -lclangToolingCore -lclangExtractAPI -lclangSupport -lclangInstallAPI -llldMinGW -llldELF -llldCOFF -llldWasm -llldMachO -llldCommon /usr/lib/llvm21/lib/libLLVM*.a'
SLOP zig version

EXPORTS TOOL   zig
EXPORTS FOLDER zig-lib     /usr/lib/zig
EXPORTS ENV    ZIG_LIB_DIR /usr/lib/zig
# The libc's directories, which Zig would otherwise ask cc for (cc -E -Wp,-v,
# cc -print-file-name); cc's link adds the libc itself.
FILE /usr/lib/zig/libc.txt
    include_dir=/usr/include
    sys_include_dir=/usr/include/wasm64-emscripten
    crt_dir=/usr/lib/dolly/process
    msvc_lib_dir=
    kernel32_lib_dir=
    gcc_dir=
EXPORTS ENV    ZIG_LIBC    /usr/lib/zig/libc.txt
FILE /usr/share/licenses/zig/LICENSE
SLOP mkdir -p /usr/share/man/cat1
SLOP zig --help > /usr/share/man/cat1/zig.1
FILE /usr/share/man/cat1/zig.1
