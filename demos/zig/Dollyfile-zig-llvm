DOLLY 7
PACKAGE zig-llvm
REQUIRES HOST runtime@0
REQUIRES HOST http@0
# What Zig builds runs threads unless it is single-threaded: zig build's runner.
REQUIRES HOST threads@0

# Zig 0.16 with its LLVM backend: zig-llvm-build's objects linked, as
# upstream's CMake build links zig2, with Zig's C++ glue (zigcpp) and LLVM,
# Clang and LLD 21, which the build uses and installers do not get.
FROM /v0.1.3/demos/zig/Dollyfile-zig-llvm-build 7769da2b34422af1f916aa0a281a2b154c640040c4a46a09ff4e4c69568b5546
USE /v0.1.3/demos/llvm/Dollyfile-llvm21 f9e6ec814a2298a6196bb2a493f0ff37d65e6ee30d6bfc87ffc8e3b821d6fc13
# Zig links a program for this target with cc (config/zig-0.16.0-dolly-native.patch).
INSTALL /v0.1.3/Dollyfile-cc bef760134ee54c42302c92bb889429944ffe4c04a4a31271d2c5cdf5c2de1027
REQUIRES TOOL   c++
REQUIRES TOOL   ar

# zigcpp, with upstream's flags (CMakeLists.txt, "zigcpp target").
SLOP CWD /usr/lib/zig-llvm-build c++ -c -O2 -std=c++17 -fno-exceptions -fno-rtti -fvisibility-inlines-hidden \
  -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS -D_GNU_SOURCE \
  -DLLVM_BUILD_STATIC -DCLANG_BUILD_STATIC -I /usr/lib/llvm21/include zig_llvm.cpp zig_llvm-ar.cpp zig_clang_driver.cpp zig_clang_cc1_main.cpp zig_clang_cc1as_main.cpp
SLOP CWD /usr/lib/zig-llvm-build ar rcs libzigcpp.a zig_llvm.o zig_llvm-ar.o zig_clang_driver.o zig_clang_cc1_main.o zig_clang_cc1as_main.o
SLOP CWD /usr/lib/zig-llvm-build slop -c 'c++ -o /usr/bin/zig zig2.o compiler_rt.o libzigcpp.a -L /usr/lib/llvm21/lib \
  -lclangFrontendTool -lclangCodeGen -lclangFrontend -lclangDriver -lclangSerialization -lclangSema -lclangStaticAnalyzerFrontend -lclangStaticAnalyzerCheckers -lclangStaticAnalyzerCore -lclangAnalysis -lclangASTMatchers -lclangAST -lclangParse -lclangAPINotes -lclangBasic -lclangEdit -lclangLex -lclangRewriteFrontend -lclangRewrite -lclangCrossTU -lclangIndex -lclangToolingCore -lclangExtractAPI -lclangSupport -lclangInstallAPI -llldMinGW -llldELF -llldCOFF -llldWasm -llldMachO -llldCommon $(/usr/lib/llvm21/bin/llvm-config --libs --link-static) $(/usr/lib/llvm21/bin/llvm-config --system-libs --link-static)'
SLOP zig version

EXPORTS TOOL   zig
EXPORTS FOLDER zig-lib     /usr/lib/zig
EXPORTS ENV    ZIG_LIB_DIR /usr/lib/zig
# The libc's directories, which Zig would otherwise ask cc for (cc -E -Wp,-v,
# cc -print-file-name); cc's link adds the libc itself.
FILE /usr/lib/zig/libc.txt
    include_dir=/usr/include
    sys_include_dir=/usr/include/wasm64-emscripten
    crt_dir=/usr/lib/dolly/process
    msvc_lib_dir=
    kernel32_lib_dir=
    gcc_dir=
EXPORTS ENV    ZIG_LIBC    /usr/lib/zig/libc.txt
FILE /usr/share/licenses/zig/LICENSE
SLOP mkdir -p /usr/share/man/cat1
SLOP zig --help > /usr/share/man/cat1/zig.1
FILE /usr/share/man/cat1/zig.1
