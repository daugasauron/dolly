+/// Emscripten's libc is the system's, and so is its link: the system's cc
+/// adds the libc, its start file and what the system records in a program.
+fn emscriptenLink(
+    lld: *Lld,
+    arena: Allocator,
+    full_out_path: []const u8,
+    zcu_obj_path: ?Cache.Path,
+    compiler_rt_path: ?Cache.Path,
+    ubsan_rt_path: ?Cache.Path,
+) !void {
+    const comp = lld.base.comp;
+    var argv: std.ArrayList([]const u8) = .empty;
+    try argv.appendSlice(arena, &.{ "cc", "-o", full_out_path });
+    if (comp.config.output_mode == .Lib) try argv.append(arena, "-shared");
+    if (comp.config.rdynamic) try argv.append(arena, "-rdynamic");
+    if (comp.config.any_non_single_threaded) try argv.append(arena, "-pthread");
+    if (comp.config.link_libcpp) try argv.append(arena, "-lc++");
+    for (comp.link_inputs) |link_input| switch (link_input) {
+        .object, .archive => |obj| {
+            const path = try obj.path.toString(arena);
+            try argv.appendSlice(arena, if (obj.must_link) &.{ "-Wl,--whole-archive", path, "-Wl,--no-whole-archive" } else &.{path});
+        },
+        .dso => |dso| try argv.append(arena, try dso.path.toString(arena)),
+        .res, .tbd => unreachable,
+    };
+    for (comp.c_objects.items) |c_object| {
+        try argv.append(arena, try c_object.status.success.object_path.toString(arena));
+    }
+    for ([_]?Cache.Path{ zcu_obj_path, compiler_rt_path, ubsan_rt_path }) |optional| {
+        if (optional) |p| try argv.append(arena, try p.toString(arena));
+    }
+    if (comp.verbose_link) try Compilation.dumpArgv(comp.io, argv.items);
+
+    // cc speaks for itself and for the linker it runs, so its whole stderr is
+    // the error; spawnLld's parser keeps only lines that begin with LLD's name.
+    const io = comp.io;
+    const diags = &comp.link_diags;
+    var child = std.process.spawn(io, .{ .argv = argv.items, .stdin = .ignore, .stdout = .ignore, .stderr = .pipe }) catch |err|
+        return diags.fail("unable to spawn cc: {t}", .{err});
+    var stderr_reader = child.stderr.?.readerStreaming(io, &.{});
+    const stderr = stderr_reader.interface.allocRemaining(arena, .unlimited) catch |err|
+        return diags.fail("unable to read cc's stderr: {t}", .{err});
+    const term = child.wait(io) catch |err| return diags.fail("unable to wait for cc: {t}", .{err});
+    switch (term) {
+        .exited => |code| if (code == 0) return,
+        else => {},
+    }
+    return diags.fail("cc failed ({any}):\n{s}", .{ term, stderr });
+}
