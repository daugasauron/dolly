+/// Emscripten's libc, as Dolly runs it, starts a process with posix_spawn and
+/// has no fork; its file actions are dup2 and chdir.
+const emscripten_spawn = struct {
+    /// musl's posix_spawn_file_actions_t.
+    const FileActions = extern struct { pad0: [2]c_int, actions: ?*anyopaque, pad: [16]c_int };
+    const Argv = [*:null]const ?[*:0]const u8;
+    extern "c" fn posix_spawn_file_actions_init(actions: *FileActions) c_int;
+    extern "c" fn posix_spawn_file_actions_destroy(actions: *FileActions) c_int;
+    extern "c" fn posix_spawn_file_actions_adddup2(actions: *FileActions, source: posix.fd_t, target: posix.fd_t) c_int;
+    extern "c" fn posix_spawn_file_actions_addclose(actions: *FileActions, fd: posix.fd_t) c_int;
+    extern "c" fn posix_spawn_file_actions_addchdir_np(actions: *FileActions, path: [*:0]const u8) c_int;
+    extern "c" fn posix_spawn_file_actions_addfchdir_np(actions: *FileActions, fd: posix.fd_t) c_int;
+    extern "c" fn posix_spawn(pid: *posix.pid_t, path: [*:0]const u8, actions: *const FileActions, attributes: ?*const anyopaque, argv: Argv, envp: Argv) c_int;
+    extern "c" fn posix_spawnp(pid: *posix.pid_t, file: [*:0]const u8, actions: *const FileActions, attributes: ?*const anyopaque, argv: Argv, envp: Argv) c_int;
+};
+
+fn spawnEmscripten(
+    arena: Allocator,
+    options: process.SpawnOptions,
+    argv: [:null]?[*:0]const u8,
+    env_block: process.Environ.PosixBlock,
+    std_pipe_fds: [3]posix.fd_t,
+    dev_null_fd: posix.fd_t,
+    prog_fd: posix.fd_t,
+) process.SpawnError!posix.pid_t {
+    const spawn = emscripten_spawn;
+    if (options.uid != null or options.gid != null or options.pgid != null or options.start_suspended)
+        return error.OperationUnsupported;
+    var actions: spawn.FileActions = undefined;
+    try spawnEmscriptenResult(spawn.posix_spawn_file_actions_init(&actions));
+    defer _ = spawn.posix_spawn_file_actions_destroy(&actions);
+    for ([_]process.SpawnOptions.StdIo{ options.stdin, options.stdout, options.stderr }, std_pipe_fds, 0..) |stdio, pipe_fd, std_fileno| {
+        const target: posix.fd_t = @intCast(std_fileno);
+        try spawnEmscriptenResult(switch (stdio) {
+            .pipe => spawn.posix_spawn_file_actions_adddup2(&actions, pipe_fd, target),
+            .close => spawn.posix_spawn_file_actions_addclose(&actions, target),
+            .inherit => 0,
+            .ignore => spawn.posix_spawn_file_actions_adddup2(&actions, dev_null_fd, target),
+            .file => |file| spawn.posix_spawn_file_actions_adddup2(&actions, file.handle, target),
+        });
+    }
+    try spawnEmscriptenResult(switch (options.cwd) {
+        .inherit => 0,
+        .dir => |cwd| spawn.posix_spawn_file_actions_addfchdir_np(&actions, cwd.handle),
+        .path => |cwd| spawn.posix_spawn_file_actions_addchdir_np(&actions, try arena.dupeZ(u8, cwd)),
+    });
+    // After the directory, as spawnPosix orders its dup2 after fchdir.
+    if (prog_fd != -1) try spawnEmscriptenResult(spawn.posix_spawn_file_actions_adddup2(&actions, prog_fd, 3));
+    const file = argv[0].?;
+    var pid: posix.pid_t = undefined;
+    try spawnEmscriptenResult(if (std.mem.findScalar(u8, std.mem.sliceTo(file, 0), '/') == null)
+        spawn.posix_spawnp(&pid, file, &actions, null, argv.ptr, env_block.slice.ptr)
+    else
+        spawn.posix_spawn(&pid, file, &actions, null, argv.ptr, env_block.slice.ptr));
+    return pid;
+}
+
+/// posix_spawn and its file actions return an errno value.
+fn spawnEmscriptenResult(rc: c_int) process.SpawnError!void {
+    return switch (@as(posix.E, @enumFromInt(rc))) {
+        .SUCCESS => {},
+        .AGAIN, .NOMEM => error.SystemResources,
+        .OPNOTSUPP => error.OperationUnsupported,
+        .ACCES => error.AccessDenied,
+        .PERM => error.PermissionDenied,
+        .NOENT => error.FileNotFound,
+        .NOTDIR => error.NotDir,
+        .ISDIR => error.IsDir,
+        .NOEXEC => error.InvalidExe,
+        .LOOP => error.SymLinkLoop,
+        .NAMETOOLONG => error.NameTooLong,
+        .MFILE => error.ProcessFdQuotaExceeded,
+        .NFILE => error.SystemFdQuotaExceeded,
+        else => |err| posix.unexpectedErrno(err),
+    };
+}
