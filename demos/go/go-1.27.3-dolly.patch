+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build dolly
+
+package syscall
+
+import (
+	"errors"
+	"internal/oserror"
+	"internal/strconv"
+	"unsafe"
+)
+
+// dollyCall makes an operation of Dolly's process contract
+// (include/dolly/process.h). It is runtime/os_dolly.go's dollySyscall, which
+// takes the signals that interrupt a call. A non-negative result is the size
+// of the response, a negative one a negated Errno.
+func dollyCall(operation uint32, request unsafe.Pointer, requestSize uint64, response unsafe.Pointer, responseCapacity uint64) int64
+
+// dollySleep is time.Sleep.
+func dollySleep(ns int64)
+
+// The operations of include/dolly/process.h.
+const (
+	opExit                     = 5
+	opFdRead                   = 16
+	opFdWrite                  = 17
+	opFdClose                  = 18
+	opFdSeek                   = 19
+	opFdStat                   = 20
+	opFdSync                   = 21
+	opFdDup                    = 22
+	opFdPipe                   = 23
+	opFdReadDirectory          = 24
+	opFdPread                  = 25
+	opFdTruncate               = 26
+	opFdSetTimes               = 28
+	opFdPwrite                 = 29
+	opFdGetFlags               = 30
+	opFdSetFlags               = 31
+	opPathOpen                 = 32
+	opPathStat                 = 33
+	opPathCreateDirectory      = 34
+	opPathRemove               = 35
+	opPathRename               = 36
+	opPathLink                 = 37
+	opPathSymlink              = 38
+	opPathReadlink             = 39
+	opPathGetCurrentDirectory  = 40
+	opPathSetCurrentDirectory  = 41
+	opPathSetTimes             = 43
+	opClockTime                = 48
+	opRandom                   = 49
+	opFdGetDescriptorFlags     = 55
+	opFdSetDescriptorFlags     = 56
+	opSpawn                    = 64
+	opWait                     = 65
+	opInfo                     = 67
+	opSignal                   = 68
+	dollyPacketLimit           = 1 << 20
+	dollyCurrentDirectory      = ^uint32(0) // a path request's directory: the working directory
+	dollyFdCloexec             = 1 << 0
+	dollyFdStatusAppend        = 1 << 2
+	dollyFdStatusNonblock      = 1 << 3
+	dollyClockRealtime         = 0
+	dollyClockMonotonic        = 1
+	dollyDescriptorLimit       = 1024
+	dollyWaitNonblock          = 1 << 0
+	dollySpawnInheritEnvirons  = 1 << 0
+	dollyInheritDescriptorsAll = 2
+)
+
+// call makes an operation and converts its result.
+func call(operation uint32, request unsafe.Pointer, requestSize uintptr, response unsafe.Pointer, responseCapacity uintptr) (int, error) {
+	r := dollyCall(operation, request, uint64(requestSize), response, uint64(responseCapacity))
+	if r < 0 {
+		return 0, errnoErr(Errno(-r))
+	}
+	return int(r), nil
+}
+
+const (
+	Stdin  = 0
+	Stdout = 1
+	Stderr = 2
+)
+
+// An Errno is an unsigned number describing an error condition: one of
+// Dolly's error numbers (include/dolly/process.h).
+// It implements the error interface. The zero Errno is by convention
+// a non-error, so code to convert from Errno to error should use:
+//
+//	var err = nil
+//	if errno != 0 {
+//		err = errno
+//	}
+type Errno uint32
+
+func (e Errno) Error() string {
+	if 0 <= int(e) && int(e) < len(errorstr) {
+		s := errorstr[e]
+		if s != "" {
+			return s
+		}
+	}
+	return "errno " + strconv.Itoa(int(e))
+}
+
+func (e Errno) Is(target error) bool {
+	switch target {
+	case oserror.ErrPermission:
+		return e == EACCES || e == EPERM
+	case oserror.ErrExist:
+		return e == EEXIST || e == ENOTEMPTY
+	case oserror.ErrNotExist:
+		return e == ENOENT
+	case errors.ErrUnsupported:
+		return e == ENOSYS || e == ENOTSUP
+	}
+	return false
+}
+
+func (e Errno) Temporary() bool {
+	return e == EINTR || e == EMFILE || e.Timeout()
+}
+
+func (e Errno) Timeout() bool {
+	return e == EAGAIN || e == ETIMEDOUT
+}
+
+// A Signal is a number describing a process signal.
+// It implements the [os.Signal] interface.
+// Dolly delivers ten of them (include/dolly/process.h); the numbers are Linux's.
+type Signal int
+
+const (
+	SIGHUP    Signal = 1
+	SIGINT    Signal = 2
+	SIGQUIT   Signal = 3
+	SIGILL    Signal = 4
+	SIGTRAP   Signal = 5
+	SIGABRT   Signal = 6
+	SIGBUS    Signal = 7
+	SIGFPE    Signal = 8
+	SIGKILL   Signal = 9
+	SIGUSR1   Signal = 10
+	SIGSEGV   Signal = 11
+	SIGUSR2   Signal = 12
+	SIGPIPE   Signal = 13
+	SIGALRM   Signal = 14
+	SIGTERM   Signal = 15
+	SIGCHLD   Signal = 17
+	SIGCONT   Signal = 18
+	SIGSTOP   Signal = 19
+	SIGTSTP   Signal = 20
+	SIGTTIN   Signal = 21
+	SIGTTOU   Signal = 22
+	SIGURG    Signal = 23
+	SIGXCPU   Signal = 24
+	SIGXFSZ   Signal = 25
+	SIGVTALRM Signal = 26
+	SIGPROF   Signal = 27
+	SIGWINCH  Signal = 28
+	SIGIO     Signal = 29
+	SIGPWR    Signal = 30
+	SIGSYS    Signal = 31
+)
+
+var signals = [...]string{
+	SIGHUP:    "hangup",
+	SIGINT:    "interrupt",
+	SIGQUIT:   "quit",
+	SIGILL:    "illegal instruction",
+	SIGTRAP:   "trace/breakpoint trap",
+	SIGABRT:   "aborted",
+	SIGBUS:    "bus error",
+	SIGFPE:    "floating point exception",
+	SIGKILL:   "killed",
+	SIGUSR1:   "user defined signal 1",
+	SIGSEGV:   "segmentation fault",
+	SIGUSR2:   "user defined signal 2",
+	SIGPIPE:   "broken pipe",
+	SIGALRM:   "alarm clock",
+	SIGTERM:   "terminated",
+	SIGCHLD:   "child exited",
+	SIGCONT:   "continued",
+	SIGSTOP:   "stopped (signal)",
+	SIGTSTP:   "stopped",
+	SIGTTIN:   "stopped (tty input)",
+	SIGTTOU:   "stopped (tty output)",
+	SIGURG:    "urgent I/O condition",
+	SIGXCPU:   "CPU time limit exceeded",
+	SIGXFSZ:   "file size limit exceeded",
+	SIGVTALRM: "virtual timer expired",
+	SIGPROF:   "profiling timer expired",
+	SIGWINCH:  "window changed",
+	SIGIO:     "I/O possible",
+	SIGPWR:    "power failure",
+	SIGSYS:    "bad system call",
+}
+
+func (s Signal) Signal() {}
+
+func (s Signal) String() string {
+	if 0 <= s && int(s) < len(signals) && signals[s] != "" {
+		return signals[s]
+	}
+	return "signal " + strconv.Itoa(int(s))
+}
+
+// The open flags os uses; Openat maps them to Dolly's.
+const (
+	O_RDONLY    = 0x0
+	O_WRONLY    = 0x1
+	O_RDWR      = 0x2
+	O_ACCMODE   = 0x3
+	O_CREAT     = 0x40
+	O_CREATE    = O_CREAT
+	O_EXCL      = 0x80
+	O_NOCTTY    = 0x100
+	O_TRUNC     = 0x200
+	O_APPEND    = 0x400
+	O_NONBLOCK  = 0x800
+	O_SYNC      = 0x101000
+	O_DIRECTORY = 0x10000
+	O_NOFOLLOW  = 0x20000
+	O_CLOEXEC   = 0x80000
+)
+
+// The commands of fcntl (internal/syscall/unix), with net_fake.go's
+// F_DUPFD_CLOEXEC.
+const (
+	F_DUPFD    = 0
+	F_GETFD    = 2
+	F_SETFD    = 3
+	F_GETFL    = 4
+	F_SETFL    = 5
+	FD_CLOEXEC = 1
+)
+
+const (
+	S_IFMT   = 0170000
+	S_IFSOCK = 0140000
+	S_IFLNK  = 0120000
+	S_IFREG  = 0100000
+	S_IFBLK  = 060000
+	S_IFDIR  = 040000
+	S_IFCHR  = 020000
+	S_IFIFO  = 010000
+
+	S_ISUID = 04000
+	S_ISGID = 02000
+	S_ISVTX = 01000
+
+	S_IRUSR = 0400
+	S_IWUSR = 0200
+	S_IXUSR = 0100
+)
+
+type Timespec struct {
+	Sec  int64
+	Nsec int64
+}
+
+type Timeval struct {
+	Sec  int64
+	Usec int64
+}
+
+func setTimespec(sec, nsec int64) Timespec {
+	return Timespec{Sec: sec, Nsec: nsec}
+}
+
+func setTimeval(sec, usec int64) Timeval {
+	return Timeval{Sec: sec, Usec: usec}
+}
+
+func Gettimeofday(tv *Timeval) error {
+	request := struct {
+		clock, reserved uint32
+		precision       uint64
+	}{dollyClockRealtime, 0, 0}
+	var nanoseconds int64
+	if _, err := call(opClockTime, unsafe.Pointer(&request), 16, unsafe.Pointer(&nanoseconds), 8); err != nil {
+		return err
+	}
+	*tv = NsecToTimeval(nanoseconds)
+	return nil
+}
+
+// Dolly has one user and no permission model; files report the user and
+// group zero.
+func Getuid() int                  { return 0 }
+func Getgid() int                  { return 0 }
+func Geteuid() int                 { return 0 }
+func Getegid() int                 { return 0 }
+func Getgroups() ([]int, error)    { return []int{0}, nil }
+func Umask(mask int) (oldmask int) { return 0 }
+
+// info is the process's id and its parent's.
+func info() (pids [2]uint32) {
+	call(opInfo, nil, 0, unsafe.Pointer(&pids), 8)
+	return pids
+}
+
+func Getpid() int  { return int(info()[0]) }
+func Getppid() int { return int(info()[1]) }
+
+func Kill(pid int, signum Signal) error {
+	if pid <= 0 {
+		return ENOSYS // Dolly signals one process.
+	}
+	request := [2]uint32{uint32(pid), uint32(signum)}
+	_, err := call(opSignal, unsafe.Pointer(&request), 8, unsafe.Pointer(&request), 8)
+	return err
+}
+
+func Sysctl(key string) (string, error) {
+	if key == "kern.hostname" {
+		return "dolly", nil
+	}
+	return "", ENOSYS
+}
+
+type Rlimit struct {
+	Cur uint64
+	Max uint64
+}
+
+const RLIMIT_NOFILE = 7
+
+func Getrlimit(which int, lim *Rlimit) error {
+	if which != RLIMIT_NOFILE {
+		return EINVAL
+	}
+	*lim = Rlimit{dollyDescriptorLimit, dollyDescriptorLimit}
+	return nil
+}
+
+func Setrlimit(which int, lim *Rlimit) error {
+	return ENOSYS
+}
+
+// Syscall and its relatives exist for portable code: Dolly has no numbered
+// system calls.
+func Syscall(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+func Syscall6(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+func RawSyscall(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+func RawSyscall6(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+// Iovec is for portable code: Dolly has no vectored I/O.
+type Iovec struct {
+	Base *byte
+	Len  uint64
+}
