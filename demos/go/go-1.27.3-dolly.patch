diff --git a/src/os/dirent_dolly.go b/src/os/dirent_dolly.go
new file mode 100644
index 00000000..b449c7fc
--- /dev/null
+++ b/src/os/dirent_dolly.go
@@ -0,0 +1,52 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build dolly
+
+package os
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+// A directory entry of Dolly's: a 24-byte header, then the name.
+const direntHeader = unsafe.Offsetof(syscall.Dirent{}.Name)
+
+func direntIno(buf []byte) (uint64, bool) {
+	return readInt(buf, unsafe.Offsetof(syscall.Dirent{}.Ino), unsafe.Sizeof(syscall.Dirent{}.Ino))
+}
+
+func direntNamlen(buf []byte) (uint64, bool) {
+	return readInt(buf, unsafe.Offsetof(syscall.Dirent{}.Namelen), unsafe.Sizeof(syscall.Dirent{}.Namelen))
+}
+
+func direntReclen(buf []byte) (uint64, bool) {
+	namelen, ok := direntNamlen(buf)
+	return uint64(direntHeader) + namelen, ok
+}
+
+func direntType(buf []byte) FileMode {
+	off := unsafe.Offsetof(syscall.Dirent{}.Type)
+	if off >= uintptr(len(buf)) {
+		return ^FileMode(0) // unknown
+	}
+	switch buf[off] {
+	case 1: // regular
+		return 0
+	case 2:
+		return ModeDir
+	case 3:
+		return ModeSymlink
+	case 4:
+		return ModeDevice | ModeCharDevice
+	case 5:
+		return ModeDevice
+	case 6:
+		return ModeNamedPipe
+	case 7:
+		return ModeSocket
+	}
+	return ^FileMode(0) // unknown
+}
