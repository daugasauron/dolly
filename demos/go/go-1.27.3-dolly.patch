+
+//go:build dolly
+
+package syscall
+
+import (
+	"runtime"
+	"unsafe"
+)
+
+// Files and paths over Dolly's descriptors. A path request names a directory
+// descriptor, dollyCurrentDirectory for the working directory, and the path's
+// bytes follow its header.
+
+const (
+	openRead      = 1 << 0
+	openWrite     = 1 << 1
+	openCreate    = 1 << 2
+	openExclusive = 1 << 3
+	openTruncate  = 1 << 4
+	openAppend    = 1 << 5
+	openDirectory = 1 << 6
+	openNofollow  = 1 << 7
+	openCloexec   = 1 << 8
+
+	pathDirectory = 1 << 0
+	pathNofollow  = 1 << 1
+
+	fileRegular         = 1
+	fileDirectory       = 2
+	fileSymbolicLink    = 3
+	fileCharacterDevice = 4
+	fileBlockDevice     = 5
+	fileFifo            = 6
+	fileSocket          = 7
+
+	timeNow  = 1 << 0
+	timeOmit = 1 << 1
+)
+
+// packet holds a request header followed by the bytes of up to two strings.
+func packet(header unsafe.Pointer, headerSize uintptr, first, second string) []byte {
+	b := make([]byte, headerSize, headerSize+uintptr(len(first)+len(second)))
+	copy(b, unsafe.Slice((*byte)(header), headerSize))
+	return append(append(b, first...), second...)
+}
+
+type pathRequest struct {
+	directory uint32
+	flags     uint32
+	reserved  uint32
+	pathSize  uint32
+}
+
+// pathCall makes a path operation on path relative to directory.
+func pathCall(operation uint32, directory int, path string, flags uint32, response unsafe.Pointer, responseCapacity uintptr) (int, error) {
+	if path == "" {
+		return 0, ENOENT
+	}
+	header := pathRequest{uint32(directory), flags, 0, uint32(len(path))}
+	request := packet(unsafe.Pointer(&header), unsafe.Sizeof(header), path, "")
+	return call(operation, unsafe.Pointer(&request[0]), uintptr(len(request)), response, responseCapacity)
+}
+
+type twoPathRequest struct {
+	oldDirectory uint32
+	newDirectory uint32
+	oldPathSize  uint32
+	newPathSize  uint32
+}
+
+func twoPathCall(operation uint32, oldDirectory int, oldPath string, newDirectory int, newPath string) error {
+	if oldPath == "" || newPath == "" {
+		return ENOENT
+	}
+	header := twoPathRequest{uint32(oldDirectory), uint32(newDirectory), uint32(len(oldPath)), uint32(len(newPath))}
+	request := packet(unsafe.Pointer(&header), unsafe.Sizeof(header), oldPath, newPath)
+	_, err := call(operation, unsafe.Pointer(&request[0]), uintptr(len(request)), nil, 0)
+	return err
+}
+
+type fdRequest struct {
+	descriptor uint32
+	reserved   uint32
+}
+
+func fdCall(operation uint32, fd int, response unsafe.Pointer, responseCapacity uintptr) (int, error) {
+	request := fdRequest{uint32(fd), 0}
+	return call(operation, unsafe.Pointer(&request), unsafe.Sizeof(request), response, responseCapacity)
+}
+
+func Open(path string, mode int, perm uint32) (int, error) {
+	return Openat(int(dollyCurrentDirectory), path, mode, perm)
+}
+
+// Openat opens path relative to the directory dirfd. Dolly has no
+// permission model, so perm is not stored.
+func Openat(dirfd int, path string, mode int, perm uint32) (int, error) {
+	var flags uint32
+	switch mode & O_ACCMODE {
+	case O_RDONLY:
+		flags = openRead
+	case O_WRONLY:
+		flags = openWrite
+	default:
+		flags = openRead | openWrite
+	}
+	for _, f := range [...]struct {
+		mode  int
+		flags uint32
+	}{
+		{O_CREAT, openCreate}, {O_EXCL, openExclusive}, {O_TRUNC, openTruncate},
+		{O_APPEND, openAppend}, {O_DIRECTORY, openDirectory},
+		{O_NOFOLLOW, openNofollow}, {O_CLOEXEC, openCloexec},
+	} {
+		if mode&f.mode != 0 {
+			flags |= f.flags
+		}
+	}
+	var response fdRequest
+	if _, err := pathCall(opPathOpen, dirfd, path, flags, unsafe.Pointer(&response), unsafe.Sizeof(response)); err != nil {
+		return -1, err
+	}
+	fd := int(response.descriptor)
+	if mode&O_NONBLOCK != 0 {
+		if err := SetNonblock(fd, true); err != nil {
+			Close(fd)
+			return -1, err
+		}
+	}
+	return fd, nil
+}
+
+func Close(fd int) error {
+	_, err := fdCall(opFdClose, fd, nil, 0)
+	return err
+}
+
+func CloseOnExec(fd int) {
+	setDescriptorFlags(fd, dollyFdCloexec)
+}
+
+func setDescriptorFlags(fd int, flags uint32) error {
+	request := [2]uint32{uint32(fd), flags}
+	_, err := call(opFdSetDescriptorFlags, unsafe.Pointer(&request), 8, nil, 0)
+	return err
+}
+
+func descriptorFlags(fd int) (uint32, error) {
+	var response [2]uint32
+	_, err := fdCall(opFdGetDescriptorFlags, fd, unsafe.Pointer(&response), 8)
+	return response[1], err
+}
+
+func statusFlags(fd int) (uint32, error) {
+	var response [2]uint32
+	_, err := fdCall(opFdGetFlags, fd, unsafe.Pointer(&response), 8)
+	return response[1], err
+}
+
+func SetNonblock(fd int, nonblocking bool) error {
+	flags, err := statusFlags(fd)
+	if err != nil {
+		return err
+	}
+	flags &= dollyFdStatusAppend
+	if nonblocking {
+		flags |= dollyFdStatusNonblock
+	}
+	request := [2]uint32{uint32(fd), flags}
+	_, err = call(opFdSetFlags, unsafe.Pointer(&request), 8, nil, 0)
+	return err
+}
+
+// fcntl is the fcntl(2) of internal/syscall/unix: descriptor and status
+// flags, and duplicating with F_DUPFD and F_DUPFD_CLOEXEC.
+//
+//go:linkname fcntl
+func fcntl(fd int, cmd int, arg int) (int, error) {
+	switch cmd {
+	case F_GETFD:
+		flags, err := descriptorFlags(fd)
+		return int(flags & dollyFdCloexec), err
+	case F_SETFD:
+		return 0, setDescriptorFlags(fd, uint32(arg)&FD_CLOEXEC)
+	case F_GETFL:
+		flags, err := statusFlags(fd)
+		mode := 0
+		switch flags & 3 {
+		case 1:
+			mode = O_RDONLY
+		case 2:
+			mode = O_WRONLY
+		case 3:
+			mode = O_RDWR
+		}
+		if flags&dollyFdStatusAppend != 0 {
+			mode |= O_APPEND
+		}
+		if flags&dollyFdStatusNonblock != 0 {
+			mode |= O_NONBLOCK
+		}
+		return mode, err
+	case F_SETFL:
+		var flags uint32
+		if arg&O_APPEND != 0 {
+			flags |= dollyFdStatusAppend
+		}
+		if arg&O_NONBLOCK != 0 {
+			flags |= dollyFdStatusNonblock
+		}
+		request := [2]uint32{uint32(fd), flags}
+		_, err := call(opFdSetFlags, unsafe.Pointer(&request), 8, nil, 0)
+		return 0, err
+	case F_DUPFD, F_DUPFD_CLOEXEC:
+		flags := uint32(dupMinimum)
+		if cmd == F_DUPFD_CLOEXEC {
+			flags |= dupCloexec
+		}
+		return dup(fd, uint32(arg), flags)
+	}
+	return 0, ENOSYS
+}
+
+const (
+	dupMinimum = 1 << 0
+	dupCloexec = 1 << 1
+)
+
+func dup(fd int, target uint32, flags uint32) (int, error) {
+	request := [4]uint32{uint32(fd), target, flags, 0}
+	var response [2]uint32
+	if _, err := call(opFdDup, unsafe.Pointer(&request), 16, unsafe.Pointer(&response), 8); err != nil {
+		return -1, err
+	}
+	return int(response[0]), nil
+}
+
+func Dup(fd int) (int, error) {
+	return dup(fd, 0, dupMinimum)
+}
+
+func Dup2(fd, newfd int) error {
+	_, err := dup(fd, uint32(newfd), 0)
+	return err
+}
+
+func Dup3(fd, newfd, flags int) error {
+	if fd == newfd {
+		return EINVAL
+	}
+	var dupFlags uint32
+	if flags&O_CLOEXEC != 0 {
+		dupFlags = dupCloexec
+	}
+	_, err := dup(fd, uint32(newfd), dupFlags)
+	return err
+}
+
+func Pipe(fd []int) error {
+	return Pipe2(fd, 0)
+}
+
+func Pipe2(fd []int, flags int) error {
+	if len(fd) != 2 {
+		return EINVAL
+	}
+	request := [2]uint32{0, 0}
+	if flags&O_CLOEXEC != 0 {
+		request[0] = dollyFdCloexec
+	}
+	var response [2]uint32
+	if _, err := call(opFdPipe, unsafe.Pointer(&request), 8, unsafe.Pointer(&response), 8); err != nil {
+		return err
+	}
+	fd[0], fd[1] = int(response[0]), int(response[1])
+	if flags&O_NONBLOCK != 0 {
+		SetNonblock(fd[0], true)
+		SetNonblock(fd[1], true)
+	}
+	return nil
+}
+
+type ioRequest struct {
+	descriptor uint32
+	reserved   uint32
+	size       uint64
+}
+
+type positionalRequest struct {
+	descriptor uint32
+	reserved   uint32
+	offset     uint64
+	size       uint64
+}
+
+// The largest buffer one packet carries.
+const ioLimit = dollyPacketLimit - unsafe.Sizeof(positionalRequest{})
+
+func Read(fd int, b []byte) (int, error) {
+	if len(b) > int(ioLimit) {
+		b = b[:ioLimit]
+	}
+	request := ioRequest{uint32(fd), 0, uint64(len(b))}
+	n, err := call(opFdRead, unsafe.Pointer(&request), unsafe.Sizeof(request), unsafe.Pointer(unsafe.SliceData(b)), uintptr(len(b)))
+	runtime.KeepAlive(b)
+	return n, err
+}
+
+func Pread(fd int, b []byte, offset int64) (int, error) {
+	if len(b) > int(ioLimit) {
+		b = b[:ioLimit]
+	}
+	request := positionalRequest{uint32(fd), 0, uint64(offset), uint64(len(b))}
+	n, err := call(opFdPread, unsafe.Pointer(&request), unsafe.Sizeof(request), unsafe.Pointer(unsafe.SliceData(b)), uintptr(len(b)))
+	runtime.KeepAlive(b)
+	return n, err
+}
+
+// writeBuffer holds the packets of Write and Pwrite: a header, then the bytes.
+var writeBuffer []byte
+
+func writePacket(header unsafe.Pointer, headerSize uintptr, b []byte) []byte {
+	if len(b) > int(ioLimit) {
+		b = b[:ioLimit]
+	}
+	if size := int(headerSize) + len(b); cap(writeBuffer) < size {
+		writeBuffer = make([]byte, size, max(size, 64<<10))
+	}
+	packet := writeBuffer[:int(headerSize)+len(b)]
+	copy(packet, unsafe.Slice((*byte)(header), headerSize))
+	copy(packet[headerSize:], b)
+	return packet
+}
+
+func Write(fd int, b []byte) (int, error) {
+	request := ioRequest{uint32(fd), 0, uint64(min(len(b), int(ioLimit)))}
+	packet := writePacket(unsafe.Pointer(&request), unsafe.Sizeof(request), b)
+	var written uint64
+	_, err := call(opFdWrite, unsafe.Pointer(&packet[0]), uintptr(len(packet)), unsafe.Pointer(&written), 8)
+	return int(written), err
+}
+
+func Pwrite(fd int, b []byte, offset int64) (int, error) {
+	request := positionalRequest{uint32(fd), 0, uint64(offset), uint64(min(len(b), int(ioLimit)))}
+	packet := writePacket(unsafe.Pointer(&request), unsafe.Sizeof(request), b)
+	var written uint64
+	_, err := call(opFdPwrite, unsafe.Pointer(&packet[0]), uintptr(len(packet)), unsafe.Pointer(&written), 8)
+	return int(written), err
+}
+
+func Seek(fd int, offset int64, whence int) (int64, error) {
+	request := struct {
+		descriptor uint32
+		whence     uint32
+		offset     int64
+	}{uint32(fd), uint32(whence), offset}
+	var position int64
+	_, err := call(opFdSeek, unsafe.Pointer(&request), unsafe.Sizeof(request), unsafe.Pointer(&position), 8)
+	return position, err
+}
+
+func Fsync(fd int) error {
+	_, err := fdCall(opFdSync, fd, nil, 0)
+	return err
+}
+
+func Ftruncate(fd int, length int64) error {
+	if length < 0 {
+		return EINVAL
+	}
+	request := ioRequest{uint32(fd), 0, uint64(length)}
+	_, err := call(opFdTruncate, unsafe.Pointer(&request), unsafe.Sizeof(request), nil, 0)
+	return err
+}
+
+func Truncate(path string, length int64) error {
+	fd, err := Open(path, O_WRONLY, 0)
+	if err != nil {
+		return err
+	}
+	defer Close(fd)
+	return Ftruncate(fd, length)
+}
+
+type Stat_t struct {
+	Dev       int64
+	Ino       uint64
+	Mode      uint32
+	Nlink     uint32
+	Uid       uint32
+	Gid       uint32
+	Rdev      int64
+	Size      int64
+	Blksize   int32
+	Blocks    int32
+	Atime     int64
+	AtimeNsec int64
+	Mtime     int64
+	MtimeNsec int64
+	Ctime     int64
+	CtimeNsec int64
+}
+
+// statResponse is dolly_process_stat_response.
+type statResponse struct {
+	device, inode, size              uint64
+	access, modification, change     uint64 // nanoseconds
+	blocks                           uint64
+	mode, linkCount, user, group     uint32
+	blockSize, fileType, _, _        uint32
+}
+
+var fileTypeModes = [...]uint32{
+	fileRegular:         S_IFREG,
+	fileDirectory:       S_IFDIR,
+	fileSymbolicLink:    S_IFLNK,
+	fileCharacterDevice: S_IFCHR,
+	fileBlockDevice:     S_IFBLK,
+	fileFifo:            S_IFIFO,
+	fileSocket:          S_IFSOCK,
+}
+
+func (st *Stat_t) set(r *statResponse) {
+	*st = Stat_t{
+		Dev:   int64(r.device),
+		Ino:   r.inode,
+		Mode:  r.mode & 07777,
+		Nlink: r.linkCount,
+		Uid:   r.user, Gid: r.group,
+		Size:    int64(r.size),
+		Blksize: int32(r.blockSize), Blocks: int32(r.blocks),
+		Atime: int64(r.access / 1e9), AtimeNsec: int64(r.access % 1e9),
+		Mtime: int64(r.modification / 1e9), MtimeNsec: int64(r.modification % 1e9),
+		Ctime: int64(r.change / 1e9), CtimeNsec: int64(r.change % 1e9),
+	}
+	if r.fileType < uint32(len(fileTypeModes)) {
+		st.Mode |= fileTypeModes[r.fileType]
+	}
+}
+
+func Fstat(fd int, st *Stat_t) error {
+	var response statResponse
+	if _, err := fdCall(opFdStat, fd, unsafe.Pointer(&response), unsafe.Sizeof(response)); err != nil {
+		return err
+	}
+	st.set(&response)
+	return nil
+}
+
+// Fstatat stats path relative to dirfd; flags is pathNofollow or zero.
+func Fstatat(dirfd int, path string, st *Stat_t, flags int) error {
+	var response statResponse
+	if _, err := pathCall(opPathStat, dirfd, path, uint32(flags)&pathNofollow, unsafe.Pointer(&response), unsafe.Sizeof(response)); err != nil {
+		return err
+	}
+	st.set(&response)
+	return nil
+}
+
+// The flags of Fstatat and Unlinkat, as internal/syscall/unix names them.
+const (
+	AT_FDCWD            = int(dollyCurrentDirectory)
+	AT_REMOVEDIR        = pathDirectory
+	AT_SYMLINK_NOFOLLOW = pathNofollow
+)
+
+func Stat(path string, st *Stat_t) error {
+	return Fstatat(AT_FDCWD, path, st, 0)
+}
+
+func Lstat(path string, st *Stat_t) error {
+	return Fstatat(AT_FDCWD, path, st, AT_SYMLINK_NOFOLLOW)
+}
+
+func Mkdirat(dirfd int, path string, mode uint32) error {
+	_, err := pathCall(opPathCreateDirectory, dirfd, path, 0, nil, 0)
+	return err
+}
+
+func Mkdir(path string, mode uint32) error {
+	return Mkdirat(AT_FDCWD, path, mode)
+}
+
+func Unlinkat(dirfd int, path string, flags int) error {
+	_, err := pathCall(opPathRemove, dirfd, path, uint32(flags)&pathDirectory, nil, 0)
+	return err
+}
+
+func Unlink(path string) error {
+	return Unlinkat(AT_FDCWD, path, 0)
+}
+
+func Rmdir(path string) error {
+	return Unlinkat(AT_FDCWD, path, AT_REMOVEDIR)
+}
+
+func Renameat(olddirfd int, oldpath string, newdirfd int, newpath string) error {
+	return twoPathCall(opPathRename, olddirfd, oldpath, newdirfd, newpath)
+}
+
+func Rename(from, to string) error {
+	return Renameat(AT_FDCWD, from, AT_FDCWD, to)
+}
+
+func Linkat(olddirfd int, oldpath string, newdirfd int, newpath string) error {
+	return twoPathCall(opPathLink, olddirfd, oldpath, newdirfd, newpath)
+}
+
+func Link(path, link string) error {
+	return Linkat(AT_FDCWD, path, AT_FDCWD, link)
+}
+
+func Symlinkat(target string, dirfd int, link string) error {
+	return twoPathCall(opPathSymlink, AT_FDCWD, target, dirfd, link)
+}
+
+func Symlink(target, link string) error {
+	return Symlinkat(target, AT_FDCWD, link)
+}
+
+func Readlinkat(dirfd int, path string, buf []byte) (int, error) {
+	if len(buf) == 0 {
+		return 0, EINVAL
+	}
+	n, err := pathCall(opPathReadlink, dirfd, path, 0, unsafe.Pointer(&buf[0]), uintptr(len(buf)))
+	runtime.KeepAlive(buf)
+	return n, err
+}
+
+func Readlink(path string, buf []byte) (int, error) {
+	return Readlinkat(AT_FDCWD, path, buf)
+}
+
+// Dolly stores no permission bits and no owners: changing them succeeds on
+// a file that exists and changes nothing.
+func Fchmodat(dirfd int, path string, mode uint32, flags int) error {
+	var st Stat_t
+	return Fstatat(dirfd, path, &st, flags)
+}
+
+func Chmod(path string, mode uint32) error {
+	return Fchmodat(AT_FDCWD, path, mode, 0)
+}
+
+func Fchmod(fd int, mode uint32) error {
+	var st Stat_t
+	return Fstat(fd, &st)
+}
+
+func Fchownat(dirfd int, path string, uid, gid int, flags int) error {
+	var st Stat_t
+	return Fstatat(dirfd, path, &st, flags)
+}
+
+func Chown(path string, uid, gid int) error {
+	return Fchownat(AT_FDCWD, path, uid, gid, 0)
+}
+
+func Lchown(path string, uid, gid int) error {
+	return Fchownat(AT_FDCWD, path, uid, gid, AT_SYMLINK_NOFOLLOW)
+}
+
+func Fchown(fd int, uid, gid int) error {
+	var st Stat_t
+	return Fstat(fd, &st)
+}
+
+// UTIME_OMIT in a Timespec leaves that time as it is.
+const UTIME_OMIT = (1 << 30) - 2
+
+type timestamp struct {
+	seconds     int64
+	nanoseconds uint32
+	flags       uint32
+}
+
+func timestampOf(ts Timespec) timestamp {
+	if ts.Nsec == UTIME_OMIT {
+		return timestamp{flags: timeOmit}
+	}
+	return timestamp{ts.Sec, uint32(ts.Nsec), 0}
+}
+
+func UtimesNanoAt(dirfd int, path string, ts []Timespec, flags int) error {
+	if len(ts) != 2 {
+		return EINVAL
+	}
+	if path == "" {
+		return ENOENT
+	}
+	header := struct {
+		directory, flags, reserved, pathSize uint32
+		access, modification                 timestamp
+	}{uint32(dirfd), uint32(flags) & pathNofollow, 0, uint32(len(path)), timestampOf(ts[0]), timestampOf(ts[1])}
+	request := packet(unsafe.Pointer(&header), unsafe.Sizeof(header), path, "")
+	_, err := call(opPathSetTimes, unsafe.Pointer(&request[0]), uintptr(len(request)), nil, 0)
+	return err
+}
+
+func UtimesNano(path string, ts []Timespec) error {
+	return UtimesNanoAt(AT_FDCWD, path, ts, 0)
+}
+
+func Futimes(fd int, tv []Timeval) error {
+	if len(tv) != 2 {
+		return EINVAL
+	}
+	request := struct {
+		descriptor, reserved uint32
+		access, modification timestamp
+	}{uint32(fd), 0, timestampOf(NsecToTimespec(TimevalToNsec(tv[0]))), timestampOf(NsecToTimespec(TimevalToNsec(tv[1])))}
+	_, err := call(opFdSetTimes, unsafe.Pointer(&request), unsafe.Sizeof(request), nil, 0)
+	return err
+}
+
+const ImplementsGetwd = true
+
+func Getwd() (string, error) {
+	buf := make([]byte, 4096)
+	n, err := call(opPathGetCurrentDirectory, nil, 0, unsafe.Pointer(&buf[0]), uintptr(len(buf)))
+	if err != nil {
+		return "", err
+	}
+	return string(buf[:n-1]), nil // without its NUL
+}
+
+func Chdir(path string) error {
+	_, err := pathCall(opPathSetCurrentDirectory, AT_FDCWD, path, 0, nil, 0)
+	return err
+}
+
+func Fchdir(fd int) error {
+	_, err := pathCall(opPathSetCurrentDirectory, fd, ".", 0, nil, 0)
+	return err
+}
+
+// Dirent is the record of ReadDirent: Dolly's directory entry, a 24-byte
+// header and the name's bytes, which are not NUL terminated.
+type Dirent struct {
+	Ino     uint64
+	Next    uint64
+	Type    uint32
+	Namelen uint32
+	Name    [256]byte
+}
+
+const direntHeader = unsafe.Offsetof(Dirent{}.Name)
+
+func direntIno(buf []byte) (uint64, bool) {
+	return readInt(buf, unsafe.Offsetof(Dirent{}.Ino), unsafe.Sizeof(Dirent{}.Ino))
+}
+
+func direntNamlen(buf []byte) (uint64, bool) {
+	return readInt(buf, unsafe.Offsetof(Dirent{}.Namelen), unsafe.Sizeof(Dirent{}.Namelen))
+}
+
+func direntReclen(buf []byte) (uint64, bool) {
+	namelen, ok := direntNamlen(buf)
+	return uint64(direntHeader) + namelen, ok
+}
+
+// ReadDirent reads entries of the directory fd from where the last read
+// stopped.
+func ReadDirent(fd int, buf []byte) (int, error) {
+	const readOn = ^uint64(0) // the cookie that continues the descriptor's listing
+	request := struct {
+		descriptor, maximumEntries uint32
+		cookie, reserved           uint64
+	}{uint32(fd), uint32(len(buf) / int(direntHeader)), readOn, 0}
+	if request.maximumEntries == 0 {
+		return 0, EINVAL
+	}
+	n, err := call(opFdReadDirectory, unsafe.Pointer(&request), unsafe.Sizeof(request), unsafe.Pointer(&buf[0]), uintptr(len(buf)))
+	runtime.KeepAlive(buf)
+	return n, err
+}
+
+func RandomGet(b []byte) error {
+	for len(b) > 0 {
+		chunk := b[:min(len(b), dollyPacketLimit)]
+		if _, err := call(opRandom, nil, 0, unsafe.Pointer(&chunk[0]), uintptr(len(chunk))); err != nil {
+			return err
+		}
+		b = b[len(chunk):]
+	}
+	return nil
+}
+
+const (
+	LOCK_SH = 0x1
+	LOCK_EX = 0x2
+	LOCK_NB = 0x4
+	LOCK_UN = 0x8
+)
+
+const opFdLock = 59
+
+// Flock locks the whole file fd is open on, as flock(2): the lock belongs to
+// the open file description. A lock that must wait polls, as Wait4 does, so
+// that a goroutine of this process holding the lock can release it.
+func Flock(fd int, how int) error {
+	request := struct {
+		descriptor, flags, kind, whence uint32
+		start, length                   int64
+	}{descriptor: uint32(fd), flags: 1} // DOLLY_PROCESS_LOCK_DESCRIPTION
+	switch {
+	case how&LOCK_UN != 0:
+		request.kind = 2
+	case how&LOCK_EX != 0:
+		request.kind = 1
+	case how&LOCK_SH != 0:
+		request.kind = 0
+	default:
+		return EINVAL
+	}
+	for delay := int64(100e3); ; delay = min(2*delay, 10e6) {
+		_, err := call(opFdLock, unsafe.Pointer(&request), unsafe.Sizeof(request), nil, 0)
+		if err != EAGAIN || how&LOCK_NB != 0 {
+			return err
+		}
+		dollySleep(delay)
+	}
+}
