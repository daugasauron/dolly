diff --git a/src/runtime/netpoll_dolly.go b/src/runtime/netpoll_dolly.go
new file mode 100644
index 00000000..930c134d
--- /dev/null
+++ b/src/runtime/netpoll_dolly.go
@@ -0,0 +1,142 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build dolly
+
+package runtime
+
+import "unsafe"
+
+// Dolly's network poller. FD_POLL is level triggered, like poll(2): every
+// armed descriptor is a query, and a ready one is disarmed and its goroutine
+// readied. Its deadline is absolute monotonic time; zero does not block and
+// all ones waits without a limit.
+
+const (
+	_DOLLY_POLL_READ    = 1 << 0
+	_DOLLY_POLL_WRITE   = 1 << 1
+	_DOLLY_POLL_ERROR   = 1 << 3
+	_DOLLY_POLL_HANGUP  = 1 << 4
+	_DOLLY_POLL_INVALID = 1 << 5
+)
+
+var (
+	pollMutex mutex
+	// The registered descriptors, and the armed ones of the current poll
+	// (pollDescs live outside the heap: netpoll may not write pointers).
+	pollRegistered []*pollDesc
+	pollArmed      []uintptr
+	// FD_POLL's packets: a 16-byte header, then 8 bytes per armed descriptor.
+	pollRequest, pollResponse []byte
+)
+
+func netpollinit() {
+	pollRequest = make([]byte, 16+8*16)
+	pollResponse = make([]byte, 16+8*16)
+}
+
+func netpollIsPollDescriptor(fd uintptr) bool {
+	return false
+}
+
+func netpollopen(fd uintptr, pd *pollDesc) int32 {
+	lock(&pollMutex)
+	pd.user = 0
+	pollRegistered = append(pollRegistered, pd)
+	if size := 16 + 8*len(pollRegistered); size > len(pollRequest) {
+		pollRequest = make([]byte, 2*size)
+		pollResponse = make([]byte, 2*size)
+	}
+	if len(pollRegistered) > len(pollArmed) {
+		pollArmed = make([]uintptr, 2*len(pollRegistered))
+	}
+	unlock(&pollMutex)
+	return 0
+}
+
+func netpollarm(pd *pollDesc, mode int) {
+	lock(&pollMutex)
+	if mode == 'r' {
+		pd.user |= _DOLLY_POLL_READ
+	} else {
+		pd.user |= _DOLLY_POLL_WRITE
+	}
+	unlock(&pollMutex)
+}
+
+func netpollclose(fd uintptr) int32 {
+	lock(&pollMutex)
+	for i, pd := range pollRegistered {
+		if pd.fd == fd {
+			last := len(pollRegistered) - 1
+			pollRegistered[i] = pollRegistered[last]
+			pollRegistered[last] = nil
+			pollRegistered = pollRegistered[:last]
+			break
+		}
+	}
+	unlock(&pollMutex)
+	return 0
+}
+
+func netpollBreak() {}
+
+func netpoll(delay int64) (gList, int32) {
+	lock(&pollMutex)
+	armed := 0
+	for _, pd := range pollRegistered {
+		if pd.user != 0 {
+			query := unsafe.Pointer(&pollRequest[16+8*armed])
+			*(*uint32)(query) = uint32(pd.fd)
+			*(*uint32)(unsafe.Add(query, 4)) = pd.user // events, then a zero reserved field
+			pollArmed[armed] = uintptr(unsafe.Pointer(pd))
+			armed++
+		}
+	}
+	if armed == 0 && delay < 0 {
+		unlock(&pollMutex)
+		return gList{}, 0
+	}
+	deadline := uint64(0)
+	if delay < 0 {
+		deadline = ^uint64(0)
+	} else if delay > 0 {
+		deadline = uint64(nanotime() + delay)
+	}
+	*(*uint64)(unsafe.Pointer(&pollRequest[0])) = deadline
+	*(*uint64)(unsafe.Pointer(&pollRequest[8])) = uint64(armed) // count, then a zero reserved field
+	size := uint64(16 + 8*armed)
+	result := dollySyscall(_DOLLY_FD_POLL, unsafe.Pointer(&pollRequest[0]), size, unsafe.Pointer(&pollResponse[0]), size)
+	if result == -_EINTR {
+		// A signal ended the wait: the scheduler recomputes it.
+		unlock(&pollMutex)
+		return gList{}, 0
+	}
+	if result != int64(size) {
+		println("runtime: FD_POLL of", armed, "descriptors returned", result)
+		throw("netpoll failed")
+	}
+	var toRun gList
+	delta := int32(0)
+	for i, address := range pollArmed[:armed] {
+		pd := (*pollDesc)(unsafe.Pointer(address))
+		events := uint32(*(*uint16)(unsafe.Pointer(&pollResponse[16+8*i])))
+		failed := events&(_DOLLY_POLL_ERROR|_DOLLY_POLL_HANGUP|_DOLLY_POLL_INVALID) != 0
+		var mode int32
+		if pd.user&_DOLLY_POLL_READ != 0 && (events&_DOLLY_POLL_READ != 0 || failed) {
+			mode += 'r'
+			pd.user &^= _DOLLY_POLL_READ
+		}
+		if pd.user&_DOLLY_POLL_WRITE != 0 && (events&_DOLLY_POLL_WRITE != 0 || failed) {
+			mode += 'w'
+			pd.user &^= _DOLLY_POLL_WRITE
+		}
+		if mode != 0 {
+			pd.setEventErr(events&(_DOLLY_POLL_ERROR|_DOLLY_POLL_INVALID) != 0, 0)
+			delta += netpollready(&toRun, pd, mode)
+		}
+	}
+	unlock(&pollMutex)
+	return toRun, delta
+}
diff --git a/src/runtime/os_dolly.go b/src/runtime/os_dolly.go
new file mode 100644
index 00000000..b450589e
--- /dev/null
+++ b/src/runtime/os_dolly.go
@@ -0,0 +1,204 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build dolly
+
+package runtime
+
+import "unsafe"
+
+// A Dolly process has one import: dolly_process_0.call, which makes an
+// operation of Dolly's process contract (include/dolly/process.h) with a
+// request and a response packet. A non-negative result is the size of the
+// response; a negative one is a negated Dolly error number.
+//
+//go:wasmimport dolly_process_0 call
+//go:noescape
+func dollyCall(operation uint32, request unsafe.Pointer, requestSize uint64, response unsafe.Pointer, responseCapacity uint64) int64
+
+// Operations, errors and signals of include/dolly/process.h.
+const (
+	_DOLLY_ARGUMENT_SIZES     = 1
+	_DOLLY_ARGUMENTS          = 2
+	_DOLLY_ENVIRONMENT_SIZES  = 3
+	_DOLLY_ENVIRONMENT        = 4
+	_DOLLY_EXIT               = 5
+	_DOLLY_FD_WRITE           = 17
+	_DOLLY_CLOCK_TIME         = 48
+	_DOLLY_RANDOM             = 49
+	_DOLLY_CLOCK_SLEEP        = 53
+	_DOLLY_FD_POLL            = 54
+	_DOLLY_INTERRUPT_POLL     = 66
+	_DOLLY_SIGNAL_ACKNOWLEDGE = 69
+
+	_EINTR = 27
+
+	_DOLLY_CLOCK_REALTIME  = 0
+	_DOLLY_CLOCK_MONOTONIC = 1
+
+	_DOLLY_SIGCHLD  = 17
+	_DOLLY_SIGWINCH = 28
+)
+
+// dollySyscall is dollyCall for operations that the kernel may interrupt with
+// a signal (all but EXIT and the signal operations). The signal is taken,
+// then the operation is made again; a sleep or a poll instead returns EINTR to
+// its caller, which recomputes its deadline. Go handles no signal on Dolly:
+// SIGCHLD and SIGWINCH are ignored and any other takes its default action,
+// ending the process.
+//
+//go:nosplit
+func dollySyscall(operation uint32, request unsafe.Pointer, requestSize uint64, response unsafe.Pointer, responseCapacity uint64) int64 {
+	for {
+		result := dollyCall(operation, request, requestSize, response, responseCapacity)
+		if result != -_EINTR || !dollyTakeSignal() ||
+			operation == _DOLLY_CLOCK_SLEEP || operation == _DOLLY_FD_POLL {
+			return result
+		}
+	}
+}
+
+// dollyTakeSignal takes the signal that interrupted a call, if any, and
+// reports whether there was one.
+//
+//go:nosplit
+func dollyTakeSignal() bool {
+	var number, remaining int32
+	if dollyCall(_DOLLY_INTERRUPT_POLL, nil, 0, unsafe.Pointer(&number), 4) != 4 || number == 0 {
+		return false
+	}
+	if number != _DOLLY_SIGCHLD && number != _DOLLY_SIGWINCH {
+		dollyExit(128+uint32(number), uint32(number))
+	}
+	dollyCall(_DOLLY_SIGNAL_ACKNOWLEDGE, unsafe.Pointer(&number), 4, unsafe.Pointer(&remaining), 4)
+	return true
+}
+
+//go:linkname syscall_dollyCall syscall.dollyCall
+//go:nosplit
+func syscall_dollyCall(operation uint32, request unsafe.Pointer, requestSize uint64, response unsafe.Pointer, responseCapacity uint64) int64 {
+	return dollySyscall(operation, request, requestSize, response, responseCapacity)
+}
+
+//go:linkname syscall_dollySleep syscall.dollySleep
+func syscall_dollySleep(ns int64) {
+	timeSleep(ns)
+}
+
+//go:nosplit
+func dollyExit(status, signal uint32) {
+	request := [2]uint32{status, signal}
+	dollyCall(_DOLLY_EXIT, unsafe.Pointer(&request), 8, nil, 0)
+	throw("dolly: exit returned")
+}
+
+//go:nosplit
+func exit(code int32) {
+	dollyExit(uint32(code)&0xff, 0)
+}
+
+// writeBuffer holds one FD_WRITE packet of write1: its header and the bytes.
+var writeBuffer [16 + 4096]byte
+
+func write1(fd uintptr, p unsafe.Pointer, n int32) int32 {
+	if n > int32(len(writeBuffer)-16) {
+		n = int32(len(writeBuffer) - 16)
+	}
+	*(*uint32)(unsafe.Pointer(&writeBuffer[0])) = uint32(fd)
+	*(*uint32)(unsafe.Pointer(&writeBuffer[4])) = 0
+	*(*uint64)(unsafe.Pointer(&writeBuffer[8])) = uint64(n)
+	memmove(unsafe.Pointer(&writeBuffer[16]), p, uintptr(n))
+	var written uint64
+	if dollySyscall(_DOLLY_FD_WRITE, unsafe.Pointer(&writeBuffer[0]), 16+uint64(n), unsafe.Pointer(&written), 8) < 0 {
+		return -1
+	}
+	return int32(written)
+}
+
+func usleep(usec uint32) {
+	request := struct {
+		clock, flags uint32
+		deadline     uint64
+	}{_DOLLY_CLOCK_MONOTONIC, 0, uint64(nanotime1()) + uint64(usec)*1000}
+	dollySyscall(_DOLLY_CLOCK_SLEEP, unsafe.Pointer(&request), 16, nil, 0)
+}
+
+func readRandom(r []byte) int {
+	if len(r) == 0 || dollySyscall(_DOLLY_RANDOM, nil, 0, unsafe.Pointer(&r[0]), uint64(len(r))) != int64(len(r)) {
+		return 0
+	}
+	return len(r)
+}
+
+// dollyStrings reads the process's arguments or environment: NUL-terminated
+// strings, as many as the sizes operation reports.
+func dollyStrings(sizesOperation, bytesOperation uint32) []string {
+	var sizes struct {
+		count, reserved uint32
+		bytes           uint64
+	}
+	if dollySyscall(sizesOperation, nil, 0, unsafe.Pointer(&sizes), 16) != 16 {
+		throw("dolly: cannot read the process's vector sizes")
+	}
+	list := make([]string, sizes.count)
+	if sizes.count == 0 {
+		return list
+	}
+	buf := make([]byte, sizes.bytes)
+	if dollySyscall(bytesOperation, nil, 0, unsafe.Pointer(&buf[0]), sizes.bytes) != int64(sizes.bytes) {
+		throw("dolly: cannot read the process's vector")
+	}
+	start := 0
+	for i := range list {
+		end := start
+		for buf[end] != 0 {
+			end++
+		}
+		list[i] = string(buf[start:end])
+		start = end + 1
+	}
+	return list
+}
+
+func goenvs() {
+	argslice = dollyStrings(_DOLLY_ARGUMENT_SIZES, _DOLLY_ARGUMENTS)
+	envs = dollyStrings(_DOLLY_ENVIRONMENT_SIZES, _DOLLY_ENVIRONMENT)
+}
+
+//go:nosplit
+func dollyClock(clock uint32) uint64 {
+	request := struct {
+		clock, reserved uint32
+		precision       uint64
+	}{clock, 0, 0}
+	var nanoseconds uint64
+	if dollySyscall(_DOLLY_CLOCK_TIME, unsafe.Pointer(&request), 16, unsafe.Pointer(&nanoseconds), 8) != 8 {
+		throw("dolly: clock failed")
+	}
+	return nanoseconds
+}
+
+func walltime() (sec int64, nsec int32) {
+	t := dollyClock(_DOLLY_CLOCK_REALTIME)
+	return int64(t / 1e9), int32(t % 1e9)
+}
+
+func nanotime1() int64 {
+	return int64(dollyClock(_DOLLY_CLOCK_MONOTONIC))
+}
+
+func resetMemoryDataView() {}
+
+// sched_yield is wasip1's hint to the host, which Dolly does not need.
+func sched_yield() int32 { return 0 }
+
+//go:nowritebarrierrec
+//go:nosplit
+func libpreinit() {}
+
+//go:nowritebarrierrec
+//go:nosplit
+func newosproc0(stacksize uintptr, fn unsafe.Pointer) {
+	throw("bad newosproc0")
+}
