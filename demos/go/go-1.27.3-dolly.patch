diff --git a/src/runtime/asm_wasm.h b/src/runtime/asm_wasm.h
new file mode 100644
index 00000000..15dbacc9
--- /dev/null
+++ b/src/runtime/asm_wasm.h
@@ -0,0 +1,21 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Go pointers are i64 in WebAssembly. GOARCH=wasm addresses a 32-bit linear
+// memory and keeps SP in an i32; GOARCH=wasm64 addresses a 64-bit linear
+// memory (memory64), so a pointer is an address and SP is an i64.
+
+#ifdef GOARCH_wasm64
+#define WrapAddress
+#define ExtendSP
+#define SPConst I64Const
+#define SPAdd I64Add
+#define SPSub I64Sub
+#else
+#define WrapAddress I32WrapI64
+#define ExtendSP I64ExtendI32U
+#define SPConst I32Const
+#define SPAdd I32Add
+#define SPSub I32Sub
