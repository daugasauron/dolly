diff --git a/src/cmd/link/internal/wasm/dolly.go b/src/cmd/link/internal/wasm/dolly.go
new file mode 100644
index 00000000..f34317a8
--- /dev/null
+++ b/src/cmd/link/internal/wasm/dolly.go
@@ -0,0 +1,42 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package wasm
+
+import (
+	"cmd/link/internal/ld"
+	"cmd/link/internal/loader"
+	"encoding/binary"
+)
+
+// A Dolly process (GOOS=dolly) imports a shared memory64 as env.memory, up to
+// the ceiling of Dolly's abi/dolly-process-0.wat, and names the process
+// contract it was linked against and its memory limits in the dolly.process
+// and dolly.process.memory sections, as Dolly's cc stamps them.
+
+const dollyMaximumMemoryPages = 131072 // 8 GiB
+
+func writeDollyMemoryImport(ctxt *ld.Link, ldr *loader.Loader) {
+	writeName(ctxt.Out, "env")
+	writeName(ctxt.Out, "memory")
+	ctxt.Out.WriteByte(0x02) // memory import
+	ctxt.Out.WriteByte(0x07) // a maximum, shared, 64-bit addresses
+	writeUleb128(ctxt.Out, initialMemoryPages(ldr))
+	writeUleb128(ctxt.Out, dollyMaximumMemoryPages)
+}
+
+func writeDollySecs(ctxt *ld.Link, ldr *loader.Loader) {
+	sizeOffset := writeSecHeader(ctxt, sectionCustom)
+	writeName(ctxt.Out, "dolly.process")
+	ctxt.Out.Write(dollyProcessABIDigest[:])
+	writeSecSize(ctxt, sizeOffset)
+
+	var limits [16]byte
+	binary.LittleEndian.PutUint64(limits[:8], initialMemoryPages(ldr))
+	binary.LittleEndian.PutUint64(limits[8:], dollyMaximumMemoryPages)
+	sizeOffset = writeSecHeader(ctxt, sectionCustom)
+	writeName(ctxt.Out, "dolly.process.memory")
+	ctxt.Out.Write(limits[:])
+	writeSecSize(ctxt, sizeOffset)
+}
