diff --git a/src/syscall/exec_dolly.go b/src/syscall/exec_dolly.go
new file mode 100644
index 00000000..749973ef
--- /dev/null
+++ b/src/syscall/exec_dolly.go
@@ -0,0 +1,178 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build dolly
+
+package syscall
+
+import (
+	"internal/bytealg"
+	"sync"
+	"unsafe"
+)
+
+// Processes on Dolly are spawned, not forked: SPAWN starts a program with
+// its arguments, environment, working directory and descriptors in one
+// operation, and WAIT reaps it.
+
+// ForkLock is not needed by StartProcess, which forks nothing; os and
+// net still take it around descriptor creation.
+var ForkLock sync.RWMutex
+
+type ProcAttr struct {
+	Dir   string    // Current working directory.
+	Env   []string  // Environment.
+	Files []uintptr // File descriptors.
+	Sys   *SysProcAttr
+}
+
+// SysProcAttr has no Dolly attributes.
+type SysProcAttr struct{}
+
+type spawnRequest struct {
+	flags                 uint32
+	argumentCount         uint32
+	environmentCount      uint32
+	cwdSize               uint32
+	mappingCount          uint32
+	descriptorInheritance uint32
+	reserved              uint32
+	pathSize              uint32
+	argumentBytes         uint64
+	environmentBytes      uint64
+	deadline              uint64
+}
+
+// StartProcess starts argv0, relative to attr.Dir when it is relative, with
+// attr.Files as its descriptors 0, 1, 2 and up (a negative one stays closed),
+// and attr.Env as its whole environment.
+func StartProcess(argv0 string, argv []string, attr *ProcAttr) (pid int, handle uintptr, err error) {
+	if attr == nil {
+		attr = &ProcAttr{}
+	}
+	if len(argv) == 0 || len(argv0) == 0 {
+		return 0, 0, EINVAL
+	}
+	dir := attr.Dir
+	if dir == "" || dir[0] != '/' {
+		wd, err := Getwd()
+		if err != nil {
+			return 0, 0, err
+		}
+		if dir != "" {
+			dir = wd + "/" + dir
+		} else {
+			dir = wd
+		}
+	}
+	path := argv0
+	if path[0] != '/' {
+		path = dir + "/" + path
+	}
+	for _, s := range append(append([]string{path, dir}, argv...), attr.Env...) {
+		if bytealg.IndexByteString(s, 0) >= 0 {
+			return 0, 0, EINVAL
+		}
+	}
+	request := spawnRequest{
+		argumentCount:    uint32(len(argv)),
+		environmentCount: uint32(len(attr.Env)),
+		cwdSize:          uint32(len(dir)),
+		pathSize:         uint32(len(path)),
+		deadline:         ^uint64(0),
+	}
+	var mappings []byte
+	for target, source := range attr.Files {
+		if int(source) >= 0 {
+			mappings = append(mappings, unsafe.Slice((*byte)(unsafe.Pointer(&[2]uint32{uint32(source), uint32(target)})), 8)...)
+			request.mappingCount++
+		}
+	}
+	strings := func(list []string) (b []byte) {
+		for _, s := range list {
+			b = append(append(b, s...), 0)
+		}
+		return b
+	}
+	arguments, environment := strings(argv), strings(attr.Env)
+	request.argumentBytes, request.environmentBytes = uint64(len(arguments)), uint64(len(environment))
+	packet := unsafe.Slice((*byte)(unsafe.Pointer(&request)), unsafe.Sizeof(request))
+	packet = append(append(append(append(append(packet[:len(packet):len(packet)], path...), arguments...), environment...), dir...), mappings...)
+	if len(packet) > dollyPacketLimit {
+		return 0, 0, E2BIG
+	}
+	var response [2]uint32
+	if _, err := call(opSpawn, unsafe.Pointer(&packet[0]), uintptr(len(packet)), unsafe.Pointer(&response), 8); err != nil {
+		return 0, 0, err
+	}
+	return int(response[0]), 0, nil
+}
+
+// Exec is not available: Dolly spawns.
+func Exec(argv0 string, argv []string, envv []string) error {
+	return ENOSYS
+}
+
+const (
+	WNOHANG = 1
+)
+
+// A WaitStatus is a child's exit status, and 128 plus the signal that
+// ended it in its upper bits.
+type WaitStatus struct {
+	status uint32
+	signal uint32
+}
+
+func (w WaitStatus) Exited() bool       { return w.signal == 0 }
+func (w WaitStatus) ExitStatus() int {
+	if w.Signaled() {
+		return -1
+	}
+	return int(w.status)
+}
+func (w WaitStatus) Signaled() bool     { return w.signal != 0 }
+func (w WaitStatus) Signal() Signal     { return Signal(w.signal) }
+func (w WaitStatus) CoreDump() bool     { return false }
+func (w WaitStatus) Stopped() bool      { return false }
+func (w WaitStatus) Continued() bool    { return false }
+func (w WaitStatus) StopSignal() Signal { return 0 }
+func (w WaitStatus) TrapCause() int     { return 0 }
+
+// Rusage is empty: Dolly does not account a child's time.
+type Rusage struct {
+	Utime Timeval
+	Stime Timeval
+}
+
+// Wait4 waits for the child pid, or any child when pid is -1 or 0. A wait
+// that would block polls instead, so that the program's other goroutines,
+// which may be reading the child's output, keep running.
+func Wait4(pid int, wstatus *WaitStatus, options int, rusage *Rusage) (wpid int, err error) {
+	if pid < -1 {
+		return 0, ENOSYS // Dolly has no process groups.
+	}
+	request := [2]uint32{uint32(max(pid, 0)), dollyWaitNonblock}
+	var response [4]uint32
+	for delay := int64(100e3); ; delay = min(2*delay, 10e6) {
+		_, err := call(opWait, unsafe.Pointer(&request), 8, unsafe.Pointer(&response), 16)
+		if err == nil {
+			break
+		}
+		if err != EAGAIN {
+			return 0, err
+		}
+		if options&WNOHANG != 0 {
+			return 0, nil
+		}
+		dollySleep(delay)
+	}
+	if wstatus != nil {
+		*wstatus = WaitStatus{response[1], response[2]}
+	}
+	if rusage != nil {
+		*rusage = Rusage{}
+	}
+	return int(response[0]), nil
+}
