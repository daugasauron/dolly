DOLLY 7
PACKAGE go
REQUIRES HOST runtime@0
# go downloads modules with net/http, which records http@0.
REQUIRES HOST http@0

# Go as Dolly builds it, in its GOROOT: the seed's go command compiles the
# toolchain and the standard library from the seed's sources again, every
# package (-a), with the flags of upstream's release build (cmd/dist's
# toolenv), and installs it over the seed's. The build fails unless every
# command is, byte for byte, the seed's. The commands start it by its own
# path, from which it finds its GOROOT.
FROM /v0.1.4/demos/go/Dollyfile-go-sdk 5d83414e352e80f0ee4a6df5bf4c83893ab4c59b82765c05f0791f1de34d1fa5
REQUIRES TOOL go
SLOP mkdir -p /tmp/seed
SLOP cp -R /usr/lib/go/pkg/tool/dolly_wasm64 /tmp/seed/tool
SLOP cp -R /usr/lib/go/bin /tmp/seed/bin
# Two compiles at a time, each held near 2 GiB: compiling cmd/compile/internal/ssa
# can grow a process to 3.9 GiB with the default collector (1.8 GB natively).
# A spawn waits for a slot beside at most one compile, so the processes stay
# under the 4 GiB a spawn is admitted below, and the build in its 6 GB.
SLOP CWD /usr/lib/go/src CGO_ENABLED=0 GOCACHE=/tmp/go-cache GOMEMLIMIT=2GiB GOFLAGS='-trimpath -ldflags=-w -gcflags=cmd/...=-dwarf=false' go install -a -p 2 cmd/go cmd/gofmt cmd/asm cmd/cgo cmd/compile cmd/cover cmd/fix cmd/link cmd/preprofile cmd/vet
# The rebuilt toolchain compares itself with the seed.
FILE /tmp/same/main.go
    // Fails unless each file of the first directory is, byte for byte, the
    // file of its name in the second.
    package main
    
    import (
    	"bytes"
    	"fmt"
    	"os"
    	"path/filepath"
    )
    
    func main() {
    	entries, err := os.ReadDir(os.Args[1])
    	if err != nil {
    		panic(err)
    	}
    	for _, entry := range entries {
    		seed, seedErr := os.ReadFile(filepath.Join(os.Args[1], entry.Name()))
    		built, builtErr := os.ReadFile(filepath.Join(os.Args[2], entry.Name()))
    		if seedErr != nil || builtErr != nil || !bytes.Equal(seed, built) {
    			fmt.Fprintf(os.Stderr, "%s is not the seed's\n", entry.Name())
    			os.Exit(1)
    		}
    	}
    	fmt.Printf("%d programs equal the seed's\n", len(entries))
    }
SLOP GOCACHE=/tmp/go-cache go run /tmp/same/main.go /tmp/seed/tool /usr/lib/go/pkg/tool/dolly_wasm64
SLOP GOCACHE=/tmp/go-cache go run /tmp/same/main.go /tmp/seed/bin /usr/lib/go/bin
SLOP go version


FILE /usr/bin/go
    #!/bin/slop
    /usr/lib/go/bin/go "$@"
FILE /usr/bin/gofmt
    #!/bin/slop
    /usr/lib/go/bin/gofmt "$@"
EXPORTS TOOL go
EXPORTS TOOL gofmt
# go.env's GOTOOLCHAIN=auto would fetch newer toolchains, which do not run here.
EXPORTS ENV GOTOOLCHAIN local
# runtime.NumCPU is 1, so go would compile one package at a time; four halve
# the time of a small module's first build.
EXPORTS ENV GOFLAGS -p=4
EXPORTS FOLDER go-root /usr/lib/go
FILE /usr/share/man/cat1/go.1
    go: the Go toolchain (Go 1.27.3) for GOOS=dolly GOARCH=wasm64, built inside
    Dolly from its pinned sources.
    
      go build              compiles a package and its dependencies
      go run main.go        compiles and runs a program
      gofmt -l .            lists files whose formatting differs
    
    Programs are pure Go: there is no cgo, and they run single-threaded.
    go builds four packages at a time (GOFLAGS=-p=4).
    net/http goes through the page's HTTP broker (its policy, and CORS), so
    go get works with proxy.golang.org; net's sockets reach nothing.
    signal.Notify receives the kernel's signals; syscall.Exec replaces the
    program. Upstream's documentation: https://go.dev/doc/
