DOLLY 7
PACKAGE libpng
REQUIRES HOST runtime@0

# libpng from upstream's release archive, unchanged, built by its CMake
# project, for programs the cc package builds, with the zlib it needs.
FROM /v0.1.4/demos/cmake/Dollyfile-cmake-build e9a42d1ad1b8c35d3a6543a28306dc2d88e90e114bd3e6df892ffec05fbcfd5f
INSTALL /v0.1.4/Dollyfile-zlib 7f3254e8d51bc7edd2fa47b19f3b1e2e43c747476ab93c57654639e4119abde7
REQUIRES HEADER libc
REQUIRES HEADER zlib
REQUIRES LIB z
REQUIRES TOOL cmake
REQUIRES TOOL gzip
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/libpng/source.tar.gz 5a53d9b0aeeea4bb3a17fbf071089afe98c8e3e00a3edc9bb8ac516c163ed351 /tmp/libpng.tar.gz
SLOP gzip -dc /tmp/libpng.tar.gz | tar -xf - -C /
SLOP cmake -S /tmp/libpng -B /tmp/libpng-build -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_SHARED_LIBS=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -DPNG_SHARED=OFF -DPNG_TESTS=OFF -DPNG_TOOLS=OFF -DPNG_EXECUTABLES=OFF
SLOP cmake --build /tmp/libpng-build -j4
SLOP cmake --install /tmp/libpng-build

EXPORTS LIB    png16      /usr/lib/libpng16.a
EXPORTS LIB    png        /usr/lib/libpng.a
EXPORTS HEADER png        /usr/include/png.h
EXPORTS HEADER pngconf    /usr/include/pngconf.h
EXPORTS HEADER pnglibconf /usr/include/pnglibconf.h
EXPORTS HEADER libpng16   /usr/include/libpng16
FILE /usr/lib/pkgconfig/libpng16.pc
FILE /usr/lib/pkgconfig/libpng.pc
FILE /usr/share/licenses/libpng/LICENSE
SLOP rm -rf /tmp/libpng /tmp/libpng-build /tmp/libpng.tar.gz
