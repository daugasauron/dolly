DOLLY 7
PACKAGE freetype
REQUIRES HOST runtime@0

# FreeType from upstream's release archive, unchanged, built by its CMake
# project, for programs the cc package builds, with the libpng and zlib it
# reads fonts with.
FROM /v0.1.4/demos/cmake/Dollyfile-cmake-build 3f9cc07612be5e715df223d8957857350c9f97761ae631c13f949870da3cfff6
INSTALL /v0.1.4/demos/zero-ad/Dollyfile-libpng 7115f2637e21fda3b33b54394c59f5138bf22ef6339c14267c4a5c744f108100
REQUIRES HEADER libc
REQUIRES HEADER png
REQUIRES HEADER zlib
REQUIRES LIB png16
REQUIRES LIB z
REQUIRES TOOL cmake
REQUIRES TOOL gzip
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/freetype/source.tar.gz 045b71defb2d966dd1452aca8425a50842772ec28961b74804640cd638cca984 /tmp/freetype.tar.gz
SLOP gzip -dc /tmp/freetype.tar.gz | tar -xf - -C /
SLOP cmake -S /tmp/freetype -B /tmp/freetype-build -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_SHARED_LIBS=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -DFT_DISABLE_BZIP2=ON -DFT_DISABLE_HARFBUZZ=ON -DFT_DISABLE_BROTLI=ON -DFT_REQUIRE_ZLIB=ON -DFT_REQUIRE_PNG=ON
SLOP cmake --build /tmp/freetype-build -j4
SLOP cmake --install /tmp/freetype-build

EXPORTS LIB    freetype  /usr/lib/libfreetype.a
EXPORTS HEADER freetype2 /usr/include/freetype2
FILE /usr/lib/pkgconfig/freetype2.pc
FOLDER /usr/share/licenses/freetype
SLOP rm -rf /tmp/freetype /tmp/freetype-build /tmp/freetype.tar.gz
