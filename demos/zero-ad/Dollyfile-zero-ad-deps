DOLLY 7
TOOLCHAIN zero-ad-deps
REQUIRES HOST runtime@0
REQUIRES HOST audio@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

# Build-only: the libraries the 0 A.D. engine links, installed from their
# packages, and ENet with Dolly's transport built here from the pinned upstream
# source of build-sources.tsv; pkgconf for its premake scripts.
FROM /v0.1.5/Dollyfile-system-tools 39e8ad7c80d06b7a0c420bbeaae2e6b2423e7e633d38640e82d72a73c20e232a
INSTALL /v0.1.5/demos/zero-ad/Dollyfile-openal 0f3cea1aeb11fca7fe8e37d6c78a756bdc41a159e5ce7032594cada2b5e6460b
INSTALL /v0.1.5/demos/zero-ad/Dollyfile-pkgconf 093ecdba243fbc62c20fd1c9c51aef92ed4a8f256f5500944e8011c832a95258
INSTALL /v0.1.5/demos/zero-ad/Dollyfile-freetype 678cbfa3ebea858fe30f962853897958e256d1adf145fb8062fc0c5fc390ec6d
INSTALL /v0.1.5/demos/xonotic/Dollyfile-libvorbis ab7723d060e33e116f8fc93bc2a67c50b5a9bff4959a9c81104ace47ac8889b1
INSTALL /v0.1.5/demos/zero-ad/Dollyfile-fmt 50edebb34c1bb667fa35f2dc0b20633ca76f23baae1277829ac7f5e489b122b0
INSTALL /v0.1.5/demos/zero-ad/Dollyfile-libxml2 fa068ab84f77e6c6deb408aa098dc83b1fabb19858201342db1308f57a2bef2a
INSTALL /v0.1.5/demos/zero-ad/Dollyfile-libsodium ce5e6bc926442c044596ff843f0b2229f22c7509a43da929d1bbc77d3560139a
INSTALL /v0.1.5/demos/zero-ad/Dollyfile-boost-headers 289d198b97a9d809c5f97d44787e3562936d811315c2633ca38dd3e0e45ea819
INSTALL /v0.1.5/demos/zero-ad/Dollyfile-icu a2994aa6215c1d5227de5143385e9cba3892f529016b241169816639f0f7767f
COPY /v0.1.5/demos/sdl2/Dollyfile-sdl2 cd864c7c3220d915822ca58199fe4df7c7f2e5fb21d34c77a6aa86f77ed466dc /usr/include/SDL2 /usr/include/SDL2
COPY /v0.1.5/demos/sdl2/Dollyfile-sdl2 cd864c7c3220d915822ca58199fe4df7c7f2e5fb21d34c77a6aa86f77ed466dc /usr/lib/libSDL2.a /usr/lib/libSDL2.a
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

SOURCE /v0.1.5/dist/static/zero-ad-build/deps.tar.gz 18922d6461ca5e99d0c62930aae4c3f7f65f5c19d20fe98a711e225e9e8c3048 /tmp/zad/deps.tar.gz
SLOP gzip -dc /tmp/zad/deps.tar.gz | tar -xf - -C /
# Licences of the libraries the engine links; zero-ad copies them.
COPY /v0.1.5/demos/sdl2/Dollyfile-sdl2 cd864c7c3220d915822ca58199fe4df7c7f2e5fb21d34c77a6aa86f77ed466dc /usr/share/licenses/SDL2 /usr/share/licenses/SDL2
FOLDER /usr/share/licenses

# ENet keeps its protocol; dolly.c replaces the unix.c and win32.c socket backends.
SLOP cp /tmp/zad/enet-dolly.c /tmp/zad/enet/dolly.c
SLOP rm /tmp/zad/enet/unix.c /tmp/zad/enet/win32.c
FILE /tmp/zad/enet/Makefile
    CFLAGS := -O2 -I/tmp/zad/enet/include
    /usr/lib/libenet.a: $(patsubst %.c,%.o,$(wildcard /tmp/zad/enet/*.c))
    	ar rcs $@ $^
SLOP make -C /tmp/zad/enet -j4
SLOP cp -R /tmp/zad/enet/include/enet /usr/include/

# pkg-config descriptions of SDL2 (copied without its own), of Dolly's libcurl
# and of ENet, built without its upstream build system.
FILE /usr/lib/pkgconfig/sdl2.pc
    Name: sdl2
    Description: Simple DirectMedia Layer
    Version: 2.32.10
    Cflags: -I/usr/include/SDL2
    Libs: -lSDL2 -lm
FILE /usr/lib/pkgconfig/libcurl.pc
    Name: libcurl
    Description: Dolly's libcurl over the HTTP broker
    Version: 8.21.0
    Libs: -lcurl
FILE /usr/lib/pkgconfig/libenet.pc
    Name: libenet
    Description: Low-latency UDP networking library supporting optional reliability
    Version: 1.3.18
    Libs: -lenet
SLOP pkg-config --exists zlib libcurl icu-i18n libsodium libenet libpng freetype2 vorbisfile fmt libxml-2.0 openal sdl2

# Probes for test/0ad-enet-browser.mjs and test/0ad-openal-browser.mjs.
SLOP mkdir -p /usr/libexec/zero-ad
SLOP cc -O1 /tmp/zad/enet-check.c -lenet -o /usr/libexec/zero-ad/enet-check
SLOP c++ -O1 /tmp/zad/openal-check.cpp -lopenal -lm -o /usr/libexec/zero-ad/openal-check
FOLDER /usr/libexec/zero-ad

EXPORTS FOLDER zero-ad-pkgconfig /usr/lib/pkgconfig
EXPORTS HEADER enet /usr/include/enet
EXPORTS LIB enet /usr/lib/libenet.a

ENTRY /bin/foreground -i /bin/slop
