DOLLY 8
TOOLCHAIN zero-ad-deps
REQUIRES HOST runtime@0
REQUIRES HOST audio@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

# Build-only: the libraries the 0 A.D. engine links, installed from their
# packages, and ENet with Dolly's transport built here from the pinned upstream
# source of build-sources.tsv; pkgconf for its premake scripts.
FROM /Dollyfile-system-tools cf31f806ea02b6bed2397c3db9c73677498b0b16a9272dee51581a8e290d6a5e
INSTALL /demos/zero-ad/Dollyfile-openal 8865dba8c0e60b2de8c2e8a8fe445c0b2478c8945930e9309c71c52341cb98b6
INSTALL /demos/zero-ad/Dollyfile-pkgconf 16a083fe1557ece74712e1d5411b574354d2918fc817674b11cbb0cfa5fc2a23
INSTALL /demos/zero-ad/Dollyfile-freetype f705f2c512b4effb0e0cdf6c2959828f2ac57c708d308d260e3a31b08743a4ce
INSTALL /demos/xonotic/Dollyfile-libvorbis 738158431161e1c9332b275dcb82954e6c91f255593b2e93a15f50171ba5f70f
INSTALL /demos/zero-ad/Dollyfile-fmt d064b3352e74e293423fb454c5024bd680f707ed4ed9e66a3fc2b7b03c947faf
INSTALL /demos/zero-ad/Dollyfile-libxml2 dd7c3c5c12f6caa263334db9dda465d8c505062435750a26b2c1f13b93462409
INSTALL /demos/zero-ad/Dollyfile-libsodium f35a8a9edede9b9fd20199c7f3e1b8c82d6b871bc6e5e31f462abc3a77dd831c
INSTALL /demos/zero-ad/Dollyfile-boost-headers 9a8f8dc0309ca2c99ff1f26f3ad11367daea4e3673fd093b80be03f95c02fbcb
INSTALL /demos/zero-ad/Dollyfile-icu 97ae6e153edf68d4b3c8bf96db611961a9213e6b899ccc844319e0113a3971c8
COPY /demos/sdl2/Dollyfile-sdl2 62de791795f4bd4b3d5c04b5b2cdb1c1774be6a3e9eaecbf0343089abdff6bc3 /usr/include/SDL2 /usr/include/SDL2
COPY /demos/sdl2/Dollyfile-sdl2 62de791795f4bd4b3d5c04b5b2cdb1c1774be6a3e9eaecbf0343089abdff6bc3 /usr/lib/libSDL2.a /usr/lib/libSDL2.a
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

SOURCE /dist/static/zero-ad-build/deps.tar.gz 18922d6461ca5e99d0c62930aae4c3f7f65f5c19d20fe98a711e225e9e8c3048 /tmp/zad/deps.tar.gz
SLOP gzip -dc /tmp/zad/deps.tar.gz | tar -xf - -C /
# Licences of the libraries the engine links; zero-ad copies them.
COPY /demos/sdl2/Dollyfile-sdl2 62de791795f4bd4b3d5c04b5b2cdb1c1774be6a3e9eaecbf0343089abdff6bc3 /usr/share/licenses/SDL2 /usr/share/licenses/SDL2
FOLDER /usr/share/licenses

# ENet keeps its protocol; dolly.c replaces the unix.c and win32.c socket backends.
SLOP cp /tmp/zad/enet-dolly.c /tmp/zad/enet/dolly.c
SLOP rm /tmp/zad/enet/unix.c /tmp/zad/enet/win32.c
FILE /tmp/zad/enet/Makefile
    CFLAGS := -O2 -I/tmp/zad/enet/include
    /usr/lib/libenet.a: $(patsubst %.c,%.o,$(wildcard /tmp/zad/enet/*.c))
    	ar rcs $@ $^
SLOP make -C /tmp/zad/enet -j4
SLOP cp -R /tmp/zad/enet/include/enet /usr/include/

# pkg-config descriptions of SDL2 (copied without its own), of Dolly's libcurl
# and of ENet, built without its upstream build system.
FILE /usr/lib/pkgconfig/sdl2.pc
    Name: sdl2
    Description: Simple DirectMedia Layer
    Version: 2.32.10
    Cflags: -I/usr/include/SDL2
    Libs: -lSDL2 -lm
FILE /usr/lib/pkgconfig/libcurl.pc
    Name: libcurl
    Description: Dolly's libcurl over the HTTP broker
    Version: 8.21.0
    Libs: -lcurl
FILE /usr/lib/pkgconfig/libenet.pc
    Name: libenet
    Description: Low-latency UDP networking library supporting optional reliability
    Version: 1.3.18
    Libs: -lenet
SLOP pkg-config --exists zlib libcurl icu-i18n libsodium libenet libpng freetype2 vorbisfile fmt libxml-2.0 openal sdl2

# Probes for test/0ad-enet-browser.mjs and test/0ad-openal-browser.mjs.
SLOP mkdir -p /usr/libexec/zero-ad
SLOP cc -O1 /tmp/zad/enet-check.c -lenet -o /usr/libexec/zero-ad/enet-check
SLOP c++ -O1 /tmp/zad/openal-check.cpp -lopenal -lm -o /usr/libexec/zero-ad/openal-check
FOLDER /usr/libexec/zero-ad

EXPORTS FOLDER zero-ad-pkgconfig /usr/lib/pkgconfig
EXPORTS HEADER enet /usr/include/enet
EXPORTS LIB enet /usr/lib/libenet.a

ENTRY /bin/foreground -i /bin/slop
