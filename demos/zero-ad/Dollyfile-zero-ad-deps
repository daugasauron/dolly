# Build-only: the libraries the 0 A.D. engine links, installed from their
# packages, and ENet with Dolly's transport built here from the pinned upstream
# source of build-sources.tsv; pkgconf for its premake scripts.
FROM /v0.1.7/Dollyfile-system-tools 39e8ab131ead90b0190b992d3a9602854a969b11c0825202303c534cdd4dedb0
INSTALL /v0.1.7/Dollyfile-curl 849a284cda0928f52ae33d5bbb0a8674877c5e86f62d6f1a7c79b9f9860b4694
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-openal 5bd6ef5209f3bd5663d764e356fb3eaffc27ced19923792d2b05371374d5512c
INSTALL /v0.1.7/demos/tools/Dollyfile-pkgconf 9f6c7243ea776e5ea9401d1d22b8d0b46391128f894936ff2ed88c3914d014a8
INSTALL /v0.1.7/demos/tools/Dollyfile-freetype c18f5c7da05eb3a874cc344589ceeb308d8d1e9973f35f1a2ea4710f9799b519
INSTALL /v0.1.7/demos/xonotic/Dollyfile-libvorbis 784a2b138a4b2f2cd2165fffd847079b295309cee395144ee4af1ca928d778d3
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-fmt 5fcf843df7e7db84e4769bdac28e5186cbe29e845a1de0590da4d1201cb460f9
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-libxml2 cc2b3051a15a3443b5d55091d783a5f00722a53481328bb982c1fa31c1e73275
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-libsodium 29e0dff6f9654f72a620fe30be99b3d7500d38084c6f6415c871454beca79ac4
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-boost-headers c9fe25e5a06ba1a2799edb6cb86485d2857c35f53d07f71f51cbeb51bfb434e8
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-icu a764c102d67fb87f7e2b82968c60d5b818a35f66d91ce3f4d9552c8c61f44497
COPY /v0.1.7/demos/sdl2/Dollyfile-sdl2 a4ff5d90279f299907a00814ba6e1760b073f04d360ad8d5e79ef71a68bdcb14 /usr/include/SDL2 /usr/include/SDL2
COPY /v0.1.7/demos/sdl2/Dollyfile-sdl2 a4ff5d90279f299907a00814ba6e1760b073f04d360ad8d5e79ef71a68bdcb14 /usr/lib/libSDL2.a /usr/lib/libSDL2.a
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

SOURCE /v0.1.7/dist/static/zero-ad-build/deps.tar.gz 18922d6461ca5e99d0c62930aae4c3f7f65f5c19d20fe98a711e225e9e8c3048 /tmp/zad/deps.tar.gz
SLOP gzip -dc /tmp/zad/deps.tar.gz | tar -xf - -C /
# Licences of the libraries the engine links; zero-ad copies them.
COPY /v0.1.7/demos/sdl2/Dollyfile-sdl2 a4ff5d90279f299907a00814ba6e1760b073f04d360ad8d5e79ef71a68bdcb14 /usr/share/licenses/SDL2 /usr/share/licenses/SDL2
FOLDER /usr/share/licenses

# ENet keeps its protocol; dolly.c replaces the unix.c and win32.c socket backends.
SLOP cp /tmp/zad/enet-dolly.c /tmp/zad/enet/dolly.c
SLOP rm /tmp/zad/enet/unix.c /tmp/zad/enet/win32.c
FILE /tmp/zad/enet/Makefile
    CFLAGS := -O2 -I/tmp/zad/enet/include
    /usr/lib/libenet.a: $(patsubst %.c,%.o,$(wildcard /tmp/zad/enet/*.c))
    	ar rcs $@ $^
SLOP make -C /tmp/zad/enet -j4
SLOP cp -R /tmp/zad/enet/include/enet /usr/include/

# pkg-config descriptions of SDL2 (copied without its own), of Dolly's libcurl
# and of ENet, built without its upstream build system.
FILE /usr/lib/pkgconfig/sdl2.pc
    Name: sdl2
    Description: Simple DirectMedia Layer
    Version: 2.32.10
    Cflags: -I/usr/include/SDL2
    Libs: -lSDL2 -lm
FILE /usr/lib/pkgconfig/libcurl.pc
    Name: libcurl
    Description: Dolly's libcurl over the HTTP broker
    Version: 8.21.0
    Libs: -lcurl
FILE /usr/lib/pkgconfig/libenet.pc
    Name: libenet
    Description: Low-latency UDP networking library supporting optional reliability
    Version: 1.3.18
    Libs: -lenet
SLOP pkg-config --exists zlib libcurl icu-i18n libsodium libenet libpng freetype2 vorbisfile fmt libxml-2.0 openal sdl2

# Probes for test/0ad-enet-browser.mjs and test/0ad-openal-browser.mjs.
SLOP mkdir -p /usr/libexec/zero-ad
SLOP cc -O1 /tmp/zad/enet-check.c -lenet -o /usr/libexec/zero-ad/enet-check
SLOP c++ -O1 /tmp/zad/openal-check.cpp -lopenal -lm -o /usr/libexec/zero-ad/openal-check
FOLDER /usr/libexec/zero-ad

EXPORTS FOLDER zero-ad-pkgconfig /usr/lib/pkgconfig
EXPORTS HEADER enet /usr/include/enet
EXPORTS LIB enet /usr/lib/libenet.a

ENTRY /bin/foreground -i /bin/slop
