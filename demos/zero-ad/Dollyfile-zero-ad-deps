# Build-only: the libraries the 0 A.D. engine links, installed from their
# packages, and ENet with Dolly's transport built here from the pinned upstream
# source of build-sources.tsv; pkgconf for its premake scripts.
FROM /v0.1.7/Dollyfile-system-tools bf4bd9f3bb45209cbf68e170f74fa8a85f093f10593f36a8f6d3e499ebce4114
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-openal 4e417036ed8b1fbbc3d9b0dd41cf6c5314b488c71041ee056098709be4f7c901
