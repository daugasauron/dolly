FROM /v0.1.3/demos/zero-ad/Dollyfile-openal-build 8f50e9952de730f77f7ebbb5ead92916e588b9ba0dd2acc7b9ccc37a709e5241
INSTALL /v0.1.3/demos/zero-ad/Dollyfile-pkgconf c18f8cbc3bbfc39a39ce07635fe7d7c567b74c60c009d5def10c8358020f80f2
INSTALL /v0.1.3/demos/zero-ad/Dollyfile-freetype 572f17756e45807b5f6d830330ed03db238f2968ce85c3554e24325154820b79
COPY /v0.1.3/demos/sdl2/Dollyfile-sdl2 c4a332c1c6bd61f1a9e758e2942e5cf39ea61c56abbbc6adf6e73539d3813c07 /usr/include/SDL2 /usr/include/SDL2
COPY /v0.1.3/demos/sdl2/Dollyfile-sdl2 c4a332c1c6bd61f1a9e758e2942e5cf39ea61c56abbbc6adf6e73539d3813c07 /usr/lib/libSDL2.a /usr/lib/libSDL2.a
