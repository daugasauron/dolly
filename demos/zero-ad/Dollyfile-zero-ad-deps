# Build-only: the libraries the 0 A.D. engine links, installed from their
# packages, and ENet with Dolly's transport built here from the pinned upstream
# source of build-sources.tsv; pkgconf for its premake scripts.
FROM /v0.1.7/Dollyfile-system-tools 9380fd6bd073b1686808f973290b4654a0889ee96c0df46817a12903968d6ca7
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-openal 38deba3056074d169efc610231513d25a9243565693d61bb137d70006c2c487e
INSTALL /v0.1.7/demos/tools/Dollyfile-pkgconf 89273bd617759f49ac9c7b675e218f37cfe1a8448705a8da7c6cf607c3641645
INSTALL /v0.1.7/demos/tools/Dollyfile-freetype df3b1d0a400ed233fa23d31d09661dbc3298c636d2103f178fc832db7d890f2d
INSTALL /v0.1.7/demos/xonotic/Dollyfile-libvorbis 8621ec596e758ea4e42bc8b7d80873aaa49492e175d4daa857efc78789f9a6c5
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-fmt e56dbbb5d54ac7d5ff99c93dd35b41988dddf443da4c2f0449bcefb938ce78a7
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-libxml2 3861ffc395eeca6ff7b8a3fc723cda4702bdb0f5a283a759a58d6956b3071ddb
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-libsodium a72198e16b691bca7b05b1c4c4bf06763dfe0c4bffd0cb4a52323a906b2fc2e1
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-boost-headers cd333847e64a65b769a13d27229b764c64b8d2f7c5d37d9f935df1b49fbf7704
INSTALL /v0.1.7/demos/zero-ad/Dollyfile-icu c152be8e5e77adf5c1c85bc29d01295844b4f761927c9ac892f7705c8cded593
COPY /v0.1.7/demos/sdl2/Dollyfile-sdl2 535dc42166b0782bc61b508e35fed36cc37ce04215489ffec5c8091cd53c4596 /usr/include/SDL2 /usr/include/SDL2
COPY /v0.1.7/demos/sdl2/Dollyfile-sdl2 535dc42166b0782bc61b508e35fed36cc37ce04215489ffec5c8091cd53c4596 /usr/lib/libSDL2.a /usr/lib/libSDL2.a
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

SOURCE /v0.1.7/dist/static/zero-ad-build/deps.tar.gz 18922d6461ca5e99d0c62930aae4c3f7f65f5c19d20fe98a711e225e9e8c3048 /tmp/zad/deps.tar.gz
SLOP gzip -dc /tmp/zad/deps.tar.gz | tar -xf - -C /
# Licences of the libraries the engine links; zero-ad copies them.
COPY /v0.1.7/demos/sdl2/Dollyfile-sdl2 535dc42166b0782bc61b508e35fed36cc37ce04215489ffec5c8091cd53c4596 /usr/share/licenses/SDL2 /usr/share/licenses/SDL2
FOLDER /usr/share/licenses

# ENet keeps its protocol; dolly.c replaces the unix.c and win32.c socket backends.
SLOP cp /tmp/zad/enet-dolly.c /tmp/zad/enet/dolly.c
SLOP rm /tmp/zad/enet/unix.c /tmp/zad/enet/win32.c
FILE /tmp/zad/enet/Makefile
    CFLAGS := -O2 -I/tmp/zad/enet/include
    /usr/lib/libenet.a: $(patsubst %.c,%.o,$(wildcard /tmp/zad/enet/*.c))
    	ar rcs $@ $^
SLOP make -C /tmp/zad/enet -j4
SLOP cp -R /tmp/zad/enet/include/enet /usr/include/

# pkg-config descriptions of SDL2 (copied without its own), of Dolly's libcurl
# and of ENet, built without its upstream build system.
FILE /usr/lib/pkgconfig/sdl2.pc
    Name: sdl2
    Description: Simple DirectMedia Layer
    Version: 2.32.10
    Cflags: -I/usr/include/SDL2
    Libs: -lSDL2 -lm
FILE /usr/lib/pkgconfig/libcurl.pc
    Name: libcurl
    Description: Dolly's libcurl over the HTTP broker
    Version: 8.21.0
    Libs: -lcurl
FILE /usr/lib/pkgconfig/libenet.pc
    Name: libenet
    Description: Low-latency UDP networking library supporting optional reliability
    Version: 1.3.18
    Libs: -lenet
SLOP pkg-config --exists zlib libcurl icu-i18n libsodium libenet libpng freetype2 vorbisfile fmt libxml-2.0 openal sdl2

# Probes for test/0ad-enet-browser.mjs and test/0ad-openal-browser.mjs.
SLOP mkdir -p /usr/libexec/zero-ad
SLOP cc -O1 /tmp/zad/enet-check.c -lenet -o /usr/libexec/zero-ad/enet-check
SLOP c++ -O1 /tmp/zad/openal-check.cpp -lopenal -lm -o /usr/libexec/zero-ad/openal-check
FOLDER /usr/libexec/zero-ad

EXPORTS FOLDER zero-ad-pkgconfig /usr/lib/pkgconfig
EXPORTS HEADER enet /usr/include/enet
EXPORTS LIB enet /usr/lib/libenet.a

ENTRY /bin/foreground -i /bin/slop
