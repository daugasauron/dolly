REQUIRES HOST threads@0

# Build-only: the libraries the 0 A.D. engine links, installed from their
# packages, and ENet with Dolly's transport built here from the pinned upstream
# source of build-sources.tsv; pkgconf for its premake scripts.
FROM /Dollyfile-system-tools d78c55f1f0aa6ca9e39149308c4ae15724e4f3d825d29a0b32b520f571c293b7
INSTALL /Dollyfile-curl bce8c6fafa9e15aa65c9804fc4fec07a309e6174c8e1cb80b7396ac6e458431e
INSTALL /demos/zero-ad/Dollyfile-openal 30f7dd02a9101d5f364429215cc0949ef31bfd972805cbbfaf7cd946a20a0968
INSTALL /demos/tools/Dollyfile-pkgconf 08a217ca8a3cb5f261e5a13960b6053422f37fce397842b82269e8affbc0f4ae
INSTALL /demos/tools/Dollyfile-freetype 76d6fec1184ed6777861804aaed2216bf555f49fe99dd60f5c7f1b01cbb7bad4
INSTALL /demos/xonotic/Dollyfile-libvorbis 20655039e2d2fd674978b118c1bb1af39dcfd44700355a5fe6c7388974dfe30f
INSTALL /demos/zero-ad/Dollyfile-fmt 9fb6fc969a91ed26a45ebe17bd57af0a44d05e188372418e093008d680afae95
INSTALL /demos/zero-ad/Dollyfile-libxml2 fa804c619dc005f9e39add7400913ae9b82936e60fce2eff694313023b27b290
INSTALL /demos/zero-ad/Dollyfile-libsodium f3e35d9894b08e0159c06d388ee76f86cdbf83e4c4e48abb4c9bbd5bee92b907
INSTALL /demos/zero-ad/Dollyfile-boost-headers c8cb6db165a7b8d849f6b1a4cb27ca346af0c0fd033ad427f32f58165d50dc3e
INSTALL /demos/zero-ad/Dollyfile-icu 3c1b2a2bc70280a69307bd4bf7d5ed36564c315e993fa60ddfa42b2c8f5355ff
INSTALL /demos/sdl2/Dollyfile-sdl2 1d2619a584cef68fec1a6a5d29ea5230e1e830fa6d39df5cf080d04a50c86d9e
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

SOURCE /dist/static/zero-ad-build/deps.tar.gz 18922d6461ca5e99d0c62930aae4c3f7f65f5c19d20fe98a711e225e9e8c3048 /tmp/zad/deps.tar.gz
SLOP gzip -dc /tmp/zad/deps.tar.gz | tar -xf - -C /
# Licences of the libraries the engine links; zero-ad copies them.
FOLDER /usr/share/licenses

# ENet keeps its protocol; dolly.c replaces the unix.c and win32.c socket backends.
SLOP cp /tmp/zad/enet-dolly.c /tmp/zad/enet/dolly.c
SLOP rm /tmp/zad/enet/unix.c /tmp/zad/enet/win32.c
FILE /tmp/zad/enet/Makefile
    CFLAGS := -O2 -I/tmp/zad/enet/include
    /usr/lib/libenet.a: $(patsubst %.c,%.o,$(wildcard /tmp/zad/enet/*.c))
    	ar rcs $@ $^
SLOP make -C /tmp/zad/enet -j4
SLOP cp -R /tmp/zad/enet/include/enet /usr/include/

# pkg-config descriptions of Dolly's libcurl and of ENet, built without its
# upstream build system.
FILE /usr/lib/pkgconfig/libcurl.pc
    Name: libcurl
    Description: Dolly's libcurl over the HTTP broker
    Version: 8.21.0
    Libs: -lcurl
FILE /usr/lib/pkgconfig/libenet.pc
    Name: libenet
    Description: Low-latency UDP networking library supporting optional reliability
    Version: 1.3.18
    Libs: -lenet
SLOP pkg-config --exists zlib libcurl icu-i18n libsodium libenet libpng freetype2 vorbisfile fmt libxml-2.0 openal sdl2

# Probes for test/0ad-enet-browser.mjs and test/0ad-openal-browser.mjs.
SLOP mkdir -p /usr/libexec/zero-ad
SLOP cc -O1 /tmp/zad/enet-check.c -lenet -o /usr/libexec/zero-ad/enet-check
SLOP c++ -O1 /tmp/zad/openal-check.cpp -lopenal -lm -o /usr/libexec/zero-ad/openal-check
FOLDER /usr/libexec/zero-ad

EXPORTS FOLDER zero-ad-pkgconfig /usr/lib/pkgconfig
EXPORTS HEADER enet /usr/include/enet
EXPORTS LIB enet /usr/lib/libenet.a

ENTRY /bin/foreground -i /bin/slop
