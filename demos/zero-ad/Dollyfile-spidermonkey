DOLLY 7
PACKAGE spidermonkey
REQUIRES HOST runtime@0

# SpiderMonkey 128.13.0, the JavaScript library 0 A.D. links, for programs the
# cc package builds: upstream's mozbuild (configure.py and Make) with Dolly's
# CPython, Cargo, cbindgen and c++, from 0 A.D.'s pinned tarball and patches.
# The tools serve the build and are not installed with it; a program links
# -ljs_static -ljsrust -lz.
FROM /v0.1.3/Dollyfile-system-tools b8dfc75b8a479542d0651732894a05f8c83fae3f8a86266efc1638e432e1a053
INSTALL /v0.1.3/Dollyfile-zlib 8e1128f9f11ae1066100c75c9e4a1b1d1dd59e86e5e3cf12584af1dfd8f5ea20
USE /v0.1.3/demos/python/Dollyfile-python 03a5f976301f23619077cb757dfe5f4b0e3bf95463727ce9968d93e755092a2e
USE /v0.1.3/demos/rust/Dollyfile-cargo bfb7a92ce6dd0f5ed24f4bb036d9d1205fd26d4972b88283b90061c38111886f
USE /v0.1.3/demos/rust/Dollyfile-cbindgen 5d913ee057a423bc4016f5f32670aabefd23e786d1907a9d641cd1789bb0370f
USE /v0.1.3/demos/zero-ad/Dollyfile-pkgconf 8e7825d1009a2fff6dba7ff4458734a622ffcaf65e4627e6576c2a512d9dccab
REQUIRES HEADER zlib
REQUIRES LIB z
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL patch
REQUIRES TOOL tar
REQUIRES TOOL gzip
REQUIRES TOOL pkg-config
REQUIRES TOOL python
REQUIRES TOOL cargo
REQUIRES TOOL rustc
REQUIRES TOOL cbindgen
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL sh
REQUIRES TOOL rm

# The pinned tree without its test suites, 0 A.D.'s patches and Dolly's.
SOURCE /v0.1.3/dist/static/spidermonkey/source.tar.gz a0e7bd4549c698ba1c84c437e4191345afde2e24746eb7ac41e7d799f1ba8808 /tmp/mozjs.tar.gz
SLOP gzip -dc /tmp/mozjs.tar.gz | tar -xf - -C /
SLOP CWD /tmp/mozjs/mozjs-128.13.0 sh ../patches/patch.sh
SLOP patch -p1 -d /tmp/mozjs/mozjs-128.13.0 -i /tmp/mozjs/spidermonkey.patch

# The host build's configuration: mozbuild knows no Dolly OS, so the compiler
# names the target as the host build did (-D__wasi__, wasm64-unknown-wasi) and
# Dolly builds on the same triple. No JIT, no Intl, no tests, no debug symbols.
# A standalone JS build uses no bindgen, but configure still looks for libclang;
# naming Dolly's library directory (which holds none) takes mozbuild's own
# --with-libclang-path route and skips its `c++ -print-search-dirs` probe,
# a spelling Dolly's cc does not have.
FILE /tmp/mozjs/build.slop
    set -e
    export MOZCONFIG=/dev/null MOZBUILD_STATE_PATH=/tmp/mozjs/state
    export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=none RUSTC_BOOTSTRAP=1 CRATE_CC_NO_DEFAULTS=1
    export CC='cc -D__wasi__' CXX='c++ -D__wasi__' HOST_CC='cc -D__wasi__' HOST_CXX='c++ -D__wasi__'
    export AR=ar RUST_TARGET=wasm64-emscripten-probe CBINDGEN=/usr/bin/cbindgen
    mkdir /tmp/mozjs/mozjs-128.13.0/obj
    cd /tmp/mozjs/mozjs-128.13.0/obj
    python ../configure.py --enable-project=js --host=wasm64-unknown-wasi --target=wasm64-unknown-wasi \
      --disable-jit --disable-shared-js --without-intl-api --disable-tests --disable-js-shell \
      --disable-jemalloc --disable-debug --enable-optimize=-O2 --disable-debug-symbols \
      --disable-bootstrap --disable-warnings-as-errors --with-libclang-path=/usr/lib
    # Cargo links the Rust library and its build scripts through Dolly's rustc
    # linker adapter, which translates the Emscripten target's linker vocabulary
    # to cc; mozbuild would otherwise hand cc the raw -s/EXPORTED_FUNCTIONS flags.
    L=/opt/rust-sdk/bin/dolly-rust-link
    make -j4 MOZ_CARGO_WRAP_LD=$L MOZ_CARGO_WRAP_HOST_LD=$L MOZ_CARGO_WRAP_LD_CXX=$L \
      MOZ_CARGO_WRAP_HOST_LD_CXX=$L MOZ_CARGO_WRAP_LDFLAGS= MOZ_CARGO_WRAP_HOST_LDFLAGS=
    mkdir -p /opt/mozjs/lib /usr/share/licenses/spidermonkey/crates
    # dist/include is 328 symlinks into the source tree, which is not retained;
    # copytree dereferences them (Dolly's cp has no -L).
    python -c 'import shutil; shutil.copytree("dist/include", "/opt/mozjs/include", symlinks=False)'
    cp js/src/build/libjs_static.a wasm64-emscripten-probe/release/libjsrust.a /opt/mozjs/lib/
    ls -l /opt/mozjs/lib
    cp ../LICENSE /usr/share/licenses/spidermonkey/LICENSE
    cp ../nsprpub/LICENSE /usr/share/licenses/spidermonkey/MPL-2.0
    # The notices of the crates compiled into libjsrust.a.
    for crate in $(ls wasm64-emscripten-probe/release/deps | sed -nE 's/^lib(.+)-[0-9a-f]{16}\.rlib$/\1/p' | sort -u); do
      for name in $crate $(echo $crate | tr _ -); do
        [ -d ../third_party/rust/$name ] || continue
        for notice in LICENSE LICENSE-MIT LICENSE-APACHE LICENSE-MPL LICENSE.txt LICENSE.md COPYING COPYRIGHT UNLICENSE; do
          [ -f ../third_party/rust/$name/$notice ] || continue
          mkdir -p /usr/share/licenses/spidermonkey/crates/$name
          cp ../third_party/rust/$name/$notice /usr/share/licenses/spidermonkey/crates/$name/$notice
        done
        break
      done
    done
SLOP time slop -e /tmp/mozjs/build.slop

EXPORTS LIB    js_static /opt/mozjs/lib/libjs_static.a
EXPORTS LIB    jsrust    /opt/mozjs/lib/libjsrust.a
EXPORTS HEADER mozjs-128 /opt/mozjs/include
FILE /usr/lib/pkgconfig/mozjs-128.pc
    Name: SpiderMonkey 128.13.0
    Description: The Mozilla library for JavaScript
    Version: 128.13.0
    Cflags: -I/opt/mozjs/include
    Libs: -L/opt/mozjs/lib -ljs_static -ljsrust -lz
FOLDER /usr/share/licenses/spidermonkey
SLOP rm -rf /tmp/mozjs /tmp/mozjs.tar.gz
