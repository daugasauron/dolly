DOLLY 7
TOOLCHAIN zero-ad-engine
REQUIRES HOST runtime@0
REQUIRES HOST audio@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST touch@0
REQUIRES HOST download@0
REQUIRES HOST gpu@0
REQUIRES HOST http@0
REQUIRES HOST upload@0
REQUIRES HOST threads@0

# Build-only: the 0 A.D. engine (pyrogenesis), built by the Makefiles premake
# generates from upstream's scripts, with Dolly's c++.
FROM /v0.1.4/demos/zero-ad/Dollyfile-zero-ad-deps 1582512b9d603bb9236095cd9423cc945b292a814406974380659f02c9d20fab
INSTALL /v0.1.4/demos/zero-ad/Dollyfile-premake 080ab3713e9077aa0997f845fa7c71c0441e4397c02bba8d13e05b3816907986
INSTALL /v0.1.4/Dollyfile-libdolly-gpu 64def5e9bfdbdd5ca85e4ef9acf72f4e460f9b75466296fbe121dddbc1336c61
INSTALL /v0.1.4/Dollyfile-libdolly-audio 7f80e7b52ba34b3b79ce19c284261f75af60899243aa33964d49411d7d56349a
INSTALL /v0.1.4/Dollyfile-libdolly-touch 6f14db9299ab865e0fa2ad6af80141661f0497ce4e8e38b10114949efae005f2
# download, which the engine's test takes its logs out with.
INSTALL /v0.1.4/Dollyfile-transfer fbea7305d8031273d6e7a5880f9182ee696b4570a98b139fb393a7e2da05fc9c
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL pkg-config
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL patch
REQUIRES TOOL cp
REQUIRES TOOL mkdir

SOURCE /v0.1.4/dist/static/zero-ad-build/engine.tar.gz a45cd31cceb7a2c6f474b432ee57e8d1c14214730c12da91c2beb5a441bcb649 /tmp/0ad.tar.gz
SLOP gzip -dc /tmp/0ad.tar.gz | tar -xf - -C /
SLOP patch -p1 -d /tmp/0ad -i /tmp/0ad-patches/engine.patch

# SpiderMonkey: its headers, the two archives, its pkg-config file and licences.
INSTALL /v0.1.4/demos/zero-ad/Dollyfile-spidermonkey e6d433414ca9cee536f053596a185175c2de6233d153bb561a92dce9c6f5a945

# Probe for test/0ad-spidermonkey-browser.mjs.
SLOP mkdir -p /usr/libexec/zero-ad
SLOP c++ -std=c++20 -O1 -I/opt/mozjs/include /tmp/0ad-patches/spidermonkey-check.cpp \
  -L/opt/mozjs/lib -ljs_static -ljsrust -lz -o /usr/libexec/zero-ad/spidermonkey-check
SLOP /usr/libexec/zero-ad/spidermonkey-check
FOLDER /usr/libexec/zero-ad

SLOP CWD /tmp/0ad/build/premake CC=cc CXX=c++ \
  premake5 --os=emscripten --minimal-flags --strip-binaries --with-system-mozjs \
  --without-atlas --without-nvtt --without-lobby --without-miniupnpc --without-pch \
  --without-tests --without-dap-interface --outpath=../workspaces/dolly gmake
# __DATE__ and __TIME__ are the release's build_version.txt mtime, for reproducible builds.
SLOP CWD /tmp/0ad/build/workspaces/dolly SOURCE_DATE_EPOCH=1771228448 \
  time make config=release -j4 CC=cc CXX=c++ AR=ar pyrogenesis
SLOP mkdir -p /opt/0ad/system
SLOP cp /tmp/0ad/binaries/system/pyrogenesis.wasm /opt/0ad/system/pyrogenesis
SLOP /opt/0ad/system/pyrogenesis -version

EXPORTS FILE pyrogenesis /opt/0ad/system/pyrogenesis

ENTRY /bin/foreground -i /bin/slop
