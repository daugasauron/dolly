DOLLY 7
TOOLCHAIN zero-ad-engine
REQUIRES HOST runtime@0
REQUIRES HOST audio@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST download@0
REQUIRES HOST gpu@0
REQUIRES HOST http@0
REQUIRES HOST upload@0

# Build-only: premake and the 0 A.D. engine (pyrogenesis), built by upstream's
# premake Makefiles with Dolly's c++.
FROM /v0.1.3/demos/zero-ad/Dollyfile-zero-ad-deps 1a20fdddcfeaef50305b12bd2822c0152836bd60b4fffcdb4d7a561b35620f37
INSTALL /v0.1.3/Dollyfile-libdolly-gpu d6c736fc4049bbfd7c58cca367c20f8697e197073c3091ea98852089b84aa3c4
INSTALL /v0.1.3/Dollyfile-libdolly-audio e0f28a4b97bf6d44758d71ffa9b2b748221538af33f4968f8c329198ba1b7a15
# download, which the engine's test takes its logs out with.
INSTALL /v0.1.3/Dollyfile-transfer 51f202bc3437e52024fdad9d2fb8f5f4bf2f4a0cb74d4a41939755ca384d39ba
REQUIRES TOOL cc
REQUIRES TOOL c++
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL pkg-config
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL patch
REQUIRES TOOL cp
REQUIRES TOOL mkdir

SOURCE /v0.1.3/dist/static/zero-ad-build/engine.tar.gz 3850376bf2e8258fb32afdd548d0fa55e0b66d16ad5d086ca01a25cde95c4669 /tmp/0ad.tar.gz
SLOP gzip -dc /tmp/0ad.tar.gz | tar -xf - -C /
SLOP patch -p1 -d /tmp/0ad -i /tmp/0ad-patches/engine.patch

# Bootstrap.mak's two stages: a premake that loads its scripts, then one with
# them embedded. Its own Makefiles are skipped for their unbounded make -j.
SLOP patch -p1 -d /tmp/premake-core-5.0.0-beta7 -i /tmp/0ad-patches/premake.patch
FILE /tmp/premake.slop
    set -ex
    cd /tmp/premake-core-5.0.0-beta7
    lua=
    for name in lapi lauxlib lbaselib lbitlib lcode lcorolib lctype ldblib ldebug ldo ldump lfunc lgc linit liolib llex lmathlib lmem loadlib lobject lopcodes loslib lparser lstate lstring lstrlib ltable ltablib ltm lundump lutf8lib lvm lzio; do
      lua="$lua contrib/lua/src/$name.c"
    done
    flags='-DLUA_STATICLIB -DLUA_USE_POSIX -DLUA_USE_DLOPEN -Icontrib/lua/src -Icontrib/luashim'
    cc -O1 -o premake_bootstrap -DPREMAKE_NO_BUILTIN_SCRIPTS $flags src/host/*.c $lua -lm
    ./premake_bootstrap embed
    cc -O2 -o /usr/bin/premake5 $flags src/host/*.c src/scripts.c $lua -lm
SLOP slop -e /tmp/premake.slop

# SpiderMonkey: its headers, the two archives, its pkg-config file and licences.
INSTALL /v0.1.3/demos/zero-ad/Dollyfile-spidermonkey 66ef94dd81b51271198e8860f5a0e5fb254ecd2347c438a1ba08259270d010fb

# Probe for test/0ad-spidermonkey-browser.mjs.
SLOP mkdir -p /usr/libexec/zero-ad
SLOP c++ -std=c++20 -O1 -I/opt/mozjs/include /tmp/0ad-patches/spidermonkey-check.cpp \
  -L/opt/mozjs/lib -ljs_static -ljsrust -lz -o /usr/libexec/zero-ad/spidermonkey-check
SLOP /usr/libexec/zero-ad/spidermonkey-check
FOLDER /usr/libexec/zero-ad

SLOP CWD /tmp/0ad/build/premake CC=cc CXX=c++ \
  premake5 --os=emscripten --minimal-flags --strip-binaries --with-system-mozjs \
  --without-atlas --without-nvtt --without-lobby --without-miniupnpc --without-pch \
  --without-tests --without-dap-interface --outpath=../workspaces/dolly gmake
# __DATE__ and __TIME__ are the release's build_version.txt mtime, for reproducible builds.
SLOP CWD /tmp/0ad/build/workspaces/dolly SOURCE_DATE_EPOCH=1771228448 \
  time make config=release -j4 CC=cc CXX=c++ AR=ar pyrogenesis
SLOP mkdir -p /opt/0ad/system
SLOP cp /tmp/0ad/binaries/system/pyrogenesis.wasm /opt/0ad/system/pyrogenesis
SLOP /opt/0ad/system/pyrogenesis -version

EXPORTS FILE pyrogenesis /opt/0ad/system/pyrogenesis

ENTRY /bin/foreground -i /bin/slop
