FROM /v0.1.6/Dollyfile-system-tools feb6b8dca551cafdab66985e5518d16a983b48fd10bc8680c6715210bb2f897d
REQUIRES TOOL gzip
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /v0.1.6/dist/static/boost-headers/source.tar.gz 1282930222d16b3b7df0697a1632f6631e79efa7437e8ab50a690d3e91ea9e7c /tmp/boost-headers.tar.gz
SLOP gzip -dc /tmp/boost-headers.tar.gz | tar -xf - -C /

EXPORTS HEADER boost /usr/include/boost
FILE /usr/share/licenses/boost/LICENSE_1_0.txt
SLOP rm /tmp/boost-headers.tar.gz
