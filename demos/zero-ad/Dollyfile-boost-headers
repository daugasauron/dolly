DOLLY 8
PACKAGE boost-headers
REQUIRES HOST runtime@0

# Boost's header-only libraries, as Emscripten's port packs Boost 1.83.0's
# headers, with the Boost Software License from Boost's repository at that
# release, for programs the cc package builds; nothing is compiled.
FROM /Dollyfile-system-tools d78c55f1f0aa6ca9e39149308c4ae15724e4f3d825d29a0b32b520f571c293b7
REQUIRES TOOL gzip
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/boost-headers/source.tar.gz 1282930222d16b3b7df0697a1632f6631e79efa7437e8ab50a690d3e91ea9e7c /tmp/boost-headers.tar.gz
SLOP gzip -dc /tmp/boost-headers.tar.gz | tar -xf - -C /

EXPORTS HEADER boost /usr/include/boost
FILE /usr/share/licenses/boost/LICENSE_1_0.txt
SLOP rm /tmp/boost-headers.tar.gz
