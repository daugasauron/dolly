DOLLY 7
PACKAGE icu
REQUIRES HOST runtime@0

# ICU 68.2's common and i18n libraries and its data from upstream's source
# archive, for programs the cc package builds. Upstream builds them with
# autotools, which Slop cannot run; as Emscripten's port does, every source of
# common, i18n and stubdata is compiled. The data stays a file, which ICU finds
# in /usr/share/icu/68.2 unless ICU_DATA names another directory.
FROM /v0.1.4/Dollyfile-system-tools 9eacc2ba76a3e499b5938ed0c70b33eb5adffe144de20f4f3d381fb78247a768
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL ar
REQUIRES TOOL c++
REQUIRES TOOL cp
REQUIRES TOOL grep
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL mkdir
REQUIRES TOOL mv
REQUIRES TOOL rm
REQUIRES TOOL sed
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/icu/source.tar.gz 2d201cd0b1af20183e8a1eca3de424ea29e87e9fd9a37785cb9ce1415bd50662 /tmp/icu.tar.gz
SLOP gzip -dc /tmp/icu.tar.gz | tar -xf - -C /
FILE /tmp/icu/Makefile
    ICU := /tmp/icu/source
    CXX := c++
    FLAGS := -O2 -std=c++11 -DU_USING_ICU_NAMESPACE=0 -DU_NO_DEFAULT_INCLUDE_UTF_HEADERS=1 \
      -DUNISTR_FROM_CHAR_EXPLICIT=explicit -DUNISTR_FROM_STRING_EXPLICIT=explicit -DU_STATIC_IMPLEMENTATION \
      -DU_CHARSET_IS_UTF8=1 '-DICU_DATA_DIR="/usr/share/icu/68.2"' -I$(ICU)/common
    objects = $(patsubst %.cpp,%.o,$(wildcard $(ICU)/$(1)/*.cpp))
    all: /usr/lib/libicuuc.a /usr/lib/libicui18n.a /usr/lib/libicudata.a
    /usr/lib/libicuuc.a: $(call objects,common)
    	ar rcs $@ $^
    /usr/lib/libicui18n.a: $(call objects,i18n)
    	ar rcs $@ $^
    /usr/lib/libicudata.a: $(call objects,stubdata)
    	ar rcs $@ $^
    $(ICU)/common/%.o: CXXFLAGS = $(FLAGS) -DU_COMMON_IMPLEMENTATION=1
    $(ICU)/i18n/%.o: CXXFLAGS = $(FLAGS) -I$(ICU)/i18n -DU_I18N_IMPLEMENTATION=1
    $(ICU)/stubdata/%.o: CXXFLAGS = $(FLAGS)
# ICU knows no Dolly platform: its charset default is the one hook it offers (U_CHARSET_IS_UTF8),
# and its bundled double-conversion lists architectures, wasm32 but not wasm64.
FILE /tmp/icu/build.slop
    set -ex
    header=/tmp/icu/source/i18n/double-conversion-utils.h
    sed 's/defined(__EMSCRIPTEN__) || defined(__wasm32__)$/defined(__EMSCRIPTEN__) || defined(__wasm32__) || defined(__wasm64__)/' $header > /tmp/icu/utils.h
    grep -q __wasm64__ /tmp/icu/utils.h
    mv /tmp/icu/utils.h $header
    make -C /tmp/icu -j4
    mkdir -p /usr/include/unicode
    cp /tmp/icu/source/common/unicode/* /tmp/icu/source/i18n/unicode/* /usr/include/unicode/
SLOP slop -e /tmp/icu/build.slop

EXPORTS LIB    icuuc   /usr/lib/libicuuc.a
EXPORTS LIB    icui18n /usr/lib/libicui18n.a
EXPORTS LIB    icudata /usr/lib/libicudata.a
EXPORTS HEADER unicode /usr/include/unicode
FILE /usr/lib/pkgconfig/icu-uc.pc
    Name: icu-uc
    Description: International Components for Unicode: Common and Data libraries
    Version: 68.2
    Cflags: -DU_STATIC_IMPLEMENTATION
    Libs: -licuuc -licudata
FILE /usr/lib/pkgconfig/icu-i18n.pc
    Name: icu-i18n
    Description: International Components for Unicode: Internationalization library
    Version: 68.2
    Requires: icu-uc
    Libs: -licui18n
FILE /usr/share/icu/68.2/icudt68l.dat
FILE /usr/share/licenses/icu/LICENSE
SLOP rm -rf /tmp/icu /tmp/icu.tar.gz
