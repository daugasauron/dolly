DOLLY 7
PACKAGE libsodium
REQUIRES HOST runtime@0

# libsodium from upstream's release archive, unchanged, for programs the cc
# package builds. Upstream builds it with autotools, which Slop cannot run, or
# Zig; as its build.zig does, every C file of src/libsodium is compiled, with
# the results of its configure step as flags and its MSVC build's version.h.
FROM /v0.1.4/Dollyfile-system-tools 7f6c86fcc73e544e7007646eba2718bbc4d43b7f0516d9558e2dc500b1a05a80
REQUIRES HEADER libc
REQUIRES TOOL ar
REQUIRES TOOL cc
REQUIRES TOOL cp
REQUIRES TOOL find
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/libsodium/source.tar.gz 5d2562c59d8a5e817f0e1e7ff11e5a0a279c58edbda1d2a4d3521948ed937de0 /tmp/libsodium.tar.gz
SLOP gzip -dc /tmp/libsodium.tar.gz | tar -xf - -C /
FILE /tmp/libsodium/Makefile
    SODIUM := /tmp/libsodium/src/libsodium
    OBJECTS := $(patsubst %.c,%.o,$(shell find $(SODIUM) -name '*.c'))
    CFLAGS := -O2 -I$(SODIUM)/include/sodium -DCONFIGURED=1 -D_GNU_SOURCE=1 -DNATIVE_LITTLE_ENDIAN=1 \
      -DHAVE_ATOMIC_OPS=1 -DHAVE_C11_MEMORY_FENCES=1 -DHAVE_GCC_MEMORY_FENCES=1 -DHAVE_INTTYPES_H=1 -DHAVE_STDINT_H=1 \
      -DHAVE_ALLOCA_H=1 -DHAVE_ALLOCA=1 -DHAVE_SYS_MMAN_H=1 -DHAVE_SYS_PARAM_H=1 -DHAVE_SYS_RANDOM_H=1 -DHAVE_MMAP=1 \
      -DHAVE_MLOCK=1 -DHAVE_MADVISE=1 -DHAVE_MPROTECT=1 -DHAVE_RAISE=1 -DHAVE_SYSCONF=1 -DHAVE_GETENTROPY=1 \
      -DHAVE_GETPID=1 -DHAVE_POSIX_MEMALIGN=1 -DHAVE_NANOSLEEP=1 -DHAVE_CLOCK_GETTIME=1 -DHAVE_EXPLICIT_BZERO=1 \
      -DHAVE_LINUX_COMPATIBLE_GETRANDOM -fvisibility=hidden -fno-strict-aliasing -fwrapv
    /usr/lib/libsodium.a: $(OBJECTS)
    	ar rcs $@ $^
SLOP cp /tmp/libsodium/builds/msvc/version.h /tmp/libsodium/src/libsodium/include/sodium/version.h
SLOP make -C /tmp/libsodium -j4
SLOP cp -R /tmp/libsodium/src/libsodium/include/sodium /tmp/libsodium/src/libsodium/include/sodium.h /usr/include/

EXPORTS LIB    sodium   /usr/lib/libsodium.a
EXPORTS HEADER sodium   /usr/include/sodium
EXPORTS HEADER sodium.h /usr/include/sodium.h
FILE /usr/lib/pkgconfig/libsodium.pc
    Name: libsodium
    Description: A modern and easy-to-use crypto library
    Version: 1.0.20
    Libs: -lsodium
FILE /usr/share/licenses/libsodium/LICENSE
SLOP rm -rf /tmp/libsodium /tmp/libsodium.tar.gz
