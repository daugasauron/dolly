REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

FROM /v0.1.4/Dollyfile-system-build d30b14fadeec9bf1bf12498f9b789ad5da8da30251ad7aad739cd7e54f8c207c
INSTALL /v0.1.4/Dollyfile-zlib 592de704054a7e961a206610a808ceb362d01386ec713418e20ab717dbd3dc7f
INSTALL /v0.1.4/Dollyfile-gzip 82966bf0d3d867b6955a977185ea77b7827687a957fbdb4e2f14fe546140ec9e
INSTALL /v0.1.4/Dollyfile-curl 1b5de7312604a0d72b32d27fc0df5bef5e94d474fc6fe853a7b793db25b56b9a
REQUIRES LIB z
REQUIRES LIB curl
REQUIRES TOOL cc
REQUIRES TOOL ar
REQUIRES TOOL tar
REQUIRES TOOL gzip
REQUIRES TOOL cp
REQUIRES TOOL rm
REQUIRES TOOL mkdir

# The external seed: rustc and its standard library, linked, and Cargo as one
# object. The linker adapter is compiled inside Dolly.
SOURCE /v0.1.4/dist/static/rust/rust-sdk.tar.gz c4ad5d7042db9763db7de2eb27dc40d5bc6796284761441e4cca02f96402a860 /tmp/rust-sdk.tar.gz
SLOP mkdir -p /opt
SLOP gzip -dc /tmp/rust-sdk.tar.gz | tar -xf - -C /opt
SOURCE /v0.1.4/dist/static/rust/rustc.sh 966c3a6e1863196ca1d44b47552c46bc0e7caa8f096ef385252b3216f2f658d1 /opt/rust-sdk/bin/rustc
SOURCE /v0.1.4/dist/static/rust/rust-linker.c 63c7b7fd5b4a73e7227b1e00ca5f878d45ee40d89b939886f433acb4264577f3 /tmp/rust-linker.c
SLOP cc -O1 /tmp/rust-linker.c -o /opt/rust-sdk/bin/dolly-rust-link
# What the adapter adds to a program that loads Rust libraries: the dl* names
# Rust binds.
SOURCE /v0.1.4/dist/static/rust/dlopen.c cd3f75610360f299acd6ff507900ec2ad0273222465fde4184d59da4b188cc6b /tmp/rust-host/dlopen.c
SLOP CWD /tmp/rust-host cc -O2 -fPIC -c dlopen.c
SLOP CWD /tmp/rust-host ar rcs /opt/rust-sdk/lib/dolly-rust-host.a dlopen.o
# Cargo's libc, libcurl and zlib are this image's.
SLOP cc -pthread /opt/rust-sdk/cargo.o -lcurl -lz -o /usr/bin/cargo
SLOP rm -rf /opt/rust-sdk/cargo.o /tmp/rust-host
SLOP mkdir -p /usr/share/licenses/rust
SLOP cp -R /opt/rust-sdk/licenses/. /usr/share/licenses/rust
SLOP rm /tmp/rust-sdk.tar.gz /tmp/rust-linker.c

EXPORTS ENV PATH APPEND /opt/rust-sdk/bin
EXPORTS TOOL rustc
EXPORTS TOOL cargo
# Images build once, so rustc's incremental sessions would only be a second
# copy of every object (there are no hard links), in a filesystem that lives in
# kernel memory: codex-build ran out of space at codex-core with them. The
# cargo package, for a session's own projects, keeps them.
EXPORTS ENV CARGO_INCREMENTAL 0
# The cc crate's default flags name a target; Dolly's cc has one.
EXPORTS ENV CRATE_CC_NO_DEFAULTS 1
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
SLOP rustc --version --verbose
SLOP cargo --version
INSTALL /v0.1.4/Dollyfile-display 66ed7a7db97d1fd4a56efbfd8b89279c4fb4fdcaf2b555ad430cde7e9eab0439

ENTRY /bin/foreground -i /bin/slop
