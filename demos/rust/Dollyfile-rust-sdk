FROM /v0.1.0/Dollyfile-system-build 6e03b119cf1b52f9cff2725c844daaa45965436245921c6059f8d6a9181039da
INSTALL /v0.1.0/Dollyfile-zlib 1765c80b34559d95d7d6f5908cec4f1b10d5ef9f93953989f8254ea08145ca92
INSTALL /v0.1.0/Dollyfile-gzip defb0a863c548e73e1d7761dbc54fa9b225b23724a2f56268def0052f7d9f709
INSTALL /v0.1.0/Dollyfile-curl f9587b53f71273125ef30c38f597de4e480aa52731dbb2b564312dd6d6a13235
