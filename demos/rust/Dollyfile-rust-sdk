FROM /v0.1.4/Dollyfile-system-build 86ebba8e8f9bafb7bf4acfb7c153270597780608a5dcbda95c9c5d41c9cf8858
INSTALL /v0.1.4/Dollyfile-zlib 5a6ca6519690be4620c58e2115f4ce8ecb594c61fa222f7633f7f1af226f50df
INSTALL /v0.1.4/Dollyfile-gzip fefc48cef01e3206330ac264459a7e4c81c8a026b3c654c00d4ea80d4f0293c5
