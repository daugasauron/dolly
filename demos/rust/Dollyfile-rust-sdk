FROM /v0.1.4/Dollyfile-system-build bd246944450081bf7d29405560412136a7d1bf6c14e21489f7bd342a871048ff
INSTALL /v0.1.4/Dollyfile-zlib 3c79effd880edb15aec5d4f3195614356bca631b7522216ccf79a7afe441688e
INSTALL /v0.1.4/Dollyfile-gzip 6b5f33688a7ac92061566f32cdd5409ddc5e682be83505dee8ff778b53f768ed
INSTALL /v0.1.4/Dollyfile-curl 0220053e05f54f4c4fc7d5ab4605079f366cfecb436764ce449e9f7d9f6c1f4e
REQUIRES LIB z
REQUIRES LIB curl
