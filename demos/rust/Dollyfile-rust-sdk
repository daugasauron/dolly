DOLLY 8
TOOLCHAIN rust-sdk
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

FROM /Dollyfile-system-build 0c72e09eba84571d4f8634cf6e7507eb1be1b9b8aa1fae61f6b0ec884b26b6fb
INSTALL /Dollyfile-zlib acf8f8daaba24468b5b521bbb4d4ba3e034fe28d7a2d92fc680d2e39a1cea971
INSTALL /Dollyfile-gzip cef69a22c3b9f73889f4c819fcfaee2fb4487474ea4efa364117b8796465d1a4
INSTALL /Dollyfile-curl bce8c6fafa9e15aa65c9804fc4fec07a309e6174c8e1cb80b7396ac6e458431e
REQUIRES LIB z
REQUIRES LIB curl
REQUIRES TOOL cc
REQUIRES TOOL ar
REQUIRES TOOL tar
REQUIRES TOOL gzip
REQUIRES TOOL cp
REQUIRES TOOL rm
REQUIRES TOOL mkdir

# The seed: rustc and its standard library as the previous round's rust-build
# built them, and its Cargo. The linker adapter is compiled inside Dolly.
SOURCE /dist/static/rust/rust-seed.tar.gz 70be972668adaf992b8b162ed90884dd2acfc2ed06ec7897eb2b9ad33e076024 /tmp/rust-seed.tar.gz
SLOP gzip -dc /tmp/rust-seed.tar.gz | tar -xf - -C /
SOURCE /dist/static/rust/rustc.sh 03589f0b44268b0bb22c1d5db37aa58cd882a8d2dae81902a23ab2385c3dde6e /opt/rust-sdk/bin/rustc
SOURCE /dist/static/rust/rust-linker.c aba3b92e9de04bd9b9457669b7621d6afbe1779c77c65477b32a3e167a7f5319 /tmp/rust-linker.c
SLOP cc -O1 /tmp/rust-linker.c -o /opt/rust-sdk/bin/dolly-rust-link
# What the adapter adds to a program that loads Rust libraries: the dl* names
# Rust binds.
SOURCE /dist/static/rust/dlopen.c cd3f75610360f299acd6ff507900ec2ad0273222465fde4184d59da4b188cc6b /tmp/rust-host/dlopen.c
SLOP CWD /tmp/rust-host cc -O2 -fPIC -c dlopen.c
SLOP CWD /tmp/rust-host ar rcs /opt/rust-sdk/lib/dolly-rust-host.a dlopen.o
SLOP rm -rf /tmp/rust-host
SLOP mkdir -p /usr/share/licenses/rust
SLOP cp -R /opt/rust-sdk/licenses/. /usr/share/licenses/rust
SLOP rm /tmp/rust-seed.tar.gz /tmp/rust-linker.c

EXPORTS ENV PATH /bin:/usr/bin:/opt/rust-sdk/bin
EXPORTS TOOL rustc
EXPORTS TOOL cargo
# Images build once, so rustc's incremental sessions would only be a second
# copy of every object (there are no hard links), in a filesystem that lives in
# kernel memory: the codex build ran out of space at codex-core with them. The
# cargo package, for a session's own projects, keeps them.
EXPORTS ENV CARGO_INCREMENTAL 0
# The cc crate's default flags name a target; Dolly's cc has one.
EXPORTS ENV CRATE_CC_NO_DEFAULTS 1
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
SLOP rustc --version --verbose
SLOP cargo --version
INSTALL /Dollyfile-display cc98bc6edc0e5dea2bfb79e3095ea1fb6744e28282d28cec6c2e013cf6435992

ENTRY /bin/foreground -i /bin/slop
