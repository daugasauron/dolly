# The external seed: rustc and its standard library, linked, and Cargo as one
# object. The linker adapter is compiled inside Dolly.
SOURCE /v0.1.3/dist/static/rust/rust-sdk.tar.gz 51f051dc0c8115ca4428ede9607bf87c22aa321615df123859f90e7a78e8cfbc /tmp/rust-sdk.tar.gz
SLOP mkdir -p /opt
SLOP gzip -dc /tmp/rust-sdk.tar.gz | tar -xf - -C /opt
SOURCE /v0.1.3/dist/static/rust/rustc.sh 966c3a6e1863196ca1d44b47552c46bc0e7caa8f096ef385252b3216f2f658d1 /opt/rust-sdk/bin/rustc
SOURCE /v0.1.3/dist/static/rust/rust-linker.c 63c7b7fd5b4a73e7227b1e00ca5f878d45ee40d89b939886f433acb4264577f3 /tmp/rust-linker.c
SLOP cc -O1 /tmp/rust-linker.c -o /opt/rust-sdk/bin/dolly-rust-link
# What the adapter adds to a program that loads Rust libraries: the dl* names
# Rust binds, and the thread attributes std prepares, which libc has only for
# threaded processes.
SOURCE /v0.1.3/dist/static/rust/dlopen.c cd3f75610360f299acd6ff507900ec2ad0273222465fde4184d59da4b188cc6b /tmp/rust-host/dlopen.c
SOURCE /v0.1.3/dist/static/rust/pthread-attr.c 37726f5f8169a41fe7baac391fb77beeb551a605e2e9065f6485760f5ce8f476 /tmp/rust-host/pthread-attr.c
SLOP CWD /tmp/rust-host cc -O2 -fPIC -c dlopen.c
SLOP CWD /tmp/rust-host cc -O2 -fPIC -c pthread-attr.c
SLOP CWD /tmp/rust-host ar rcs /opt/rust-sdk/lib/dolly-rust-host.a dlopen.o pthread-attr.o
# Cargo's libc, libcurl and zlib are this image's.
SLOP cc -pthread /opt/rust-sdk/cargo.o -lcurl -lz -o /usr/bin/cargo
SLOP rm -rf /opt/rust-sdk/cargo.o /tmp/rust-host
SLOP mkdir -p /usr/share/licenses/rust
SLOP cp -R /opt/rust-sdk/licenses/. /usr/share/licenses/rust
SLOP rm /tmp/rust-sdk.tar.gz /tmp/rust-linker.c

EXPORTS ENV PATH APPEND /opt/rust-sdk/bin
EXPORTS TOOL rustc
EXPORTS TOOL cargo
# Until Dolly has file locks: rustc's incremental sessions need them.
EXPORTS ENV CARGO_INCREMENTAL 0
# The cc crate's default flags name a target; Dolly's cc has one.
EXPORTS ENV CRATE_CC_NO_DEFAULTS 1
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
SLOP rustc --version --verbose
SLOP cargo --version
INSTALL /v0.1.3/Dollyfile-display 3d4c189a58060abfee9cb7ecf9f3b182f04fb626f416e53a506db1aa67ee7c4d

