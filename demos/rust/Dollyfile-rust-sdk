FROM /v0.1.4/Dollyfile-system-build 4ce2bf896849cf8968a075da0f290b49457225e2283fd7627f4a1cba2931bb58
INSTALL /v0.1.4/Dollyfile-zlib edf4e844352349e501f2ac261333bb2937bcb1f7311672a1f225045d4b09c16e
INSTALL /v0.1.4/Dollyfile-gzip 9f4618403aa9ac85423edc1755d4d1a45ec0b31d3f65a87ae8400adb720dddfa
INSTALL /v0.1.4/Dollyfile-curl 985b1bdac354d9ad0cf5517fc904ea6cffe49732d68fa69ca62f021c55920dc7
