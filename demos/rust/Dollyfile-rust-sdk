DOLLY 7
TOOLCHAIN rust-sdk
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

FROM /v0.1.5/Dollyfile-system-build f63af7b4782f08bad559b157c94c733deb6a0f5371671a778a8a1e30cbbbb5d2
INSTALL /v0.1.5/Dollyfile-zlib b9af882b9dec794326db0060855bb79f39ae7f3fbba0744596e353bb33ad392e
INSTALL /v0.1.5/Dollyfile-gzip 291c47eec9871909d24d10080776e01f1712c11dad8b55867813d3764c74f770
INSTALL /v0.1.5/Dollyfile-curl cf007bd8d3c1a06df9bff7a5f3cabfc67c975a3b943b1eb34e6be834ed2f6afd
REQUIRES LIB z
REQUIRES LIB curl
REQUIRES TOOL cc
REQUIRES TOOL ar
REQUIRES TOOL tar
REQUIRES TOOL gzip
REQUIRES TOOL cp
REQUIRES TOOL rm
REQUIRES TOOL mkdir

# The external seed: rustc and its standard library, linked, and Cargo as one
# object. The linker adapter is compiled inside Dolly.
SOURCE /v0.1.5/dist/static/rust/rust-sdk.tar.gz 472f045cf13b2db828b98d18db206624f60f6b7bf3ee50cc5f30ee82bba96a1f /tmp/rust-sdk.tar.gz
SLOP mkdir -p /opt
SLOP gzip -dc /tmp/rust-sdk.tar.gz | tar -xf - -C /opt
SOURCE /v0.1.5/dist/static/rust/rustc.sh 03589f0b44268b0bb22c1d5db37aa58cd882a8d2dae81902a23ab2385c3dde6e /opt/rust-sdk/bin/rustc
SOURCE /v0.1.5/dist/static/rust/rust-linker.c 63c7b7fd5b4a73e7227b1e00ca5f878d45ee40d89b939886f433acb4264577f3 /tmp/rust-linker.c
SLOP cc -O1 /tmp/rust-linker.c -o /opt/rust-sdk/bin/dolly-rust-link
# What the adapter adds to a program that loads Rust libraries: the dl* names
# Rust binds.
SOURCE /v0.1.5/dist/static/rust/dlopen.c cd3f75610360f299acd6ff507900ec2ad0273222465fde4184d59da4b188cc6b /tmp/rust-host/dlopen.c
SLOP CWD /tmp/rust-host cc -O2 -fPIC -c dlopen.c
SLOP CWD /tmp/rust-host ar rcs /opt/rust-sdk/lib/dolly-rust-host.a dlopen.o
# Cargo's libc, libcurl and zlib are this image's.
SLOP cc -pthread /opt/rust-sdk/cargo.o -lcurl -lz -o /usr/bin/cargo
SLOP rm -rf /opt/rust-sdk/cargo.o /tmp/rust-host
SLOP mkdir -p /usr/share/licenses/rust
SLOP cp -R /opt/rust-sdk/licenses/. /usr/share/licenses/rust
SLOP rm /tmp/rust-sdk.tar.gz /tmp/rust-linker.c

EXPORTS ENV PATH /bin:/usr/bin:/opt/rust-sdk/bin
EXPORTS TOOL rustc
EXPORTS TOOL cargo
# Images build once, so rustc's incremental sessions would only be a second
# copy of every object (there are no hard links), in a filesystem that lives in
# kernel memory: the codex build ran out of space at codex-core with them. The
# cargo package, for a session's own projects, keeps them.
EXPORTS ENV CARGO_INCREMENTAL 0
# The cc crate's default flags name a target; Dolly's cc has one.
EXPORTS ENV CRATE_CC_NO_DEFAULTS 1
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
SLOP rustc --version --verbose
SLOP cargo --version
INSTALL /v0.1.5/Dollyfile-display c6a0bde3cbb5e1f8888cc3d35312cfed170977d1a315d23811c075ebd23ff008

ENTRY /bin/foreground -i /bin/slop
