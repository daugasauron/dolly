@@ -0,0 +1,28 @@
+#[cfg(not(all(target_os = "emscripten", target_arch = "wasm64")))]
+pub(crate) use crate::blocking::{JoinHandle, spawn_blocking, spawn_mandatory_blocking};
+
+#[cfg(all(target_os = "emscripten", target_arch = "wasm64"))]
+pub(crate) use memory_file_system::*;
+
+#[cfg(all(target_os = "emscripten", target_arch = "wasm64"))]
+mod memory_file_system {
+    pub(crate) type JoinHandle<T> = std::future::Ready<Result<T, crate::task::JoinError>>;
+
+    // Only filesystem operations use this adapter. Public task/thread spawning
+    // is unchanged; in-memory regular-file operations need no background worker.
+    pub(crate) fn spawn_blocking<F, T>(operation: F) -> JoinHandle<T>
+    where
+        F: FnOnce() -> T + Send + 'static,
+        T: Send + 'static,
+    {
+        std::future::ready(Ok(operation()))
+    }
+
+    pub(crate) fn spawn_mandatory_blocking<F, T>(operation: F) -> Option<JoinHandle<T>>
+    where
+        F: FnOnce() -> T + Send + 'static,
+        T: Send + 'static,
+    {
+        Some(spawn_blocking(operation))
+    }
+}
