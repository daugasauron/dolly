# Cargo as rust-build built it.
COPY /v0.1.4/demos/rust/Dollyfile-rust-build 83f4a5e27ad67456e3bd52f4f8faa5d35ce83fef2ad0dbad70066a6e793d0433 /usr/bin/cargo /usr/bin/cargo
COPY /v0.1.4/demos/rust/Dollyfile-rust-build 83f4a5e27ad67456e3bd52f4f8faa5d35ce83fef2ad0dbad70066a6e793d0433 /usr/share/licenses/cargo /usr/share/licenses/cargo
