# Cargo as rust-build built it.
COPY /v0.1.4/demos/rust/Dollyfile-rust-build 0019dff64616ae36643ead947f68fe7ec899560c551cf38083378f043a3b98bd /usr/bin/cargo /usr/bin/cargo
