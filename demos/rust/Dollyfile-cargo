DOLLY 7
PACKAGE cargo
REQUIRES HOST runtime@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

# Cargo as rust-build built it.
COPY /v0.1.4/demos/rust/Dollyfile-rust-build 9f4d49f1170ee91db2201a0b5c91456c2e5fb8ed7b3d5fd1eb66c7e0e35b1c85 /usr/bin/cargo /usr/bin/cargo
COPY /v0.1.4/demos/rust/Dollyfile-rust-build 9f4d49f1170ee91db2201a0b5c91456c2e5fb8ed7b3d5fd1eb66c7e0e35b1c85 /usr/share/licenses/cargo /usr/share/licenses/cargo
COPY /v0.1.4/demos/rust/Dollyfile-rust-build 9f4d49f1170ee91db2201a0b5c91456c2e5fb8ed7b3d5fd1eb66c7e0e35b1c85 /usr/share/dolly/builds/cargo.lock /usr/share/dolly/builds/cargo.lock
# Cargo runs rustc: the package brings the compiler it was built with.
INSTALL /v0.1.4/demos/rust/Dollyfile-rust b09a8a29e3a4ece262561de647fc8116bf0528aae34979f2a7d975737dd50b77
# The cc crate's default flags name a target; Dolly's cc has one.
EXPORTS ENV CRATE_CC_NO_DEFAULTS 1
# A Git dependency is fetched by git, which reaches HTTP hosts through the
# broker; Cargo's own Git opens sockets, which a program has none of.
EXPORTS ENV CARGO_NET_GIT_FETCH_WITH_CLI true
EXPORTS TOOL cargo
EXPORTS FOLDER cargo-licenses /usr/share/licenses/cargo
FILE /usr/share/dolly/builds/cargo.lock

FILE /usr/share/man/cat1/cargo.1
    cargo: Cargo 1.98.1, built inside Dolly; the rust package is its compiler.
    
      cargo build          builds a crate: path and vendored dependencies,
                           build scripts and procedural macros
      cargo test           runs its tests and doc tests
      target/debug/NAME    runs what it built
    
    cargo run builds and replaces Cargo with the program (exec). Crate archives
    come through the page's HTTP broker; crates.io's index sends no CORS headers,
    so a project's crates are vendored: amy install vendor-crates, then
    vendor-crates in the project and cargo build --offline. A crate that uses
    libc needs the SDK's copy, which vendor-crates patches in. A Git dependency
    is fetched by git (amy install git), from a host that sends CORS headers.
    There is no cargo search, publish or login.
    Upstream's book: https://doc.rust-lang.org/cargo/
