# Cargo as rust-build built it.
COPY /v0.1.3/demos/rust/Dollyfile-rust-build 27b24451ab2f682b9416a6fe561039487d2ee400769327109039497bc9405f86 /usr/bin/cargo /usr/bin/cargo
