DOLLY 7
PACKAGE cargo
REQUIRES HOST runtime@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

# Cargo as rust-build built it.
COPY /v0.1.0/demos/rust/Dollyfile-rust-build fd31dc39dea74f0606bd1c88a985e4078e0f23a42e5f2efbe717f0bee4639fed /usr/bin/cargo /usr/bin/cargo
COPY /v0.1.0/demos/rust/Dollyfile-rust-build fd31dc39dea74f0606bd1c88a985e4078e0f23a42e5f2efbe717f0bee4639fed /usr/share/licenses/cargo /usr/share/licenses/cargo
COPY /v0.1.0/demos/rust/Dollyfile-rust-build fd31dc39dea74f0606bd1c88a985e4078e0f23a42e5f2efbe717f0bee4639fed /usr/share/dolly/builds/cargo.lock /usr/share/dolly/builds/cargo.lock
# Cargo runs rustc: the package brings the compiler it was built with.
INSTALL /v0.1.0/demos/rust/Dollyfile-rust 8771f0217e77e68257439a9244aaaf8bad65468bc3198f11fb1d7555e0328c04
# Until Dolly has file locks: rustc's incremental sessions need them.
EXPORTS ENV CARGO_INCREMENTAL 0
# The cc crate's default flags name a target; Dolly's cc has one.
EXPORTS ENV CRATE_CC_NO_DEFAULTS 1
EXPORTS TOOL cargo
EXPORTS FOLDER cargo-licenses /usr/share/licenses/cargo
FILE /usr/share/dolly/builds/cargo.lock

FILE /tmp/cargo-check/Cargo.toml
    [package]
    name = "cargo-check"
    version = "0.1.0"
    edition = "2021"
FILE /tmp/cargo-check/src/main.rs
    fn main() { println!("built by cargo"); }
SLOP cargo --version
SLOP CWD /tmp/cargo-check cargo build --offline
SLOP /tmp/cargo-check/target/debug/cargo-check
SLOP rm -rf /tmp/cargo-check
