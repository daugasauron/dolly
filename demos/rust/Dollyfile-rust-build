DOLLY 7
TOOLCHAIN rust-build
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

# Rust as Dolly builds it: rustc, its standard library and Cargo, compiled
# here from their pinned sources. The seed builds the first rustc; that one
# builds the rustc kept. Every Rust program in the catalog is built by this
# image's toolchain.
FROM /v0.1.4/demos/rust/Dollyfile-rust-sdk 4e0eb946c5d1892ceb777ea279a0d9d45165a584674690cf20ceac931957b7bb
COPY /v0.1.4/demos/rust/Dollyfile-rust-llvm 151e7ff82ef743d763b823478ac823c961770e9cb942178b61baa87a36d5b19b /opt/rust-llvm /opt/rust-llvm
# patch, for the compiler's patch below.
INSTALL /v0.1.4/Dollyfile-git b485ad00a8bd56d4b1f4f12cb9f10d5333af2912f4c8726201ebb3951b07e254
# cmp, for the check that the second generation rebuilds the same library.
INSTALL /v0.1.4/Dollyfile-posix a61075dc335040c249a0a09e81339fee3bc9c95932be2e9665a2620799b6eb6a
REQUIRES TOOL cargo
REQUIRES TOOL rustc
REQUIRES TOOL cc
REQUIRES TOOL cmp
REQUIRES TOOL patch
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL ln
REQUIRES TOOL rm

# rustc's and std's source as the seed's build prepared it, their locked
# crates as Cargo's directory source, and the build's settings in
# /tmp/rustc/.cargo/config.toml.
SOURCE /v0.1.4/dist/static/rust/rustc.tar.gz ca0d133f3ac7ce71572cbf61e4da7e40b9f574937d163f1df2a0d7c5cd2e5198 /tmp/rustc.tar.gz
SLOP gzip -dc /tmp/rustc.tar.gz | tar -xf - -C /
SLOP rm /tmp/rustc.tar.gz
# rustdoc builds its sessions from the default options, whose sysroot the
# static compiler finds only by its symlinked name, as rustdoc-real is: the
# lookup checked lib/rustlib against the working directory, not that sysroot.
SOURCE /v0.1.4/dist/static/rust/rustc-sysroot.patch 1446ec39a26318f5caa6ec71f71490225ca26b5b8313074f14ff812f92e6cf7f /tmp/rustc/sysroot.patch
SLOP patch -p1 -d /tmp/rustc/source -i /tmp/rustc/sysroot.patch
# The target as Dolly defines it now (panics unwind). The seed's library was
# built for the seed's definition, which stays the host's until a library for
# this one replaces it: a crate built for one cannot link the other's.
SOURCE /v0.1.4/dist/static/rust/wasm64-emscripten-probe.json 90972fb95b4f3f9abdc5a4483d284afc349095f504fa5febf3612c69cd93d053 /tmp/rustc/spec/wasm64-emscripten-probe.json

# One generation: the compiler, built by the rustc in /opt/rust-sdk against the
# standard library there, replaces that rustc. It is linked as a host of
# procedural-macro libraries, with room for its data.
FILE /tmp/rustc/compiler.slop
    cd /tmp/rustc/source
    RUSTC_BOOTSTRAP=1 cargo rustc -j 4 --offline -p rustc-main --bin rustc-main --features llvm --target-dir /tmp/rustc/target -- -C link-arg=-rdynamic -C link-arg=-Wl,--initial-memory=33554432
    cp /tmp/rustc/target/debug/rustc-main /opt/rust-sdk/bin/rustc-real
# The standard library for that target by the rustc in /opt/rust-sdk, left in
# /tmp/rustc/sdk-target, with libtest for cargo test; its build scripts run on
# the host. Cargo's build-std reads the source below the sysroot and builds it
# for a crate. The compiler aborts, as its first generation must with the
# seed's library; the library unwinds.
FILE /tmp/rustc/std.slop
    cd /tmp/rustc/sdk
    rm -rf /tmp/rustc/sdk-target
    RUSTC_BOOTSTRAP=1 RUSTC_WRAPPER=/tmp/rustc/std-rustc RUSTFLAGS="-C relocation-model=pic -C embed-bitcode=yes" cargo build -j 4 --offline --lib --target /tmp/rustc/spec/wasm64-emscripten-probe.json -Z json-target-spec -Z build-std=std,panic_abort,proc_macro,test --target-dir /tmp/rustc/sdk-target --config 'profile.dev.panic="unwind"'
    rm /tmp/rustc/sdk-target/wasm64-emscripten-probe/debug/deps/libdolly_rust_sdk-*
# As in Rust's own build, the library unwinds and its abort runtime aborts, so
# a program of either strategy links them.
FILE /tmp/rustc/std-rustc
    #!/bin/slop
    case " $* " in
      *" --crate-name panic_abort "*) exec "$@" -C panic=abort ;;
    esac
    exec "$@"
FILE /tmp/rustc/sdk/Cargo.toml
    [package]
    name = "dolly-rust-sdk"
    version = "0.0.0"
    edition = "2024"
    [workspace]
FILE /tmp/rustc/sdk/src/lib.rs
    // Built for its dependency: the standard library.
# rustc and rustdoc are one executable, as natively both link one
# librustc_driver; rustdoc names the compiler's crates itself (rustc_private),
# so it builds against the libraries a generation leaves in /tmp/rustc/target.
FILE /tmp/rustc/driver.slop
    cd /tmp/rustc/driver
    RUSTC_BOOTSTRAP=1 RUSTFLAGS="-C relocation-model=pic -L /tmp/rustc/target/debug/deps" DOC_RUST_LANG_ORG_CHANNEL=https://doc.rust-lang.org/nightly cargo rustc -j 4 --offline --target-dir /tmp/rustc/driver-target -- -C link-arg=-rdynamic -C link-arg=-Wl,--initial-memory=33554432
    cp /tmp/rustc/driver-target/debug/dolly-rustc /opt/rust-sdk/bin/rustc-real
    rm -rf /tmp/rustc/driver-target
FILE /tmp/rustc/driver/Cargo.toml
    [package]
    name = "dolly-rustc"
    version = "0.0.0"
    edition = "2024"
    [dependencies]
    rustdoc = { path = "../source/src/librustdoc" }
    [workspace]
FILE /tmp/rustc/driver/src/main.rs
    // rustc, or rustdoc when it runs as rustdoc-real.
    #![feature(rustc_private)]
    extern crate rustc_driver;
    use std::ffi::OsStr;
    use std::path::Path;
    use std::process::ExitCode;
    fn main() -> ExitCode {
        let name = std::env::args_os().next().unwrap_or_default();
        if Path::new(&name).file_name() == Some(OsStr::new("rustdoc-real")) {
            rustdoc::main()
        } else {
            rustc_driver::main()
        }
    }
SLOP mkdir -p /opt/rust-sdk/lib/rustlib/src/rust
SLOP cp -R /tmp/rustc/source/library /opt/rust-sdk/lib/rustlib/src/rust/library

# The first generation is the seed's work and links the seed's standard
# library. Its own standard library replaces the seed's, and the target's
# definition with it.
SLOP slop -e /tmp/rustc/compiler.slop
SLOP rm -rf /tmp/rustc/target
SLOP slop -e /tmp/rustc/std.slop
SLOP slop -c 'rm /opt/rust-sdk/lib/rustlib/wasm64-emscripten-probe/lib/*.rlib'
SLOP slop -c 'cp /tmp/rustc/sdk-target/wasm64-emscripten-probe/debug/deps/*.rlib /opt/rust-sdk/lib/rustlib/wasm64-emscripten-probe/lib'
SLOP cp /tmp/rustc/spec/wasm64-emscripten-probe.json /opt/rust-sdk/wasm64-emscripten-probe.json
SLOP cp /tmp/rustc/spec/wasm64-emscripten-probe.json /opt/rust-sdk/lib/rustlib/wasm64-emscripten-probe/target.json
# The second generation is built by the first from the same source and holds
# nothing of the seed: it is the rustc this image keeps, with rustdoc. The
# standard library it builds must be, byte for byte, the one installed.
SLOP slop -e /tmp/rustc/compiler.slop
SLOP slop -e /tmp/rustc/driver.slop
SLOP ln -s rustc-real /opt/rust-sdk/bin/rustdoc-real
SLOP ln -s rustc /opt/rust-sdk/bin/rustdoc
SLOP rm -rf /tmp/rustc/target
SLOP slop -e /tmp/rustc/std.slop
SLOP CWD /tmp/rustc/sdk-target/wasm64-emscripten-probe/debug/deps slop -e -c 'for library in *.rlib; do cmp "$library" "/opt/rust-sdk/lib/rustlib/wasm64-emscripten-probe/lib/$library"; done'
SLOP rm -rf /tmp/rustc /opt/rust-llvm /opt/rust-sdk/lib/rustlib/src

# Cargo, by the kept compiler and library; the seed's Cargo drives its last build.
SOURCE /v0.1.4/dist/static/rust/cargo.tar.gz a1cfcffcac95319a5d6d161ffe6e2b71bba8465943ddd933fb31c795f83ad197 /tmp/cargo.tar.gz
SLOP gzip -dc /tmp/cargo.tar.gz | tar -xf - -C /
SLOP rm /tmp/cargo.tar.gz
SLOP CWD /tmp/cargo/source cargo build -j 4 --offline --bin cargo --target-dir /tmp/cargo/build
SLOP cp /tmp/cargo/build/debug/cargo /usr/bin/cargo
SLOP mkdir -p /usr/share/licenses/cargo /usr/share/dolly/builds
SLOP cp /tmp/cargo/source/LICENSE-MIT /usr/share/licenses/cargo/LICENSE-MIT
SLOP cp /tmp/cargo/source/LICENSE-APACHE /usr/share/licenses/cargo/LICENSE-APACHE
SLOP cp /tmp/cargo/source/LICENSE-THIRD-PARTY /usr/share/licenses/cargo/LICENSE-THIRD-PARTY
SLOP cp /tmp/cargo/vendor/libgit2-sys-0.18.5+1.9.4/libgit2/COPYING /usr/share/licenses/cargo/libgit2-COPYING
SLOP cp /tmp/cargo/source/Cargo.lock /usr/share/dolly/builds/cargo.lock
SLOP rm -rf /tmp/cargo

# The SDK's members are this recipe's now, not the seed's.
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
EXPORTS FOLDER cargo-licenses /usr/share/licenses/cargo
FILE /usr/share/dolly/builds/cargo.lock
SLOP rustc --version --verbose
SLOP rustdoc --version
SLOP cargo --version

# The built toolchain builds and runs a program that uses a procedural macro.
FILE /tmp/rust-check/Cargo.toml
    [workspace]
    members = ["twice", "check"]
    resolver = "3"
FILE /tmp/rust-check/twice/Cargo.toml
    [package]
    name = "twice"
    version = "0.1.0"
    edition = "2024"
    [lib]
    proc-macro = true
FILE /tmp/rust-check/twice/src/lib.rs
    use proc_macro::TokenStream;
    #[proc_macro]
    pub fn twice(input: TokenStream) -> TokenStream {
        format!("({0}) + ({0})", input).parse().unwrap()
    }
FILE /tmp/rust-check/check/Cargo.toml
    [package]
    name = "check"
    version = "0.1.0"
    edition = "2024"
    [dependencies]
    twice = { path = "../twice" }
FILE /tmp/rust-check/check/src/main.rs
    fn main() { println!("built by cargo: {}", twice::twice!(21)); }
SLOP CWD /tmp/rust-check cargo build --offline
SLOP /tmp/rust-check/target/debug/check
SLOP rm -rf /tmp/rust-check

ENTRY /bin/foreground -i /bin/slop
