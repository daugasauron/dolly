DOLLY 7
PACKAGE ripgrep
REQUIRES HOST runtime@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

FROM /v0.1.0/demos/rust/Dollyfile-rust-build 2548409d44fbb1119a89cec53d1a9af6ba2eaf7d8a8ff90c890f98fdf1cd9f61
REQUIRES TOOL cargo
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

# The archive holds upstream source and its locked crates, checksum-verified,
# laid out as Cargo's directory source.
SOURCE /v0.1.0/dist/static/rust/ripgrep.tar.gz 7f4f092352953f6c04d74c5cf5e5fc5f047ba6968c36a927926193d95857e9c4 /tmp/ripgrep.tar.gz
SLOP gzip -dc /tmp/ripgrep.tar.gz | tar -xf - -C /
SLOP CWD /tmp/ripgrep/source cargo build -j 4 --offline --bin rg --target-dir /tmp/ripgrep/build
SLOP cp /tmp/ripgrep/build/debug/rg /usr/bin/rg
SLOP mkdir -p /usr/share/licenses/ripgrep /usr/share/dolly/builds
SLOP cp /tmp/ripgrep/source/LICENSE-MIT /usr/share/licenses/ripgrep/LICENSE-MIT
SLOP cp /tmp/ripgrep/source/UNLICENSE /usr/share/licenses/ripgrep/UNLICENSE
SLOP cp /tmp/ripgrep/source/Cargo.lock /usr/share/dolly/builds/ripgrep.lock
SLOP rm -rf /tmp/ripgrep /tmp/ripgrep.tar.gz

EXPORTS TOOL rg
EXPORTS FOLDER ripgrep-licenses /usr/share/licenses/ripgrep
FILE /usr/share/dolly/builds/ripgrep.lock
SLOP rg --version
SLOP mkdir -p /usr/share/man/cat1
SLOP rg --help > /usr/share/man/cat1/rg.1
FILE /usr/share/man/cat1/rg.1
