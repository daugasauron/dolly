DOLLY 7
PACKAGE fd
REQUIRES HOST runtime@0
REQUIRES HOST threads@0

FROM /v0.1.4/demos/rust/Dollyfile-rust-build 3c8e804d3c5863387c763dd986a3c7647469b78e22b031a1147f61511b2d7667
REQUIRES TOOL cargo
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

# The archive holds upstream source and its locked crates, checksum-verified,
# laid out as Cargo's directory source.
SOURCE /v0.1.4/dist/static/rust/fd.tar.gz ec120f2da383db8bb5361b27e48920a0b162bbe55bf0e3a9902eee0b83289355 /tmp/fd.tar.gz
SLOP gzip -dc /tmp/fd.tar.gz | tar -xf - -C /
SLOP CWD /tmp/fd/source cargo build -j 4 --offline --bin fd --target-dir /tmp/fd/build
SLOP cp /tmp/fd/build/debug/fd /usr/bin/fd
SLOP mkdir -p /usr/share/licenses/fd /usr/share/dolly/builds
SLOP cp /tmp/fd/source/LICENSE-MIT /usr/share/licenses/fd/LICENSE-MIT
SLOP cp /tmp/fd/source/LICENSE-APACHE /usr/share/licenses/fd/LICENSE-APACHE
SLOP cp /tmp/fd/source/Cargo.lock /usr/share/dolly/builds/fd.lock
SLOP rm -rf /tmp/fd /tmp/fd.tar.gz

EXPORTS TOOL fd
EXPORTS FOLDER fd-licenses /usr/share/licenses/fd
FILE /usr/share/dolly/builds/fd.lock
SLOP fd --version
FILE /usr/share/man/cat1/fd.1
    fd: finds files by name: upstream fd, built inside Dolly by Cargo.
    
      fd PATTERN [PATH]      paths under PATH (.) whose name matches PATTERN
      fd -e c                files ending in .c
      fd --help              every option
    
    PATTERN is a regular expression; -g takes a glob. It skips hidden files and
    what .gitignore lists unless told otherwise (-H, -I).
