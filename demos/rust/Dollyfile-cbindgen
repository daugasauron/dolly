DOLLY 7
PACKAGE cbindgen
REQUIRES HOST runtime@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

FROM /v0.1.0/demos/rust/Dollyfile-rust-build d78df632a5ee59e3683be7967b4b9d9a7bb36aa7a12e7bb12206f38ae94bced2
REQUIRES TOOL patti
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

# The tool SpiderMonkey's configure requires. The archive holds cbindgen's
# source at its pinned tag and checksum-verified locked crate archives.
SOURCE /v0.1.0/dist/static/rust/cbindgen.tar bbecf1fc3acff2829b92c66a7179ce518e967d15aae4060c0715233aa792deef /tmp/cbindgen.tar
SLOP tar -xf /tmp/cbindgen.tar -C /
SLOP patti build -j 4 --offline --manifest-path /tmp/cbindgen/source/Cargo.toml --bin cbindgen --patch libc=/opt/rust-sdk/src/libc --cache /tmp/cbindgen/cache --target-dir /tmp/cbindgen/build
SLOP cp /tmp/cbindgen/build/cbindgen /usr/bin/cbindgen
SLOP mkdir -p /usr/share/licenses/cbindgen /usr/share/dolly/builds
SLOP cp /tmp/cbindgen/source/LICENSE /usr/share/licenses/cbindgen/LICENSE
SLOP cp /tmp/cbindgen/build/patti-build.json /usr/share/dolly/builds/cbindgen.json
SLOP rm -rf /tmp/cbindgen /tmp/cbindgen.tar

EXPORTS TOOL cbindgen
EXPORTS FOLDER cbindgen-licenses /usr/share/licenses/cbindgen
FILE /usr/share/dolly/builds/cbindgen.json
SLOP cbindgen --version
