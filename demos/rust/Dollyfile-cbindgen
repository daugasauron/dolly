DOLLY 7
PACKAGE cbindgen
REQUIRES HOST runtime@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

FROM /v0.1.3/demos/rust/Dollyfile-rust-build 27b24451ab2f682b9416a6fe561039487d2ee400769327109039497bc9405f86
REQUIRES TOOL cargo
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm

# The tool SpiderMonkey's configure requires. The archive holds cbindgen's
# source at its pinned tag and its locked crates, checksum-verified, laid out
# as Cargo's directory source.
SOURCE /v0.1.3/dist/static/rust/cbindgen.tar.gz 210cd82eabf3f46fe4de03eb1c2131ffcce069574ffa41889dc19d412680f59c /tmp/cbindgen.tar.gz
SLOP gzip -dc /tmp/cbindgen.tar.gz | tar -xf - -C /
SLOP CWD /tmp/cbindgen/source cargo build -j 4 --offline --bin cbindgen --target-dir /tmp/cbindgen/build
SLOP cp /tmp/cbindgen/build/debug/cbindgen /usr/bin/cbindgen
SLOP mkdir -p /usr/share/licenses/cbindgen /usr/share/dolly/builds
SLOP cp /tmp/cbindgen/source/LICENSE /usr/share/licenses/cbindgen/LICENSE
SLOP cp /tmp/cbindgen/source/Cargo.lock /usr/share/dolly/builds/cbindgen.lock
SLOP rm -rf /tmp/cbindgen /tmp/cbindgen.tar.gz

EXPORTS TOOL cbindgen
EXPORTS FOLDER cbindgen-licenses /usr/share/licenses/cbindgen
FILE /usr/share/dolly/builds/cbindgen.lock
SLOP cbindgen --version
FILE /usr/share/man/cat1/cbindgen.1
    cbindgen: writes a C or C++ header for a Rust library's public items, built
    inside Dolly by Cargo; SpiderMonkey's configure requires it.
    
      cbindgen --crate NAME --output NAME.h     in the crate's directory
      cbindgen --help                           every option
