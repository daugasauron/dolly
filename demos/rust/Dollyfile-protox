DOLLY 7
PACKAGE protox
REQUIRES HOST runtime@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

FROM /v0.1.1/demos/rust/Dollyfile-rust-build bce904a6f1cbb297cea656212c7f4fea8732797572c20336b7c98496a488e116
REQUIRES TOOL cargo
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL rm
REQUIRES TOOL test

# The archive holds upstream source and its locked crates, checksum-verified,
# laid out as Cargo's directory source.
SOURCE /v0.1.1/dist/static/rust/protox.tar.gz bff2cf74fe7622b12f3fbc0c994bf95a9fc3630fe00031821682312633a11fe9 /tmp/protox.tar.gz
SLOP gzip -dc /tmp/protox.tar.gz | tar -xf - -C /
SLOP CWD /tmp/protox/source cargo build -j 4 --offline --bin protox --features bin --target-dir /tmp/protox/build
SLOP cp /tmp/protox/build/debug/protox /usr/bin/protox
SLOP mkdir -p /usr/share/licenses/protox /usr/share/dolly/builds
SLOP cp /tmp/protox/source/LICENSE-APACHE /usr/share/licenses/protox/LICENSE-APACHE
SLOP cp /tmp/protox/source/LICENSE-MIT /usr/share/licenses/protox/LICENSE-MIT
SLOP cp /tmp/protox/source/Cargo.lock /usr/share/dolly/builds/protox.lock
SLOP rm -rf /tmp/protox /tmp/protox.tar.gz

EXPORTS TOOL protox
EXPORTS FOLDER protox-licenses /usr/share/licenses/protox
FILE /usr/share/dolly/builds/protox.lock
FILE /tmp/protox-check.proto
    syntax = "proto3";
    message DollyCheck { string value = 1; }
SLOP protox -I /tmp -o /tmp/protox-check.pb /tmp/protox-check.proto
SLOP test -s /tmp/protox-check.pb
SLOP rm /tmp/protox-check.proto /tmp/protox-check.pb
