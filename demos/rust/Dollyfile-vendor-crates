DOLLY 7
PACKAGE vendor-crates
REQUIRES HOST runtime@0
REQUIRES HOST download@0
REQUIRES HOST http@0

# vendor-crates writes the crates.io crates a Cargo project depends on to
# vendor/ and points Cargo at them: crates.io's index sends no CORS headers
# for the files its cache holds, so Cargo cannot resolve there from a page.
# It is one Janis script linked with the runner, as janis-install is, and
# checks and decompresses crates with sha256sum (posix) and gzip.
FROM /v0.1.4/Dollyfile-system-tools 35a11274c9fbd8221484a10542d60f4d3cbb664e7df5c77996ae5d308a5452c2
INSTALL /v0.1.4/demos/javascript/Dollyfile-janis 25d4fc76e5251a6655c43ab2cbedb4b6ce0f19cc27693ddcb48f3c724ceeddcb
INSTALL /v0.1.4/Dollyfile-gzip f38751cfb56f3726afaa8c6438d35a6900e5b9676ae30986e5aea5ef5e1b9647

REQUIRES HEADER libc
REQUIRES HEADER quickjs-runner
REQUIRES LIB    dolly-js
REQUIRES LIB    quickjs
REQUIRES TOOL   cc
REQUIRES TOOL   gzip
REQUIRES TOOL   mkdir
REQUIRES TOOL   sha256sum

SOURCE /v0.1.4/dist/static/rust/vendor-crates.mjs 9ea76e5c405a2f67c93cdc970f0556b240fdd26f0b37d2a9f862f229bc1c87b2 /usr/lib/vendor-crates/vendor-crates.mjs
SOURCE /v0.1.4/dist/static/rust/vendor-crates.c   fe7c09dcabc8aeaf62b28621e32c04ec49725f3503f7f33ac6244bdfab6939a9 /tmp/vendor-crates/vendor-crates.c
SLOP cc -I /usr/include/dolly /tmp/vendor-crates/vendor-crates.c -ldolly-js -lquickjs -o /usr/bin/vendor-crates

SLOP vendor-crates --help > /usr/share/man/cat1/vendor-crates.1

EXPORTS TOOL vendor-crates
FILE /usr/lib/vendor-crates/vendor-crates.mjs
FILE /usr/share/man/cat1/vendor-crates.1
