COPY /v0.1.2/demos/rust/Dollyfile-rust-build bce904a6f1cbb297cea656212c7f4fea8732797572c20336b7c98496a488e116 /opt/rust-sdk /opt/rust-sdk
COPY /v0.1.2/demos/rust/Dollyfile-rust-build bce904a6f1cbb297cea656212c7f4fea8732797572c20336b7c98496a488e116 /usr/share/licenses/rust /usr/share/licenses/rust
# rustc links what it compiles with the C toolchain.
INSTALL /v0.1.2/Dollyfile-cc 1e6b86c8a9ea655c37ec6c74d13667e6a231c96c78ce099c902dae6c3c6aae3a
