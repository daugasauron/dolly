DOLLY 7
PACKAGE rust
REQUIRES HOST runtime@0
REQUIRES HOST dso@0
REQUIRES HOST threads@0

# The Rust SDK as rust-build built it. Its rustc finds its sysroot beside
# itself, so /usr/bin/rustc starts it by its own path.
COPY /v0.1.2/demos/rust/Dollyfile-rust-build 0fc5bd6a18530a65271a169223ac9be7db13c4f7c6f015d82671c1f28a8a3a15 /opt/rust-sdk /opt/rust-sdk
COPY /v0.1.2/demos/rust/Dollyfile-rust-build 0fc5bd6a18530a65271a169223ac9be7db13c4f7c6f015d82671c1f28a8a3a15 /usr/share/licenses/rust /usr/share/licenses/rust
# rustc links what it compiles with the C toolchain.
INSTALL /v0.1.2/Dollyfile-cc 1ee4d7e9d50a9740a041891ce347ed8856dae350c9ab0aefe2cfdf719be76964
FILE /usr/bin/rustc
    #!/bin/slop
    /opt/rust-sdk/bin/rustc "$@"
EXPORTS TOOL rustc
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
