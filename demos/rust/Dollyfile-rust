DOLLY 6
PACKAGE rust
REQUIRES HOST runtime@0
REQUIRES HOST threads@0

# The Rust SDK and Patti as rust-build holds them. The SDK's rustc finds its
# sysroot beside itself, so /usr/bin/rustc starts it by its own path.
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build 2d4e8e5f7dd96f067cfc126ca490f06a201ce1920849d8d33d4e249078a1b99e /opt/rust-sdk /opt/rust-sdk
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build 2d4e8e5f7dd96f067cfc126ca490f06a201ce1920849d8d33d4e249078a1b99e /usr/bin/patti /usr/bin/patti
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build 2d4e8e5f7dd96f067cfc126ca490f06a201ce1920849d8d33d4e249078a1b99e /usr/share/licenses/rust /usr/share/licenses/rust
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build 2d4e8e5f7dd96f067cfc126ca490f06a201ce1920849d8d33d4e249078a1b99e /usr/share/licenses/patti /usr/share/licenses/patti
FILE /usr/bin/rustc
    #!/bin/slop
    /opt/rust-sdk/bin/rustc "$@"
EXPORTS TOOL rustc
EXPORTS TOOL patti
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
