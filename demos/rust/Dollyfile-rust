# The Rust SDK and Patti as rust-build holds them. The SDK's rustc finds its
# sysroot beside itself, so /usr/bin/rustc starts it by its own path.
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build afe5c33afdd9e7f928d51adf8aa083ce2435f1e9c5580b4f4ec2abc94adb3c93 /opt/rust-sdk /opt/rust-sdk
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build afe5c33afdd9e7f928d51adf8aa083ce2435f1e9c5580b4f4ec2abc94adb3c93 /usr/bin/patti /usr/bin/patti
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build afe5c33afdd9e7f928d51adf8aa083ce2435f1e9c5580b4f4ec2abc94adb3c93 /usr/share/licenses/rust /usr/share/licenses/rust
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build afe5c33afdd9e7f928d51adf8aa083ce2435f1e9c5580b4f4ec2abc94adb3c93 /usr/share/licenses/patti /usr/share/licenses/patti
# rustc links what it compiles with the C toolchain.
INSTALL https://daugasauron.com/Dollyfile-cc 98c6ebedf593c564a64390ac95f891a4c43fbec5f68ab3c659a0b595dec19437
FILE /usr/bin/rustc
    #!/bin/slop
    /opt/rust-sdk/bin/rustc "$@"
EXPORTS TOOL rustc
EXPORTS TOOL patti
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
