DOLLY 6
PACKAGE rust
REQUIRES HOST runtime@0
REQUIRES HOST dso@0
REQUIRES HOST threads@0

# The Rust SDK and Patti as rust-build holds them. The SDK's rustc finds its
# sysroot beside itself, so /usr/bin/rustc starts it by its own path.
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build 5c9c3e2a5fce13fa141b0eb3e2e395a1cdecb191d958edd73fe8ba369ece3cd3 /opt/rust-sdk /opt/rust-sdk
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build 5c9c3e2a5fce13fa141b0eb3e2e395a1cdecb191d958edd73fe8ba369ece3cd3 /usr/bin/patti /usr/bin/patti
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build 5c9c3e2a5fce13fa141b0eb3e2e395a1cdecb191d958edd73fe8ba369ece3cd3 /usr/share/licenses/rust /usr/share/licenses/rust
COPY https://daugasauron.com/demos/rust/Dollyfile-rust-build 5c9c3e2a5fce13fa141b0eb3e2e395a1cdecb191d958edd73fe8ba369ece3cd3 /usr/share/licenses/patti /usr/share/licenses/patti
# rustc links what it compiles with the C toolchain.
INSTALL https://daugasauron.com/Dollyfile-cc ddb74ea1ea3bc19a366f10064efdafd172e4256d25de1d4d60cc2a1bdef17b9a
FILE /usr/bin/rustc
    #!/bin/slop
    /opt/rust-sdk/bin/rustc "$@"
EXPORTS TOOL rustc
EXPORTS TOOL patti
EXPORTS FOLDER rust-sdk /opt/rust-sdk
EXPORTS FOLDER rust-licenses /usr/share/licenses/rust
