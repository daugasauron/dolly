# Janis: Dolly's runner on the QuickJS library, with Node's module rules and
# a finite node:* surface over Dolly's files, processes and HTTP. The runner
# is a library too: a program that is one script (tsc, pi, a game's agent)
# links -ldolly-js -lquickjs and reads the two scripts kept here when it starts.
FROM /Dollyfile-system-tools 9bf7b939f6f7618b08e3af8d670717747e9a38311a736479bcc002db79e2c112
INSTALL /demos/javascript/Dollyfile-quickjs 162636b7b5e0bd42d755c2abf7ea1b060f39242d337e7d181d8a82195a860d8a
INSTALL /Dollyfile-libdolly-download c4fcb208423787a23dba384fa56a9e7a94680d3fbe8a107e3e59b2237ab6dc16

REQUIRES HEADER libc
REQUIRES HEADER runtime
REQUIRES HEADER download
REQUIRES HEADER quickjs
REQUIRES LIB    quickjs
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   mkdir

SOURCE /dist/static/default/runtimes/quickjs-main.c   9d9ead69394e94723f98e89766484f7fa2a6674b64ac9d03943c6d04f2999373 /tmp/janis/quickjs-main.c
SOURCE /dist/static/default/runtimes/quickjs-runner.h cb2ae27cc02ed3d90b43eeb924f474b01fa8d7598f1e5989b0de3fcd12c2a97f /usr/include/dolly/quickjs-runner.h
SOURCE /dist/static/default/runtimes/dolly-node.js    d7e19c4bb4f46cce32ccbe2130e5f5e9203c1ba185cf0d0a9952f5d1b1ecabd3 /usr/lib/dolly/node.js
SOURCE /dist/static/default/runtimes/janis.js         938d296286745dbab9a30e33f7f78963077070427e7c8a2ddec9bc310018c89a /usr/lib/janis/runtime.js
SOURCE /dist/static/default/commands/janis.c          08c40227d11f06e851a6406fe5ed8f8d7e5f7cdd28a3dad2609c04650a7afe1b /tmp/janis/janis.c

SLOP cc -O2 -std=gnu11 -funsigned-char -D_GNU_SOURCE -I /usr/include/dolly -c /tmp/janis/quickjs-main.c -o /tmp/janis/quickjs-main.o
SLOP ar rcs /usr/lib/libdolly-js.a /tmp/janis/quickjs-main.o
SLOP cc -I /usr/include/dolly /tmp/janis/janis.c -ldolly-js -lquickjs -o /usr/bin/janis

SLOP test "$(janis -e 'console.log(require("node:fs").readFileSync("/tmp/janis/janis.c", "utf8").includes("dolly_quickjs_run"))')" = true
SLOP test "$(janis -e 'console.log(typeof Atomics, typeof SharedArrayBuffer)')" = "object function"
SLOP janis --help > /usr/share/man/cat1/janis.1

EXPORTS TOOL   janis
EXPORTS LIB    dolly-js       /usr/lib/libdolly-js.a
EXPORTS HEADER quickjs-runner /usr/include/dolly/quickjs-runner.h
FILE /usr/lib/dolly/node.js
FILE /usr/lib/janis/runtime.js
FILE /usr/share/man/cat1/janis.1
