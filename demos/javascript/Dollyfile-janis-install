DOLLY 7
PACKAGE janis-install
REQUIRES HOST runtime@0
REQUIRES HOST download@0
REQUIRES HOST http@0

# janis-install NAME[@VERSION] installs a package from the npm registry and
# the packages it depends on into /usr/lib/node_modules, with a /usr/bin
# launcher for each command it names. It is one Janis script linked with the
# runner, as tsc is, and checks and decompresses tarballs with sha512sum and gzip.
FROM /v0.1.7/Dollyfile-system-tools bf4bd9f3bb45209cbf68e170f74fa8a85f093f10593f36a8f6d3e499ebce4114
INSTALL /v0.1.7/demos/javascript/Dollyfile-janis cff0675c7c09f5a48bac6783ac115c10926bc87d7dcd52e778027d4fdc1c73b1
INSTALL /v0.1.7/Dollyfile-gzip fe37ea911f935be9f5dc2fcf29fdddba385759e05220a033ebaea81a810a16b5
INSTALL /v0.1.7/demos/tools/Dollyfile-sbase 212574c483104350d6b269938c627f78a937e9d4f3c74a7253de7a6d0356a57f

REQUIRES HEADER libc
REQUIRES HEADER quickjs-runner
REQUIRES LIB    dolly-js
REQUIRES LIB    quickjs
REQUIRES TOOL   cc
REQUIRES TOOL   gzip
REQUIRES TOOL   mkdir
REQUIRES TOOL   sha512sum

SOURCE /v0.1.7/dist/static/default/runtimes/janis-install.mjs bd49ed1516ea935601a6ab9b4fc0d03e386524a39a7ee13e5bddc66d2e6c0722 /usr/lib/janis-install/janis-install.mjs
SOURCE /v0.1.7/dist/static/default/commands/janis-install.c   3a9eeafa19aea3b722e725072b5296d63511a1e0a4859b057e1b6cb03befedb6 /tmp/janis-install/janis-install.c
SLOP cc -I /usr/include/dolly /tmp/janis-install/janis-install.c -ldolly-js -lquickjs -o /usr/bin/janis-install

SLOP janis-install --help > /usr/share/man/cat1/janis-install.1

EXPORTS TOOL janis-install
FILE /usr/lib/janis-install/janis-install.mjs
FILE /usr/share/man/cat1/janis-install.1
