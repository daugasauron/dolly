DOLLY 7
PACKAGE janis-install
REQUIRES HOST runtime@0
REQUIRES HOST download@0
REQUIRES HOST http@0

# janis-install NAME[@VERSION] installs a package from the npm registry and
# the packages it depends on into /usr/lib/node_modules, with a /usr/bin
# launcher for each command it names. It is one Janis script linked with the
# runner, as tsc is, and checks and decompresses tarballs with sha512sum and gzip.
FROM /v0.1.3/Dollyfile-system-tools 13ba21000aa665d6729f8e00cb795c4871f3bfaa72a4e18a7197d536b84a5826
INSTALL /v0.1.3/demos/javascript/Dollyfile-janis 93c552ad1f37b8cd86880806d76f06732dab9753e4f5172df5d2d0cd044b7517
INSTALL /v0.1.3/Dollyfile-gzip a80a7ce96d5c9e4ce3fc40d1086121decf3fda7d00d4c07295ed8732745feec6
INSTALL /v0.1.3/demos/tools/Dollyfile-sbase ae786f43f37f839a6c89a5bd333ab76162d2ffdab96fb28629dc9cbd549da212

REQUIRES HEADER libc
REQUIRES HEADER quickjs-runner
REQUIRES LIB    dolly-js
REQUIRES LIB    quickjs
REQUIRES TOOL   cc
REQUIRES TOOL   gzip
REQUIRES TOOL   mkdir
REQUIRES TOOL   sha512sum

SOURCE /v0.1.3/dist/static/default/runtimes/janis-install.mjs 0f65122856fd657d6d0e8f984c7268715e5af2eea0e61ec282d79d37f72c5747 /usr/lib/janis-install/janis-install.mjs
SOURCE /v0.1.3/dist/static/default/commands/janis-install.c   3a9eeafa19aea3b722e725072b5296d63511a1e0a4859b057e1b6cb03befedb6 /tmp/janis-install/janis-install.c
SLOP cc -I /usr/include/dolly /tmp/janis-install/janis-install.c -ldolly-js -lquickjs -o /usr/bin/janis-install

SLOP mkdir -p /usr/share/man/cat1
SLOP janis-install --help > /usr/share/man/cat1/janis-install.1

EXPORTS TOOL janis-install
FILE /usr/lib/janis-install/janis-install.mjs
FILE /usr/share/man/cat1/janis-install.1
