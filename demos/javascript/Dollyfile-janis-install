DOLLY 7
PACKAGE janis-install
REQUIRES HOST runtime@0
REQUIRES HOST download@0
REQUIRES HOST http@0

# janis-install NAME[@VERSION] installs a package from the npm registry and
# the packages it depends on into /usr/lib/node_modules, with a /usr/bin
# launcher for each command it names. It is one Janis script linked with the
# runner, as tsc is, and checks and decompresses tarballs with sha512sum and gzip.
FROM /v0.1.5/Dollyfile-system-tools 9bc38034f4d331f3175758f9e8d606d9fc3a34061657e0a43951c9ba828e8eb3
INSTALL /v0.1.5/demos/javascript/Dollyfile-janis e23707ae6a2153ea765228b62420f6e334b98208389a5300d9d6340599237dd1
INSTALL /v0.1.5/Dollyfile-gzip 63931bb8773b8079a4ce1b619372e24b304ca5fb0585302cf8d2d80edc3e37c8
INSTALL /v0.1.5/demos/tools/Dollyfile-sbase ece2e42316d673dfd5e9d5fdd5788ff63971dd1183a40243046904963f25372c

REQUIRES HEADER libc
REQUIRES HEADER quickjs-runner
REQUIRES LIB    dolly-js
REQUIRES LIB    quickjs
REQUIRES TOOL   cc
REQUIRES TOOL   gzip
REQUIRES TOOL   mkdir
REQUIRES TOOL   sha512sum

SOURCE /v0.1.5/dist/static/default/runtimes/janis-install.mjs bd49ed1516ea935601a6ab9b4fc0d03e386524a39a7ee13e5bddc66d2e6c0722 /usr/lib/janis-install/janis-install.mjs
SOURCE /v0.1.5/dist/static/default/commands/janis-install.c   3a9eeafa19aea3b722e725072b5296d63511a1e0a4859b057e1b6cb03befedb6 /tmp/janis-install/janis-install.c
SLOP cc -I /usr/include/dolly /tmp/janis-install/janis-install.c -ldolly-js -lquickjs -o /usr/bin/janis-install

SLOP janis-install --help > /usr/share/man/cat1/janis-install.1

EXPORTS TOOL janis-install
FILE /usr/lib/janis-install/janis-install.mjs
FILE /usr/share/man/cat1/janis-install.1
