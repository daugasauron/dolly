DOLLY 7
PACKAGE janis-install
REQUIRES HOST runtime@0
REQUIRES HOST download@0
REQUIRES HOST http@0

# janis-install NAME[@VERSION] installs a package from the npm registry and
# the packages it depends on into /usr/lib/node_modules, with a /usr/bin
# launcher for each command it names. It is one Janis script linked with the
# runner, as tsc is, and checks and decompresses tarballs with sha512sum and gzip.
FROM /v0.1.6/Dollyfile-system-tools ec2173d41592d7ecdc825db884a8dfeb3acebb13dcdcd678cd00c237c78b6052
INSTALL /v0.1.6/demos/javascript/Dollyfile-janis 9e62a8ad84e01713f3816265c7689bd29f759248417a4d338e8804ca506419eb
INSTALL /v0.1.6/Dollyfile-gzip 366928611d0b4c8c8e071ea92ff7c00c8e130b2368df21b089bfc2c75b8717de
INSTALL /v0.1.6/demos/tools/Dollyfile-sbase 663a473db7670c628bca34148021b6c247dfbf80aa323bf12ad41ca7c4521497

REQUIRES HEADER libc
REQUIRES HEADER quickjs-runner
REQUIRES LIB    dolly-js
REQUIRES LIB    quickjs
REQUIRES TOOL   cc
REQUIRES TOOL   gzip
REQUIRES TOOL   mkdir
REQUIRES TOOL   sha512sum

SOURCE /v0.1.6/dist/static/default/runtimes/janis-install.mjs bd49ed1516ea935601a6ab9b4fc0d03e386524a39a7ee13e5bddc66d2e6c0722 /usr/lib/janis-install/janis-install.mjs
SOURCE /v0.1.6/dist/static/default/commands/janis-install.c   3a9eeafa19aea3b722e725072b5296d63511a1e0a4859b057e1b6cb03befedb6 /tmp/janis-install/janis-install.c
SLOP cc -I /usr/include/dolly /tmp/janis-install/janis-install.c -ldolly-js -lquickjs -o /usr/bin/janis-install

SLOP janis-install --help > /usr/share/man/cat1/janis-install.1

EXPORTS TOOL janis-install
FILE /usr/lib/janis-install/janis-install.mjs
FILE /usr/share/man/cat1/janis-install.1
