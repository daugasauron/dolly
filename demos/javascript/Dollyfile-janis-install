DOLLY 8
PACKAGE janis-install
REQUIRES HOST runtime@0
REQUIRES HOST download@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

# janis-install NAME[@VERSION] installs a package from the npm registry and
# the packages it depends on into /usr/lib/node_modules, with a /usr/bin
# launcher for each command it names. It is one Janis script linked with the
# runner, as tsc is, and checks and decompresses tarballs with sha512sum and gzip.
FROM /Dollyfile-system-tools 41d78b18183d4c4d3786fa7131c53810a1b0090f845b8298a56f0ae87a02db9e
INSTALL /demos/javascript/Dollyfile-janis c1a388558985f8fb9a73f052e153428f220b3db633f40741998bcf219745d50c
INSTALL /Dollyfile-gzip cef69a22c3b9f73889f4c819fcfaee2fb4487474ea4efa364117b8796465d1a4
INSTALL /demos/tools/Dollyfile-sbase 7084fca4802063720599aa301c5243e9c17244cb536d3336bf32206dc9b176a4

REQUIRES HEADER libc
REQUIRES HEADER quickjs-runner
REQUIRES LIB    dolly-js
REQUIRES LIB    quickjs
REQUIRES TOOL   cc
REQUIRES TOOL   gzip
REQUIRES TOOL   mkdir
REQUIRES TOOL   sha512sum

SOURCE /dist/static/default/runtimes/janis-install.mjs bd49ed1516ea935601a6ab9b4fc0d03e386524a39a7ee13e5bddc66d2e6c0722 /usr/lib/janis-install/janis-install.mjs
SOURCE /dist/static/default/commands/janis-install.c   3a9eeafa19aea3b722e725072b5296d63511a1e0a4859b057e1b6cb03befedb6 /tmp/janis-install/janis-install.c
SLOP cc -I /usr/include/dolly /tmp/janis-install/janis-install.c -ldolly-js -lquickjs -o /usr/bin/janis-install

SLOP janis-install --help > /usr/share/man/cat1/janis-install.1

EXPORTS TOOL janis-install
FILE /usr/lib/janis-install/janis-install.mjs
FILE /usr/share/man/cat1/janis-install.1
