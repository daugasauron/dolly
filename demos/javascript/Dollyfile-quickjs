DOLLY 7
PACKAGE quickjs
REQUIRES HOST runtime@0

# QuickJS-ng from its pinned checkout, unchanged, as upstream's CMakeLists.txt
# builds it: the engine as a library (-lquickjs, <quickjs.h>) and upstream's
# qjs, the engine with its own std, os and bjson modules and nothing of Node.
# EMSCRIPTEN is upstream's switch for a target without threads: there is no
# os.Worker, and os.exec fails because nothing here forks.
FROM /v0.1.4/Dollyfile-system-tools d05eab32629208de16683f7ae4e2490501bcd220bf6ffd5ad9b9494d28ac6c6b

REQUIRES HEADER libc
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   cp
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   tar

SOURCE /v0.1.4/dist/static/default/quickjs.tar 9fd1cf2a32d292362acf460b48b2332e1e4a8dd49e603b62ad9ba87bc1205af8 /tmp/quickjs.tar
SLOP tar -xf /tmp/quickjs.tar -C /

FILE /tmp/quickjs.mk
    .RECIPEPREFIX := >
    SOURCE := /usr/src/quickjs
    ENGINE := dtoa libregexp libunicode quickjs
    COMMAND := qjs quickjs-libc gen/repl gen/standalone
    CFLAGS := -O2 -std=gnu11 -funsigned-char -DEMSCRIPTEN=1 -D_GNU_SOURCE -DQUICKJS_NG_BUILD -DNDEBUG
    objects = $(addprefix $(SOURCE)/,$(addsuffix .o,$(1)))
    all: /usr/bin/qjs
    $(SOURCE)/%.o: $(SOURCE)/%.c
    >cc $(CFLAGS) -c $< -o $@
    /usr/lib/libquickjs.a: $(call objects,$(ENGINE))
    >ar rcs $@ $^
    /usr/bin/qjs: $(call objects,$(COMMAND)) /usr/lib/libquickjs.a
    >cc $^ -o $@
SLOP make -j4 -f /tmp/quickjs.mk
SLOP cp /usr/src/quickjs/quickjs.h /usr/include/quickjs.h

SLOP test "$(qjs -e 'console.log(6 * 7)')" = 42
# qjs --help ends with status 1.
SLOP qjs --help > /usr/share/man/cat1/qjs.1 || test -s /usr/share/man/cat1/qjs.1

EXPORTS TOOL   qjs
EXPORTS LIB    quickjs /usr/lib/libquickjs.a
EXPORTS HEADER quickjs /usr/include/quickjs.h
FILE /usr/share/man/cat1/qjs.1
FILE /usr/share/licenses/quickjs-ng/LICENSE
