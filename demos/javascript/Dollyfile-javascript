DOLLY 6
PACKAGE javascript
REQUIRES HOST download@0
REQUIRES HOST http@0

# QuickJS, Janis and TypeScript, built by typescript-build; the package keeps
# only the exports below.
FROM https://daugasauron.com/demos/javascript/Dollyfile-typescript-build b3348eb05e78380bb3dc67ba23a6a19a32c64ca5dfba130615ba2e326e125273

EXPORTS TOOL   qjs
EXPORTS TOOL   janis
EXPORTS TOOL   tsc
EXPORTS LIB    dolly-js       /usr/lib/libdolly-js.a
EXPORTS HEADER quickjs-runner /usr/include/dolly/quickjs-runner.h
EXPORTS HEADER quickjs        /usr/include/quickjs.h
EXPORTS FOLDER typescript     /usr/lib/typescript
FILE /usr/lib/dolly/node.js
FILE /usr/lib/janis/runtime.js
FILE /usr/share/licenses/quickjs-ng/LICENSE
