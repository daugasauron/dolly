# libmd's SHA-1, the one hash the server takes from it (glyph names), and
# libXfont2 with what the server reads: its built-in "fixed" and "cursor"
# fonts and PCF and BDF files, gzipped or not. Not built: FreeType (and so
# libfontenc) and the font server client, which needs TCP.
FILE /tmp/xorg/libs.mk
    .RECIPEPREFIX := >
    .DELETE_ON_ERROR:
    MAKEFLAGS += -r
    S := /tmp/xorg
    B := /tmp/xorg/build
    all: /usr/lib/libmd.a /usr/lib/libXfont2.a /usr/lib/pkgconfig/xfont2.pc
    
    MD := $(S)/libmd-1.3.0
    $(B)/md/sha1.o: $(MD)/src/sha1.c
    >mkdir -p $(@D)
    >printf '#define HAVE_EXPLICIT_BZERO 1\n' > $(B)/md/config.h
    >cc -O2 -I$(B)/md -I$(MD)/include -I$(MD)/src -c $< -o $@
    /usr/lib/libmd.a: $(B)/md/sha1.o
    >cp $(MD)/include/sha1.h /usr/include/
    >ar rcs $@ $^
    
    XFONT := $(S)/libXfont2-2.0.9
    XFONT_SOURCES := $(wildcard $(addprefix $(XFONT)/src/,stubs/*.c util/*.c fontfile/*.c bitmap/*.c builtins/*.c))
    XFONT_SOURCES := $(filter-out $(addprefix %/,reallocarray.c realpath.c strlcat.c strlcpy.c bunzip2.c),$(XFONT_SOURCES))
    # configure's answers here, and the formats it builds by default. The
    # server calls it with its own 64-bit protocol types (_XSERVER64: XID,
    # Mask and Atom are CARD32), and WebAssembly checks a call's signature.
    XFONT_FLAGS := -D_XSERVER64 -D_GNU_SOURCE -DHAVE_POLL -DHAVE_POLL_H -DHAVE_READLINK -DHAVE_STRLCAT \
      -DHAVE_REALLOCARRAY -DHAVE_REALPATH -DHAVE_STRLCPY -DHAVE_ENDIAN_H -DHAVE_ERR_H -DHAVE_FLOAT_H \
      -DX_GZIP_FONT_COMPRESSION -DXFONT_BUILTINS -DXFONT_PCFFORMAT -DXFONT_BDFFORMAT \
      -DXFONT_SNFFORMAT -DXFONT_BITMAP -DXFONT_FONTFILE -DNO_LOCALE -DXTHREADS -DXUSE_MTSAFE_API
    $(B)/Xfont2/%.o: $(XFONT)/src/%.c
    >mkdir -p $(@D)
    >cc -O2 $(XFONT_FLAGS) -I$(XFONT) -I$(XFONT)/include -c $< -o $@
    /usr/lib/libXfont2.a: $(patsubst $(XFONT)/src/%.c,$(B)/Xfont2/%.o,$(XFONT_SOURCES))
    >cp $(XFONT)/include/X11/fonts/libxfont2.h /usr/include/X11/fonts/
    >ar rcs $@ $^
    /usr/lib/pkgconfig/xfont2.pc: /usr/lib/libXfont2.a
    >printf '%s\n' 'prefix=/usr' 'Name: Xfont2' 'Description: X font Library version 2' 'Version: 2.0.9' \
       'Requires: xproto fontsproto' 'Libs: -L/usr/lib -lXfont2 -lz -lm' 'Cflags: -I/usr/include' > $@
SLOP make -j4 -f /tmp/xorg/libs.mk

# The server: Xsdl alone, without a GPU, TCP, shared memory or Xorg's
# hardware. epoll_create1 is a stub in libc, which Meson's function check
# would find: __stub_ names it so, as glibc does.
# Its sockets are sockets@0's, which it asks for when it links: set after
# setup, which would link its linker probe with them.
SLOP meson setup /tmp/xorg/build/server /tmp/xorg/xorg-server-21.1.25 --prefix=/usr --libdir=lib \
  --buildtype=release -Dc_args=-D__stub_epoll_create1 \
  -Dxsdl=true -Dxorg=false -Dxephyr=false -Dxnest=false -Dxvfb=false -Dxwin=false -Dxquartz=false \
  -Dglamor=false -Dglx=false -Ddri1=false -Ddri2=false -Ddri3=false -Ddrm=false -Dudev=false \
  -Dudev_kms=false -Dhal=false -Dsystemd_logind=false -Dxdmcp=false -Dxdm-auth-1=false \
  -Dsecure-rpc=false -Dipv6=false -Dinput_thread=false -Dmitshm=false -Dxselinux=false \
  -Dlinux_apm=false -Dlinux_acpi=false -Dpciaccess=false -Dint10=false -Dvgahw=false -Ddga=false \
  -Dxv=false -Dxvmc=false -Ddocs=false -Ddevel-docs=false -Dsha1=libmd -Dlibunwind=false \
  -Ddefault_font_path=built-ins -Dxkb_output_dir=/tmp
SLOP meson configure -Dc_link_args=-ldolly-sockets /tmp/xorg/build/server
SLOP meson compile -C /tmp/xorg/build/server && meson install --no-rebuild -C /tmp/xorg/build/server
SLOP text-page /usr/share/man/man1/Xserver.1
SLOP CWD /tmp/xorg for source in xorg-server-21.1.25 libXfont2-2.0.9 libmd-1.3.0; do mkdir -p /usr/share/licenses/${source%%-[0-9]*} && cp $source/COPYING /usr/share/licenses/${source%%-[0-9]*}/; done

EXPORTS TOOL Xsdl
FILE /usr/share/man/cat1/Xserver.1
FILE /usr/share/man/cat1/Xsdl.1
    Xsdl: the X server in Dolly's display, kdrive's SDL server with xkbcomp for
    its keymap. One screen; clients connect at /tmp/.X11-unix/XN, not over TCP.
    
      Xsdl :0 -nolock &              starts it as display :0
      DISPLAY=:0 xclock &            a client on it
      Xsdl :0 -screen 1600x900 -nolock    the size of its screen
    
    -nolock is needed: the server makes its lock file with link(), and Dolly's
    filesystem has no hard links, so without it the server ends at once
    ("Linking lock file ... failed: Too many links"). It holds the display, the
    keyboard and the pointer until it ends; kill its process to end it.
    Xserver(1) lists the other options.
FOLDER /usr/share/licenses/xorg-server
FOLDER /usr/share/licenses/libXfont2
FOLDER /usr/share/licenses/libmd
