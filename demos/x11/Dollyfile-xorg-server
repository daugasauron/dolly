# and the keyboard descriptions xkbcomp reads. libXfont2 (its built-in and
# bitmap fonts) and libmd's SHA-1 are built by the Makefile below for the
# server alone: libXfont2 with the server's own protocol types, and of libmd
# only the hash the server takes.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build e074880a15b565617d3d59732f7a85b52eb0a271162d5bca2dcdb8f94c5774f1
