# Xsdl, the X server on Dolly's display: X.Org's kdrive in an SDL window
# (xsdl/), drawn by the sdl2 package into Dolly's display, from X.Org's release
# archive, built by upstream's Meson; with the xkbcomp it runs for its keymap
# and the keyboard descriptions xkbcomp reads. libXfont2 (its built-in and
# bitmap fonts) and libmd's SHA-1 are built by the Makefile below for the
# server alone: libXfont2 with the server's own protocol types, and of libmd
# only the hash the server takes.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build cdfab3c41d68884ae36bc1f3a0cc706f8e4fd1ed15772d54fa540749d65253f5
