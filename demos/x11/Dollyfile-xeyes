DOLLY 7
PACKAGE xeyes
REQUIRES HOST runtime@0
REQUIRES HOST sockets@0

# xeyes from X.Org's release archive, unchanged, drawn with the Render
# extension; Present is not built (it needs xcb's extension libraries).
FROM /v0.1.3/demos/x11/Dollyfile-x11-build caf84b17e013c30146c92e4ef5e80e60849a47504e4d0d9512bd0e8c46173409

SOURCE /v0.1.3/dist/static/x11/xeyes-1.3.1.tar.gz d223283270488b1a6b408d0e97bd69a7704cf6a9596c0320035d807e63cdc084 /tmp/xeyes.tar.gz
SLOP CWD /tmp gzip -dc xeyes.tar.gz | tar -xf -
SLOP CWD /tmp/xeyes-1.3.1 cc -O2 -DXRENDER -DPACKAGE_STRING='"xeyes 1.3.1"' xeyes.c Eyes.c transform.c -o /usr/bin/xeyes \
  -lXi -lXrender -lXfixes -lXmu -lXt -lSM -lICE -lXext -lX11 -lxcb -lXau -ldolly-sockets -lm
SLOP mkdir -p /usr/share/licenses/xeyes
SLOP cp /tmp/xeyes-1.3.1/COPYING /usr/share/licenses/xeyes/
SLOP text-page /tmp/xeyes-1.3.1/man/xeyes.man && mv /usr/share/man/cat1/xeyes.man /usr/share/man/cat1/xeyes.1

EXPORTS TOOL xeyes
FILE /usr/share/licenses/xeyes/COPYING
# The licences of the X libraries it links.
FOLDER /usr/share/licenses/libXi
FOLDER /usr/share/licenses/libXrender
FOLDER /usr/share/licenses/libXfixes
FOLDER /usr/share/licenses/libXmu
FOLDER /usr/share/licenses/libXt
FOLDER /usr/share/licenses/libSM
FOLDER /usr/share/licenses/libICE
FOLDER /usr/share/licenses/libXext
FOLDER /usr/share/licenses/libX11
FOLDER /usr/share/licenses/libxcb
FOLDER /usr/share/licenses/libXau
FILE /usr/share/man/cat1/xeyes.1
