Dolly has no fork(): Popen and Pclose, with which the server runs xkbcomp,
take libc's popen and pclose, which spawn the shell.
A null function the server installs through a cast of NoopDDA(void) is a
function of the pointer's own type: WebAssembly traps on a call through a
pointer of another type.
--- a/os/utils.c
+++ b/os/utils.c
@@ -1428,6 +1428,10 @@
     FILE *iop;
     int pdes[2], pid;
 
+#ifdef __dolly__
+    /* Dolly has no fork(): its popen() spawns the shell (xkbcomp's). */
+    return popen(command, type);
+#endif
     if (command == NULL || type == NULL)
         return NULL;
 
@@ -1628,6 +1632,9 @@
     int pstat;
     int pid;
 
+#ifdef __dolly__
+    return pclose(iop);
+#endif
     DebugF("Pclose: fp = %p\n", iop);
     fclose(iop);
 
