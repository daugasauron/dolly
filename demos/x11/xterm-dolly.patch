In slave mode xterm resets its group and user ids, which Dolly refuses even
when they are the ones it has: there is nothing to reset then.
--- a/misc.c
+++ b/misc.c
@@ -2305,6 +2305,11 @@
 xtermResetIds(TScreen *screen)
 {
     int result = 0;
+#ifdef __dolly__
+    /* Dolly refuses setgid and setuid, even to the ids a process has. */
+    if (getgid() == screen->gid && getuid() == screen->uid)
+	return 0;
+#endif
     if (setgid(screen->gid) == -1) {
 	xtermWarning("unable to reset group-id\n");
 	result = -1;
