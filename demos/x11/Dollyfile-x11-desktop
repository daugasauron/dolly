# An X session on Dolly's display: the Xsdl server, twm managing the
# windows, and three of X's own clients in theirs: a clock, eyes that follow
# the pointer and a terminal with a shell, where imgui-x11 starts Dear ImGui's
# example in a window of its own.
FROM /v0.1.4/Dollyfile-system 9afff85ea68791281293b0cbacfaa1e3ead36407f060e74b56e104ee440a7217
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server ec349e378cf93986270e32c4e2f892fc0c98e7c7d8257cb229e2bb7f51b38aad
INSTALL /v0.1.4/demos/x11/Dollyfile-twm 92e6c952a8d1631bcde303ecd51ff746f6b9d1a44bc29384574011e969bc3e79
INSTALL /v0.1.4/demos/x11/Dollyfile-xclock c7724bab3bd89a28a0f838db0e6235dcde30755754e7211323b9993bb080b4ac
INSTALL /v0.1.4/demos/x11/Dollyfile-xeyes c250e0d948c57c05d2f4f342bcba2fcee556baa64717d45c8da2ccf0dbb5bb1d
INSTALL /v0.1.4/demos/x11/Dollyfile-xterm 465905968f858b8f3108720027e88149390b7677aec3a45331fa383cebdf0e98
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy de8d4c2404adfd43bb54bc492688aa8ba6d7e7d388889cb4b965e018800bafe6
INSTALL /v0.1.4/Dollyfile-nena c178ca1752cdd95bf79fad652be90724128620c5d7183097660d38565aee519e
INSTALL /v0.1.4/demos/sdl2/Dollyfile-imgui-x11 dbc9e75b36872ee08d0a65af4138dfbf1111f4a13800aa0b681afab6b08032a6

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in the terminal); its clients end with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1600x900 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    twm &
    xclock -geometry 180x180+40+40 &
    xeyes -geometry 240x160+260+40 &
    xterm -geometry 80x24+40+300 &
    wait $server
    printf 'The X server has ended.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
