# An X session on Dolly's display: the Xsdl server, twm managing the
# windows, and three of X's own clients in theirs: a clock, eyes that follow
# the pointer and a terminal with a shell, where imgui-x11 starts Dear ImGui's
# example in a window of its own.
FROM /v0.1.4/Dollyfile-system 49c8a2a1219574aa572ca8424b6f88338ecc3ff04ecf99946dcc6bbdcbc2d0dd
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server 7f571d423c01cbabfb38923a8e1bff78ee9602ab9e1fedc853c03c828b7d7ca7
INSTALL /v0.1.4/demos/x11/Dollyfile-twm ac4017b05c6ecc161e221b05af553216658fbb24b44f1ca925c6a3ad9a9a2ba7
INSTALL /v0.1.4/demos/x11/Dollyfile-xclock 8b7bab3f274495e45f2f4c7dcf6bfbff9fd758031d101d5905a3cad02270987e
INSTALL /v0.1.4/demos/x11/Dollyfile-xeyes 6297af24556ab6f0396941e5c7a73a2e83df6854ac1de4dd02e6aef9d2ecedef
INSTALL /v0.1.4/demos/x11/Dollyfile-xterm 7f437ba5400b3eb9f7afbe87302b18fdd191064debad505752eef0972b07bb9a
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy 18a346724d1ce80867fdc7ae3375921c0b0cda24bb5bfef32d5fc3a7faecd053
INSTALL /v0.1.4/Dollyfile-nena 5841c957aafee5dc9473c7f08802ec178d2bdf59a1206d51674180eea2252384
INSTALL /v0.1.4/demos/sdl2/Dollyfile-imgui-x11 4641d3216a9ca27489368f8e7bd265d3072decf87d643ccde8596795bc9b8241

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in the terminal); its clients end with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1600x900 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    twm &
    xclock -geometry 180x180+40+40 &
    xeyes -geometry 240x160+260+40 &
    xterm -geometry 80x24+40+300 &
    wait $server
    printf 'The X server has ended.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
