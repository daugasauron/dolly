# An X session on Dolly's display: the Xsdl server, twm managing the
# windows, and three of X's own clients in theirs: a clock, eyes that follow
# the pointer and a terminal with a shell, where imgui-x11 starts Dear ImGui's
# example in a window of its own.
FROM /v0.1.4/Dollyfile-system cf425a764ed8927d2e369df57f4a0437728d81ff4075de829cdccab20c3361c2
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server 03fe5270c4457b116f5bd6543415a69e6b578209a5c93114e042ad0adc522843
INSTALL /v0.1.4/demos/x11/Dollyfile-twm ec19340fc7ea014209a0db6031b0652f328832a6a6e608e72a657c86bee2c157
INSTALL /v0.1.4/demos/x11/Dollyfile-xclock 2806bc831a5f16890f539433e723e9a185c4975b04a257d3d44f8c284cc6a8f2
INSTALL /v0.1.4/demos/x11/Dollyfile-xeyes c3ca257875af9564777192e208ed7b33affa10629a2a85e52fbac4bf1390cfd8
INSTALL /v0.1.4/demos/x11/Dollyfile-xterm 8c8c206d2c8e74dcaf7cefde37fc00134970bdf8a2821a877ff2eb5f3d399777
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy 83f602f8cb536e226d304ccefb2bcd6da1670c91002cd340703361036330d0bf
INSTALL /v0.1.4/Dollyfile-nena d1faa44c302ce509b5a7df694f78fa92451198b94b6435ba37abb9929c0c20db
INSTALL /v0.1.4/demos/sdl2/Dollyfile-imgui-x11 a757631eb5a9201e6d1cea5448ce10ce5d09812ed17162605521fc9344e18830

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in the terminal); its clients end with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1600x900 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    # SDL programs started from here draw through X, not Dolly's display.
    export SDL_VIDEODRIVER=x11
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    twm &
    xclock -geometry 180x180+40+40 &
    xeyes -geometry 240x160+260+40 &
    xterm -geometry 80x24+40+300 &
    wait $server
    printf 'The X server has ended.\n'
    unset SDL_VIDEODRIVER
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
