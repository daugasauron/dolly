# An X session on Dolly's display: the Xsdl server, twm managing the
# windows, and two of X's own clients in theirs.
FROM /v0.1.3/Dollyfile-system 6537319cb5da6fdf6da34117e1b97113b8bc0d788d1f5c9453f05ff7207828df
INSTALL /v0.1.3/demos/x11/Dollyfile-xorg-server 7722b9739f41bd73adeeb7776f9dad3a4b33ddf849742ce61c134bec263d546a
INSTALL /v0.1.3/demos/x11/Dollyfile-twm 34fba55feebc1a98ef018f9d953acdc992ff74a4f695cf08c583efe77a21333b
INSTALL /v0.1.3/demos/x11/Dollyfile-xclock 7e1e47cb4c10ddea8a30e3743ebcfc8c8fcdd17074c5f26f17846a585c2774d7
INSTALL /v0.1.3/demos/x11/Dollyfile-xeyes 52099710764f1d3045168de111e3dc6cae0e8a929313b965ad8e127edea6557d

# The server takes the display and the keyboard and pointer; the shell that
# started it waits for it and is the recovery shell once it has ended.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1024x768 -nolock -dumbSched -s 0 &
    server=$!
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    twm &
    xclock -geometry 180x180+40+40 &
    xeyes -geometry 240x160+260+40 &
    wait $server

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
