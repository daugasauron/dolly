# An X session on Dolly's display: the Xsdl server, twm managing the
# windows, and three of X's own clients in theirs: a clock, eyes that follow
# the pointer and a terminal with a shell, where imgui-x11 starts Dear ImGui's
# example in a window of its own.
FROM /v0.1.4/Dollyfile-system 915c71d4ce772989e3076060967824e48ccd6a1a6259624fe6213542df088dbc
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server fc1a9254504cf2ce3958847249b0b93bb65385d34d92f2c97f3223b746a54795
INSTALL /v0.1.4/demos/x11/Dollyfile-twm 45a0d5ef8a8b1767e34bd8433030372e14eb23f586612df9608b3e0f7cc4ecd3
INSTALL /v0.1.4/demos/x11/Dollyfile-xclock c63174ad218edee60168924bc7d2720dfa2e56c760fecc37b537c352d46a0f11
INSTALL /v0.1.4/demos/x11/Dollyfile-xeyes 0a7dbd7075fc732f876332a6550e438cc05b819cfca4bcb37c4228b5bf65ccd3
INSTALL /v0.1.4/demos/x11/Dollyfile-xterm 06af8cf51fc255fb2cfeb1f30d4e65dea8d2108ae141a244913aca98cbcb8a4f
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy 90701fe1be537fae9f0e376f2dcfda377c019426cdbab48faeb9107f91bcb6de
INSTALL /v0.1.4/Dollyfile-nena 2e851d9a70ca04b6ef01be6980cdc2e4e9e0c49a291573dde00df9558f04d249
INSTALL /v0.1.4/demos/sdl2/Dollyfile-imgui-x11 ab9d5205035bb971ae72a271f513d6117d9993ac98274466356a8c95c7533e23

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in the terminal); its clients end with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1600x900 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    twm &
    xclock -geometry 180x180+40+40 &
    xeyes -geometry 240x160+260+40 &
    xterm -geometry 80x24+40+300 &
    wait $server
    printf 'The X server has ended.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
