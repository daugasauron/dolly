# An X session on Dolly's display: the Xsdl server, twm managing the
# windows, and three of X's own clients in theirs: a clock, eyes that follow
# the pointer and a terminal with a shell, where imgui-x11 starts Dear ImGui's
# example in a window of its own.
FROM /v0.1.4/Dollyfile-system 57020abe76b98939f2413f828f8bfeae6ed9a092125645640c2bc991044a4532
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server 32a8dbf7e6c2419657cb0fe65f021e89f8df95b35e887c714da3e067aa6cf0c5
INSTALL /v0.1.4/demos/x11/Dollyfile-twm dd061cb763bdd718a9d7455d4c1bf89da059fb1a397247bd96d03bd7330eb0c2
INSTALL /v0.1.4/demos/x11/Dollyfile-xclock 0547aac56fc68156e0c480b488d8d7b22794ab36ae5c7408b2e608555d9b09e5
INSTALL /v0.1.4/demos/x11/Dollyfile-xeyes 8b7cf1b2ec09e813d950e1b056255ec8771d614766c4559bf35edaa3a03b7320
INSTALL /v0.1.4/demos/x11/Dollyfile-xterm 41947b4ad27fa4f159b87240663d2982330922c63bc5f8edb37cd02c838cbb06
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy 8ad5e794b30a0366651f0283aa92fe6de36f891772dbc685f5dbcdaa7daac656
INSTALL /v0.1.4/Dollyfile-nena fba5c91bea777c617e5626650a433a428fa942f593b7792c083489adf1dd9f8f
INSTALL /v0.1.4/demos/sdl2/Dollyfile-imgui-x11 2da4292cedc8e402b773ec556635330c7438e935000f45abd6a21d277f29b0bf

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in the terminal); its clients end with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1600x900 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    twm &
    xclock -geometry 180x180+40+40 &
    xeyes -geometry 240x160+260+40 &
    xterm -geometry 80x24+40+300 &
    wait $server
    printf 'The X server has ended.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
