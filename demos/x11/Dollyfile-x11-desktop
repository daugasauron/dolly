# An X session on Dolly's display: the Xsdl server, twm managing the
# windows, and three of X's own clients in theirs: a clock, eyes that follow
# the pointer and a terminal with a shell, where imgui-x11 starts Dear ImGui's
# example in a window of its own.
FROM /v0.1.4/Dollyfile-system 0d7679b488d33587fae002d3513d704f53b0ed28e268e8a656e357cd2b1df6d1
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server d0b4c8d627e63619af6fecde03edaec6e955261b40c14cf61ee8d143c1d39fbe
INSTALL /v0.1.4/demos/x11/Dollyfile-twm bc60d62f49c86fcf69f978b43badf7c5b82716451980ea9cc5c8905be0b9a5bd
INSTALL /v0.1.4/demos/x11/Dollyfile-xclock 3e2e4b91a645608bdbb83ef56619ddb406d3429e81e4d78c1a3e9066e0181d9b
INSTALL /v0.1.4/demos/x11/Dollyfile-xeyes a1cbd4573be9062de635457da1a685129266d5227c12aab294fc2e909878e2b7
INSTALL /v0.1.4/demos/x11/Dollyfile-xterm 8391828c5550ce98248bc9dc6ae6e0b49b7bbb7ee6510845331b44267b7a5230
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy 1d10eb7bb6aa885b88ec4212b577e053511761ee56d770fef91db0c37b983be7
INSTALL /v0.1.4/Dollyfile-nena d8bf9c07ae078f25bef5335681c7769a59505e8b70355c17a5feeee973941072
INSTALL /v0.1.4/demos/sdl2/Dollyfile-imgui-x11 2a38b4d40b8f60710e2686f066db17077aba770a2a4b57f348537c867c600883

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in the terminal); its clients end with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1600x900 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    twm &
    xclock -geometry 180x180+40+40 &
    xeyes -geometry 240x160+260+40 &
    xterm -geometry 80x24+40+300 &
    wait $server
    printf 'The X server has ended.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
