# An X session on Dolly's display: the Xsdl server, twm managing the
# windows, and three of X's own clients in theirs: a clock, eyes that follow
# the pointer and a terminal with a shell, where imgui-x11 starts Dear ImGui's
# example in a window of its own.
FROM /v0.1.4/Dollyfile-system 2e3401741eb6ab77220db31920f18139f45fde19409fba765608929658524258
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server 1fabc3c5e4ca191729061a0b88b63f855bded3e4c3abbfb129f0074acd404456
INSTALL /v0.1.4/demos/x11/Dollyfile-twm bb00ee294b2c74c6ecbccec5e2d09e34a2179841934c60235c58d49f9d0e0a22
INSTALL /v0.1.4/demos/x11/Dollyfile-xclock 953be5eeb17afbae540879fab172f6b4d531f6b1c20c413c0cce1b14c9ad217d
INSTALL /v0.1.4/demos/x11/Dollyfile-xeyes 0966d16e71cf601c14cde0a56df64ee905b475199d48c3056282e63908eb7d34
INSTALL /v0.1.4/demos/x11/Dollyfile-xterm bf21e558671a3e49dea383554a4b8f2736952d57de2fbc3623abd11e7ee5728c
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy 2747c8d4e0823eb5d4a8b4057e55780b9abe8cbb850f47c4d72c77821eadf972
INSTALL /v0.1.4/Dollyfile-nena 1dd9dcd473e683c599e4a4be019416a1eb3070e644e540bb3a054590cae611de
INSTALL /v0.1.4/demos/sdl2/Dollyfile-imgui-x11 d0ddbde9e849721cd469022fc72570a35702cc80e6872cd080fd24fd2b4cf180

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in the terminal); its clients end with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1600x900 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    # SDL programs started from here draw through X, not Dolly's display.
    export SDL_VIDEODRIVER=x11
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    twm &
    xclock -geometry 180x180+40+40 &
    xeyes -geometry 240x160+260+40 &
    xterm -geometry 80x24+40+300 &
    wait $server
    printf 'The X server has ended.\n'
    unset SDL_VIDEODRIVER
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
