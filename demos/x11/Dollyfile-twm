DOLLY 7
PACKAGE twm
REQUIRES HOST runtime@0
REQUIRES HOST sockets@0

# twm, the Tab Window Manager, from X.Org's release archive, unchanged: its
# parser and default configuration come generated in the archive.
FROM /v0.1.3/demos/x11/Dollyfile-x11-build ef76ffd4911bcf7381b82725ed24ee6c154d53c921183390ca0066fd34ea7886

SOURCE /v0.1.3/dist/static/x11/twm-1.0.13.1.tar.gz e16bdbc82ac57c096d606a90e63c42c73a4a8a6a8a04d97b7dad199f919c8471 /tmp/twm.tar.gz
SLOP CWD /tmp gzip -dc twm.tar.gz | tar -xf -
SLOP CWD /tmp/twm-1.0.13.1/src cc -O2 -DHAVE_MKSTEMP -DAPP_VERSION='"1.0.13.1"' -DDATADIR='"/usr/share"' \
  *.c -o /usr/bin/twm -lXmu -lXt -lSM -lICE -lXext -lX11 -lxcb -lXau -ldolly-sockets
SLOP mkdir -p /usr/share/X11/twm /usr/share/licenses/twm
SLOP cp /tmp/twm-1.0.13.1/src/system.twmrc /usr/share/X11/twm/
SLOP cp /tmp/twm-1.0.13.1/COPYING /usr/share/licenses/twm/
SLOP text-page /tmp/twm-1.0.13.1/man/twm.man && mv /usr/share/man/cat1/twm.man /usr/share/man/cat1/twm.1

EXPORTS TOOL twm
FILE /usr/share/X11/twm/system.twmrc
FILE /usr/share/licenses/twm/COPYING
# The licences of the X libraries it links.
FOLDER /usr/share/licenses/libXmu
FOLDER /usr/share/licenses/libXt
FOLDER /usr/share/licenses/libSM
FOLDER /usr/share/licenses/libICE
FOLDER /usr/share/licenses/libXext
FOLDER /usr/share/licenses/libX11
FOLDER /usr/share/licenses/libxcb
FOLDER /usr/share/licenses/libXau
FILE /usr/share/man/cat1/twm.1
