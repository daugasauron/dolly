USE /v0.1.7/demos/tools/Dollyfile-pkgconf 89273bd617759f49ac9c7b675e218f37cfe1a8448705a8da7c6cf607c3641645
USE /v0.1.7/demos/x11/Dollyfile-libxkbfile 1b1b3b9436a543ece6e3d3a0058a6642ba33e8bfe89b044376baa78137c7838f
USE /v0.1.7/demos/tools/Dollyfile-yacc afb29cc44d71fc1ef19db3b7cb33ba898ede32cd84df51920284bc95ef978c29
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

