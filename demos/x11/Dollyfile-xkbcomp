USE /v0.1.4/demos/tools/Dollyfile-meson c6f613ce28509cf624176a286060928a2e39db9862201a7a9d23f766f397856a
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf 1d5456b04c97495a49675010c912ab55a92bba220979cab66355da1782633947
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile ea509d2a764a46a13c3ba289096aca3c953987983406b60684b448ad32b84d2a
USE /v0.1.4/demos/tools/Dollyfile-yacc 4d64042c6d2af68abafc021586b352bce469a81980df6c40a73b7cb513b16247
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

