# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.5/demos/x11/Dollyfile-x11-build 8877f3d242487b74845f401ae2387fbf0c713aa4f0be7c50a8b5577cfec04ae4
USE /v0.1.5/demos/tools/Dollyfile-meson f9894aedacfd9594c87a3eff900d004dc6b3f64b33c31535525be2f937e465df
USE /v0.1.5/demos/zero-ad/Dollyfile-pkgconf 330b309879d8e1859663a573a47f3ed229682d4c3a5ab478602d9f4f5108837d
USE /v0.1.5/demos/x11/Dollyfile-libxkbfile 604c9ae3a8b0a8766aa0546dc43a73079c39675e8d13b2ea30feb54d5ea53ab9
USE /v0.1.5/demos/tools/Dollyfile-yacc 042c8bc412bb0e58c7d5e818c20a4f986432b7a82671de8d5540dfaa55a4ceff
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
