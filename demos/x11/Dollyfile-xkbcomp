DOLLY 7
PACKAGE xkbcomp
REQUIRES HOST runtime@0
# It reaches the X server through libX11, over a socket.
REQUIRES HOST sockets@0

# xkbcomp, X.Org's XKB keymap compiler, which the X server runs for its
# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build ddbe003fed6776198fcab0c7ea339a1fc8292e3d77066f2392b4ba55df158074
# The tar package reads the pax headers of X.Org's archives.
USE /v0.1.4/demos/tools/Dollyfile-tar 5424c2be35af3d422e7be6f4f8b0c08e682b808088b8e4944a2710708eb02aeb
USE /v0.1.4/demos/tools/Dollyfile-meson b05a86ff77c9a7ab9d79d6f1235d5895c255bbd2a1196595e573bdcdce219ecf
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf c98bc2586a752d022caca0657d7fefa69f7b06883ae4f90d782a5d7c5725bf15
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile 294414c39897eb2c3e9dc4100c86667b3f5833594daa128c62c021a4e72e1912
USE /v0.1.4/demos/tools/Dollyfile-yacc 296e168c85f62b02d98cc3b945b4756e59fda71f93006006191c5e8dcae0ecf2
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/x11/xkbcomp-1.5.0.tar.gz d070694dd8d94714aa1da3e3590b75084a4b183da3980866aedd68835954b97c /tmp/xkbcomp.tar.gz
SLOP gzip -dc /tmp/xkbcomp.tar.gz | tar -xf - -C /tmp
