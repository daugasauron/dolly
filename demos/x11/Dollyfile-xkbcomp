DOLLY 7
PACKAGE xkbcomp
REQUIRES HOST runtime@0
# It reaches the X server through libX11, over a socket.
REQUIRES HOST sockets@0

# xkbcomp, X.Org's XKB keymap compiler, which the X server runs for its
# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build 380d3ecd65fc139980ea61ec2723800eadb501c594740f1f6dafa33fe844502e
# The tar package reads the pax headers of X.Org's archives.
USE /v0.1.4/demos/tools/Dollyfile-tar c805b9181e3a51ba506952ed351913ff7f377e09fc04b336445fb69ba43f8885
USE /v0.1.4/demos/tools/Dollyfile-meson 8cf890a440853fa92bca973d935ec0cee93d5f10e38d32f7451451099866e212
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf c6deb0099a5aecaa675dd691e14197c81893d640cef9d6529fe75bc402bf8ae4
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile 2bc6c86df9a23803ac2920b538aa5379a8cf377b0cc52dec41f08a6d106b2e20
USE /v0.1.4/demos/tools/Dollyfile-yacc a84ae4ddf2ca5d2aa6e3ed9e7b9c5dd29a3b982a2b89b76d9494c66811ae1968
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/x11/xkbcomp-1.5.0.tar.gz d070694dd8d94714aa1da3e3590b75084a4b183da3980866aedd68835954b97c /tmp/xkbcomp.tar.gz
SLOP gzip -dc /tmp/xkbcomp.tar.gz | tar -xf - -C /tmp
