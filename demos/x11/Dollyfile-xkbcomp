# libxkbfile package, which it links statically.
FROM /v0.1.7/demos/x11/Dollyfile-x11-build dec72b78fc21f2dddf94fddc9f9bac489c108113a4c99df32dc3747cb2453052
USE /v0.1.7/demos/tools/Dollyfile-meson 52e4bcb6e9bbbe94ce8c29ee7baf80e17aa032950e431b1b1e92f3af3c3ff987
USE /v0.1.7/demos/zero-ad/Dollyfile-pkgconf 7d45ba27f3ff765e3dfa1d5aa4c673f7ce7ef2f5ac666a647768d44c651d6ba9
USE /v0.1.7/demos/x11/Dollyfile-libxkbfile 6805831328c95f1b1235159010cb7e2def83eebadd2b3ffc46ea2f2648448e1e
USE /v0.1.7/demos/tools/Dollyfile-yacc 8a1d1675da4cb1951c7eb99ec1a681ae3acba1cab74c09829ac046ecabed2ac4
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

