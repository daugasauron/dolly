# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.5/demos/x11/Dollyfile-x11-build eca56a7781a9a0c24610be18a2e2dff41e0ca2cc6509f7667eec0ae6fd62fba2
USE /v0.1.5/demos/tools/Dollyfile-meson 60a997fe08a0c01509b918549df967b271e2eab7066f417448c55e2a1e3166e7
USE /v0.1.5/demos/zero-ad/Dollyfile-pkgconf 2bb0e4b3d02e364c19a8f9aa379eb9a9cfdb3aafbb370cd3f0c470d2dae3b3ec
USE /v0.1.5/demos/x11/Dollyfile-libxkbfile a42938455d3858ae25ede88e9b939e005a6c6df1df97f45cc3fc5194d6e91ef0
USE /v0.1.5/demos/tools/Dollyfile-yacc ed83b157abfd16b353b79a1f08c3cee2652e093b4b00f86307768bcf5ef9532b
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

