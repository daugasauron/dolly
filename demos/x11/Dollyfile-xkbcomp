# libxkbfile package, which it links statically.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build ab1a16d8447221665a9131ccb73fb6db86f252e6044794339c9cfdeaa6776761
# The tar package reads the pax headers of X.Org's archives.
USE /v0.1.4/demos/tools/Dollyfile-tar 577e804411e56477b1021f5ededcfefa4ccfef4dc89b7b25001435ad5980667e
USE /v0.1.4/demos/tools/Dollyfile-meson 04e37da2b3a2b625b1a9123848ae0dbf771d835b8c79942897da0dd4bd64a378
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf 091f33c353d0c521fed214b1b0530e38c44964ec9dd0bebd32b4f8f79bbdac54
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile 6ab9ec5c9049b371df0378b3ca6fb36e7dde41d74bf14d36e672cdce0dadccee
USE /v0.1.4/demos/tools/Dollyfile-yacc 04f38a8aaff6a89dbf15fed8ea0eb4f1aa3bbc0936b8295bc22247ad8f1a4d5f
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
