DOLLY 7
PACKAGE xkbcomp
REQUIRES HOST runtime@0
# It reaches the X server through libX11, over a socket.
REQUIRES HOST sockets@0

# xkbcomp, X.Org's XKB keymap compiler, which the X server runs for its
# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build ff3eec2e743dc9930c83702df4b879c7f164bd9ad362d82f37a233a45819caa8
# The tar package reads the pax headers of X.Org's archives.
USE /v0.1.4/demos/tools/Dollyfile-tar 23cd8ef5cce746bd0a47657aba6d1914efd81017ec0a4c20e7f78944e058eae7
USE /v0.1.4/demos/tools/Dollyfile-meson fdf6b56135f6b2446e9b02680b94a43c04a95ddb0aa1ee9ec9176658b365eb8a
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf c9be89938c3e165017d6b0763625b658b6409345f90275460e4a161d90f679ef
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile 106dd781aba848bc567af7d479e7c65fea083ae0e7b2ec928a52f71fda057cf3
USE /v0.1.4/demos/tools/Dollyfile-yacc 897fd130f6a1e780e8bcc7022405ef6a97e96946df2c71632d2a0a0158dff1af
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/x11/xkbcomp-1.5.0.tar.gz d070694dd8d94714aa1da3e3590b75084a4b183da3980866aedd68835954b97c /tmp/xkbcomp.tar.gz
SLOP gzip -dc /tmp/xkbcomp.tar.gz | tar -xf - -C /tmp
SLOP meson setup /tmp/build/xkbcomp /tmp/xkbcomp-1.5.0 --prefix=/usr --libdir=lib --buildtype=release
SLOP meson compile -C /tmp/build/xkbcomp && meson install --no-rebuild -C /tmp/build/xkbcomp
SLOP text-page /usr/share/man/man1/xkbcomp.1
SLOP mkdir -p /usr/share/licenses/xkbcomp && cp /tmp/xkbcomp-1.5.0/COPYING /usr/share/licenses/xkbcomp/

