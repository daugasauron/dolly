DOLLY 7
PACKAGE xkbcomp
REQUIRES HOST runtime@0
# It reaches the X server through libX11, over a socket.
REQUIRES HOST sockets@0

# xkbcomp, X.Org's XKB keymap compiler, which the X server runs for its
# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build 382bbcbe86e5ea0f59bf77ad531e6f76d793699ee3a80e722497ede70fa363ea
USE /v0.1.4/demos/tools/Dollyfile-meson 2f6fa415592d323307bdd0ca4cfd2f02a4b174395d37e8f4bdebe4e72b30e68a
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf 3be7c9efdebd7eef451223743a770a1514e4bd205a981012e8e57d1af0f77a0a
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile b8283096f9fbed8aa4f4429d609e95b04085c375b709c1fc154a80b0799b522b
USE /v0.1.4/demos/tools/Dollyfile-yacc 8d84ace0741219de10b569e088fd9c29a9cacb5c4d5fab652dcc636d4f3cec0b
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/x11/xkbcomp-1.5.0.tar.gz d070694dd8d94714aa1da3e3590b75084a4b183da3980866aedd68835954b97c /tmp/xkbcomp.tar.gz
SLOP gzip -dc /tmp/xkbcomp.tar.gz | tar -xf - -C /tmp
