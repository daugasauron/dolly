DOLLY 7
PACKAGE xkbcomp
REQUIRES HOST runtime@0
# It reaches the X server through libX11, over a socket.
REQUIRES HOST sockets@0

# xkbcomp, X.Org's XKB keymap compiler, which the X server runs for its
# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build 3be1de0a0f10edebb7f81ef22b64b3026ac77096ba670196bd2ece3695c2b243
USE /v0.1.4/demos/tools/Dollyfile-meson 019eb96b8b392b2d0cd7376f68449540751d44d6c502cbbb55b6f0a4c75cb36d
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf 09d770b114113840e3f3172e0f263e53edaf94a59a140733c88c148f3534f00e
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile 62753517cf5c7f33055a8590f65853892632cc9931bc21b75ee90f5dd6f554ae
USE /v0.1.4/demos/tools/Dollyfile-yacc 16d6e95d9a558d6a90515f76292778d93189b81331a4ec0b024607945287d348
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/x11/xkbcomp-1.5.0.tar.gz d070694dd8d94714aa1da3e3590b75084a4b183da3980866aedd68835954b97c /tmp/xkbcomp.tar.gz
SLOP gzip -dc /tmp/xkbcomp.tar.gz | tar -xf - -C /tmp
SLOP meson setup /tmp/build/xkbcomp /tmp/xkbcomp-1.5.0 --prefix=/usr --libdir=lib --buildtype=release
SLOP meson compile -C /tmp/build/xkbcomp && meson install --no-rebuild -C /tmp/build/xkbcomp
SLOP text-page /usr/share/man/man1/xkbcomp.1
SLOP mkdir -p /usr/share/licenses/xkbcomp && cp /tmp/xkbcomp-1.5.0/COPYING /usr/share/licenses/xkbcomp/

EXPORTS TOOL xkbcomp
FILE /usr/share/man/cat1/xkbcomp.1
FILE /usr/share/licenses/xkbcomp/COPYING
FILE /usr/share/licenses/libxkbfile/COPYING
