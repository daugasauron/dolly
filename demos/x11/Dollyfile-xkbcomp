SLOP meson compile -C /tmp/build/xkbcomp && meson install --no-rebuild -C /tmp/build/xkbcomp
SLOP text-page /usr/share/man/man1/xkbcomp.1
SLOP mkdir -p /usr/share/licenses/xkbcomp && cp /tmp/xkbcomp-1.5.0/COPYING /usr/share/licenses/xkbcomp/

