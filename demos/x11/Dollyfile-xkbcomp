DOLLY 7
PACKAGE xkbcomp
REQUIRES HOST runtime@0
# It reaches the X server through libX11, over a socket.
REQUIRES HOST sockets@0

# xkbcomp, X.Org's XKB keymap compiler, which the X server runs for its
# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build e48216644d2fd104d23aea4e865d1f7345edbea47c31a9fa9d08a76883ead6f0
# The tar package reads the pax headers of X.Org's archives.
USE /v0.1.4/demos/tools/Dollyfile-tar aada72d3f783431c00ea312e404d1741292b06dc93030207e12304aa9f7d45a2
USE /v0.1.4/demos/tools/Dollyfile-meson 7251c38ebcac1a95b096a7996eb4e6082c1ea3eaa9bc52ddd38e7ebee5776394
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf bca60e262e4ce73256ad4290db13827bb42761310323a46f0948633b1d753760
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile 100177d2d06cfe54acb718d56bc8a11300d056e9e29f2727158b0eaa29b2eeaa
USE /v0.1.4/demos/tools/Dollyfile-yacc 5b1e0a59f8ee5d92c8874548b678cc7bb59bc342ad62d9bcc895d68afa4d4bb4
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/x11/xkbcomp-1.5.0.tar.gz d070694dd8d94714aa1da3e3590b75084a4b183da3980866aedd68835954b97c /tmp/xkbcomp.tar.gz
SLOP gzip -dc /tmp/xkbcomp.tar.gz | tar -xf - -C /tmp
