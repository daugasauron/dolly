# keymap: from its release archive, built by its Meson project against the
# libxkbfile package, which it links statically.
FROM /v0.1.4/demos/x11/Dollyfile-x11-build 246aaab7b4ba3eb2cd294499d33f937254ab1f9bf299dafdb940fafbc7be9e78
USE /v0.1.4/demos/tools/Dollyfile-meson 6755b3ea10e77675e91d0ef56d41b8d056417062e53e12471bbedec1bc623362
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf e63308c24ad362f57df661a9c5198837df0f55847f563248fb41e759ffa3dd1a
USE /v0.1.4/demos/x11/Dollyfile-libxkbfile e645abdf8c8841594a697edae1fca410568442a4da436b7ad9eecf0564eba671
USE /v0.1.4/demos/tools/Dollyfile-yacc e7fe225a02ba0650defccbdebb9a297c309c2cf6feddcfeec9e021f72e4a0c1c
REQUIRES TOOL meson
REQUIRES TOOL byacc
REQUIRES TOOL gzip
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/x11/xkbcomp-1.5.0.tar.gz d070694dd8d94714aa1da3e3590b75084a4b183da3980866aedd68835954b97c /tmp/xkbcomp.tar.gz
SLOP gzip -dc /tmp/xkbcomp.tar.gz | tar -xf - -C /tmp
