# Dolly's libc has pselect and refuses select: xterm's waits, without a mask.
FILE /tmp/xterm/dolly-select.h
    #include <stddef.h>
    #include <sys/select.h>
    #include <sys/time.h>
    static inline int dolly_select(int count, fd_set *readers, fd_set *writers, fd_set *errors,
                                   struct timeval *timeout) {
      struct timespec wait;
      if (timeout) {
        wait.tv_sec = timeout->tv_sec;
        wait.tv_nsec = timeout->tv_usec * 1000;
      }
      return pselect(count, readers, writers, errors, timeout ? &wait : NULL, NULL);
    }
    #define select dolly_select

FILE /tmp/xterm/xterm.mk
    .RECIPEPREFIX := >
    .DELETE_ON_ERROR:
    MAKEFLAGS += -r
    X := /tmp/xterm
    SOURCES := button cachedGCs charproc charsets cursor data doublechr fontutils input \
      keysym2ucs linedata main menu misc print ptydata scrollback screen scrollbar tabs util \
      version xstrings xtermcap VTPrsTbl charclass precompose wcwidth
    CFLAGS := -O2 -D_GNU_SOURCE -DHAVE_CONFIG_H -DDEFCLASS='"XTerm"' -include $(X)/dolly-select.h -I$(X)
    all: /usr/libexec/xterm /usr/bin/xterm
    # As upstream's Makefile writes them: the parser's state numbers, and the
    # icon xterm sets.
    $(X)/VTparse.hin: $(X)/VTparse.def
    >awk 'BEGIN{printf "/* vile:cmode */\n";}/^CASE_/{printf "#define %s %d\n", $$1, n++}' < $< > $@
    $(X)/builtin_icons.h: $(X)/icons/mini.xterm_48x48.xpm
    >printf '%s\n' '#if OPT_BUILTIN_XPMS' '#include <icons/mini.xterm.xpms>' '#include <icons/filled-xterm.xpms>' \
       '#include <icons/xterm.xpms>' '#include <icons/xterm-color.xpms>' '#else' > $@
    >sed -e 's/static char \* /static const char * /' $< >> $@
    >printf '#endif\n' >> $@
    $(X)/%.o: $(X)/%.c $(X)/VTparse.hin $(X)/builtin_icons.h
    >cc $(CFLAGS) -c $< -o $@
    /usr/libexec/xterm: $(addprefix $(X)/,$(addsuffix .o,$(SOURCES)))
    >cc $^ -o $@ -lXaw7 -lXmu -lXpm -lXt -lSM -lICE -lXext -lX11 -lxcb -lXau -lterminfo -ldolly-sockets
    /usr/bin/xterm: $(X)/xterm-pty.c
    >cc -O2 $< -o $@ -ldolly-pty
