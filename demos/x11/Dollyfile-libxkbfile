DOLLY 8
PACKAGE libxkbfile
REQUIRES HOST runtime@0
REQUIRES HOST sockets@0

# libxkbfile, X.Org's library of XKB keymap files, from its release archive,
# built by its Meson project as a static library: xkbcomp and the X server
# link it. Its headers use Xlib's and the protocol's, which come with it.
FROM /demos/x11/Dollyfile-x11-build 36d336b3007df32264e38238c807ca96aa03d73016dca9ce6ac466b137815544
INSTALL /demos/x11/Dollyfile-x11-libs 8b046f1893f2800aebb2bcfb1177bb5d57d4a895abc0cf200c9a8ab2e1b47827
USE /demos/tools/Dollyfile-xz 1ee07b9f2944f5dc4599228939c64a0918ccac7f591bbcced5d13338b2671024
USE /demos/tools/Dollyfile-meson e388b70e271dd313d88f9ef1de369f9dde67e1598f77f56bb15fb89eaebb447f
USE /demos/tools/Dollyfile-pkgconf 7aa2fb7ca6d1e11fc4a062fa683ca4a6980bcc85f06fbedee1d11b3fe99f9011
REQUIRES TOOL meson
REQUIRES TOOL xz
REQUIRES TOOL tar

SOURCE /dist/static/x11/libxkbfile-1.2.0.tar.xz 7f71884e5faf56fb0e823f3848599cf9b5a9afce51c90982baeb64f635233ebf /tmp/libxkbfile.tar.xz
SLOP xz -dc /tmp/libxkbfile.tar.xz | tar -xf - -C /tmp
SLOP meson setup /tmp/build/xkbfile /tmp/libxkbfile-1.2.0 --prefix=/usr --libdir=lib \
  --buildtype=release -Ddefault_library=static
SLOP meson compile -C /tmp/build/xkbfile && meson install --no-rebuild -C /tmp/build/xkbfile
SLOP mkdir -p /usr/share/licenses/libxkbfile && cp /tmp/libxkbfile-1.2.0/COPYING /usr/share/licenses/libxkbfile/

EXPORTS LIB xkbfile /usr/lib/libxkbfile.a
FILE /usr/include/X11/extensions/XKBbells.h
FILE /usr/include/X11/extensions/XKBconfig.h
FILE /usr/include/X11/extensions/XKBfile.h
FILE /usr/include/X11/extensions/XKBrules.h
FILE /usr/include/X11/extensions/XKM.h
FILE /usr/include/X11/extensions/XKMformat.h
FILE /usr/lib/pkgconfig/xkbfile.pc
FILE /usr/share/licenses/libxkbfile/COPYING
