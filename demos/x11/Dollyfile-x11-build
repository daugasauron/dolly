# The X Window System's client libraries from X.Org's release archives,
# unchanged: the protocol headers, xtrans, libXau and libxcb (whose protocol
# code xcb-proto's Python generator writes), libX11 and the libraries of the
# Athena toolkit's stack. Static libraries in /usr/lib, as the packages and
# programs of this demo link them. Python serves xcb's generator.
FROM /v0.1.3/demos/tools/Dollyfile-tools-build 5da77d5197726f454cfb161eb1d73a4f7f62970355b03e603de8156fdd4cdf2e
INSTALL /v0.1.3/demos/python/Dollyfile-python e9343a3a8c0478a6065c800824fb46f3a06e2a3e34d72ff41a46d0a72cdacb7d
# sockets@0's client, which every X program here links (pkg-config names it).
INSTALL /v0.1.3/Dollyfile-libdolly-sockets fec5b03ca885948ccb061a7f49243a466cf79312ba9eafaa7cb0e60d8b23edc5

REQUIRES HEADER libc
REQUIRES TOOL ar
REQUIRES TOOL cc
REQUIRES TOOL cp
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL mkdir
REQUIRES TOOL python3
REQUIRES TOOL sed
REQUIRES TOOL tar

