DOLLY 8
PACKAGE x11-window
REQUIRES HOST runtime@0
REQUIRES HOST sockets@0

# A program's window on the X server, for a platform that draws on the page
# through display@0 and input@0: frames of pixels go in, and keys, the pointer,
# the wheel and focus come out as input@0's records, keys named as a browser
# names them. Godot and PhotoCraft draw their X windows through it. A static
# library over Xlib: a program links it with -lX11 -lxcb -lXau -ldolly-sockets,
# which come with it, as do the input header its own includes.
FROM /demos/x11/Dollyfile-x11-build 5f9800a3ec63dcebba6a101cdde90d69ef548c8fc6ce1e4baac360c62625761a
INSTALL /demos/x11/Dollyfile-x11-libs dbb8298daa3bc672a4a4d5c097a982d606b82f46fc8da5c721f01cc07b7b934f
USE /Dollyfile-libdolly-display afbf05e4d39eda376f6195f86762fb635a3effb3f2e5414ef1ffa70b298af919
INSTALL /Dollyfile-libdolly-input b49e7c2e3af3ce6f77b321bf959634101ec8fa2fb62fa071e4acad8ecd3d42b3
REQUIRES HEADER libc
REQUIRES TOOL ar
REQUIRES TOOL cc
REQUIRES TOOL rm

SOURCE /dist/static/x11/x11-window.h 02304c404eb2d265c6c09fd5e75fd10ae145bdf2ad20d38f4f932bd31f5b5158 /usr/include/x11-window.h
SOURCE /dist/static/x11/x11-window.c cfff68e730a5cb022de1ba35fa6f4a2ab67c4eb342aa0d39757d52d79bbd1705 /tmp/x11-window/x11-window.c
SLOP cc -O2 -c /tmp/x11-window/x11-window.c -o /tmp/x11-window/x11-window.o
SLOP ar rcs /usr/lib/libx11-window.a /tmp/x11-window/x11-window.o
SLOP rm -rf /tmp/x11-window

EXPORTS HEADER x11-window /usr/include/x11-window.h
EXPORTS LIB x11-window /usr/lib/libx11-window.a
