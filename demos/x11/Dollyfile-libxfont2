DOLLY 8
PACKAGE libxfont2
REQUIRES HOST runtime@0
REQUIRES HOST sockets@0

# libXfont2, the font library of X servers, from X.Org's release archive,
# unchanged, for servers the cc package builds (the xorg-server package): its
# built-in "fixed" and "cursor" fonts and PCF, BDF and SNF files, gzipped or
# not. Slop cannot run its configure script: its sources are compiled with
# configure's answers here, and with the server's own 64-bit protocol types
# (_XSERVER64: XID, Mask and Atom are CARD32), since WebAssembly checks a
# call's signature. Not built: FreeType (and so libfontenc) and the font
# server client, which needs TCP. Its headers include X.Org's protocol headers,
# which come with it in the x11-libs package.
FROM /demos/cmake/Dollyfile-cmake-build 2baf4bb61a256fbae4111b9adb7fc6438ee52f52d4c6dfb4e325c8245edaf0e7
INSTALL /demos/x11/Dollyfile-x11-libs 35717a8ff71126fc72d47fd6e4aa806e834865ad25f185db21013d98176ac100
INSTALL /Dollyfile-zlib acf8f8daaba24468b5b521bbb4d4ba3e034fe28d7a2d92fc680d2e39a1cea971
REQUIRES HEADER libc
REQUIRES HEADER zlib
REQUIRES TOOL ar
REQUIRES TOOL cc
REQUIRES TOOL cp
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL mkdir
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/x11/libXfont2-2.0.9.tar.gz 8564b4df365bc5a6cb0c15900dc688f6e8f47b00a8571c6708c916dfb85066ba /tmp/libXfont2.tar.gz
SLOP CWD /tmp gzip -dc libXfont2.tar.gz | tar -xf -
FILE /tmp/libXfont2-2.0.9/libxfont2.mk
    XFONT := /tmp/libXfont2-2.0.9
    SOURCES := $(wildcard $(addprefix $(XFONT)/src/,stubs/*.c util/*.c fontfile/*.c bitmap/*.c builtins/*.c))
    SOURCES := $(filter-out $(addprefix %/,reallocarray.c realpath.c strlcat.c strlcpy.c bunzip2.c),$(SOURCES))
    FLAGS := -D_XSERVER64 -D_GNU_SOURCE -DHAVE_POLL -DHAVE_POLL_H -DHAVE_READLINK -DHAVE_STRLCAT \
      -DHAVE_REALLOCARRAY -DHAVE_REALPATH -DHAVE_STRLCPY -DHAVE_ENDIAN_H -DHAVE_ERR_H -DHAVE_FLOAT_H \
      -DX_GZIP_FONT_COMPRESSION -DXFONT_BUILTINS -DXFONT_PCFFORMAT -DXFONT_BDFFORMAT \
      -DXFONT_SNFFORMAT -DXFONT_BITMAP -DXFONT_FONTFILE -DNO_LOCALE -DXTHREADS -DXUSE_MTSAFE_API
    /usr/lib/libXfont2.a: $(patsubst %.c,%.o,$(SOURCES))
    	ar rcs $@ $^
    %.o: %.c
    	cc -O2 $(FLAGS) -I$(XFONT) -I$(XFONT)/include -c $< -o $@
SLOP make -j4 -f /tmp/libXfont2-2.0.9/libxfont2.mk
SLOP mkdir -p /usr/include/X11/fonts /usr/share/licenses/libxfont2
SLOP cp /tmp/libXfont2-2.0.9/include/X11/fonts/libxfont2.h /usr/include/X11/fonts/libxfont2.h
SLOP cp /tmp/libXfont2-2.0.9/COPYING /usr/share/licenses/libxfont2/COPYING

EXPORTS LIB    Xfont2    /usr/lib/libXfont2.a
EXPORTS HEADER libxfont2 /usr/include/X11/fonts/libxfont2.h
FILE /usr/lib/pkgconfig/xfont2.pc
    prefix=/usr
    Name: Xfont2
    Description: X font Library version 2
    Version: 2.0.9
    Requires: xproto fontsproto
    Libs: -L/usr/lib -lXfont2 -lz -lm
    Cflags: -I/usr/include
FILE /usr/share/licenses/libxfont2/COPYING
SLOP rm -rf /tmp/libXfont2-2.0.9 /tmp/libXfont2.tar.gz
