DOLLY 7
PACKAGE pixman
REQUIRES HOST runtime@0

# pixman, the pixel library of X.Org's server (and of cairo), from its release
# archive, built by its Meson project as a static library: without the SIMD of
# other machines; Dolly runs no OpenMP. The build compiles, then installs what
# it compiled (--no-rebuild: Meson's install step would run the build again).
FROM /v0.1.4/demos/x11/Dollyfile-x11-build 9d8ad6533494bb4668fb083a66b4e9ba5d84eca0bd3023f03f35ce77109bb66a
# The tar package reads the pax headers of X.Org's archives.
USE /v0.1.4/demos/tools/Dollyfile-tar 52338324df74cd7820e5ba3b7554a854f155b52df6094b07904594e97b9ef99e
USE /v0.1.4/demos/tools/Dollyfile-meson a02c73f54873b5222bdee4b261a1956b120a3e42cada5afcaa80dcd23e616022
USE /v0.1.4/demos/zero-ad/Dollyfile-pkgconf 82c7b029c11f430ad2a737aff89724924b75e646a2b531747640903400384de6
REQUIRES TOOL meson
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL sed
REQUIRES TOOL mv

SOURCE /v0.1.4/dist/static/x11/pixman-0.46.4.tar.gz d09c44ebc3bd5bee7021c79f922fe8fb2fb57f7320f55e97ff9914d2346a591c /tmp/pixman.tar.gz
SLOP gzip -dc /tmp/pixman.tar.gz | tar -xf - -C /tmp
SLOP meson setup /tmp/build/pixman /tmp/pixman-0.46.4 --prefix=/usr --libdir=lib \
  --buildtype=release -Ddefault_library=static -Dloongson-mmi=disabled -Dmmx=disabled \
  -Dsse2=disabled -Dssse3=disabled -Dvmx=disabled -Darm-simd=disabled -Dneon=disabled \
  -Da64-neon=disabled -Dmips-dspr2=disabled -Drvv=disabled -Dgnu-inline-asm=disabled \
  -Dopenmp=disabled -Dtimers=false -Dgtk=disabled -Dlibpng=disabled -Dtests=disabled -Ddemos=disabled
SLOP meson compile -C /tmp/build/pixman && meson install --no-rebuild -C /tmp/build/pixman
# Meson's threads dependency puts -pthread in pixman's pkg-config file, which
# would make each program that links it a threaded one; pixman needs no thread here.
SLOP sed 's/ -pthread//g' /usr/lib/pkgconfig/pixman-1.pc > /tmp/pixman-1.pc && mv /tmp/pixman-1.pc /usr/lib/pkgconfig/pixman-1.pc
SLOP mkdir -p /usr/share/licenses/pixman && cp /tmp/pixman-0.46.4/COPYING /usr/share/licenses/pixman/

EXPORTS LIB    pixman-1        /usr/lib/libpixman-1.a
EXPORTS FOLDER pixman-headers  /usr/include/pixman-1
FILE /usr/lib/pkgconfig/pixman-1.pc
FILE /usr/share/licenses/pixman/COPYING
