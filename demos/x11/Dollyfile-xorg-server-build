# The X server from X.Org's release archive: Xsdl, kdrive in an SDL window
# (xsdl/), drawn by the sdl2 package into Dolly's display. Upstream's Meson
# builds it and pixman, libxkbfile and xkbcomp; libXfont2, its built-in and
# bitmap fonts, and the SHA-1 of libmd are built by the Makefile below, and
# xkeyboard-config's rules by its own generator.
FROM /v0.1.3/demos/x11/Dollyfile-x11-build 98ae9243fde462a5357fd9d8099fe40b9e89c0d01b21f4586b47e717d794c748
INSTALL /v0.1.3/demos/tools/Dollyfile-meson d2428f8a9c299be18a202ae58889445bae4d598fbf55afad7d0c6335c364cc57
INSTALL /v0.1.3/demos/zero-ad/Dollyfile-pkgconf 4c35d98b699d2e53026dc5ef77fefc724abd1011c5dfb5e2476fe4daaa3356f9
INSTALL /v0.1.3/demos/sdl2/Dollyfile-sdl2 f2463bb7f0f94c0bf8b28872617c01b96cb89f24415aa8cb734508ae5e52a8ef
