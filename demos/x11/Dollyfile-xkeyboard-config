DOLLY 7
PACKAGE xkeyboard-config
REQUIRES HOST runtime@0

# xkeyboard-config's keyboard descriptions, which xkbcomp reads for the X
# server, and the evdev rules its Meson build writes with this generator (the
# .lst files it adds need Perl).
FROM /v0.1.4/demos/x11/Dollyfile-x11-build 8f46cd2117ede0b45677cffd873ccd2c322c8953068aa4a0235b1e507b65ca9c
# The tar package reads the pax headers of X.Org's archives.
USE /v0.1.4/demos/tools/Dollyfile-tar 85c13c99371b7c8f3dc71070195fda6730727ed00d1817b3e03f6e88333fc835
USE /v0.1.4/demos/tools/Dollyfile-xz fc0e3a64d550ebcbb5daf766660e0273621297736656aa98dc127ca29f541ff5
REQUIRES TOOL python3
REQUIRES TOOL xz
REQUIRES TOOL tar

SOURCE /v0.1.4/dist/static/x11/xkeyboard-config-2.48.tar.xz b77041324f0109f77161ee43743fe04baa485866af8460d31e476ad3f7648fd5 /tmp/xkeyboard-config.tar.xz
SLOP xz -dc /tmp/xkeyboard-config.tar.xz | tar -xf - -C /tmp
SLOP mkdir -p /usr/share/X11/xkb/rules
SLOP CWD /tmp/xkeyboard-config-2.48 cp -r compat geometry keycodes symbols types /usr/share/X11/xkb/
SLOP CWD /tmp/xkeyboard-config-2.48 PYTHONPATH=. python3 -m rules.generator rules \
  --ruleset evdev --version v2 --output /usr/share/X11/xkb/rules/evdev rules/rules.in
SLOP cp /tmp/xkeyboard-config-2.48/rules/base.xml /usr/share/X11/xkb/rules/evdev.xml
SLOP mkdir -p /usr/share/licenses/xkeyboard-config && cp /tmp/xkeyboard-config-2.48/COPYING /usr/share/licenses/xkeyboard-config/

FOLDER /usr/share/X11/xkb
FILE /usr/share/licenses/xkeyboard-config/COPYING
