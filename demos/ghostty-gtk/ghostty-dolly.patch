+/// actions. A program whose streams are a pseudo-terminal's slave has it as
+/// its terminal, so the pre-exec callbacks, which make it one after fork,
+/// have nothing to do.
+fn startSpawn(self: *Command, arena: Allocator) !void {
+    const argsZ = try arena.allocSentinel(?[*:0]const u8, self.args.len, null);
+    for (self.args, 0..) |arg, i| argsZ[i] = arg.ptr;
+    const envp: spawn.Argv = if (self.env) |env_map|
+        @ptrCast((try createNullDelimitedEnvMap(arena, env_map)).ptr)
+    else
+        @ptrCast(std.c.environ);
