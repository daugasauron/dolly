+        spawn.posix_spawnattr_setsigmask(&attributes, &none) != 0) return error.SystemResources;
+
+    var pid: posix.pid_t = undefined;
+    switch (@as(posix.E, @enumFromInt(spawn.posix_spawnp(&pid, self.path, &actions, &attributes, argsZ.ptr, envp)))) {
+        .SUCCESS => {},
+        .NOENT => return error.FileNotFound,
+        else => |err| return posix.unexpectedErrno(err),
+    }
+    self.pid = pid;
+    if (self.rt_post_fork) |f| try f(self);
