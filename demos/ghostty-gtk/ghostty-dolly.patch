+/// musl's posix_spawn, for Emscripten's libc (Dolly's), which has no fork.
+const spawn = struct {
+    const FileActions = extern struct { pad0: [2]c_int, actions: ?*anyopaque, pad: [16]c_int };
+    const Argv = [*:null]const ?[*:0]const u8;
+    extern "c" fn posix_spawn_file_actions_init(actions: *FileActions) c_int;
+    extern "c" fn posix_spawn_file_actions_destroy(actions: *FileActions) c_int;
+    extern "c" fn posix_spawn_file_actions_adddup2(actions: *FileActions, source: posix.fd_t, target: posix.fd_t) c_int;
+    extern "c" fn posix_spawn_file_actions_addchdir_np(actions: *FileActions, path: [*:0]const u8) c_int;
+    extern "c" fn posix_spawnp(pid: *posix.pid_t, file: [*:0]const u8, actions: *const FileActions, attributes: ?*const anyopaque, argv: Argv, envp: Argv) c_int;
+};
+
+/// Starts the command by posix_spawn: its streams and directory are file
+/// actions. A program whose streams are a pseudo-terminal's slave has it as
+/// its terminal, so the pre-exec callbacks, which make it one after fork,
+/// have nothing to do.
+fn startSpawn(self: *Command, arena: Allocator) !void {
+    const argsZ = try arena.allocSentinel(?[*:0]const u8, self.args.len, null);
+    for (self.args, 0..) |arg, i| argsZ[i] = arg.ptr;
+    const envp: spawn.Argv = if (self.env) |env_map|
+        @ptrCast((try createNullDelimitedEnvMap(arena, env_map)).ptr)
+    else
+        @ptrCast(std.c.environ);
+
+    var actions: spawn.FileActions = undefined;
+    if (spawn.posix_spawn_file_actions_init(&actions) != 0) return error.SystemResources;
+    defer _ = spawn.posix_spawn_file_actions_destroy(&actions);
+    for ([_]?File{ self.stdin, self.stdout, self.stderr }, 0..) |file, target| if (file) |f| {
+        if (spawn.posix_spawn_file_actions_adddup2(&actions, f.handle, @intCast(target)) != 0)
+            return error.SystemResources;
+    };
+    if (self.cwd) |cwd| if (spawn.posix_spawn_file_actions_addchdir_np(&actions, cwd) != 0)
+        return error.SystemResources;
+
+    var pid: posix.pid_t = undefined;
+    switch (@as(posix.E, @enumFromInt(spawn.posix_spawnp(&pid, self.path, &actions, null, argsZ.ptr, envp)))) {
+        .SUCCESS => {},
+        .NOENT => return error.FileNotFound,
+        else => |err| return posix.unexpectedErrno(err),
+    }
+    self.pid = pid;
+    if (self.rt_post_fork) |f| try f(self);
+}
