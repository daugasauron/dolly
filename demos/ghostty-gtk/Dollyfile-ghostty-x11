# Ghostty's GTK window on Dolly's X server, with Slop in it: the Xsdl server
# takes the display, and Ghostty draws its terminal with Mesa's OpenGL
# (softpipe through EGL, OpenGL 4.3 as Ghostty asks) and its window's
# widgets with cairo. GTK's text is fontconfig's, from the terminal's font.
INSTALL /v0.1.5/Dollyfile-core 2f8f0daacf0fc5f8ce3d5a6bfcbe6576e434db8146b7ba01f0e4928336f80cf6
INSTALL /v0.1.5/Dollyfile-posix 92f9c9b8f9d3298d60446c8351d7b6ce7717f41145a36ee238418bf16f0f6cd9
INSTALL /v0.1.5/Dollyfile-display c6a0bde3cbb5e1f8888cc3d35312cfed170977d1a315d23811c075ebd23ff008
INSTALL /v0.1.5/demos/x11/Dollyfile-xorg-server b0f0995f2d0ad9af708bc4aacfd500f8d5f829aac845d2338dc9865f2f178b3c
INSTALL /v0.1.5/demos/ghostty-gtk/Dollyfile-ghostty-gtk cab4029a530c3fa0c8bfe4db42eecbcc6bc0a7ab1aaaea3d04740874d5052e0a
# amy installs packages into the session (tmux, nvim and the rest); nena
# enables the host modules they need.
INSTALL /v0.1.5/Dollyfile-amy 5dbdc3779aa7ee926ffec16f0ec1058a4506bed05e793aa49a7bb4f91928ab2a
INSTALL /v0.1.5/Dollyfile-nena 80cf7d4a16d51b5394bac9ab6253fb63c3c42bbfcdebbefc225c2d2057ad28b8
COPY /v0.1.5/Dollyfile-ghostty-build 59aa3f5058ccd63728ab92cbba935674b71d9dadf275945e5ca62730399f3719 /usr/share/fonts/IosevkaTerm-SemiBold.ttf /usr/share/fonts/IosevkaTerm-SemiBold.ttf
FILE /etc/fonts/fonts.conf
    <?xml version="1.0"?>
    <!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
    <fontconfig>
      <dir>/usr/share/fonts</dir>
      <cachedir>/tmp/fontconfig</cachedir>
    </fontconfig>

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in Ghostty's shell); Ghostty ends with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1024x700 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 600; do sleep 0.1; tries=$((tries + 1)); done
    GSK_RENDERER=cairo MESA_GL_VERSION_OVERRIDE=4.3 MESA_GLSL_VERSION_OVERRIDE=430 ghostty --command=direct:/bin/slop --shell-integration=none --gtk-single-instance=false --term=xterm-256color &
    wait $server
    printf 'The X server has ended.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
