# Ghostty's GTK window on Dolly's X server, with Slop in it: the Xsdl server
# takes the display, and Ghostty draws its terminal with Mesa's OpenGL
# (softpipe, GLX over Xlib, OpenGL 4.3 as Ghostty asks) and its window's
# widgets with cairo. GTK's text is fontconfig's, from the terminal's font.
FROM /v0.1.4/Dollyfile-system 0060f55ddcc2f72c5b6a4ab175d77ce84987fe4e46ddd8f5315a01f764a43f17
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server e72f5b421290df27ef4b7dd07cd5bad5fe5863f5065276c640e6718588fd94d6
INSTALL /v0.1.4/demos/ghostty-gtk/Dollyfile-ghostty-gtk d3f82713538dd2c8a17e1c49548e80305c7585c5a8a55898d907c21aac7fba51
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy 0ced10d792e5f3939615046884d47b1c1e215e3a67c8c344b5b2fa78363dcb4a
INSTALL /v0.1.4/Dollyfile-nena a51217ba5e3cf34b584e5f56be834df086fb88f1080b2459b3b601314873dd59
COPY /v0.1.4/Dollyfile-ghostty-build 8a99603f55d22dbcf3c3a96c4727e8039875af0b1991757e98530adf1c3331af /usr/share/fonts/IosevkaTerm-SemiBold.ttf /usr/share/fonts/IosevkaTerm-SemiBold.ttf
FILE /etc/fonts/fonts.conf
    <?xml version="1.0"?>
    <!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
    <fontconfig>
      <dir>/usr/share/fonts</dir>
      <cachedir>/tmp/fontconfig</cachedir>
    </fontconfig>

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in Ghostty's shell); Ghostty ends with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1024x700 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    GDK_DEBUG=gl-glx GSK_RENDERER=cairo MESA_GL_VERSION_OVERRIDE=4.3 MESA_GLSL_VERSION_OVERRIDE=430 ghostty --command=direct:/bin/slop --shell-integration=none --gtk-single-instance=false --term=xterm-256color &
    wait $server
    printf 'The X server has ended.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
