# Ghostty's GTK window on Dolly's X server, with Slop in it: the Xsdl server
# takes the display, and Ghostty draws its terminal with Mesa's OpenGL
# (softpipe through EGL, OpenGL 4.3 as Ghostty asks) and its window's
# widgets with cairo. GTK's text is fontconfig's, from the terminal's font.
FROM /v0.1.4/Dollyfile-system c70f3b842963a6101ae2699d788d6a747556ccc478af760696bf50c27043f342
INSTALL /v0.1.4/demos/x11/Dollyfile-xorg-server 98858a19b9e90e10673506839b002442c62a16fe0f8641a8dded28bb157c8077
INSTALL /v0.1.4/demos/ghostty-gtk/Dollyfile-ghostty-gtk a633916473c65954c0dd01279770146ab5f1b89a9385e1bea476f72773f5bb45
# amy installs packages into the session (tmux, nvim and the rest), with the
# modules default declares for them; nena enables another.
INSTALL /v0.1.4/Dollyfile-amy c7ced1889354892556ec390f9472f7573f403c17859c18bb4ab5a6ceca35301b
INSTALL /v0.1.4/Dollyfile-nena 570376e58d071b68891540aec80e0dd7c0dd94bcb04039d2922b704073106522
COPY /v0.1.4/Dollyfile-ghostty-build f656fdeb53d233600e21b44ddbac200f3ebb292174a8933b49a0e00413f62258 /usr/share/fonts/IosevkaTerm-SemiBold.ttf /usr/share/fonts/IosevkaTerm-SemiBold.ttf
FILE /etc/fonts/fonts.conf
    <?xml version="1.0"?>
    <!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
    <fontconfig>
      <dir>/usr/share/fonts</dir>
      <cachedir>/tmp/fontconfig</cachedir>
    </fontconfig>

# The server takes the display, the keyboard and the pointer until it ends
# (kill $(cat /tmp/.X0-pid) in Ghostty's shell); Ghostty ends with it, and
# this shell's terminal is back.
FILE /etc/dolly/init.slop
    export DISPLAY=:0
    Xsdl :0 -screen 1024x700 -nolock -dumbSched -s 0 &
    server=$!
    echo $server > /tmp/.X0-pid
    tries=0
    until test -e /tmp/.X11-unix/X0 || test $tries = 3000; do tries=$((tries + 1)); done
    GSK_RENDERER=cairo MESA_GL_VERSION_OVERRIDE=4.3 MESA_GLSL_VERSION_OVERRIDE=430 ghostty --command=direct:/bin/slop --shell-integration=none --gtk-single-instance=false --term=xterm-256color &
    wait $server
    printf 'The X server has ended.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
