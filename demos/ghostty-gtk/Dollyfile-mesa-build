# A program draws with softpipe through EGL without a display, as Ghostty's
# renderer does: a renderbuffer cleared and read back. Mesa is partly C++: a
# program is linked with it by c++, as Ghostty is.
FILE /tmp/mesa/egl-check.c
    #define GL_GLEXT_PROTOTYPES
    #include <EGL/egl.h>
    #include <EGL/eglext.h>
    #include <GL/gl.h>
    #include <GL/glext.h>
    #include <string.h>
    #define GL(name) __typeof__(&name) name##_ = (__typeof__(&name))eglGetProcAddress(#name)
    int main(void) {
      EGLDisplay display = eglGetPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, NULL);
      const EGLint attributes[] = {EGL_SURFACE_TYPE, 0, EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT, EGL_NONE};
      EGLConfig config;
      EGLint configs;
      if (!eglInitialize(display, NULL, NULL) || !eglChooseConfig(display, attributes, &config, 1, &configs) ||
          configs != 1 || !eglBindAPI(EGL_OPENGL_API)) return 1;
      EGLContext context = eglCreateContext(display, config, EGL_NO_CONTEXT, NULL);
      if (!eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context)) return 2;
      GL(glGetString);
      GL(glGenFramebuffers);
      GL(glBindFramebuffer);
      GL(glGenRenderbuffers);
      GL(glBindRenderbuffer);
      GL(glRenderbufferStorage);
      GL(glFramebufferRenderbuffer);
      GL(glClearColor);
      GL(glClear);
      GL(glReadPixels);
      if (!strstr((const char *)glGetString_(GL_RENDERER), "softpipe")) return 3;
      GLuint framebuffer, renderbuffer;
      glGenFramebuffers_(1, &framebuffer);
      glBindFramebuffer_(GL_FRAMEBUFFER, framebuffer);
      glGenRenderbuffers_(1, &renderbuffer);
      glBindRenderbuffer_(GL_RENDERBUFFER, renderbuffer);
      glRenderbufferStorage_(GL_RENDERBUFFER, GL_RGBA8, 4, 4);
      glFramebufferRenderbuffer_(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, renderbuffer);
      glClearColor_(1, 0.5f, 0, 1);
      glClear_(GL_COLOR_BUFFER_BIT);
      unsigned char pixel[4];
      glReadPixels_(1, 1, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixel);
      return pixel[0] == 255 && pixel[1] >= 127 && pixel[1] <= 128 && pixel[2] == 0 ? 0 : 4;
    }
SLOP cc -O1 -pthread -c /tmp/mesa/egl-check.c -o /tmp/mesa/egl-check.o && \
  c++ -pthread /tmp/mesa/egl-check.o -o /tmp/mesa/egl-check -lEGL -lgallium_dri -lz -lm && \
  /tmp/mesa/egl-check

SLOP mkdir -p /usr/share/licenses/mesa
SLOP cp /tmp/mesa/mesa/docs/license.rst /usr/share/licenses/mesa/license.rst
FOLDER /usr/lib/pkgconfig
FOLDER /usr/include
FOLDER /usr/lib
FOLDER /usr/share/licenses
