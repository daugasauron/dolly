+pub const OperationType = enum {
+    noop,
+    cancel,
+    accept,
+    connect,
+    poll,
+    read,
+    pread,
+    write,
+    pwrite,
+    send,
+    recv,
+    close,
+    shutdown,
+    timer,
+};
