+            .send => |*op| .{
+                .send = switch (op.buffer) {
+                    .slice => |v| xev_posix.send(op.fd, v, 0),
+                    .array => |*v| xev_posix.send(op.fd, v.array[0..v.len], 0),
+                },
+            },
