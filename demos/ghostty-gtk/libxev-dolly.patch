+            .accept => |v| v.socket,
+            .connect => |v| v.socket,
+            .poll => |v| v.fd,
+            .read => |v| v.fd,
+            .pread => |v| v.fd,
+            .recv => |v| v.fd,
+            .write => |v| v.fd,
+            .pwrite => |v| v.fd,
+            .send => |v| v.fd,
