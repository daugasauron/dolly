+        /// Notify the loop. A full pipe already wakes it.
+        pub fn notify(self: Self) !void {
+            _ = xev_posix.write(self.write_fd, &.{1}) catch |err| switch (err) {
+                error.WouldBlock => return,
+                else => return err,
+            };
+        }
