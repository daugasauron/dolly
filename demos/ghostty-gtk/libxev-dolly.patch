+/// Async implementation using a pipe, for the poll backend: notify writes
+/// a byte, which makes the read end readable, and the wait drains it.
+fn AsyncPipe(comptime xev: type) type {
+    return struct {
+        const Self = @This();
+
+        /// The error that can come in the wait callback.
+        pub const WaitError = xev.ReadError;
+
+        /// The read end, which the wait reads.
+        fd: posix.fd_t,
+
+        /// The write end, to which notify writes.
+        write_fd: posix.fd_t,
+
+        pub fn init() !Self {
+            const fds = try xev_posix.pipe2(.{ .CLOEXEC = true, .NONBLOCK = true });
+            return .{ .fd = fds[0], .write_fd = fds[1] };
+        }
+
+        pub fn deinit(self: *Self) void {
+            xev_posix.close(self.fd);
+            xev_posix.close(self.write_fd);
+        }
+
+        /// Wait for a notification, as AsyncEventFd's.
+        pub fn wait(
+            self: Self,
+            loop: *xev.Loop,
+            c: *xev.Completion,
+            comptime Userdata: type,
+            userdata: ?*Userdata,
+            comptime cb: *const fn (
+                ud: ?*Userdata,
+                l: *xev.Loop,
+                c: *xev.Completion,
+                r: WaitError!void,
+            ) xev.CallbackAction,
+        ) void {
+            c.* = .{
+                .op = .{
+                    .read = .{
+                        .fd = self.fd,
+                        .buffer = .{ .array = undefined },
+                    },
+                },
+
+                .userdata = userdata,
+                .callback = (struct {
+                    fn callback(
+                        ud: ?*anyopaque,
+                        l_inner: *xev.Loop,
+                        c_inner: *xev.Completion,
+                        r: xev.Result,
+                    ) xev.CallbackAction {
+                        // The notifications coalesced into this one.
+                        if (r.read) |n| {
+                            var buf: [64]u8 = undefined;
+                            var full = n == c_inner.op.read.buffer.array.len;
+                            while (full) full = (xev_posix.read(c_inner.op.read.fd, &buf) catch 0) == buf.len;
+                        } else |_| {}
+
+                        return @call(.always_inline, cb, .{
+                            common.userdataValue(Userdata, ud),
+                            l_inner,
+                            c_inner,
+                            if (r.read) |_| {} else |err| err,
+                        });
+                    }
+                }).callback,
