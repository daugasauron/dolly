# Ghostty's GTK application at the pinned commit, built by Zig in Dolly over
# mesa-build: libadwaita, blueprint-compiler for its interface files, and
# Ghostty's own build.zig
# (ghostty-dolly.patch; its packages fetched on the host, prepare-ghostty.sh).
FROM /v0.1.3/demos/ghostty-gtk/Dollyfile-mesa-build c8594b7e1f09030174337480342dfa5fb8cc69ac6cf593714a0199cc90135f53
USE /v0.1.3/demos/zig/Dollyfile-zig-llvm dafca7abda7d731c2d477980cc98d1720ee7132abea786e9b2e5c70c779d8114

REQUIRES TOOL   c++
REQUIRES TOOL   cc
REQUIRES TOOL   cp
