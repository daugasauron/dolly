DOLLY 7
PACKAGE ghostty-gtk
REQUIRES HOST runtime@0
REQUIRES HOST dso@0
REQUIRES HOST pty@0
REQUIRES HOST sockets@0
REQUIRES HOST threads@0

# Ghostty's GTK application from its release tarball, which carries its
# compiled interface files, built by Zig in Dolly over mesa-build: libadwaita
# and Ghostty's own build.zig
# (ghostty-dolly.patch; its packages fetched on the host, prepare-ghostty.sh).
FROM /v0.1.4/demos/ghostty-gtk/Dollyfile-mesa-build c81eaee590cffa3159d0791c73903a95e72863842c7b15fe0068be4e998cd76e
USE /v0.1.4/demos/zig/Dollyfile-zig-llvm 3d30406e53386ddca6528562a39b8a1946784d6333e837eb4c3474eb66c4756e

REQUIRES TOOL   c++
REQUIRES TOOL   cc
REQUIRES TOOL   cp
REQUIRES TOOL   gzip
REQUIRES TOOL   ln
REQUIRES TOOL   meson
REQUIRES TOOL   mkdir
REQUIRES TOOL   patch
REQUIRES TOOL   python3
REQUIRES TOOL   tar
REQUIRES TOOL   xz
REQUIRES TOOL   zig

# libadwaita, static. It carries its own copies of five of GTK's builder
# helpers under GTK's names, which a static link of both would hold twice:
# its build names its copies its own.
SOURCE /v0.1.4/dist/static/ghostty-gtk/libadwaita-1.10.0.tar.xz b1bf56239269d101a6391ad4553c910eff9cc6170b803916405477ef60a66c84 /tmp/ghostty-gtk/libadwaita.tar.xz
SLOP CWD /tmp/ghostty-gtk xz -dc libadwaita.tar.xz | tar -xf -
SLOP CWD /tmp/ghostty-gtk meson setup build-adw libadwaita-1.10.0 --wrap-mode=nodownload --prefix=/usr --libdir=lib \
  --buildtype=release -Ddefault_library=static -Dintrospection=disabled -Dvapi=false -Dtests=false \
  -Dexamples=false -Ddocumentation=false "-Dc_args=-D_gtk_builder_check_parent=adw_gtk_builder_check_parent -D_gtk_builder_prefix_error=adw_gtk_builder_prefix_error -D_gtk_builder_error_unhandled_tag=adw_gtk_builder_error_unhandled_tag -D_gtk_builder_parser_translate=adw_gtk_builder_parser_translate -Dgtk_buildable_child_deprecation_warning=adwgtk_buildable_child_deprecation_warning"
SLOP meson compile -C /tmp/ghostty-gtk/build-adw && meson install --no-rebuild -C /tmp/ghostty-gtk/build-adw

# Zig hands a link to cc without the program's own flags, and asks cc for
# libc's headers with -Wp,-v, which Dolly's cc answers to -v. This cc passes
# all of it to Dolly's and gives Ghostty's link the rest: Binaryen's cast
# emulation (GObject calls through pointers of other types), the X libraries,
# Mesa's driver, which its EGL links, and libadwaita's resources, registered
# by constructors that wasm-ld keeps only for objects something keeps (an
# export does).
FILE /tmp/ghostty-cc/cc.c
    #include <spawn.h>
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <sys/wait.h>
    extern char **environ;
    static const char *const ghostty[] = {"--dolly-cast-emulation", "-Wl,--initial-memory=268435456",
      "-Wl,--export=adw_get_resource", "-Wl,--export=adw_stylesheet_get_resource", "-L/usr/lib",
      "-lgallium_dri", "-lXext", "-lX11", "-lxcb", "-lXau", "-lz", "-ldolly-sockets", "-lm"};
    int main(int argc, char **argv) {
      int link = 1, program = 0;
      for (int i = 1; i < argc; i++) {
        if (!strcmp(argv[i], "-c") || !strcmp(argv[i], "-E") || !strcmp(argv[i], "-S")) link = 0;
        if (!strcmp(argv[i], "-o") && i + 1 < argc) {
          const char *slash = strrchr(argv[i + 1], '/');
          program = !strcmp(slash ? slash + 1 : argv[i + 1], "ghostty.wasm");
        }
      }
      char **args = calloc((size_t)argc + sizeof(ghostty) / sizeof(*ghostty) + 1, sizeof(char *));
      size_t n = 0;
      args[n++] = link && program ? "/bin/c++" : "/bin/cc";
      for (int i = 1; i < argc; i++) args[n++] = strcmp(argv[i], "-Wp,-v") ? argv[i] : "-v";
      if (link && program) for (size_t i = 0; i < sizeof(ghostty) / sizeof(*ghostty); i++) args[n++] = (char *)ghostty[i];
      pid_t pid;
      int status;
      if (posix_spawn(&pid, args[0], NULL, NULL, args, environ) != 0) return perror(args[0]), 127;
      if (waitpid(pid, &status, 0) != pid) return 127;
      return WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
    }
SLOP cc -O1 /tmp/ghostty-cc/cc.c -o /tmp/ghostty-cc/cc
# Ghostty's build finds libdolly-sockets and libdolly-pty under a prefix's lib.
SLOP mkdir -p /tmp/ghostty-prefix && ln -s /usr/lib/dolly/process /tmp/ghostty-prefix/lib

SOURCE /v0.1.4/dist/static/ghostty-gtk/ghostty.tar.gz 6c5d144628a8bc6b7800e3b264628ea357877cff42c60f6845936b5a327c335a /tmp/ghostty.tar.gz
SLOP gzip -dc /tmp/ghostty.tar.gz | tar -xf - -C /
# Ghostty's threads share the program's memory, so its code needs wasm's
# atomics, which Zig's baseline for Emscripten lacks: the CPU Dolly's cc
# compiles for, with the simd128 Ghostty adds when no CPU is named.
SLOP CWD /tmp/ghostty PATH=/tmp/ghostty-cc:$PATH ZIG_LIBC=/usr/lib/zig/libc.txt zig build -Dapp-runtime=gtk -Doptimize=ReleaseFast -Dcpu=generic+atomics+simd128 \
  -Dgtk-wayland=false -Dsentry=false -Di18n=false -Demit-docs=false -Demit-terminfo=false -Demit-termcap=false \
  -Dversion-string=1.4.0 -fsys=freetype -fsys=harfbuzz -fsys=fontconfig -fsys=libpng -fsys=zlib \
  --search-prefix /tmp/ghostty-prefix --summary none
SLOP cp /tmp/ghostty/zig-out/bin/ghostty.wasm /usr/bin/ghostty
SLOP ghostty +version | grep -q 'Ghostty 1.4.0'

SLOP mkdir -p /usr/share/licenses/ghostty-gtk
SLOP cp /tmp/ghostty/LICENSE /usr/share/licenses/ghostty-gtk/ghostty-LICENSE
SLOP cp /tmp/ghostty-gtk/libadwaita-1.10.0/COPYING /usr/share/licenses/ghostty-gtk/libadwaita-COPYING
SLOP cp /usr/share/licenses/mesa/license.rst /usr/share/licenses/ghostty-gtk/mesa-license.rst
EXPORTS TOOL ghostty
FILE /usr/share/licenses/ghostty-gtk/ghostty-LICENSE
FILE /usr/share/licenses/ghostty-gtk/libadwaita-COPYING
FILE /usr/share/licenses/ghostty-gtk/mesa-license.rst
FILE /usr/share/man/cat1/ghostty.1
    ghostty: Ghostty's GTK application, built inside Dolly from the pinned
    commit, for an X server (the ghostty-x11 application starts one).
    
      ghostty                           a window with $SHELL in it
      ghostty --command=direct:/bin/slop --gtk-single-instance=false
      ghostty +version                  its version
      ghostty +help                     the actions and options
    
    It draws its terminal with Mesa's OpenGL in the program (softpipe through
    EGL's surfaceless platform) and its window with cairo: set
    GSK_RENDERER=cairo MESA_GL_VERSION_OVERRIDE=4.3
    MESA_GLSL_VERSION_OVERRIDE=430, as ghostty-x11 does.
    Upstream's documentation: https://ghostty.org/docs
