COPY https://daugasauron.com/demos/classicube/Dollyfile-classicube-build ceb8fbfde641aec4a5000e0cf7c0bd9f4018743319c3019c3b05474b74882ab4 /usr/share/classicube /home/dolly/classicube
COPY https://daugasauron.com/demos/classicube/Dollyfile-classicube-build ceb8fbfde641aec4a5000e0cf7c0bd9f4018743319c3019c3b05474b74882ab4 /usr/share/licenses/classicube /usr/share/licenses/classicube
