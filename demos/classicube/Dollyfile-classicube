FILE /home/dolly/classicube/options.txt
    window-width=640
    window-height=480
    viewdist=32
    fpslimit=Limit60FPS
    gui-showfps=False
    musicvolume=0
    soundsvolume=0

FILE /etc/dolly/init.slop
    /bin/foreground -i /usr/bin/classicube-agent
    printf '\nDolly: ClassiCube launcher exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
