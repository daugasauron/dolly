# Lantern Drift on the page, with Godot's editor beside it: the game starts at once; Q quits to
# a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.6/Dollyfile-core a64f50b75a27a2701fd0dfe5576d51dbe8d2935c0d0e8d3246dbb79a7368dd47
INSTALL /v0.1.6/Dollyfile-posix 469ea6b54a78b9737eb5378aadb9198068c27e621558938468588f0b0d574ebf
INSTALL /v0.1.6/Dollyfile-display 0ac4795910e07e891278604f39ff54f6fe81c4347384b0a6d2470ba7d1dc5bdb
INSTALL /v0.1.6/demos/godot/Dollyfile-lantern-drift 970e1c5c060bf0c8735ebdbd62658aec3244f44c21840b53186a896d93c9efcb
INSTALL /v0.1.6/demos/godot/Dollyfile-godot-editor 958e33f24e4494455e8712e74520a53bab8934a80b118b7d01182c1e1df687e3
COPY /v0.1.6/demos/godot/Dollyfile-lantern-drift 970e1c5c060bf0c8735ebdbd62658aec3244f44c21840b53186a896d93c9efcb /usr/share/lantern-drift/project /home/dolly/lantern-drift
REQUIRES TOOL lantern-drift
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/lantern-drift
    printf '\nLantern Drift has quit. godot-editor -e --path ~/lantern-drift opens its project in the editor, lantern-drift plays it again.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
