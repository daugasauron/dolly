# Lantern Drift on the page, with Godot's editor beside it: the game starts at once; Q quits to
# a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.6/Dollyfile-core 1af35bd391b18ddb626a8a5248c4c940564cc4c23af9c2d44e313bf847b66bba
INSTALL /v0.1.6/Dollyfile-posix 37d85018d9ab218475d878070e6d5df646238f3e450e534e5c31b6c9e3198191
INSTALL /v0.1.6/Dollyfile-display 9516e36ef9c8566c9f0590546e1474db96ca02ddc75028e562e92af71fdbdeef
INSTALL /v0.1.6/demos/godot/Dollyfile-lantern-drift 9c89e69f54b53e77f3f14c9a52888c604ceb27d3973b356488b2addbb7a52d74
INSTALL /v0.1.6/demos/godot/Dollyfile-godot-editor 824a42e42bc71870454975d15ca94d4d27387a751330f33cd74e112db6742b69
COPY /v0.1.6/demos/godot/Dollyfile-lantern-drift 9c89e69f54b53e77f3f14c9a52888c604ceb27d3973b356488b2addbb7a52d74 /usr/share/lantern-drift/project /home/dolly/lantern-drift
REQUIRES TOOL lantern-drift
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/lantern-drift
    printf '\nLantern Drift has quit; lantern-drift plays it again.\n'
    printf 'godot-editor -e --path ~/lantern-drift opens its project in the Godot editor, the islands in its 3D view.\n'
    printf 'The eye beside HUD in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
