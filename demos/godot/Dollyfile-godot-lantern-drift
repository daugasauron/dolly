DOLLY 7
APPLICATION godot-lantern-drift
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST snapshot@0
REQUIRES HOST audio@0
REQUIRES HOST gpu@0
REQUIRES HOST threads@0
REQUIRES HOST sockets@0

# Lantern Drift on the page, with Godot's editor beside it: the game starts at once; Q quits to
# a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.5/Dollyfile-core ba71669ba7bd50ecab1497691cf784bb263a532435b36f5f1783ea2d1dc7f5ac
INSTALL /v0.1.5/Dollyfile-posix ec580400fe2f6dc4186b44a563a238456c525def4fcdf16a3242938886b9aaaa
INSTALL /v0.1.5/Dollyfile-display 215807de7ce4ec5f1b2025eb491005f3b4b515079b1f14ba947b46c2091fea52
INSTALL /v0.1.5/demos/godot/Dollyfile-lantern-drift bc54fefd2aa71a710c6ffeb43237c583df8bc96286f2c8d1a2653d40e76298fb
INSTALL /v0.1.5/demos/godot/Dollyfile-godot-editor 724db78673714ef54102cbea588faeab128a1c71dcea2b0d6c4cd8b52b0ce4c1
COPY /v0.1.5/demos/godot/Dollyfile-lantern-drift bc54fefd2aa71a710c6ffeb43237c583df8bc96286f2c8d1a2653d40e76298fb /usr/share/lantern-drift/project /home/dolly/lantern-drift
REQUIRES TOOL lantern-drift
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/lantern-drift
    printf '\nLantern Drift has quit. godot-editor -e --path ~/lantern-drift opens its project in the editor, lantern-drift plays it again.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
