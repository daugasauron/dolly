DOLLY 8
APPLICATION godot-lantern-drift
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST snapshot@0
REQUIRES HOST audio@0
REQUIRES HOST gpu@0
REQUIRES HOST threads@0
REQUIRES HOST sockets@0
REQUIRES HOST clipboard@0

# Lantern Drift on the page, with Godot's editor beside it: the game starts at once; Q quits to
# a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /Dollyfile-core f92e986b840d0d46883b4a8d6eee8082aebd56f944f318083bda74cfe3e86b10
INSTALL /Dollyfile-posix 135a308c65e7797939f58d35f54046ea6667d3630dc3ac09c6bf0b659667039d
INSTALL /Dollyfile-display 92fa47fba681122d18eec549b498ccfdc00477b619685d046643846f3b8df646
INSTALL /demos/godot/Dollyfile-lantern-drift a1f0415b227bace13cb20cab5144577264ca4d6bb7535a218d71a882eb54bff7
INSTALL /demos/godot/Dollyfile-godot-editor 0b70dd8f796aa907c3a3a1f0599e08dc81ba248d2ba869091fa1565c4034abac
COPY /demos/godot/Dollyfile-lantern-drift a1f0415b227bace13cb20cab5144577264ca4d6bb7535a218d71a882eb54bff7 /usr/share/lantern-drift/project /home/dolly/lantern-drift
REQUIRES TOOL lantern-drift
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/lantern-drift
    printf '\nLantern Drift has quit; lantern-drift plays it again.\n'
    printf 'godot-editor -e --path ~/lantern-drift opens its project in the Godot editor, the islands in its 3D view.\n'
    printf 'The eye beside HUD in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
