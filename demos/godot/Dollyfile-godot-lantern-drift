INSTALL /v0.1.7/Dollyfile-core 477b1e16bf88948c46bc4b68cd39d9610ffe5119e131c45223f89a61421520fa
INSTALL /v0.1.7/Dollyfile-posix 6a2f9206752a09e80d5e1a4d2d2be08ab2174816a108c7fcaf0045f337e50172
INSTALL /v0.1.7/Dollyfile-display 8f206fd7c1ccb3b0a4f96dc679b970f4bb7000e92b39ae1d2800a2df0236cca3
INSTALL /v0.1.7/demos/godot/Dollyfile-lantern-drift 58670f5529b7d44f928eee813dececd55a38a32fdf36da5a0a4bd364c0480971
INSTALL /v0.1.7/demos/godot/Dollyfile-godot-editor 74dd84b3c49033531a8dbd6f5831ac9ec863e381bf940984198e162591532179
COPY /v0.1.7/demos/godot/Dollyfile-lantern-drift 58670f5529b7d44f928eee813dececd55a38a32fdf36da5a0a4bd364c0480971 /usr/share/lantern-drift/project /home/dolly/lantern-drift
REQUIRES TOOL lantern-drift
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/lantern-drift
    printf '\nLantern Drift has quit; lantern-drift plays it again.\n'
    printf 'godot-editor -e --path ~/lantern-drift opens its project in the Godot editor, the islands in its 3D view.\n'
    printf 'The eye beside HUD in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
