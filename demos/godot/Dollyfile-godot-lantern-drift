INSTALL /v0.1.7/Dollyfile-posix a56414b5e6e838f9469331f6c931af66736860694446f2475e26a10e7dabc70a
INSTALL /v0.1.7/Dollyfile-display a0fc9ed4e46ee533458a6eaa9fdba0428051c0bd3b65ae20ea808528263d68f2
INSTALL /v0.1.7/demos/godot/Dollyfile-lantern-drift 2d14b0f8893d451270bb3012b469c9f7af1b049b4033532dc48f9b2ca0bbfd7c
INSTALL /v0.1.7/demos/godot/Dollyfile-godot-editor 095ec41baf3e37c8672d16dc770a114b32bcb9b71a4793b3d6e59f890b898b5e
COPY /v0.1.7/demos/godot/Dollyfile-lantern-drift 2d14b0f8893d451270bb3012b469c9f7af1b049b4033532dc48f9b2ca0bbfd7c /usr/share/lantern-drift/project /home/dolly/lantern-drift
REQUIRES TOOL lantern-drift
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/lantern-drift
    printf '\nLantern Drift has quit; lantern-drift plays it again.\n'
    printf 'godot-editor -e --path ~/lantern-drift opens its project in the Godot editor, the islands in its 3D view.\n'
    printf 'The eye beside HUD in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
