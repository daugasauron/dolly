# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.6/Dollyfile-core d69d0e16a3e1a7813171966d23fcf5a44d488a6bcf2723a3d32f689fa162fc5c
INSTALL /v0.1.6/Dollyfile-posix 9773acc9cc5cdbe7b4d9a355092dcf3bed9a77de6f1da50eb925d1d9690c68ba
INSTALL /v0.1.6/Dollyfile-display e1328f1decb7f81e8b508cf5f03c18246fdac37d39d259021ea69882d59f4d9f
INSTALL /v0.1.6/demos/godot/Dollyfile-airtime-godot 3f15e6a1a0daa52b1d6a957d492921a9740123500e7db572130aee673a98d75b
INSTALL /v0.1.6/demos/godot/Dollyfile-godot-editor 7568d021a6bd0950770fd04ae5b6e1b2a7f70be86ebf198a4d1a750f8cb39794
COPY /v0.1.6/demos/godot/Dollyfile-airtime-godot 3f15e6a1a0daa52b1d6a957d492921a9740123500e7db572130aee673a98d75b /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit. godot-editor -e --path ~/airtime opens its project in the editor, airtime-godot plays it again.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
