# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.6/Dollyfile-core 3f0ed8f48580b1aea351749cdcfbeab4bfe452436abc50beca43dac3d12fd7a9
INSTALL /v0.1.6/Dollyfile-posix 44897e45850c0eb09bd481984aed46ab099f11c4d37bdcfc05591df26746e60a
INSTALL /v0.1.6/Dollyfile-display 717f83d872a97cfc876278574e3c44fb4b3995d9b3b09562f85c0c718b8baec6
INSTALL /v0.1.6/demos/godot/Dollyfile-airtime-godot 60bda242839a6abd17108775f2f206b3d1a3b6eb85cb0eba65d6851001a00c65
INSTALL /v0.1.6/demos/godot/Dollyfile-godot-editor 17d9894d688435ca8141e613718c562541b0d5e2b70a11809539592ea1b4e055
COPY /v0.1.6/demos/godot/Dollyfile-airtime-godot 60bda242839a6abd17108775f2f206b3d1a3b6eb85cb0eba65d6851001a00c65 /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit. godot-editor -e --path ~/airtime opens its project in the editor, airtime-godot plays it again.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
