# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.6/Dollyfile-core d69d0e16a3e1a7813171966d23fcf5a44d488a6bcf2723a3d32f689fa162fc5c
INSTALL /v0.1.6/Dollyfile-posix 3f1e6b15fe6a98d19c9a4d53aa9fd9d0a3e543f0098f61f4b28cfa690d095c5f
INSTALL /v0.1.6/Dollyfile-display 04c5a260eb25a1f21c877baef97fb57fe930a637af40ad6dfa530f66709f2a7e
INSTALL /v0.1.6/demos/godot/Dollyfile-airtime-godot 41f22e23f98071919f7ffacb258ec69eb009b25e963a2bebe22cfa5bc83fd562
INSTALL /v0.1.6/demos/godot/Dollyfile-godot-editor b6b00eb540f87970af27cef78fa3bd995e4e7dafacc75ee44f283b402167d853
COPY /v0.1.6/demos/godot/Dollyfile-airtime-godot 41f22e23f98071919f7ffacb258ec69eb009b25e963a2bebe22cfa5bc83fd562 /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit. godot-editor -e --path ~/airtime opens its project in the editor, airtime-godot plays it again.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
