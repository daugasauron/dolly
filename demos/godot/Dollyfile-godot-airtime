# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.7/Dollyfile-core caa19f185c50cbd349b17f198915d8c4ebfed0f998dd03f81d0efa52d20ef1a1
INSTALL /v0.1.7/Dollyfile-posix 67fa1665d450f0b545f42675e75f23d4eba656186bd8b9552c521636548d667e
INSTALL /v0.1.7/Dollyfile-display 65002fa85e44894e37b74c232023f10a87bec83c81e2cb8093a1cf0ac8bebbcf
INSTALL /v0.1.7/demos/godot/Dollyfile-airtime-godot 82ca3e4965bb37b8661fcf64025935fc259f890086b53fac35bd84c8cb5ca3a4
INSTALL /v0.1.7/demos/godot/Dollyfile-godot-editor 9bcac7af862992ce88fe62cca0f1af80928dab2d82733b771f83c6398da530b0
COPY /v0.1.7/demos/godot/Dollyfile-airtime-godot 82ca3e4965bb37b8661fcf64025935fc259f890086b53fac35bd84c8cb5ca3a4 /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit; airtime-godot plays it again.\n'
    printf 'godot-editor -e --path ~/airtime opens its project in the Godot editor, the course in its 3D view. The eye\n'
    printf 'beside Hud in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
