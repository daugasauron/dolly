# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.6/Dollyfile-core 03ca90f448fb77376f87753c0402c50cd460bd775d64546578044971ed15e98d
INSTALL /v0.1.6/Dollyfile-posix 170e7c2312195e2dc62a3c48d5e76f66b4a4859aff52a69b644f90c0e4e2f730
INSTALL /v0.1.6/Dollyfile-display d6ed8ecc88fa129ae2543779a9c97cd99a94639bb75338af65915d0ec75ab24f
INSTALL /v0.1.6/demos/godot/Dollyfile-airtime-godot 9391df27cd39e2903f83817cb8c29d3ded4528645e657d7704d6af9fab10458f
INSTALL /v0.1.6/demos/godot/Dollyfile-godot-editor 5ed23a00d374b74d7c68bdf43f953fa6a87157409aad3acc1645f5acd9974cf7
COPY /v0.1.6/demos/godot/Dollyfile-airtime-godot 9391df27cd39e2903f83817cb8c29d3ded4528645e657d7704d6af9fab10458f /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit; airtime-godot plays it again.\n'
    printf 'godot-editor -e --path ~/airtime opens its project in the Godot editor, the course in its 3D view. The eye\n'
    printf 'beside Hud in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
