# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.6/Dollyfile-core 1af35bd391b18ddb626a8a5248c4c940564cc4c23af9c2d44e313bf847b66bba
INSTALL /v0.1.6/Dollyfile-posix 37d85018d9ab218475d878070e6d5df646238f3e450e534e5c31b6c9e3198191
INSTALL /v0.1.6/Dollyfile-display 9516e36ef9c8566c9f0590546e1474db96ca02ddc75028e562e92af71fdbdeef
INSTALL /v0.1.6/demos/godot/Dollyfile-airtime-godot e5b0ce44d4a5ad72158f5ff8e47bdc086a74e1420f687c4bb35813f6283c0f46
INSTALL /v0.1.6/demos/godot/Dollyfile-godot-editor 6dd0e5b78f2e4bd5b03d170727bc0a77aa734c49af7bad280263005696a0a52a
COPY /v0.1.6/demos/godot/Dollyfile-airtime-godot e5b0ce44d4a5ad72158f5ff8e47bdc086a74e1420f687c4bb35813f6283c0f46 /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit; airtime-godot plays it again.\n'
    printf 'godot-editor -e --path ~/airtime opens its project in the Godot editor, the course in its 3D view. The eye\n'
    printf 'beside Hud in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
