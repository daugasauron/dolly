# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.7/Dollyfile-core 25fa0445fc7df33ec943073859ed66854fc63eb79a8069388057bcd2ec3fa8ca
INSTALL /v0.1.7/Dollyfile-posix a56414b5e6e838f9469331f6c931af66736860694446f2475e26a10e7dabc70a
INSTALL /v0.1.7/Dollyfile-display a0fc9ed4e46ee533458a6eaa9fdba0428051c0bd3b65ae20ea808528263d68f2
INSTALL /v0.1.7/demos/godot/Dollyfile-airtime-godot 8a461478886e81ea5b128edd42f181013326834c29e817b1afbf29258021b63c
INSTALL /v0.1.7/demos/godot/Dollyfile-godot-editor 095ec41baf3e37c8672d16dc770a114b32bcb9b71a4793b3d6e59f890b898b5e
COPY /v0.1.7/demos/godot/Dollyfile-airtime-godot 8a461478886e81ea5b128edd42f181013326834c29e817b1afbf29258021b63c /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit; airtime-godot plays it again.\n'
    printf 'godot-editor -e --path ~/airtime opens its project in the Godot editor, the course in its 3D view. The eye\n'
    printf 'beside Hud in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
