# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /v0.1.7/Dollyfile-core eda40e39821dad0950a249cff23bddafe3b31ea1e57e9e17216705f925d4c1e3
INSTALL /v0.1.7/Dollyfile-posix 4058459f4998f9c3fc435e673f27c3e631dd22f1cc74a7edcc4628bb0acb71fc
INSTALL /v0.1.7/Dollyfile-display 3335bd4643ab8a00323d4cc52c70d6b2046b9a72a50915bf62cb2f16027238ef
INSTALL /v0.1.7/demos/godot/Dollyfile-airtime-godot 17f585f4e49db359ea09208007ba57e4853d7a1c9510adddd8754f59a0c61d79
INSTALL /v0.1.7/demos/godot/Dollyfile-godot-editor 9854dfc94c06a985759fb4c10e40fbe46c222803cec1fef11c89dcf79cbd84eb
COPY /v0.1.7/demos/godot/Dollyfile-airtime-godot 17f585f4e49db359ea09208007ba57e4853d7a1c9510adddd8754f59a0c61d79 /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit; airtime-godot plays it again.\n'
    printf 'godot-editor -e --path ~/airtime opens its project in the Godot editor, the course in its 3D view. The eye\n'
    printf 'beside Hud in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
