DOLLY 8
APPLICATION godot-airtime
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST touch@0
REQUIRES HOST snapshot@0
REQUIRES HOST audio@0
REQUIRES HOST gpu@0
REQUIRES HOST threads@0
REQUIRES HOST sockets@0
REQUIRES HOST clipboard@0

# Airtime: Foundry in Godot on the page, with Godot's editor beside it: the game starts at once;
# Q quits to a shell where the editor opens the game's project, a copy in the home directory.
INSTALL /Dollyfile-core f92e986b840d0d46883b4a8d6eee8082aebd56f944f318083bda74cfe3e86b10
INSTALL /Dollyfile-posix c67f734780c8ee1d6294e903694f1ca0604308013a00ed3439a1a69b5218a854
INSTALL /Dollyfile-display 92fa47fba681122d18eec549b498ccfdc00477b619685d046643846f3b8df646
INSTALL /demos/godot/Dollyfile-airtime-godot db3d7ddc3d48d9c735ff25743a4e3eb645c09550255ff4a92597558f42cb2063
INSTALL /demos/godot/Dollyfile-godot-editor 38dad70910ea957bb622c200c6532f8ce3a75baec1f8256b082210c5e4af4b15
COPY /demos/godot/Dollyfile-airtime-godot db3d7ddc3d48d9c735ff25743a4e3eb645c09550255ff4a92597558f42cb2063 /usr/share/airtime-godot/project /home/dolly/airtime
REQUIRES TOOL airtime-godot
REQUIRES TOOL godot-editor

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/airtime-godot
    printf '\nAirtime has quit; airtime-godot plays it again.\n'
    printf 'godot-editor -e --path ~/airtime opens its project in the Godot editor, the course in its 3D view. The eye\n'
    printf 'beside Hud in the Scene dock hides the game display; F5 plays the game so, and Ctrl+S saves the scene.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
