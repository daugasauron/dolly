# Blender's Scripting workspace, flyer.py in its Text Editor, run once, and
# the 3D view showing the colours of its materials. What Blender makes here is
# the script's and the file it writes, so quitting asks to save no scene.
FILE /usr/share/voxel-flyover/open-flyer.py
    import bpy
    bpy.context.preferences.view.use_save_prompt = False
    text = bpy.data.texts.load("/usr/share/voxel-flyover/project/flyer.py")
    workspace = bpy.data.workspaces["Scripting"]
    for area in workspace.screens[0].areas:
        if area.type == "TEXT_EDITOR":
            area.spaces[0].text = text
        if area.type == "VIEW_3D":
            area.spaces[0].shading.color_type = "MATERIAL"
    bpy.context.window.workspace = workspace
    # Once the window has drawn, which it does after this script.
    def run():
        with bpy.context.temp_override(window=bpy.context.window_manager.windows[0]):
            exec(compile(text.as_string(), text.filepath, "exec"), {"__name__": "__main__"})
    bpy.app.timers.register(run, first_interval=1.0)

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/blender --python /usr/share/voxel-flyover/open-flyer.py
    printf '\nBlender has quit; voxel-flyover plays the flyer it saved, and\n'
    printf 'blender --python /usr/share/voxel-flyover/open-flyer.py opens the script again.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
