SLOP gzip -dc /tmp/godot-source.tar.gz | tar -xf - -C /
# Godot's modern renderers take only the drivers main.cpp names; glslang builds beside them;
# Forward+ starts SDFGI only on a device with image atomics, which its voxelization takes.
SLOP CWD /usr/src/godot patch -p1 -i platform/dolly/godot-dolly.patch
SLOP CWD /usr/src/godot scons -j4 platform=dolly modules_enabled_by_default=no \
  module_gdscript_enabled=yes module_text_server_fb_enabled=yes module_freetype_enabled=yes \
  module_godot_physics_2d_enabled=yes module_godot_physics_3d_enabled=yes module_ogg_enabled=yes module_vorbis_enabled=yes \
  module_minimp3_enabled=yes module_webp_enabled=yes module_regex_enabled=yes module_glslang_enabled=yes
SLOP cp /usr/src/godot/bin/godot.dolly.template_release.wasm64 /usr/bin/godot
SLOP mkdir -p /usr/share/licenses/godot
SLOP cp /usr/src/godot/LICENSE.txt /usr/src/godot/COPYRIGHT.txt /usr/share/licenses/godot
SLOP cp /usr/share/licenses/mesa/license.rst /usr/share/licenses/godot/mesa-license.rst
# Godot's page is in section 6, games; man reads section 1.
SLOP cp /usr/src/godot/misc/dist/linux/godot.6 /tmp/godot.1
SLOP text-page /tmp/godot.1
SLOP rm -rf /usr/src/godot /tmp/godot-source.tar.gz /tmp/godot.1

