DOLLY 7
PACKAGE godot
REQUIRES HOST runtime@0
REQUIRES HOST audio@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST threads@0

# Godot from its release, unchanged, built by SCons with Dolly's cc on a
# platform of Dolly's own (platform/dolly, from demos/godot/platform): the
# engine with GDScript, 2D physics and the fallback text server, without 3D,
# and its Compatibility renderer on Mesa's OpenGL (EGL and softpipe, linked
# in from mesa-build), with its sound on audio@0. It plays on the page or runs a
# project with --headless.
FROM /v0.1.5/demos/ghostty-gtk/Dollyfile-mesa-build c2560dd3b9782789bb0b58997815f5d6315e9ceb7529a67e13cbc2c00ba1a61b
USE /v0.1.5/demos/tools/Dollyfile-scons 32e62646343a0caf64ad4087ce4bbf89d9c3bb35b6d8f4da24a797b033979da0
USE /v0.1.5/Dollyfile-mandoc 83da22748d615feab08a0a774cb1f704c8d8f6cde9402b86d4b0dd8ea166e5bd
USE /v0.1.5/Dollyfile-libdolly-audio cf506533d24804e00d1211d4008d8eb71d16747dc8563843262545be6dbca30b

REQUIRES TOOL cp
REQUIRES TOOL grep
REQUIRES TOOL gzip
REQUIRES TOOL mkdir
REQUIRES TOOL rm
REQUIRES TOOL scons
REQUIRES TOOL tar
REQUIRES TOOL text-page

SOURCE /v0.1.5/dist/static/godot/source.tar.gz eb5de7b7fbbb7acbd9e69db536b6225f73859773f5cd6dc662fd2534d89c29f5 /tmp/godot-source.tar.gz
SLOP gzip -dc /tmp/godot-source.tar.gz | tar -xf - -C /
SLOP CWD /usr/src/godot scons -j4 platform=dolly disable_3d=yes modules_enabled_by_default=no \
  module_gdscript_enabled=yes module_text_server_fb_enabled=yes module_freetype_enabled=yes \
  module_godot_physics_2d_enabled=yes
SLOP cp /usr/src/godot/bin/godot.dolly.template_release.wasm64 /usr/bin/godot
SLOP mkdir -p /usr/share/licenses/godot
SLOP cp /usr/src/godot/LICENSE.txt /usr/src/godot/COPYRIGHT.txt /usr/share/licenses/godot
SLOP cp /usr/share/licenses/mesa/license.rst /usr/share/licenses/godot/mesa-license.rst
# Godot's page is in section 6, games; man reads section 1.
SLOP cp /usr/src/godot/misc/dist/linux/godot.6 /tmp/godot.1
SLOP text-page /tmp/godot.1
SLOP rm -rf /usr/src/godot /tmp/godot-source.tar.gz /tmp/godot.1

FILE /tmp/godot-check/project.godot
    config_version=5
    [application]
    run/main_scene="res://main.tscn"
FILE /tmp/godot-check/main.tscn
    [gd_scene format=3]
    [ext_resource type="Script" path="res://main.gd" id="1"]
    [node name="Main" type="Node"]
    script = ExtResource("1")
FILE /tmp/godot-check/main.gd
    extends Node
    func _ready() -> void:
        print("GODOT ", OS.get_name())
        get_tree().quit()
SLOP godot --headless --path /tmp/godot-check | grep -qx 'GODOT Dolly'

EXPORTS TOOL godot
FILE /usr/share/licenses/godot/LICENSE.txt
FILE /usr/share/licenses/godot/COPYRIGHT.txt
FILE /usr/share/licenses/godot/mesa-license.rst
FILE /usr/share/man/cat1/godot.1
