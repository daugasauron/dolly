DOLLY 7
PACKAGE godot-editor
REQUIRES HOST runtime@0
REQUIRES HOST audio@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST threads@0
REQUIRES HOST sockets@0
REQUIRES HOST gpu@0

# Godot's editor from the same release on the same platform: it imports a
# project's assets and exports its pack (--headless --import, --export-pack),
# and draws its own window on the page. Without Basis Universal, whose encoder
# names a header of Linux's that Emscripten's libc and Dolly's leave out
# (sys/timex.h), and Jolt Physics, which knows WebAssembly only as Emscripten:
# 3D physics is Godot's own.
FROM /v0.1.6/demos/ghostty-gtk/Dollyfile-mesa-build f2e3ab66911ec857a6191ac5229f0bc7fe42cd1250b9c5dca8c299b4c375cdd8
USE /v0.1.6/demos/tools/Dollyfile-scons 79614ab35e4761e4393147fbf312ac7092cbac99c9ad077b6574f45531e2957c
USE /v0.1.6/Dollyfile-mandoc 05e2800edcfd0600e44e6bdbd5292a5aa4577bc12a2ea456634c0b7c56258f0d
USE /v0.1.6/Dollyfile-libdolly-gpu 9a87750403b544f3e224006e3e114461160e2094fff2607008924aead0665ad7
USE /v0.1.6/Dollyfile-libdolly-sockets 4636295439c4e243368efb6de237b465183368c299040efda2cce4cf2215aa48
USE /v0.1.6/demos/godot/Dollyfile-spirv-wgsl c6b85241a3358f2caf2ecd410588f61f9646b779ecd4bf00daa9903c9dff3bcf
USE /v0.1.6/Dollyfile-libdolly-audio 697012964ba7447e65e52fae8f8e4aa87de31647a0427b703c39da194d090b3d

REQUIRES TOOL cp
REQUIRES TOOL grep
REQUIRES TOOL gzip
REQUIRES TOOL mkdir
REQUIRES TOOL patch
REQUIRES TOOL rm
REQUIRES TOOL scons
REQUIRES TOOL tar
REQUIRES TOOL test
REQUIRES TOOL text-page

SOURCE /v0.1.6/dist/static/godot/source.tar.gz dd17f5ebabe46588a3ed90cf11943846982044d018495a5dcec486139a63a0a5 /tmp/godot-source.tar.gz
SLOP gzip -dc /tmp/godot-source.tar.gz | tar -xf - -C /
# Godot's modern renderers take only the drivers main.cpp names; glslang builds beside them;
# Forward+ starts SDFGI only on a device with image atomics, which its voxelization takes.
SLOP CWD /usr/src/godot patch -p1 -i platform/dolly/godot-dolly.patch
SLOP CWD /usr/src/godot scons -j4 platform=dolly target=editor module_basis_universal_enabled=no \
  module_jolt_physics_enabled=no
SLOP cp /usr/src/godot/bin/godot.dolly.editor.wasm64 /usr/bin/godot-editor
SLOP mkdir -p /usr/share/licenses/godot-editor
SLOP cp /usr/src/godot/LICENSE.txt /usr/src/godot/COPYRIGHT.txt /usr/share/licenses/godot-editor
SLOP cp /usr/share/licenses/mesa/license.rst /usr/share/licenses/godot-editor/mesa-license.rst
# Godot's page, which describes the editor, is in section 6; man reads section 1.
SLOP cp /usr/src/godot/misc/dist/linux/godot.6 /tmp/godot-editor.1
SLOP text-page /tmp/godot-editor.1
SLOP rm -rf /usr/src/godot /tmp/godot-source.tar.gz /tmp/godot-editor.1

# A project whose script reads an SVG the editor imported into the pack it exported.
FILE /tmp/godot-check/project.godot
    config_version=5
    [application]
    run/main_scene="res://main.tscn"
FILE /tmp/godot-check/export_presets.cfg
    [preset.0]
    name="Dolly"
    platform="Linux"
    runnable=true
    export_filter="all_resources"
    [preset.0.options]
    custom_template/release=""
FILE /tmp/godot-check/icon.svg
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><rect width="16" height="16" fill="#4080ff"/></svg>
FILE /tmp/godot-check/main.tscn
    [gd_scene format=3]
    [ext_resource type="Script" path="res://main.gd" id="1"]
    [node name="Main" type="Node"]
    script = ExtResource("1")
FILE /tmp/godot-check/main.gd
    extends Node
    func _ready() -> void:
        print("ICON ", load("res://icon.svg").get_size())
        get_tree().quit()
SLOP CWD /tmp/godot-check godot-editor --headless --import
SLOP CWD /tmp/godot-check godot-editor --headless --export-pack Dolly /tmp/godot-check.pck
SLOP CWD /tmp godot-editor --headless --main-pack /tmp/godot-check.pck | grep -qx 'ICON (16.0, 16.0)'

EXPORTS TOOL godot-editor
FILE /usr/share/licenses/godot-editor/LICENSE.txt
FILE /usr/share/licenses/godot-editor/COPYRIGHT.txt
FILE /usr/share/licenses/godot-editor/mesa-license.rst
FILE /usr/share/man/cat1/godot-editor.1
