DOLLY 7
PACKAGE lantern-drift
REQUIRES HOST runtime@0
REQUIRES HOST audio@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST threads@0
REQUIRES HOST sockets@0
REQUIRES HOST gpu@0
REQUIRES HOST clipboard@0

# Lantern Drift, Dolly's showcase for Godot: glide a paper lantern through rings of light over a
# sky archipelago from sunset into night, drawn by Godot's Forward+ renderer on gpu@0 with
# volumetric fog, glow, SSAO and particles, its sound made in code. Its project
# (demos/godot/lantern-drift) is imported and exported here by Godot's editor, and lantern-drift
# plays the pack with godot, which installs with it. The project installs too, for the editor.
FROM /v0.1.6/Dollyfile-system 33e5bcf65ef4a634da5dbf8e291a379148e7971aa0411fe1bdaa4e0332f24b94
INSTALL /v0.1.6/demos/godot/Dollyfile-godot f9bfa77355356aa10dae2a7932825a3004f092e8eeb0d3ed333a58211db1a8cb
USE /v0.1.6/demos/godot/Dollyfile-godot-editor 40b356d99d06e3334cca43232df29096f916427434a8c11d684c967ee5b4600b

REQUIRES TOOL cp
REQUIRES TOOL godot-editor
REQUIRES TOOL mkdir
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /v0.1.6/dist/static/godot/lantern-drift.tar 48d6b38d8862f7a56372f5dbaf26f38d255cfd6c949b2b3c216aee122eeb6f13 /tmp/lantern-drift.tar
SLOP CWD / tar -xf /tmp/lantern-drift.tar
SLOP mkdir -p /usr/share/lantern-drift
SLOP cp -r /usr/src/lantern-drift /usr/share/lantern-drift/project
SLOP CWD /usr/src/lantern-drift godot-editor --headless --import
SLOP CWD /usr/src/lantern-drift godot-editor --headless --export-pack Dolly /usr/share/lantern-drift/lantern-drift.pck
SLOP rm -rf /usr/src/lantern-drift /tmp/lantern-drift.tar

FILE /usr/bin/lantern-drift
    #!/bin/slop
    godot --main-pack /usr/share/lantern-drift/lantern-drift.pck "$@"
EXPORTS TOOL lantern-drift
FILE /usr/share/man/cat1/lantern-drift.1
    lantern-drift [GODOT-OPTION...] [-- --autopilot SECONDS] [-- --nightfall DISTANCE]
    Plays Lantern Drift on the page: fly through the rings of light to keep your
    lantern burning, from sunset into night. Arrows or WASD steer, Space boosts,
    Escape pauses, Q quits; Enter or a click takes off. With --autopilot it flies
    one run by itself and prints its frame rate and score. It draws through WebGPU
    (gpu@0). Its project is /usr/share/lantern-drift/project: copy it to edit it
    with godot-editor.
FILE /usr/share/lantern-drift/lantern-drift.pck
FOLDER /usr/share/lantern-drift/project
