; Lantern Drift: Dolly's showcase game for Godot, made with its editor inside Dolly.

config_version=5

[application]

config/name="Lantern Drift"
config/description="Glide a paper lantern through rings of light over a sky archipelago at dusk."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.1, 0.07, 0.2, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
