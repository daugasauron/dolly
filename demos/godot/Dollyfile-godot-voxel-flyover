# Voxel Flyover on the page: the flight starts at once; Q quits to a shell.
INSTALL /Dollyfile-core f92e986b840d0d46883b4a8d6eee8082aebd56f944f318083bda74cfe3e86b10
INSTALL /Dollyfile-posix c67f734780c8ee1d6294e903694f1ca0604308013a00ed3439a1a69b5218a854
INSTALL /Dollyfile-display 92fa47fba681122d18eec549b498ccfdc00477b619685d046643846f3b8df646
INSTALL /demos/godot/Dollyfile-voxel-flyover b5675dfe44831c0f83502dced1372523829fc404380eeea32575a9d0fb0a1f20
REQUIRES TOOL voxel-flyover

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/voxel-flyover
    printf '\nVoxel Flyover has quit; voxel-flyover plays it again, and man voxel-flyover lists its options.\n'
    printf 'Its project is /usr/share/voxel-flyover/project: the planet is terrain.gdshaderinc.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
