# Voxel Flyover on the page: the flight starts at once; Q quits to a shell.
INSTALL /v0.1.6/Dollyfile-core 1af35bd391b18ddb626a8a5248c4c940564cc4c23af9c2d44e313bf847b66bba
INSTALL /v0.1.6/Dollyfile-posix 37d85018d9ab218475d878070e6d5df646238f3e450e534e5c31b6c9e3198191
INSTALL /v0.1.6/Dollyfile-display 9516e36ef9c8566c9f0590546e1474db96ca02ddc75028e562e92af71fdbdeef
INSTALL /v0.1.6/demos/godot/Dollyfile-voxel-flyover b26a76145d9b699db88dc1b832f6ade6bc634746ff85f2b69a17f525951c754e
REQUIRES TOOL voxel-flyover

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/voxel-flyover
    printf '\nVoxel Flyover has quit; voxel-flyover plays it again, and man voxel-flyover lists its options.\n'
    printf 'Its project is /usr/share/voxel-flyover/project: the world is terrain.gdshaderinc.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
