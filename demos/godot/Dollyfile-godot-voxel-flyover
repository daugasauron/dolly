DOLLY 8
APPLICATION godot-voxel-flyover
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST input@0
REQUIRES HOST touch@0
REQUIRES HOST snapshot@0
REQUIRES HOST audio@0
REQUIRES HOST gpu@0
REQUIRES HOST threads@0
REQUIRES HOST sockets@0
REQUIRES HOST clipboard@0

# Voxel Flyover on the page: the flight starts at once; Q quits to a shell.
INSTALL /Dollyfile-core f92e986b840d0d46883b4a8d6eee8082aebd56f944f318083bda74cfe3e86b10
INSTALL /Dollyfile-posix c24b7cb8dfc057769bc7f644f68c2922514adb89272756d8ed793c0318d5f3d5
INSTALL /Dollyfile-display cc98bc6edc0e5dea2bfb79e3095ea1fb6744e28282d28cec6c2e013cf6435992
INSTALL /demos/godot/Dollyfile-voxel-flyover 5b99f61de720ae3dcabd65f035d5c62a73f0b45740c1ac20bb94fba245388709
REQUIRES TOOL voxel-flyover

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/voxel-flyover
    printf '\nVoxel Flyover has quit; voxel-flyover plays it again, and man voxel-flyover lists its options.\n'
    printf 'Its project is /usr/share/voxel-flyover/project: the planet is terrain.gdshaderinc.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
