# Waits for one key with the terminal in raw mode; Ctrl+C stays SIGINT.
FILE /tmp/anykey.c
    #include <termios.h>
    #include <unistd.h>
    int main(void) {
      struct termios cooked, raw;
      if (tcgetattr(0, &cooked) != 0) return 1;
      raw = cooked;
      raw.c_lflag &= ~(ICANON | ECHO);
      raw.c_cc[VMIN] = 1;
      raw.c_cc[VTIME] = 0;
      if (tcsetattr(0, TCSANOW, &raw) != 0) return 1;
      char key;
      const long count = read(0, &key, 1);
      tcsetattr(0, TCSANOW, &cooked);
      return count == 1 ? 0 : 1;
    }
SLOP cc -O1 /tmp/anykey.c -o /usr/bin/anykey
EXPORTS TOOL anykey

FILE /usr/share/doc/code-agent/NOTICE
    CLAUDE CODE IN THIS BROWSER SESSION
    -----------------------------------
    This image runs Claude Code, Anthropic's command-line coding agent. Claude
    Code is Anthropic's software and not part of Dolly; Dolly is not affiliated
    with or endorsed by Anthropic.
    - Continuing downloads Claude Code 2.1.112 (April 2026, 18.7 MB) from the
      npm registry into this browser session, checks its digest and runs it as
      published. This site serves nothing of it. Its use is subject to
      Anthropic's terms: https://code.claude.com/docs/en/legal-and-compliance
    - You sign in with your own API key or Claude account, and the usage is
      billed to you. Requests go from this browser to Anthropic; the site
      serving Dolly does not receive them. A saved or exported session contains
      your sign-in and the downloaded package.
    - Limits: 2.1.112 is the last release that is JavaScript; it runs on Janis,
      not Node, without a Bash tool. In a browser its interactive start stops
      at "Unable to connect to Anthropic services" (Anthropic's check endpoints
      refuse browser requests), so signing in there, with a Claude account or
      a Console account, cannot be reached. What works is print mode with
      your key: press Ctrl+C now, then  export ANTHROPIC_API_KEY=...  and
      code-agent -p 'your request'.
    Press any key to download and start Claude Code, or Ctrl+C to leave.

# Shows the notice, then downloads Claude Code into the session (once),
# checks the pinned digest of the tarball and runs it unchanged.
FILE /usr/bin/code-agent
    #!/bin/slop
    clear
    cat /usr/share/doc/code-agent/NOTICE
    printf '\n'
    anykey || exit $?
    package=/opt/claude-code/package
    if ! test -s $package/cli.js; then
      printf '\nDownloading Claude Code 2.1.112 from registry.npmjs.org ...\n'
      curl -fsS https://registry.npmjs.org/@anthropic-ai/claude-code/-/claude-code-2.1.112.tgz -o /tmp/claude-code.tgz || exit 1
      set -- $(sha256sum /tmp/claude-code.tgz)
      if test "$1" != 84379969ea53a0e5fd231a8f77debe4c7cb17dd971f4809d10d33f9aeca5de09; then
        printf 'code-agent: the download does not match the pinned SHA-256; nothing was unpacked.\n' >&2
        rm -f /tmp/claude-code.tgz
        exit 1
      fi
      mkdir -p /opt/claude-code && gzip -dc /tmp/claude-code.tgz > /tmp/claude-code.tar && tar -xf /tmp/claude-code.tar -C /opt/claude-code || exit 1
      rm -f /tmp/claude-code.tgz /tmp/claude-code.tar
    fi
    env USE_BUILTIN_RIPGREP=0 janis $package/cli.js "$@"
EXPORTS TOOL code-agent

FILE /etc/dolly/init.slop
    cd /workspace
    /bin/foreground -i /usr/bin/code-agent
    printf '\nDolly: image entry exited; entering the recovery Slop shell. code-agent starts it again.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
