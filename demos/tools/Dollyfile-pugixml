DOLLY 8
PACKAGE pugixml
REQUIRES HOST runtime@0

# pugixml, the C++ XML parser with XPath (OpenImageIO's), from upstream's
# release archive, unchanged, built by its CMake project, for programs the cc
# package builds.
FROM /demos/cmake/Dollyfile-cmake-build 2baf4bb61a256fbae4111b9adb7fc6438ee52f52d4c6dfb4e325c8245edaf0e7
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL cmake
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/pugixml/source.tar.gz 70b90447e39db88117545e0143bcdb342184634fcbee6bb339f5a6a3ce2e6599 /tmp/pugixml.tar.gz
SLOP gzip -dc /tmp/pugixml.tar.gz | tar -xf - -C /
SLOP cmake -S /tmp/pugixml -B /tmp/pugixml-build -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5
SLOP cmake --build /tmp/pugixml-build -j4
SLOP cmake --install /tmp/pugixml-build

EXPORTS LIB    pugixml       /usr/lib/libpugixml.a
EXPORTS HEADER pugixml       /usr/include/pugixml.hpp
EXPORTS HEADER pugiconfig    /usr/include/pugiconfig.hpp
EXPORTS FOLDER pugixml-cmake /usr/lib/cmake/pugixml
FILE /usr/lib/pkgconfig/pugixml.pc
FILE /usr/share/licenses/pugixml/LICENSE.md
SLOP rm -rf /tmp/pugixml /tmp/pugixml-build /tmp/pugixml.tar.gz
