DOLLY 8
PACKAGE yaml-cpp
REQUIRES HOST runtime@0

# yaml-cpp, a YAML parser and emitter for C++ (OpenColorIO's configurations),
# from upstream's release archive, unchanged, built by its CMake project, for
# programs the cc package builds.
FROM /demos/cmake/Dollyfile-cmake-build ef925b15c0342d66937cb491e956474f5dbb37d60cb2063e6e7ec91e0cb85d71
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL cmake
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/yaml-cpp/source.tar.gz 4104bd507b7ab5ac0ece0b58bedc1998ad2c293370ec6564ce89d69bfb3ca3d2 /tmp/yaml-cpp.tar.gz
SLOP gzip -dc /tmp/yaml-cpp.tar.gz | tar -xf - -C /
SLOP cmake -S /tmp/yaml-cpp -B /tmp/yaml-cpp-build -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DYAML_CPP_BUILD_TESTS=OFF \
  -DYAML_CPP_BUILD_TOOLS=OFF -DYAML_CPP_BUILD_CONTRIB=OFF
SLOP cmake --build /tmp/yaml-cpp-build -j4
SLOP cmake --install /tmp/yaml-cpp-build

EXPORTS LIB    yaml-cpp       /usr/lib/libyaml-cpp.a
EXPORTS HEADER yaml-cpp       /usr/include/yaml-cpp
EXPORTS FOLDER yaml-cpp-cmake /usr/lib/cmake/yaml-cpp
FILE /usr/lib/pkgconfig/yaml-cpp.pc
FILE /usr/share/licenses/yaml-cpp/LICENSE
SLOP rm -rf /tmp/yaml-cpp /tmp/yaml-cpp-build /tmp/yaml-cpp.tar.gz
