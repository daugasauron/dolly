DOLLY 8
PACKAGE libjpeg-turbo
REQUIRES HOST runtime@0

# libjpeg-turbo from upstream's release archive, unchanged, built by its CMake
# project without its SIMD code, which is x86's and Arm's: the libjpeg API,
# for programs the cc package builds. Its licence asks for README.ijg beside
# a program that links it.
FROM /demos/cmake/Dollyfile-cmake-build ec172ae8a3b79bf8dcf9ea2b9c070699dcf05b337ea738e2b6657bb1d0fb7004
REQUIRES HEADER libc
REQUIRES TOOL cmake
REQUIRES TOOL gzip
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/libjpeg-turbo/source.tar.gz 537d788e556d0f394b8f41cc5b7458fa64b2a4e02caa60ade20da7acbb81ce61 /tmp/libjpeg-turbo.tar.gz
SLOP gzip -dc /tmp/libjpeg-turbo.tar.gz | tar -xf - -C /
SLOP cmake -S /tmp/libjpeg-turbo -B /tmp/libjpeg-turbo-build -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
  -DENABLE_SHARED=OFF -DENABLE_STATIC=ON -DWITH_SIMD=OFF -DWITH_TURBOJPEG=OFF
SLOP cmake --build /tmp/libjpeg-turbo-build -j4
SLOP cmake --install /tmp/libjpeg-turbo-build

EXPORTS LIB    jpeg     /usr/lib/libjpeg.a
EXPORTS HEADER jpeglib  /usr/include/jpeglib.h
EXPORTS HEADER jconfig  /usr/include/jconfig.h
EXPORTS HEADER jmorecfg /usr/include/jmorecfg.h
EXPORTS HEADER jerror   /usr/include/jerror.h
FILE /usr/lib/pkgconfig/libjpeg.pc
FOLDER /usr/share/licenses/libjpeg-turbo
SLOP rm -rf /tmp/libjpeg-turbo /tmp/libjpeg-turbo-build /tmp/libjpeg-turbo.tar.gz
