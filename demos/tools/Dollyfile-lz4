DOLLY 7
PACKAGE lz4
REQUIRES HOST runtime@0

# LZ4 from the files of upstream's release archive, unchanged: lz4 and liblz4,
# with the files and flags of upstream's Makefiles for one thread (a -pthread
# program would need threads@0). unlz4 and lz4cat are lz4 under the names it
# looks for. The library is BSD-licensed and the program GPL-2.0-or-later.
FROM /v0.1.4/demos/tools/Dollyfile-tools-build 1d9feaa3a6b68adbbb30d01024fa370ccd4537da9e45183309ea2b86ca7a46cc

REQUIRES HEADER libc
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   cmp
REQUIRES TOOL   cp
REQUIRES TOOL   gzip
REQUIRES TOOL   ln
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   mv
REQUIRES TOOL   tar
REQUIRES TOOL   text-page

SOURCE /v0.1.4/dist/static/tools/lz4-1.10.0.tar.gz 537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b /tmp/lz4.tar.gz
SLOP gzip -dc /tmp/lz4.tar.gz | tar -xf - -C /tmp && mv /tmp/lz4-1.10.0 /tmp/lz4

FILE /tmp/lz4.mk
    .RECIPEPREFIX := >
    S := /tmp/lz4
    BIN := /usr/bin
    LIB := /usr/lib
    LIBRARY := $(wildcard $S/lib/*.c)
    PROGRAM := $(wildcard $S/programs/*.c)
    all: $(BIN)/lz4
    $S/%.o: $S/%.c
    >cc -O2 -I $S/lib -DXXH_NAMESPACE=LZ4_ -c $< -o $@
    $(LIB)/liblz4.a: $(LIBRARY:.c=.o)
    >ar rcs $@ $^
    $(BIN)/lz4: $(PROGRAM:.c=.o) $(LIB)/liblz4.a
    >cc $^ -o $@
SLOP make -j4 -f /tmp/lz4.mk
SLOP ln -s lz4 /usr/bin/unlz4
SLOP ln -s lz4 /usr/bin/lz4cat
SLOP cp /tmp/lz4/lib/lz4.h /tmp/lz4/lib/lz4hc.h /tmp/lz4/lib/lz4frame.h /usr/include
SLOP mkdir -p /usr/share/licenses/lz4 && cp /tmp/lz4/LICENSE /usr/share/licenses/lz4/LICENSE && cp /tmp/lz4/lib/LICENSE /usr/share/licenses/lz4/lib-LICENSE && cp /tmp/lz4/programs/COPYING /usr/share/licenses/lz4/programs-COPYING

SLOP lz4 -9 -c /tmp/lz4/lib/lz4.h | unlz4 | cmp - /tmp/lz4/lib/lz4.h
SLOP lz4 -q /tmp/lz4/lib/lz4.h /tmp/lz4-check.lz4 && lz4cat /tmp/lz4-check.lz4 | cmp - /tmp/lz4/lib/lz4.h

EXPORTS TOOL   lz4
EXPORTS TOOL   unlz4
EXPORTS TOOL   lz4cat
EXPORTS LIB    lz4      /usr/lib/liblz4.a
EXPORTS HEADER lz4      /usr/include/lz4.h
EXPORTS HEADER lz4hc    /usr/include/lz4hc.h
EXPORTS HEADER lz4frame /usr/include/lz4frame.h
FILE /usr/share/licenses/lz4/LICENSE
FILE /usr/share/licenses/lz4/lib-LICENSE
FILE /usr/share/licenses/lz4/programs-COPYING
SLOP text-page /tmp/lz4/programs/lz4.1
FILE /usr/share/man/cat1/lz4.1
