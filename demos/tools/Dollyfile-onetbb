DOLLY 8
PACKAGE onetbb
REQUIRES HOST runtime@0
REQUIRES HOST threads@0

# oneTBB, Intel's Threading Building Blocks: parallel algorithms, flow graphs
# and concurrent containers over a pool of threads, from upstream's release
# archive, unchanged, built by its CMake project, for programs the cc package
# builds with -pthread, on threads@0: the tbb library without hwloc and
# without its allocator. ccfilter drops the -fstack-protector-strong it gives
# Clang.
FROM /demos/cmake/Dollyfile-cmake-build ef925b15c0342d66937cb491e956474f5dbb37d60cb2063e6e7ec91e0cb85d71
USE /demos/tools/Dollyfile-ccfilter c0b143cfbb34f61ceae68b2ed62b8bf93f55385c1567b688b50ba02bc72b3ded
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES TOOL ccfilter
REQUIRES TOOL cmake
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/onetbb/source.tar.gz 84e89d1c131052a5950736f53b6e3c84d8aae83aaaa65647f7681b8461e98a1f /tmp/onetbb.tar.gz
SLOP gzip -dc /tmp/onetbb.tar.gz | tar -xf - -C /
SLOP cmake -S /tmp/onetbb -B /tmp/onetbb-build -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
  -DCMAKE_C_FLAGS=-pthread -DCMAKE_CXX_FLAGS=-pthread -DCMAKE_C_COMPILER_LAUNCHER=/usr/bin/ccfilter \
  -DCMAKE_CXX_COMPILER_LAUNCHER=/usr/bin/ccfilter -DTBB_TEST=OFF -DTBBMALLOC_BUILD=OFF -DTBB_STRICT=OFF \
  -DTBB_DISABLE_HWLOC_AUTOMATIC_SEARCH=ON -DTBB_EXAMPLES=OFF
SLOP cmake --build /tmp/onetbb-build -j4
SLOP cmake --install /tmp/onetbb-build

EXPORTS LIB    tbb       /usr/lib/libtbb.a
EXPORTS HEADER tbb       /usr/include/tbb
EXPORTS HEADER oneapi    /usr/include/oneapi
EXPORTS FOLDER tbb-cmake /usr/lib/cmake/TBB
FILE /usr/lib/pkgconfig/tbb.pc
FOLDER /usr/share/licenses/onetbb
SLOP rm -rf /tmp/onetbb /tmp/onetbb-build /tmp/onetbb.tar.gz
