DOLLY 7
PACKAGE vi
REQUIRES HOST runtime@0

# Neatvi, a small vi and ex, from the files of upstream's tagged archive,
# unchanged, by the rules of its Makefile. It draws with escape sequences of
# its own and reads no terminal database. Its ! commands and language servers
# start by fork, which fails here, and it says so.
FROM /v0.1.4/Dollyfile-system-tools 3613905f318bbbacafd3292203f8771298d53c02c2509eed45b7d803b54c3cbf

REQUIRES HEADER libc
REQUIRES TOOL   cc
REQUIRES TOOL   cp
REQUIRES TOOL   gzip
REQUIRES TOOL   ln
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   mv
REQUIRES TOOL   printf
REQUIRES TOOL   sed
REQUIRES TOOL   tar
REQUIRES TOOL   test

SOURCE /v0.1.4/dist/static/tools/neatvi-20.tar.gz e1d9a89d770aa5bb60da472be1a526eb1d99be9267c4d6067fc625f10efc8fe5 /tmp/neatvi.tar.gz
SLOP gzip -dc /tmp/neatvi.tar.gz | tar -xf - -C /tmp && mv /tmp/neatvi-20 /tmp/neatvi

# Neatvi leaves it to the terminal to turn Enter, a carriage return, into a
# newline (ICRNL). Dolly's terminal maps no input, so term.c reads through this.
FILE /tmp/neatvi/enter.h
    #include <unistd.h>
    static ssize_t read_enter(int fd, void *bytes, size_t size) {
      ssize_t count = read(fd, bytes, size);
      for (ssize_t at = 0; at < count; at++) {
        if (((char *)bytes)[at] == '\r') ((char *)bytes)[at] = '\n';
      }
      return count;
    }
    #define read read_enter
FILE /tmp/vi.mk
    .RECIPEPREFIX := >
    S := /tmp/neatvi
    BIN := /usr/bin
    NAMES := vi ex lbuf mot sbuf ren dir syn reg led uc term rset rstr regex cmd tag conf lsp json
    $(BIN)/vi: $(addprefix $S/,$(addsuffix .o,$(NAMES)))
    >cc $^ -o $@
    $S/term.o: CFLAGS := -include $S/enter.h
    $S/%.o: $S/%.c $S/vi.h $S/conf.h $S/kmap.h
    >cc -O2 $(CFLAGS) -c $< -o $@
SLOP make -j4 -f /tmp/vi.mk
SLOP ln -s vi /usr/bin/ex
# Neatvi ships no licence file or manual page: its sources open with the
# licence, and its README is the manual.
SLOP mkdir -p /usr/share/licenses/vi
SLOP sed -n 2,16p /tmp/neatvi/vi.c > /usr/share/licenses/vi/LICENSE
SLOP mkdir -p /usr/share/doc/vi && cp /tmp/neatvi/README /usr/share/doc/vi/README

SLOP printf 'one\ntwo\n' > /tmp/vi-check && printf '%s\n' '%s/two/2/' 'w' 'q' | ex -s /tmp/vi-check > /dev/null && test "$(sed -n 2p /tmp/vi-check)" = 2

EXPORTS TOOL vi
EXPORTS TOOL ex
FILE /usr/share/licenses/vi/LICENSE
FILE /usr/share/doc/vi/README
FILE /usr/share/man/cat1/vi.1
    vi, ex: Neatvi, a small vi with an ex mode, from upstream's files unchanged.
    
      vi FILE...        edits the files
      ex FILE...        edits them in ex mode
      :wq writes and leaves; :q! leaves without writing.
    
    It draws with escape sequences of its own and needs no terminal database.
    What starts another program (:!, a filter through a command, a language
    server) needs fork, which Dolly does not have: it fails and says so.
    Upstream's README lists the commands and options: /usr/share/doc/vi/README.
