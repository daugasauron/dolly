DOLLY 7
PACKAGE xz
REQUIRES HOST runtime@0

# XZ Utils from upstream's release archive, unchanged: the xz program and
# liblzma. unxz and xzcat are xz under the names it looks for.
FROM /v0.1.3/demos/tools/Dollyfile-tools-build 9850648c2874d3c986e2ef70f371106631b18def7b4ffa01ab56d9689c985dce

REQUIRES HEADER libc
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   cmp
REQUIRES TOOL   cp
REQUIRES TOOL   gzip
REQUIRES TOOL   ln
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   tar
REQUIRES TOOL   text-page

SOURCE /v0.1.3/dist/static/tools/xz-5.8.4.tar.gz 0014c7886930454fe8bd4228665b51af55eeae560ea135c9c4cd33f55b2591d9 /tmp/xz.tar.gz
SLOP gzip -dc /tmp/xz.tar.gz | tar -xf - -C /tmp

# Slop does not run upstream's configure, so this says what it would find
# here, as for --disable-threads --disable-nls: a -pthread liblzma would need
# threads@0 in every program that links it, and no message catalogue is
# installed. Every filter, check and match finder is built.
FILE /tmp/xz-5.8.4/config.h
    #define _GNU_SOURCE 1
    #define ASSUME_RAM 128
    #define HAVE_CHECK_CRC32 1
    #define HAVE_CHECK_CRC64 1
    #define HAVE_CHECK_SHA256 1
    #define HAVE_CLOCK_GETTIME 1
    #define HAVE_CLOCK_MONOTONIC 1
    #define HAVE_DECODERS 1
    #define HAVE_DECODER_ARM 1
    #define HAVE_DECODER_ARM64 1
    #define HAVE_DECODER_ARMTHUMB 1
    #define HAVE_DECODER_DELTA 1
    #define HAVE_DECODER_IA64 1
    #define HAVE_DECODER_LZMA1 1
    #define HAVE_DECODER_LZMA2 1
    #define HAVE_DECODER_POWERPC 1
    #define HAVE_DECODER_RISCV 1
    #define HAVE_DECODER_SPARC 1
    #define HAVE_DECODER_X86 1
    #define HAVE_ENCODERS 1
    #define HAVE_ENCODER_ARM 1
    #define HAVE_ENCODER_ARM64 1
    #define HAVE_ENCODER_ARMTHUMB 1
    #define HAVE_ENCODER_DELTA 1
    #define HAVE_ENCODER_IA64 1
    #define HAVE_ENCODER_LZMA1 1
    #define HAVE_ENCODER_LZMA2 1
    #define HAVE_ENCODER_POWERPC 1
    #define HAVE_ENCODER_RISCV 1
    #define HAVE_ENCODER_SPARC 1
    #define HAVE_ENCODER_X86 1
    #define HAVE_FUTIMENS 1
    #define HAVE_GETOPT_H 1
    #define HAVE_GETOPT_LONG 1
    #define HAVE_INTTYPES_H 1
    #define HAVE_LZIP_DECODER 1
    #define HAVE_MBRTOWC 1
    #define HAVE_MF_BT2 1
    #define HAVE_MF_BT3 1
    #define HAVE_MF_BT4 1
    #define HAVE_MF_HC3 1
    #define HAVE_MF_HC4 1
    #define HAVE_STDBOOL_H 1
    #define HAVE_STDINT_H 1
    #define HAVE_STDLIB_H 1
    #define HAVE_STRINGS_H 1
    #define HAVE_STRING_H 1
    #define HAVE_STRUCT_STAT_ST_ATIM_TV_NSEC 1
    #define HAVE_SYS_STAT_H 1
    #define HAVE_SYS_TYPES_H 1
    #define HAVE_UINTPTR_T 1
    #define HAVE_UNISTD_H 1
    #define HAVE_WCHAR_H 1
    #define HAVE_WCWIDTH 1
    #define HAVE___BUILTIN_ASSUME_ALIGNED 1
    #define HAVE___BUILTIN_BSWAPXX 1
    #define NDEBUG 1
    #define PACKAGE_BUGREPORT "xz@tukaani.org"
    #define PACKAGE_NAME "XZ Utils"
    #define PACKAGE_URL "https://tukaani.org/xz/"
    #define SIZEOF_SIZE_T 8
    #define STDC_HEADERS 1
    #define TUKLIB_PHYSMEM_SYSCONF 1
FILE /tmp/xz.mk
    .RECIPEPREFIX := >
    S := /tmp/xz-5.8.4
    BIN := /usr/bin
    LIB := /usr/lib
    L := $S/src/liblzma
    # Left out, as upstream's Makefiles do: the programs that generate its
    # tables, the small variants of the checks, and the threaded coders.
    LIBRARY := $(filter-out %_tablegen.c %_small.c %_gen.c %_mt.c %/outqueue.c %/hardware_cputhreads.c, \
      $(wildcard $(addprefix $L/,check/*.c common/*.c delta/*.c lz/*.c lzma/*.c rangecoder/*.c simple/*.c))) \
      $S/src/common/tuklib_physmem.c
    PROGRAM := $(wildcard $S/src/xz/*.c) $(addprefix $S/src/common/tuklib_,exit.c mbstr_fw.c \
      mbstr_nonprint.c mbstr_width.c mbstr_wrap.c open_stdxxx.c progname.c)
    CPPFLAGS := -DHAVE_CONFIG_H -I $S -I $S/src/common -I $L/api
    all: $(BIN)/xz
    # Upstream gives a Wasm target that is not Emscripten no call that masks
    # signals; here it is sigprocmask, as on every other Unix.
    $(PROGRAM:.c=.o): CPPFLAGS += -Dmythread_sigmask=sigprocmask
    $(LIBRARY:.c=.o): CPPFLAGS += -DTUKLIB_SYMBOL_PREFIX=lzma_ $(addprefix -I $L/,common check lz rangecoder lzma delta simple)
    $S/%.o: $S/%.c $S/config.h
    >cc -O2 $(CPPFLAGS) -c $< -o $@
    $(LIB)/liblzma.a: $(LIBRARY:.c=.o)
    >ar rcs $@ $^
    $(BIN)/xz: $(PROGRAM:.c=.o) $(LIB)/liblzma.a
    >cc $^ -o $@
SLOP make -j4 -f /tmp/xz.mk
SLOP ln -s xz /usr/bin/unxz
SLOP ln -s xz /usr/bin/xzcat
SLOP cp -r /tmp/xz-5.8.4/src/liblzma/api/lzma.h /tmp/xz-5.8.4/src/liblzma/api/lzma /usr/include
SLOP mkdir -p /usr/share/licenses/xz
SLOP cp /tmp/xz-5.8.4/COPYING /tmp/xz-5.8.4/COPYING.0BSD /usr/share/licenses/xz
SLOP text-page /tmp/xz-5.8.4/src/xz/xz.1

SLOP xz -9e -c /tmp/xz-5.8.4/NEWS | unxz | cmp - /tmp/xz-5.8.4/NEWS
SLOP xz -k /tmp/xz-5.8.4/NEWS && xz -t /tmp/xz-5.8.4/NEWS.xz && xzcat /tmp/xz-5.8.4/NEWS.xz | cmp - /tmp/xz-5.8.4/NEWS
# The archive's own test files, as its test suite reads them.
SLOP CWD /tmp/xz-5.8.4/tests/files xz -t good-1-check-sha256.xz good-1-lzma2-5.xz good-1-arm64-lzma2-1.xz good-1-delta-lzma2.tiff.xz
SLOP CWD /tmp/xz-5.8.4/tests/files ! xz -t bad-1-check-crc64.xz 2> /dev/null

EXPORTS TOOL   xz
EXPORTS TOOL   unxz
EXPORTS TOOL   xzcat
EXPORTS LIB    lzma /usr/lib/liblzma.a
EXPORTS HEADER lzma /usr/include/lzma.h
EXPORTS FOLDER lzma-headers /usr/include/lzma
FILE /usr/share/licenses/xz/COPYING
FILE /usr/share/licenses/xz/COPYING.0BSD
FILE /usr/share/man/cat1/xz.1
