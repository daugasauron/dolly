DOLLY 7
PACKAGE sbase
REQUIRES HOST runtime@0

# The sbase commands that posix leaves out and people type, unchanged, built
# by sbase's own Makefile from the archive system-tools builds its from.
FROM /v0.1.3/demos/tools/Dollyfile-tools-build 5da77d5197726f454cfb161eb1d73a4f7f62970355b03e603de8156fdd4cdf2e

REQUIRES HEADER libc
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   head
REQUIRES TOOL   make
REQUIRES TOOL   mv
REQUIRES TOOL   test
REQUIRES TOOL   wc
REQUIRES TOOL   text-page

SOURCE /v0.1.3/dist/static/default/sbase.tar c05c64631cbc8441a50785da447c129c0a4f07fa3c3a10a5355c0f1102d3b1cd /tmp/sbase.tar
SLOP tar -xf /tmp/sbase.tar -C /

FILE /tmp/sbase/dolly.mk
    TOOLS = cal cols sha1sum sha512sum sponge uudecode uuencode yes
    .RECIPEPREFIX := >
    dolly-bin: $(TOOLS)
    >mv $(TOOLS) /usr/bin
    .RECIPEPREFIX :=
    include Makefile
SLOP make -C /tmp/sbase -f dolly.mk CFLAGS=-O2 ARFLAGS=rc RANLIB=:
SLOP CWD /tmp/sbase text-page cal.1 cols.1 sha1sum.1 sha512sum.1 sponge.1 uudecode.1 uuencode.1 yes.1

SLOP test "$(yes | head -n 3 | wc -l)" -eq 3

EXPORTS TOOL cal
EXPORTS TOOL cols
EXPORTS TOOL sha1sum
EXPORTS TOOL sha512sum
EXPORTS TOOL sponge
EXPORTS TOOL uudecode
EXPORTS TOOL uuencode
EXPORTS TOOL yes
FILE /usr/share/licenses/sbase/LICENSE
FILE /usr/share/man/cat1/cal.1
FILE /usr/share/man/cat1/cols.1
FILE /usr/share/man/cat1/sha1sum.1
FILE /usr/share/man/cat1/sha512sum.1
FILE /usr/share/man/cat1/sponge.1
FILE /usr/share/man/cat1/uudecode.1
FILE /usr/share/man/cat1/uuencode.1
FILE /usr/share/man/cat1/yes.1
