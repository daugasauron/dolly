DOLLY 7
PACKAGE tar
REQUIRES HOST runtime@0

# sbase's tar, built by sbase's own Makefile from the archive system-tools
# builds its commands from. It writes archives and reads links, which the
# tar of the core package does not, and it takes that one's place: /bin
# comes first on PATH. Its -z, -j and -J start gzip, bzip2 or xz from PATH,
# by posix_spawn instead of fork (sbase-tar-spawn.patch), and tar waits for it:
# the three come with it.
FROM /v0.1.7/demos/tools/Dollyfile-tools-build dff97f79f90177d6145353fb86527a826d245d4bdd4474abea12aecbf91e6a00
INSTALL /v0.1.7/Dollyfile-gzip 299b32b99755fb7ded74d5d4eb26189852020daf234a165d8895880d637809fe
INSTALL /v0.1.7/demos/tools/Dollyfile-bzip2 03f64c157633cd6c9369a9ca0df4d28cc70654e57c9c9c38ea2449bd1e09e813
INSTALL /v0.1.7/demos/tools/Dollyfile-xz 3dfcc478ba04df1c2662c382b433c1a1b5f6d601c16325e197d22d497e70eb79

REQUIRES HEADER libc
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   cmp
REQUIRES TOOL   ln
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   mv
REQUIRES TOOL   patch
REQUIRES TOOL   readlink
REQUIRES TOOL   test
REQUIRES TOOL   text-page

SOURCE /v0.1.7/dist/static/default/sbase.tar 23daa7bd6d5169ba5ad4a9801fe039ba28b103e3dbb74583fccb48f3333253eb /tmp/sbase.tar
SOURCE /v0.1.7/dist/static/tools/sbase-tar-spawn.patch 3c7c19e521a33229eb18435f81af7f47160a03c97f61e3e6c508b41648487463 /tmp/sbase-tar-spawn.patch
SLOP tar -xf /tmp/sbase.tar -C /
SLOP patch -p1 -d /tmp/sbase -i /tmp/sbase-tar-spawn.patch

FILE /tmp/sbase/dolly.mk
    .RECIPEPREFIX := >
    dolly-bin: tar
    >mv tar /bin/tar
    .RECIPEPREFIX :=
    include Makefile
SLOP make -C /tmp/sbase -f dolly.mk CFLAGS=-O2 ARFLAGS=rc RANLIB=:
# Its page takes the place of the core's.
SLOP text-page /tmp/sbase/tar.1

FILE /tmp/tar-check/names
    in
    in/deep
    in/link
SLOP mkdir -p /tmp/tar-check/in/deep /tmp/tar-check/out && ln -s deep /tmp/tar-check/in/link
SLOP CWD /tmp/tar-check tar -cf in.tar in && tar -xf in.tar -C out && test "$(readlink out/in/link)" = deep
SLOP CWD /tmp/tar-check tar -cf - in | tar -tf - | cmp - /tmp/tar-check/names

EXPORTS TOOL tar
FILE /usr/share/licenses/sbase/LICENSE
FILE /usr/share/man/cat1/tar.1
