DOLLY 7
PACKAGE tar
REQUIRES HOST runtime@0

# sbase's tar, built by sbase's own Makefile from the archive system-tools
# builds its commands from. It writes archives and reads links and pax
# headers, which the tar of the core package does not, and it takes that
# one's place: /bin comes first on PATH. Its -z, -j and -J start gzip, bzip2
# or xz from PATH, by posix_spawn instead of fork (sbase-tar-spawn.patch),
# and tar waits for it. The gzip of the core reads .gz; pigz writes it.
FROM /v0.1.4/demos/tools/Dollyfile-tools-build a06ba71539d5dde74e6cbb4393108796429fc04d88e988073c0bfdfc8de60316

REQUIRES HEADER libc
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   cmp
REQUIRES TOOL   ln
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   mv
REQUIRES TOOL   patch
REQUIRES TOOL   readlink
REQUIRES TOOL   test
REQUIRES TOOL   text-page

SOURCE /v0.1.4/dist/static/default/sbase.tar 23daa7bd6d5169ba5ad4a9801fe039ba28b103e3dbb74583fccb48f3333253eb /tmp/sbase.tar
SOURCE /v0.1.4/dist/static/tools/sbase-tar-spawn.patch 3c7c19e521a33229eb18435f81af7f47160a03c97f61e3e6c508b41648487463 /tmp/sbase-tar-spawn.patch
SLOP tar -xf /tmp/sbase.tar -C /
SLOP patch -p1 -d /tmp/sbase -i /tmp/sbase-tar-spawn.patch

FILE /tmp/sbase/dolly.mk
    .RECIPEPREFIX := >
    dolly-bin: tar
    >mv tar /bin/tar
    .RECIPEPREFIX :=
    include Makefile
SLOP make -C /tmp/sbase -f dolly.mk CFLAGS=-O2 ARFLAGS=rc RANLIB=:
# Its page takes the place of the core's.
SLOP text-page /tmp/sbase/tar.1

FILE /tmp/tar-check/names
    in
    in/deep
    in/link
SLOP mkdir -p /tmp/tar-check/in/deep /tmp/tar-check/out && ln -s deep /tmp/tar-check/in/link
SLOP CWD /tmp/tar-check tar -cf in.tar in && tar -xf in.tar -C out && test "$(readlink out/in/link)" = deep
SLOP CWD /tmp/tar-check tar -cf - in | tar -tf - | cmp - /tmp/tar-check/names

EXPORTS TOOL tar
FILE /usr/share/licenses/sbase/LICENSE
FILE /usr/share/man/cat1/tar.1
