DOLLY 8
PACKAGE scons
REQUIRES HOST runtime@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST sockets@0
REQUIRES HOST threads@0

# SCons from the wheel PyPI publishes, installed by pip; Python runs it. Its base
# holds the C compiler it starts. The host modules are Python's.
FROM /Dollyfile-system 40cc3295c8b8b9cb65a54dad7383bc370977ab5c7de4d91fe26a24c89ae787cd
INSTALL /demos/python/Dollyfile-python d3c5640d46e8189cd090e530bf21a3fa5ec4190cbb55b2ca10a6997b8942ff2c
USE /Dollyfile-mandoc 47b9b5b34207eb0ea0afbf3c200c63af7c09d4fce2076a7333afb5a2d7c48ae0

REQUIRES TOOL cc
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL pip
REQUIRES TOOL text-page

SOURCE /dist/static/tools/scons-4.10.1-py3-none-any.whl bd9d1c52f908d874eba92a8c0c0a8dcf2ed9f3b88ab956d0fce1da479c4e7126 /tmp/scons-4.10.1-py3-none-any.whl
SLOP pip install --no-compile --no-index --no-deps /tmp/scons-4.10.1-py3-none-any.whl
SLOP mkdir -p /usr/share/licenses/scons
SLOP cp /usr/lib/python3.14/site-packages/scons-4.10.1.dist-info/licenses/LICENSE /usr/share/licenses/scons/LICENSE
# The page from SCons' source archive: the wheel has none.
SOURCE /dist/static/tools/scons.1 b6c0c5c9997d8dc70af5bf623df08a4d9091065ae6b4046cd17019d965c07cac /tmp/scons.1
SLOP text-page /tmp/scons.1

# SCons takes a program on PATH for a compiler only if its execute bit is set,
# and Dolly keeps none, so the SConstruct names it.
FILE /tmp/scons-check/SConstruct
    Environment(CC="cc").Program("check", "check.c")
FILE /tmp/scons-check/check.c
    int main(void) { return 0; }
SLOP CWD /tmp/scons-check scons -Q && ./check

EXPORTS TOOL scons
FOLDER /usr/lib/python3.14/site-packages/SCons
FOLDER /usr/lib/python3.14/site-packages/scons-4.10.1.dist-info
FILE /usr/share/licenses/scons/LICENSE
FILE /usr/share/man/cat1/scons.1
