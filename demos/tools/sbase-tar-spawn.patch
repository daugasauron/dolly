+/* The filter reads in and writes out; the end of the pipe tar keeps is not
+ * inherited. posix_spawn rather than fork, which some systems lack. */
+static void
+spawnfilter(const char *tool, const char *flags, int in, int out, int keep)
+{
+	extern char **environ;
+	char *argv[] = { (char *)tool, (char *)flags, NULL };
+	posix_spawn_file_actions_t fa;
+	int err;
+
+	if (fcntl(keep, F_SETFD, FD_CLOEXEC) < 0)
+		eprintf("fcntl:");
+	if ((err = posix_spawn_file_actions_init(&fa)) ||
+	    (err = posix_spawn_file_actions_adddup2(&fa, in, 0)) ||
+	    (err = posix_spawn_file_actions_adddup2(&fa, out, 1)) ||
+	    (err = posix_spawnp(&filterpid, tool, &fa, NULL, argv, environ))) {
+		errno = err;
+		eprintf("posix_spawnp %s:", tool);
+	}
+	posix_spawn_file_actions_destroy(&fa);
+}
