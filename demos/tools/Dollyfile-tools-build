# What the packages of this demo are built on: cmake-build, which is
# system-tools with the CMake that wabt needs, and mandoc. A package is built
# FROM it and keeps none of it, so the formatter serves the build and is no
# row of the package: nothing installs mandoc because a page was formatted
# with it. (COPY may not write under /tmp, so a package cannot borrow the
# formatter from another image for its build alone.)
FROM /v0.1.3/demos/cmake/Dollyfile-cmake-build 181addf84cf4a67a51858fe92f6738924560fc96dd64e563a60aef1f08605758
INSTALL /v0.1.3/demos/tools/Dollyfile-mandoc 6fcaa83e9c8865d3b21eaebace5fc262de12dbdf67a36b85772b089af22d4fc5

REQUIRES TOOL awk
REQUIRES TOOL basename
REQUIRES TOOL grep
REQUIRES TOOL mandoc
REQUIRES TOOL rm
REQUIRES TOOL test

# man prints /usr/share/man/cat1/NAME.1 as it is, before the page of macros
# in man1. mandoc marks bold and underlined text by overstriking; a reader
# without a pager, an agent among them, wants the words alone.
FILE /usr/bin/text-page
    #!/bin/slop
    # text-page PAGE...: each manual page as plain text in /usr/share/man/cat1.
    for page in "$@"; do
      text="/usr/share/man/cat1/$(basename "$page")"
      mandoc -T utf8 "$page" | LC_ALL=C.UTF-8 awk '{ gsub(/.\b/, ""); print }' > "$text"
      test -s "$text" || exit 1
    done
EXPORTS TOOL text-page

# A letter outside ASCII loses its overstrike whole.
FILE /tmp/text-page-check.1
    .TH CHECK 1
    .SH NAME
    check \- caf\['e]
    .SH DESCRIPTION
    \fBcaf\['e]\fR
SLOP text-page /tmp/text-page-check.1 && grep -c 'café' /usr/share/man/cat1/text-page-check.1 | grep -qx 2
SLOP rm /usr/share/man/cat1/text-page-check.1

ENTRY /bin/foreground -i /bin/slop
