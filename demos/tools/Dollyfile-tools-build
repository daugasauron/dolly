# What the packages of this demo are built on: cmake-build, which is
# system-tools with the CMake that wabt needs, and mandoc with its text-page,
# which formats upstream's manual pages as text. A package is built FROM it
# and keeps none of it, so the formatter serves the build and is no row of
# the package: nothing installs mandoc because a page was formatted with it.
# (COPY may not write under /tmp, so a package cannot borrow the formatter
# from another image for its build alone.)
FROM /v0.1.4/demos/cmake/Dollyfile-cmake-build b2e30c5983992408ee2eae25d47d6cd4230fbef9c3ca5d8bb418ddba886c00e6
INSTALL /v0.1.4/Dollyfile-mandoc f507627be7e51e3189832985b0be0971d94cb506f32f6534b15442b668242eb1

REQUIRES TOOL mandoc
REQUIRES TOOL text-page

ENTRY /bin/foreground -i /bin/slop
