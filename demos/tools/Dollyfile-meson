DOLLY 7
PACKAGE meson
REQUIRES HOST runtime@0
REQUIRES HOST dso@0
REQUIRES HOST http@0
REQUIRES HOST sockets@0

# Meson from the wheel PyPI publishes, installed by pip. Python runs it, meson
# setup starts the C compiler and meson compile starts Ninja, so those three
# packages come with it; the host modules are the ones Python declares.
FROM /v0.1.4/demos/tools/Dollyfile-tools-build 1b5a19627d633f3b27db1017b698ce63936df8f97d4ec8aaa7f2de0e11d3b390
INSTALL /v0.1.4/demos/python/Dollyfile-python 6db9f56d9fdbed63641cf4ee6aa6eed76d964e835d6c011e098d2cbdfc4db7ee
INSTALL /v0.1.4/Dollyfile-cc f2ad329c95b14b45404c070414c0e48330c769adb810501ae1e122b326d8117f
INSTALL /v0.1.4/Dollyfile-ninja dc55100a2238e897ee7b64661e37e0857f68d8c807e1befd433fb8fa1332913b

REQUIRES TOOL cc
REQUIRES TOOL cp
REQUIRES TOOL mkdir
REQUIRES TOOL ninja
REQUIRES TOOL pip
REQUIRES TOOL text-page

SOURCE /v0.1.4/dist/static/tools/meson-1.12.1-py3-none-any.whl 930bc7542cbd9f57009e182fd014eba48cf1a0180a7b9006d2d32d8f168d8b02 /tmp/meson-1.12.1-py3-none-any.whl
SLOP pip install --no-compile --no-index --no-deps /tmp/meson-1.12.1-py3-none-any.whl
SLOP mkdir -p /usr/share/licenses/meson
SLOP cp /usr/lib/python3.14/site-packages/meson-1.12.1.dist-info/licenses/COPYING /usr/share/licenses/meson/COPYING

FILE /tmp/meson-check/meson.build
    project('check', 'c')
    executable('check', 'check.c')
FILE /tmp/meson-check/check.c
    int main(void) { return 0; }
SLOP CWD /tmp/meson-check meson setup build && meson compile -C build && build/check

EXPORTS TOOL meson
FOLDER /usr/lib/python3.14/site-packages/mesonbuild
FOLDER /usr/lib/python3.14/site-packages/meson-1.12.1.dist-info
FILE /usr/share/licenses/meson/COPYING
SLOP text-page /usr/share/man/man1/meson.1
FILE /usr/share/man/cat1/meson.1
