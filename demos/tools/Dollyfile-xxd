DOLLY 7
PACKAGE xxd
REQUIRES HOST runtime@0

# xxd, the hex dump Vim ships, from Vim's tagged source, unchanged: one file
# and its manual page.
FROM /v0.1.3/demos/tools/Dollyfile-tools-build 5da77d5197726f454cfb161eb1d73a4f7f62970355b03e603de8156fdd4cdf2e

REQUIRES HEADER libc
REQUIRES TOOL   cc
REQUIRES TOOL   echo
REQUIRES TOOL   grep
REQUIRES TOOL   mkdir
REQUIRES TOOL   sed
REQUIRES TOOL   test
REQUIRES TOOL   text-page

SOURCE /v0.1.3/dist/static/tools/xxd.c f4f9812f9b83651e30040c83bd722651cc4656eb95b86a852edd1cd60e9b2fcd /tmp/xxd.c
SOURCE /v0.1.3/dist/static/tools/xxd.1 ab329ce79d69f86007ace6040d5915fc3453368ba0568bed8a944f9e5bd02ae5 /tmp/xxd.1
SLOP cc -O2 /tmp/xxd.c -o /usr/bin/xxd
# xxd ships no licence file: its source says under which it is used.
SLOP mkdir -p /usr/share/licenses/xxd
SLOP sed -n 81,86p /tmp/xxd.c > /usr/share/licenses/xxd/LICENSE

SLOP test "$(echo hello | xxd -p)" = 68656c6c6f0a && echo 68656c6c6f0a | xxd -r -p | grep -qx hello

EXPORTS TOOL xxd
FILE /usr/share/licenses/xxd/LICENSE
SLOP text-page /tmp/xxd.1
FILE /usr/share/man/cat1/xxd.1
