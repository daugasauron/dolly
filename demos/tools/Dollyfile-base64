DOLLY 7
PACKAGE base64
REQUIRES HOST runtime@0

# base64 by Alfred Klomp from the files of upstream's tagged archive,
# unchanged: the base64 program and libbase64, by the rules of its Makefile
# with none of the codecs written for x86 and ARM vector instructions.
FROM /v0.1.4/Dollyfile-system-tools d05eab32629208de16683f7ae4e2490501bcd220bf6ffd5ad9b9494d28ac6c6b

REQUIRES HEADER libc
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   cp
REQUIRES TOOL   echo
REQUIRES TOOL   gzip
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   mv
REQUIRES TOOL   tar
REQUIRES TOOL   test

SOURCE /v0.1.4/dist/static/tools/base64-0.5.2.tar.gz 723a0f9f4cf44cf79e97bcc315ec8f85e52eb104c8882942c3f2fba95acc080d /tmp/base64.tar.gz
SLOP gzip -dc /tmp/base64.tar.gz | tar -xf - -C /tmp && mv /tmp/base64-0.5.2 /tmp/base64

# As upstream's Makefile writes it when no codec is asked for.
FILE /tmp/base64/lib/config.h
    #define HAVE_AVX512 0
    #define HAVE_AVX2   0
    #define HAVE_NEON32 0
    #define HAVE_NEON64 0
    #define HAVE_SSSE3  0
    #define HAVE_SSE41  0
    #define HAVE_SSE42  0
    #define HAVE_AVX    0
FILE /tmp/base64.mk
    .RECIPEPREFIX := >
    S := /tmp/base64
    BIN := /usr/bin
    LIB := /usr/lib
    LIBRARY := $(wildcard $S/lib/arch/*/codec.c) $(addprefix $S/lib/,lib.c codec_choose.c tables/tables.c)
    all: $(BIN)/base64
    $S/%.o: $S/%.c $S/lib/config.h
    >cc -std=c99 -O2 -DBASE64_STATIC_DEFINE -I $S/lib -c $< -o $@
    $(LIB)/libbase64.a: $(LIBRARY:.c=.o)
    >ar rcs $@ $^
    $(BIN)/base64: $S/bin/base64.o $(LIB)/libbase64.a
    >cc $^ -o $@
SLOP make -j4 -f /tmp/base64.mk
SLOP cp /tmp/base64/include/libbase64.h /usr/include/libbase64.h
SLOP mkdir -p /usr/share/licenses/base64 && cp /tmp/base64/LICENSE /usr/share/licenses/base64/LICENSE

SLOP test "$(echo packed | base64)" = cGFja2VkCg== && test "$(echo cGFja2VkCg== | base64 -d)" = packed

EXPORTS TOOL   base64
EXPORTS LIB    base64    /usr/lib/libbase64.a
EXPORTS HEADER libbase64 /usr/include/libbase64.h
FILE /usr/share/licenses/base64/LICENSE
FILE /usr/share/man/cat1/base64.1
    base64: encode a file as Base64 on standard output, or decode one
    (Alfred Klomp's base64, with the plain C codec only).
    
      base64 [-w COLS] [FILE]   encodes, wrapping lines at COLS (76; 0: none)
      base64 -d [FILE]          decodes
      base64 --help             prints the options
    
    Without FILE, or with -, it reads standard input. The library it is built
    on is installed too: /usr/lib/libbase64.a and /usr/include/libbase64.h, for
    programs the cc package builds.
