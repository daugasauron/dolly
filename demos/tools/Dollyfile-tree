DOLLY 7
PACKAGE tree
REQUIRES HOST runtime@0

# tree from the files of upstream's release archive, unchanged, by the rules of its
# Makefile; the paths it keeps for Linux alone are not taken.
FROM /v0.1.4/demos/tools/Dollyfile-tools-build c2aac78c57371b7f5f352732bc83906d58a4aaac57597c7c5cfd60624a94e62d

REQUIRES HEADER libc
REQUIRES TOOL   cc
REQUIRES TOOL   cp
REQUIRES TOOL   gzip
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   mv
REQUIRES TOOL   tar
REQUIRES TOOL   test
REQUIRES TOOL   wc
REQUIRES TOOL   text-page

SOURCE /v0.1.4/dist/static/tools/unix-tree-2.3.2.tar.gz 513a53cbc42ca1f4ea06af2bab1f5283524a3848266b1d162416f8033afc4985 /tmp/tree.tar.gz
SLOP gzip -dc /tmp/tree.tar.gz | tar -xf - -C /tmp && mv /tmp/unix-tree-2.3.2 /tmp/tree

FILE /tmp/tree.mk
    .RECIPEPREFIX := >
    S := /tmp/tree
    BIN := /usr/bin
    NAMES := color file filter hash html info json list tree unix util xml strverscmp
    $(BIN)/tree: $(addprefix $S/,$(addsuffix .o,$(NAMES)))
    >cc $^ -o $@
    $S/%.o: $S/%.c $S/tree.h
    >cc -O2 -std=c11 -DLARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -c $< -o $@
SLOP make -j4 -f /tmp/tree.mk
SLOP mkdir -p /usr/share/licenses/tree && cp /tmp/tree/LICENSE /usr/share/licenses/tree/LICENSE

SLOP mkdir -p /tmp/tree-check/a/b && test "$(tree -dn --noreport /tmp/tree-check | wc -l)" = 3

EXPORTS TOOL tree
FILE /usr/share/licenses/tree/LICENSE
SLOP text-page /tmp/tree/doc/tree.1
FILE /usr/share/man/cat1/tree.1
