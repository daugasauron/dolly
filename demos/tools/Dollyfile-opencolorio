DOLLY 8
PACKAGE opencolorio
REQUIRES HOST runtime@0
REQUIRES HOST threads@0

# OpenColorIO, colour management for film and graphics, from upstream's release
# archive, unchanged, built by its CMake project over the expat, yaml-cpp,
# pystring, minizip-ng and Imath packages, for programs the cc package builds:
# its library, without its programs, Python, GPU tests or SIMD. Compiled with
# -pthread: a program links it so, on threads@0.
FROM /demos/cmake/Dollyfile-cmake-build ec172ae8a3b79bf8dcf9ea2b9c070699dcf05b337ea738e2b6657bb1d0fb7004
INSTALL /demos/tools/Dollyfile-expat bf3ca3446b50262dfd379d7c41b8fe564f8220cb7b18adc7e1c99ea60d91c24b
INSTALL /demos/tools/Dollyfile-yaml-cpp 9fe3e228a69f7039db6353cbe3c5239583f3d8839e8dbf0e5bfff7fd0114c9dc
INSTALL /demos/tools/Dollyfile-pystring 3759273459441408246a38262ebd8c88c2db88e9b3bae1ee462a0db0efb01a63
INSTALL /demos/tools/Dollyfile-minizip-ng baaddc0c90736dfd44137f2a09a5493473161e4fc85064933ec2765ff94f35c5
INSTALL /demos/tools/Dollyfile-imath 16ed3e4e2900195d8f2ea5c291c0069f1544bee6db0b91370f80d0fc4d5caf2c
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES LIB expat
REQUIRES LIB yaml-cpp
REQUIRES LIB pystring
REQUIRES LIB minizip
REQUIRES LIB Imath
REQUIRES TOOL cmake
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/opencolorio/source.tar.gz 209a8529d4a36bfcfa1bc8de934f11d1489760749b0541271d6f854afe82176a /tmp/opencolorio.tar.gz
SLOP gzip -dc /tmp/opencolorio.tar.gz | tar -xf - -C /
SLOP cmake -S /tmp/opencolorio -B /tmp/opencolorio-build -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_C_FLAGS=-pthread -DCMAKE_CXX_FLAGS=-pthread -DOCIO_BUILD_APPS=OFF \
  -DOCIO_BUILD_PYTHON=OFF -DOCIO_BUILD_NUKE=OFF -DOCIO_BUILD_JAVA=OFF -DOCIO_BUILD_DOCS=OFF -DOCIO_BUILD_TESTS=OFF \
  -DOCIO_BUILD_GPU_TESTS=OFF -DOCIO_USE_SIMD=OFF -DOCIO_INSTALL_EXT_PACKAGES=NONE -Dyaml-cpp_VERSION=0.8.0
SLOP cmake --build /tmp/opencolorio-build -j4
SLOP cmake --install /tmp/opencolorio-build

EXPORTS LIB    OpenColorIO       /usr/lib/libOpenColorIO.a
EXPORTS HEADER OpenColorIO       /usr/include/OpenColorIO
EXPORTS FOLDER opencolorio-cmake /usr/lib/cmake/OpenColorIO
# The find modules OpenColorIO's CMake package locates its static libraries with.
FOLDER /usr/share/OpenColorIO
FILE /usr/lib/pkgconfig/OpenColorIO.pc
FOLDER /usr/share/licenses/opencolorio
SLOP rm -rf /tmp/opencolorio /tmp/opencolorio-build /tmp/opencolorio.tar.gz
