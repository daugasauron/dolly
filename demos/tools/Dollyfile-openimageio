DOLLY 8
PACKAGE openimageio
REQUIRES HOST runtime@0
REQUIRES HOST threads@0

# OpenImageIO, which reads, writes and processes the images of film and
# graphics, from upstream's release archive with openimageio-dolly.patch
# (Dolly beside Emscripten in its lists of systems, WebAssembly's int64_t, and
# ustring's plain path for this libc++), built by its CMake project over the
# OpenEXR, libtiff, libjpeg-turbo, libpng, pugixml, {fmt} and OpenColorIO
# packages: its libraries and its programs (oiiotool, iinfo, iconvert, idiff, igrep, maketx,
# testtex) with -pthread, on threads@0. No TBB, FreeType, video, camera raw,
# HEIF, WebP, GIF, JPEG 2000 or OpenGL.
FROM /demos/cmake/Dollyfile-cmake-build ec172ae8a3b79bf8dcf9ea2b9c070699dcf05b337ea738e2b6657bb1d0fb7004
INSTALL /demos/tools/Dollyfile-openexr 2ff9d6d3cf79d6e87f5d23d831ef02c7564f7f5734ba9acb466a929d38221070
INSTALL /demos/tools/Dollyfile-libtiff 4a75a029e6d17819b84a7c43811d8857bb35d0cbfbffa5eaec272e6e981f6001
INSTALL /demos/tools/Dollyfile-libpng 1819c51ce77b670220ddd0297212c2ce3c7575fda5712173cc65642656f194ac
INSTALL /demos/tools/Dollyfile-pugixml c8488c8597d5ef41a7dc3df59c23b7f0762549978a420ead0b452b517fd20bdb
INSTALL /demos/tools/Dollyfile-fmt 99497886647d758ab09efd99bb518614ce57c30e7ce15c144a3a13eaec825723
INSTALL /demos/tools/Dollyfile-opencolorio 360838ca8830eba5e8c3723a919f2f93e0be33e07482f639990733c010e5ef2f
USE /demos/tools/Dollyfile-robin-map 0f4259b415ac58885804731a89a7c10f3220b68d0424f3a7f284f045a400ebb6
REQUIRES HEADER libc
REQUIRES HEADER cpp
REQUIRES HEADER tsl
REQUIRES LIB OpenEXR
REQUIRES LIB tiff
REQUIRES LIB jpeg
REQUIRES LIB png16
REQUIRES LIB pugixml
REQUIRES LIB fmt
REQUIRES LIB OpenColorIO
REQUIRES TOOL cmake
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL patch
REQUIRES TOOL rm
REQUIRES TOOL tar
REQUIRES TOOL test

SOURCE /dist/static/openimageio/source.tar.gz 998905e686d2bbda1d020d525621a9b99a55466f447d02f08cc3b5abc4ff546b /tmp/openimageio.tar.gz
SOURCE /dist/static/openimageio/openimageio-dolly.patch 381fafeeb5a5e9dd9125b748f55247ac1b30a8a9f870cb274c9b114e3bec7994 /tmp/openimageio-dolly.patch
SLOP gzip -dc /tmp/openimageio.tar.gz | tar -xf - -C /
SLOP patch -p1 -d /tmp/openimageio -i /tmp/openimageio-dolly.patch
SLOP cmake -S /tmp/openimageio -B /tmp/openimageio-build -DCMAKE_SYSTEM_NAME=Dolly -DCMAKE_SYSTEM_PROCESSOR=wasm64 \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_C_FLAGS=-pthread -DCMAKE_CXX_FLAGS=-pthread \
  -DUSE_PYTHON=OFF -DOIIO_BUILD_TOOLS=ON -DOIIO_BUILD_TESTS=OFF -DBUILD_TESTING=OFF -DBUILD_DOCS=OFF \
  -DINSTALL_DOCS=OFF -DSTOP_ON_WARNING=OFF -DLINKSTATIC=ON -DUSE_EXTERNAL_PUGIXML=ON -DUSE_TBB=OFF \
  -DUSE_FREETYPE=OFF -DUSE_QT=OFF -DUSE_OPENCV=OFF -DUSE_FFMPEG=OFF -DUSE_NUKE=OFF -DUSE_OPENVDB=OFF \
  -DUSE_GIF=OFF -DUSE_LIBRAW=OFF -DUSE_LIBHEIF=OFF -DUSE_PTEX=OFF -DUSE_WEBP=OFF -DUSE_OPENJPEG=OFF \
  -DUSE_JXL=OFF -DUSE_DCMTK=OFF -DUSE_R3DSDK=OFF -DUSE_OPENGL=OFF -DOpenImageIO_BUILD_MISSING_DEPS=none
SLOP cmake --build /tmp/openimageio-build -j4
SLOP cmake --install /tmp/openimageio-build

EXPORTS LIB    OpenImageIO       /usr/lib/libOpenImageIO.a
EXPORTS LIB    OpenImageIO_Util  /usr/lib/libOpenImageIO_Util.a
EXPORTS HEADER OpenImageIO       /usr/include/OpenImageIO
EXPORTS FOLDER openimageio-cmake /usr/lib/cmake/OpenImageIO
EXPORTS TOOL oiiotool
EXPORTS TOOL iconvert
EXPORTS TOOL idiff
EXPORTS TOOL igrep
EXPORTS TOOL iinfo
EXPORTS TOOL maketx
EXPORTS TOOL testtex
