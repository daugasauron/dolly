--- a/bytecomp/bytelink.ml
+++ b/bytecomp/bytelink.ml
@@ -894,9 +894,23 @@
   remove_file prims_obj;
   result
 
+(* A WebAssembly module ends at its last section: there the bytecode follows
+   as a custom section, so that the module stays valid, its trailer last. *)
 let append_bytecode bytecode_name exec_name =
+  let wasm =
+    In_channel.with_open_bin exec_name (fun ic ->
+      In_channel.really_input_string ic 4 = Some "\000asm") in
   let oc = open_out_gen [Open_wronly; Open_append; Open_binary] 0 exec_name in
   let ic = open_in_bin bytecode_name in
+  if wasm then begin
+    let rec output_leb128 n =
+      if n < 0x80 then output_byte oc n
+      else (output_byte oc (n land 0x7f lor 0x80); output_leb128 (n lsr 7)) in
+    output_byte oc 0;
+    output_leb128 (1 + String.length "ocaml" + in_channel_length ic);
+    output_byte oc (String.length "ocaml");
+    output_string oc "ocaml"
+  end;
   copy_file ic oc;
   close_in ic;
   close_out oc
