DOLLY 7
PACKAGE ocaml
REQUIRES HOST runtime@0
REQUIRES HOST threads@0

# OCaml 5.5 from upstream's release, as bytecode: OCaml has no native code
# generator for WebAssembly. configure runs outside, in the pinned Emscripten
# container (prepare-ocaml.sh), and the runtime is patched for Dolly
# (ocaml-dolly.patch). Dolly compiles the runtime, and upstream's boot/ocamlc
# builds the compiler, the libraries and the tools; then the compiler builds
# itself until it reproduces itself. The runtime runs OCaml 5's domains on
# Dolly's threads.
FROM /v0.1.4/demos/tools/Dollyfile-tools-build 2004dd4cb4a2df45e3b2c58ae132da598669e6f4bf2e2b9048df69156efaeb4d
# A program with C stubs (unix, str, threads) links its runtime with cc.
INSTALL /v0.1.4/Dollyfile-cc 08e8f5c6878cfb8325fd565c38e002025da8fd8794e8255f70406efff20858e2

REQUIRES HEADER libc
REQUIRES TOOL   cc
REQUIRES TOOL   cmp
REQUIRES TOOL   gzip
REQUIRES TOOL   install
REQUIRES TOOL   make
REQUIRES TOOL   tar
REQUIRES TOOL   text-page

SOURCE /v0.1.4/dist/static/ocaml/ocaml.tar.gz 3da108d0a18904cff5e8f23b76ec506377899fde60ec8bd3f61b1817d7f53299 /tmp/ocaml.tar.gz
SLOP gzip -dc /tmp/ocaml.tar.gz | tar -xf - -C /
SLOP CWD /tmp/ocaml make -j4 world
# Upstream's fixpoint: the compiler that boot/ocamlc built compiles itself,
# and that compiler again; make fails unless the last two compilers and
# lexers are the same bytes ("Fixpoint reached, bootstrap succeeded.").
SLOP CWD /tmp/ocaml make -j4 bootstrap
SLOP CWD /tmp/ocaml make install

# The toplevel runs a script; ocamlc links a program with unix and str (a
# custom runtime, which carries the bytecode in a custom section) that spawns
# a command through a pipe, and one that runs a domain and a thread.
FILE /tmp/ocaml-check/answer.ml
    print_int (List.fold_left ( + ) 0 [20; 22])
FILE /tmp/ocaml-check/words.ml
    let () =
      let input, output = Unix.pipe () in
      let pid = Unix.create_process "echo" [| "echo"; "one two  three" |] Unix.stdin output Unix.stderr in
      Unix.close output;
      let line = input_line (Unix.in_channel_of_descr input) in
      let _, status = Unix.waitpid [] pid in
      let words = Str.split (Str.regexp " +") line in
      Printf.printf "%d %s %b\n" (List.length words) (String.concat "," words) (status = Unix.WEXITED 0)
FILE /tmp/ocaml-check/domains.ml
    let sum n = let rec go i total = if i > n then total else go (i + 1) (total + i) in go 1 0
    let () =
      let domain = Domain.spawn (fun () -> sum 1000) in
      let result = ref 0 in
      Thread.join (Thread.create (fun () -> result := sum 100) ());
      Printf.printf "%d %d\n" (Domain.join domain) !result
SLOP test "$(ocaml /tmp/ocaml-check/answer.ml)" = 42
SLOP CWD /tmp/ocaml-check ocamlc -I +unix -I +str unix.cma str.cma words.ml -o words && test "$(./words)" = '3 one,two,three true'
SLOP CWD /tmp/ocaml-check ocamlc -I +unix -I +threads unix.cma threads.cma domains.ml -o domains && test "$(./domains)" = '500500 5050'

