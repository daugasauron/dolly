+    ofn->nFileOffset = copy.nFileOffset;
+    ofn->nFileExtension = copy.nFileExtension;
+    ofn->nFilterIndex = copy.nFilterIndex;
+    ofn->Flags = copy.Flags | (ofn->Flags & explorer_flags);
