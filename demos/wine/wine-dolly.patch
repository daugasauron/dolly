+#ifdef __dolly__
+/* The Explorer-style dialog is built on ole32 and the shell's folder views,
+ * which this Wine does not link: every file dialog is comdlg32's older one,
+ * without the caller's Explorer template and hook, and with one selection. */
+static const DWORD explorer_flags = OFN_EXPLORER | OFN_ENABLEHOOK | OFN_ENABLETEMPLATE |
+                                    OFN_ENABLETEMPLATEHANDLE | OFN_ALLOWMULTISELECT;
+
+static BOOL dolly_file_dialog_W( OPENFILENAMEW *ofn, UINT type )
+{
+    OPENFILENAMEW copy;
+    BOOL ret;
+
+    if (is_win16_looks( ofn->Flags )) return GetFileName31W( ofn, type );
+    memset( &copy, 0, sizeof(copy) );
+    memcpy( &copy, ofn, min( ofn->lStructSize, sizeof(copy) ) );
+    copy.Flags &= ~explorer_flags;
+    ret = GetFileName31W( &copy, type );
+    /* that dialog takes the title from its list, which a typed name is not in */
+    if (ret && ofn->lpstrFile && ofn->lpstrFileTitle && ofn->nMaxFileTitle)
+    {
+        const WCHAR *name = strrchrW( ofn->lpstrFile, '\\' );
+        lstrcpynW( ofn->lpstrFileTitle, name ? name + 1 : ofn->lpstrFile, ofn->nMaxFileTitle );
+    }
+    ofn->nFileOffset = copy.nFileOffset;
+    ofn->nFileExtension = copy.nFileExtension;
+    ofn->nFilterIndex = copy.nFilterIndex;
+    ofn->Flags = copy.Flags | (ofn->Flags & explorer_flags);
+    return ret;
+}
+
+static BOOL dolly_file_dialog_A( OPENFILENAMEA *ofn, UINT type )
