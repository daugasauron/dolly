+#ifdef __dolly__
+/***********************************************************************
+ *		wine_dolly_free_program_classes
+ *
+ * Unregister the classes of a program that ended. The programs of the
+ * desktop are threads of one process (kernel32-program.c), so the process
+ * exit that frees a program's classes never comes.
+ */
+void wine_dolly_free_program_classes( HINSTANCE module )
+{
+    for (;;)
+    {
+        CLASS *class;
+        ATOM atom = 0;
+
+        USER_Lock();
+        LIST_FOR_EACH_ENTRY( class, &class_list, CLASS, entry )
+            if (class->hInstance == module) { atom = class->atomName; break; }
+        USER_Unlock();
+        if (!atom || !UnregisterClassW( (LPCWSTR)MAKEINTATOM(atom), module )) break;
+    }
+}
+#endif
