MODULE    = netsurf.exe
APPMODE   = -mwindows
IMPORTS   = comctl32 comdlg32 shell32 shlwapi user32 gdi32 advapi32 kernel32
# NetSurf is a program for the Windows headers (its front end) and the C library, not a part of Wine.
EXTRADEFS = -U__WINESRC__
EXTRAINCL = -I$(N)/netsurf/frontends/windows -I$(N)/netsurf/frontends/windows/res

# The prepared NetSurf release lies beside this file: the browser, its libraries, and IJG's libjpeg.
N := $(MODSRC)/$(MODDIR)
OBJ := $(B)/obj/$(MODDIR)
LIBRARIES := libwapcaplet libparserutils libhubbub libdom libcss libnsbmp libnsgif libnsutils libutf8proc libnspsl
JPEG_UNITS := jaricom jcomapi jdapimin jdapistd jdarith jdatasrc jdcoefct jdcolor jddctmgr jdhuff jdinput jdmainct \
  jdmarker jdmaster jdmerge jdpostct jdsample jerror jidctflt jidctfst jidctint jquant1 jquant2 jutils jmemmgr jmemnobs

sources = $(patsubst $(N)/%,%,$(wildcard $(addprefix $(N)/,$(1))))
C_SRCS := $(call sources,libwapcaplet/src/*.c libparserutils/src/*/*.c libparserutils/src/charset/*/*.c \
    libhubbub/src/*.c libhubbub/src/*/*.c libdom/src/*/*.c libdom/bindings/hubbub/*.c \
    libcss/src/*.c libcss/src/*/*.c libcss/src/*/properties/*.c \
    libnsbmp/src/*.c libnsgif/src/*.c libnsutils/src/*.c libutf8proc/src/utf8proc.c libnspsl/src/*.c \
    netsurf/utils/*.c netsurf/utils/*/*.c netsurf/desktop/*.c netsurf/content/*.c \
    netsurf/content/fetchers/*.c netsurf/content/fetchers/*/*.c netsurf/content/handlers/css/*.c \
    netsurf/content/handlers/html/*.c netsurf/content/handlers/text/*.c netsurf/frontends/windows/*.c) \
  $(patsubst %,netsurf/content/handlers/image/%.c,image image_cache bmp gif ico jpeg png) \
  netsurf/content/handlers/javascript/fetcher.c netsurf/content/handlers/javascript/none/none.c \
  $(JPEG_UNITS:%=jpeg/%.c)
# Included by another source, a build tool, and the disc cache (the memory one is used).
EXCLUDE := libhubbub/src/treebuilder/autogenerated-element-type.c libcss/src/parse/properties/css_property_parser_gen.c \
  netsurf/content/fs_backing_store.c
RC_SRCS = netsurf.rc

# Each library sees its own src directory, and every part the public headers of all; the defines are
# those of NetSurf's build system for clang.
COMMON := $(LIBRARIES:%=-I$(N)/%/include) -I$(N)/jpeg -D_GNU_SOURCE -D_DEFAULT_SOURCE \
    '-D_ALIGNED=__attribute__((aligned))' -DSTMTEXPR=1 -DNDEBUG
$(foreach library,$(LIBRARIES),$(eval $(OBJ)/$(library)/%.o: MODDEFS := -I$(N)/$(library)/src $(COMMON) -DWITHOUT_ICONV_FILTER))
$(OBJ)/libutf8proc/%.o: MODDEFS += -I$(N)/libutf8proc/include/libutf8proc
$(OBJ)/netsurf/%.o: MODDEFS := -I$(N)/netsurf -I$(N)/netsurf/include -I$(N)/netsurf/frontends \
    -I$(N)/netsurf/content/handlers $(COMMON) -Dnswin32 -DWITH_CURL -DWITH_PNG -DWITH_JPEG \
    -DWITH_BMP -DWITH_GIF -DWITH_UTF8PROC -DWITH_NSPSL -DNETSURF_LOG_LEVEL=INFO \
    -DNETSURF_UA_FORMAT_STRING='"Mozilla/5.0 (%s) NetSurf/%d.%d"' -DNETSURF_HOMEPAGE='"site:/"' \
    -DNETSURF_BUILTIN_LOG_FILTER='"level:WARNING"' -DNETSURF_BUILTIN_VERBOSE_FILTER='"level:VERBOSE"' \
    -DNETSURF_WINDOWS_RESPATH='"C:"'
# Its fetcher on Dolly's libcurl (curl-dolly.h), which has no curl_getdate for the date parser.
netsurf/content/fetchers/curl_EXTRADEFS := -include $(N)/curl-dolly.h
netsurf/utils/time_EXTRADEFS := -UWITH_CURL
# The front end is written for a compiler whose headers come with windows.h; Wine's winsock.h and the
# C library's sockets cannot both be seen.
# AlphaBlend is msimg32's name for gdi32's GdiAlphaBlend.
$(OBJ)/netsurf/frontends/windows/%.o: MODDEFS += -DWINE_NOWINSOCK -include limits.h -include windows.h \
    -DAlphaBlend=GdiAlphaBlend
# Its test for a missing standard output asks the Microsoft C runtime; here there always is one.
netsurf/frontends/windows/main_EXTRADEFS := '-D_get_osfhandle(fd)=(fd)'
# IJG's jconfig.txt is the generic configuration (makefile.ansi); jmemnobs.c is its memory manager.
.DEFAULT_GOAL := $(OBJ)/module.a
$(N)/jpeg/jconfig.h: $(N)/jpeg/jconfig.txt
	cp $< $@
$(JPEG_UNITS:%=$(OBJ)/jpeg/%.o) $(OBJ)/netsurf/content/handlers/image/jpeg.o: $(N)/jpeg/jconfig.h
