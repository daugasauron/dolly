FILE /usr/share/licenses/wine/AUTHORS
FILE /usr/share/licenses/tinycc/COPYING
FILE /usr/share/licenses/netsurf/COPYING
FILE /usr/share/licenses/libjpeg/README
FOLDER /usr/share/licenses/gimp
# GIMP's data, configuration and personal folder, and fontconfig's configuration.
FOLDER /usr/share/gimp
FOLDER /etc/gimp
FOLDER /etc/fonts
FOLDER /home/dolly/.gimp-2.2
# The source of the x86-64 sample, for the terminal, and the user's Desktop folder: the desktop's icons.
FILE /home/dolly/hello_win.c
FOLDER /home/dolly/Desktop

ENTRY /bin/foreground -i /bin/slop
