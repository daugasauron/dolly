SOURCE /v0.1.3/dist/static/wine/source.tar.gz 280f7cf2c1dcac26a10efe40bb7760b9499db3ecc4514a2346d4de5b0fc5b27d /tmp/wine-source.tar.gz
SLOP gzip -dc /tmp/wine-source.tar.gz | tar -xf - -C /
# TinyCC's win64 binaries, unmodified: x86-64 code for x86emu, which builds the Start menu's x86-64 sample with them.
SOURCE /v0.1.3/dist/static/wine/tinycc.tar.gz 20709ea054c77d290a1837699bd8993dfbe84f97b5900002057a50dfd002fe4a /tmp/tinycc.tar.gz
SLOP gzip -dc /tmp/tinycc.tar.gz | tar -xf - -C /
