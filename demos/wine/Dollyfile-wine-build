# FreeType (with its libpng) for gdi32's fonts, as 0 A.D. built them; libpng's headers for NetSurf.
INSTALL /v0.1.3/demos/zero-ad/Dollyfile-freetype cbb1dcff4236907d1e85d576b3256a7c77bbd9f13e3adcce6be9020205704a1f
REQUIRES HEADER curl
REQUIRES HEADER zlib
REQUIRES LIB curl
REQUIRES LIB z
REQUIRES TOOL ar
REQUIRES TOOL awk
REQUIRES TOOL cc
REQUIRES TOOL cmp
REQUIRES TOOL grep
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL sed
