# FreeType (with its libpng) for gdi32's fonts, as 0 A.D. built them; libpng's headers for NetSurf.
INSTALL /v0.1.6/demos/zero-ad/Dollyfile-freetype c2179530af3656d78b88e3839dd9ad59a8b573976d8cf0c81da9f3dd3dac620b
REQUIRES HEADER curl
REQUIRES HEADER zlib
REQUIRES LIB curl
REQUIRES LIB z
REQUIRES TOOL ar
REQUIRES TOOL awk
REQUIRES TOOL cc
REQUIRES TOOL cmp
REQUIRES TOOL grep
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL sed
REQUIRES TOOL sort
REQUIRES TOOL tar

SOURCE /v0.1.6/dist/static/wine/source.tar.gz b9d96d80fc5a541dcc14b518ebd4d0b59b554c6c17fdf7b12a9979ee34607296 /tmp/wine-source.tar.gz
SLOP gzip -dc /tmp/wine-source.tar.gz | tar -xf - -C /
# TinyCC's win64 binaries, unmodified: x86-64 code for x86emu, which builds the Start menu's x86-64 sample with them.
SOURCE /v0.1.6/dist/static/wine/tinycc.tar.gz 20709ea054c77d290a1837699bd8993dfbe84f97b5900002057a50dfd002fe4a /tmp/tinycc.tar.gz
SLOP gzip -dc /tmp/tinycc.tar.gz | tar -xf - -C /
# Tools, generated headers, every module and wineserver, linked into /usr/bin/wine; Wine's fonts.
SLOP make -j4 -f /usr/src/dolly/wine/Makefile

EXPORTS TOOL wine
EXPORTS FOLDER wine-data /usr/share/wine
EXPORTS FOLDER wine-source /usr/src/wine
EXPORTS FOLDER wine-port /usr/src/dolly/wine
FILE /usr/share/licenses/wine/COPYING.LIB
FILE /usr/share/licenses/wine/LICENSE
FILE /usr/share/licenses/wine/AUTHORS
FILE /usr/share/licenses/tinycc/COPYING
FILE /usr/share/licenses/netsurf/COPYING
FILE /usr/share/licenses/libjpeg/README
FOLDER /usr/share/licenses/gimp
# GIMP's data, configuration and personal folder, and fontconfig's configuration.
FOLDER /usr/share/gimp
FOLDER /etc/gimp
FOLDER /etc/fonts
FOLDER /home/dolly/.gimp-2.2
# The source of the x86-64 sample, for the terminal, and the user's Desktop folder: the desktop's icons.
FILE /home/dolly/hello_win.c
FOLDER /home/dolly/Desktop

ENTRY /bin/foreground -i /bin/slop
