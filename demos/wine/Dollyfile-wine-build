# FreeType (with its libpng) for gdi32's fonts, as 0 A.D. built them; libpng's headers for NetSurf.
INSTALL /v0.1.3/demos/zero-ad/Dollyfile-freetype adb4aaf6723ea6f9b0cdace06a5898efb9d2187d13aa2b01da16ce7e1a6df3b2
REQUIRES HEADER curl
REQUIRES HEADER zlib
REQUIRES LIB curl
REQUIRES LIB z
REQUIRES TOOL ar
REQUIRES TOOL awk
REQUIRES TOOL cc
REQUIRES TOOL cmp
REQUIRES TOOL grep
REQUIRES TOOL gzip
REQUIRES TOOL make
REQUIRES TOOL sed
REQUIRES TOOL sort
