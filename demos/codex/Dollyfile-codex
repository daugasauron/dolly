COPY /v0.1.3/demos/codex/Dollyfile-codex-build 1c42890d5b693ac248a16771859e10fc51bc8f9849ea2ccc6ac5822e94027ad9 /usr/share/dolly/builds/codex.lock /usr/share/dolly/builds/codex.lock
