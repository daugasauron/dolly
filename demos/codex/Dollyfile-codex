COPY /v0.1.4/demos/codex/Dollyfile-codex-build 61532a230e171eff2157aabecc504b9e52d6fdc9a7b3f665769f0dbb51bf4d8c /usr/share/dolly/builds/codex.lock /usr/share/dolly/builds/codex.lock
