COPY /v0.1.3/demos/codex/Dollyfile-codex-build 1b2d50ba7f9ac88de884db246fb3f5502c47d201c826334e3d72a1b56460f69c /usr/share/licenses/codex /usr/share/licenses/codex
COPY /v0.1.3/demos/codex/Dollyfile-codex-build 1b2d50ba7f9ac88de884db246fb3f5502c47d201c826334e3d72a1b56460f69c /usr/share/dolly/builds/codex.lock /usr/share/dolly/builds/codex.lock
