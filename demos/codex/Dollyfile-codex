COPY /v0.1.4/demos/codex/Dollyfile-codex-build b0f99de66e05e4a63c3c13a96c4bd74d4f52ab35ac3ea945e74dc158e0f29f2d /usr/share/licenses/codex /usr/share/licenses/codex
COPY /v0.1.4/demos/codex/Dollyfile-codex-build b0f99de66e05e4a63c3c13a96c4bd74d4f52ab35ac3ea945e74dc158e0f29f2d /usr/share/dolly/builds/codex.lock /usr/share/dolly/builds/codex.lock
