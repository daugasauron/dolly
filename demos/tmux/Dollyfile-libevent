FILE /tmp/libevent.mk
    .RECIPEPREFIX := >
    .DELETE_ON_ERROR:
    MAKEFLAGS += -r
    E := /tmp/libevent-2.1.13-stable
    # The core's sources in upstream's CMakeLists.txt without threads, and
    # of the headers upstream installs those that declare them: event2's and
    # the older <event.h> over them, which tmux includes. <event.h> brings
    # event2/tag.h, whose functions are in upstream's extra library with DNS,
    # HTTP and RPC: that one is not built.
    SOURCES := buffer bufferevent bufferevent_filter bufferevent_pair bufferevent_ratelim \
      bufferevent_sock event evmap evutil evutil_rand evutil_time listener log signal \
      strlcpy poll
    HEADERS := event evutil $(addprefix event2/,buffer buffer_compat bufferevent \
      bufferevent_compat bufferevent_struct event event_compat event_struct event-config \
      keyvalq_struct listener tag tag_compat util visibility)
    all: /usr/lib/libevent_core.a $(addprefix /usr/include/,$(addsuffix .h,$(HEADERS)))
    $(E)/%.o: $(E)/%.c
    >cc -O2 -I$(E) -I$(E)/include -I$(E)/compat -c $< -o $@
    /usr/lib/libevent_core.a: $(addprefix $(E)/,$(addsuffix .o,$(SOURCES)))
    >ar rcs $@ $^
    /usr/include/%.h: $(E)/include/%.h
    >cp $< $@
SLOP mkdir -p /usr/include/event2 /usr/share/licenses/libevent
SLOP make -j4 -f /tmp/libevent.mk
SLOP cp /tmp/libevent-2.1.13-stable/LICENSE /usr/share/licenses/libevent/LICENSE

EXPORTS LIB    event_core /usr/lib/libevent_core.a
EXPORTS HEADER event2     /usr/include/event2
EXPORTS HEADER event      /usr/include/event.h
EXPORTS HEADER evutil     /usr/include/evutil.h
FILE /usr/share/licenses/libevent/LICENSE
