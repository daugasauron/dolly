SOURCE /v0.1.3/dist/static/tmux/libevent-2.1.13-stable.tar.gz f7e9383b8c0baa81b687e5b5eecc01beefaf1b19b64151d95ed61647fe7a315c /tmp/libevent.tar.gz
SLOP gzip -dc /tmp/libevent.tar.gz | tar -xf - -C /tmp

