FILE /tmp/tmux.mk
    .RECIPEPREFIX := >
    .DELETE_ON_ERROR:
    MAKEFLAGS += -r
    N := /tmp/terminfo
    E := /tmp/libevent-2.1.13-stable
    T := /tmp/tmux-3.8
    all: /usr/bin/tmux
    
    # libterminfo as its GNUmakefile builds it. nbperf and tic are built
    # first: the library's own scripts run them to write its hash tables
    # and the terminal descriptions it holds (xterm-256color among them).
    # tic needs TERMINFO_COMPAT for _ti_promote, which the release's
    # GNUmakefile leaves out.
    L := $(N)/libterminfo
    $(N)/nbperf/nbperf: $(wildcard $(N)/nbperf/*.c) $(L)/mi_vector_hash.c
    >cc -O1 -I$(N) -I$(N)/nbperf $^ -o $@
    $(L)/hash.c: $(L)/genhash $(L)/term.h $(N)/nbperf/nbperf
    >TOOL_NBPERF=$(N)/nbperf/nbperf sh $(L)/genhash $(L)/term.h > $@
    $(L)/termcap_hash.c: $(L)/genthash $(L)/termcap_map.c $(N)/nbperf/nbperf
    >TOOL_NBPERF=$(N)/nbperf/nbperf sh $(L)/genthash $(L)/termcap_map.c > $@
    $(N)/tic/tic: $(N)/tic/tic.c $(N)/tic/cdbw.c $(L)/compile.c $(L)/mi_vector_hash.c $(L)/hash.c
    >cc -O1 -I$(N) -I$(L) -I$(N)/tic -DTERMINFO_COMPAT $^ -o $@
    $(L)/compiled_terms.c: $(L)/genterms $(N)/terminfo/terminfo $(N)/tic/tic
    >TOOL_TIC=$(N)/tic/tic TERMINFODIR=$(N)/terminfo sh $(L)/genterms > $@
    TI := term ti setupterm curterm tparm tputs compile hash cdbr mi_vector_hash termcap
    $(L)/term.o: $(L)/compiled_terms.c
    $(L)/termcap.o: $(L)/termcap_hash.c
    $(L)/%.o: $(L)/%.c
    >cc -O2 -I$(N) -I$(L) -I$(N)/libcurses '-DINSTALL_PREFIX="/usr"' \
    >  -DTERMINFO_COMPILE -DTERMINFO_DB -DTERMINFO_COMPAT -c $< -o $@
    /tmp/libterminfo.a: $(addprefix $(L)/,$(addsuffix .o,$(TI)))
    >ar rcs $@ $^
    
    # libevent's core, the sources of its CMakeLists.txt without threads.
    EV := buffer bufferevent bufferevent_filter bufferevent_pair bufferevent_ratelim \
      bufferevent_sock event evmap evutil evutil_rand evutil_time listener log signal \
      strlcpy poll
    $(E)/%.o: $(E)/%.c
    >cc -O2 -I$(E) -I$(E)/include -I$(E)/compat -c $< -o $@
    /tmp/libevent_core.a: $(addprefix $(E)/,$(addsuffix .o,$(EV)))
    >ar rcs $@ $^
    
    # tmux: HAVE is what its configure would define here and COMPAT the
    # functions it would replace. Not claimed: SO_PEERCRED, which sockets@0
    # refuses (tmux then answers the one user itself). TMUX_SOCK_PERM is
    # upstream's knob: Dolly has no permission bits to check on /tmp/tmux-0.
    # TMUX_TERM is configure's pick among the names libterminfo knows.
    HAVE := DIRENT_H FCNTL_H INTTYPES_H PATHS_H PTY_H STDINT_H SYS_DIR_H CURSES_H \
      EVENT2_EVENT_H ERR_H DIRFD FLOCK SYSCONF ASPRINTF CFMAKERAW CLOCK_GETTIME \
      EXPLICIT_BZERO GETLINE MEMMEM SETENV STRCASESTR STRLCAT STRLCPY STRNDUP \
      STRNLEN STRSEP FORKPTY TIPARM
    COMPAT := base64 closefrom daemon fdforkpty freezero getdtablecount getdtablesize \
      getopt_long getpeereid getprogname htonll imsg imsg-buffer ntohll recallocarray \
      setproctitle strtonum unvis vis
    SOURCES := $(filter-out $(T)/osdep-%.c $(T)/image.c $(T)/image-sixel.c,$(wildcard $(T)/*.c)) \
      $(T)/osdep-dolly.c $(addprefix $(T)/compat/,$(addsuffix .c,$(COMPAT)))
    CPPFLAGS := -D_GNU_SOURCE $(addprefix -DHAVE_,$(HAVE)) '-DTMUX_VERSION="3.8"' \
      '-DTMUX_CONF="/etc/tmux.conf:~/.tmux.conf:$$XDG_CONFIG_HOME/tmux/tmux.conf:~/.config/tmux/tmux.conf"' \
      '-DTMUX_LOCK_CMD="lock -np"' '-DTMUX_TERM="tmux-256color"' -DTMUX_MOUSE=1 \
      -DTMUX_SOCK_PERM=0 -I$(T) -I$(E)/include -I$(L) -I$(N)/libcurses
    $(T)/%.o: $(T)/%.c
    >cc -O2 -std=gnu99 $(CPPFLAGS) -c $< -o $@
    /usr/bin/tmux: $(SOURCES:.c=.o) /tmp/libevent_core.a /tmp/libterminfo.a
    >cc $^ -ldolly-sockets -ldolly-pty -o $@
