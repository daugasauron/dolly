DOLLY 8
PACKAGE tree-sitter
REQUIRES HOST runtime@0

# The tree-sitter runtime, the incremental parsing library that grammars'
# generated parsers run on (Neovim's), from upstream's release archive,
# unchanged, built by its Makefile as a static library for programs the cc
# package builds; not its command-line generator.
FROM /demos/cmake/Dollyfile-cmake-build 2baf4bb61a256fbae4111b9adb7fc6438ee52f52d4c6dfb4e325c8245edaf0e7
REQUIRES HEADER libc
REQUIRES TOOL cc
REQUIRES TOOL cp
REQUIRES TOOL make
REQUIRES TOOL rm
REQUIRES TOOL tar

SOURCE /dist/static/neovim/treesitter.tar c63644d2f09dd4625d604cc48784d162800258712e1d6a36ab8e837dd70353dd /tmp/treesitter/source.tar
SLOP tar -xf /tmp/treesitter/source.tar -C /
SLOP make -C /tmp/treesitter/source CC=cc CFLAGS=-O2 libtree-sitter.a
SLOP cp /tmp/treesitter/source/libtree-sitter.a /usr/lib/libtree-sitter.a
SLOP cp -R /tmp/treesitter/source/lib/include/tree_sitter /usr/include
SLOP cp /tmp/treesitter/source/lib/src/unicode/LICENSE /usr/share/licenses/tree-sitter/Unicode-LICENSE

EXPORTS LIB    tree-sitter /usr/lib/libtree-sitter.a
EXPORTS HEADER tree_sitter /usr/include/tree_sitter
FILE /usr/share/licenses/tree-sitter/LICENSE
FILE /usr/share/licenses/tree-sitter/Unicode-LICENSE
SLOP rm -rf /tmp/treesitter
