DOLLY 6
APPLICATION neovim
REQUIRES HOST runtime@0
REQUIRES HOST display@0
REQUIRES HOST download@0
REQUIRES HOST http@0
REQUIRES HOST snapshot@0
REQUIRES HOST upload@0

FROM https://daugasauron.com/Dollyfile-system 600e07eff6905f15f1971af8d8e88925cf6eeef85d0516bc7b6eb95fd7de840e
INSTALL https://daugasauron.com/demos/neovim/Dollyfile-nvim 6ccf458d02c56464b743b1744474a7102ccf59b1a672ea2e1ea86cef65bf94ce

FILE /home/dolly/.config/nvim/init.lua
    vim.opt.shell = "/bin/slop"

FILE /usr/share/nvim/welcome.txt
    Neovim inside Dolly
    Press i to insert text. Escape returns to normal mode.
    :w saves; :q quits; :q! discards changes.
    :edit /workspace/example.c opens a file in your workspace.
    :!ls runs a command through Slop. :help opens Neovim's help.
    Quitting returns to Slop. Run nvim to open the editor again.
    Files live in the sandbox. Ctrl+Shift+S saves your session in this browser.
    PTY terminals, detached jobs, raw sockets and LuaJIT FFI are not supported.

FILE /etc/dolly/init.slop
    /bin/foreground /usr/bin/nvim /usr/share/nvim/welcome.txt
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
