# Neovim supports PUC Lua 5.1. Build the upstream interpreter and C library;
# -rdynamic lets source-built Lua C modules share that interpreter's API.
REQUIRES HEADER libc
REQUIRES TOOL cc
REQUIRES TOOL ar
REQUIRES TOOL make
REQUIRES TOOL gzip
REQUIRES TOOL tar
REQUIRES TOOL mkdir
