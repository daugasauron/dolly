SOURCE /v0.1.0/dist/static/neovim/neovim.tar.gz 037fc672b70c6bc962e9ecf08b847f5d4f4d2e526678c00dd8382aa156db3c82 /tmp/neovim/source.tar.gz
SLOP gzip -dc /tmp/neovim/source.tar.gz | tar -xf - -C /
SLOP cmake -S /tmp/neovim/source -B /tmp/neovim/build \
  -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
  -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_FLAGS_DEBUG=-O0 \
  -DPREFER_LUA=ON -DENABLE_LTO=OFF -DENABLE_LIBINTL=OFF \
  -DENABLE_UNIBILIUM=OFF -DENABLE_WASMTIME=OFF \
