DOLLY 6
PACKAGE git
REQUIRES HOST runtime@0
REQUIRES HOST http@0

# Git with its HTTP helpers, and diff and patch, which run it.
FROM https://daugasauron.com/Dollyfile-system-tools c97728fd04a940a529b6d2894715e51d605e41634d1889133b10d24c48000dc2

EXPORTS TOOL git
EXPORTS TOOL diff
EXPORTS TOOL patch
FILE /usr/libexec/dolly/git-remote-http
FILE /usr/libexec/dolly/git-remote-https
FOLDER /usr/share/git-core/templates
FILE /usr/share/licenses/git/COPYING
FILE /usr/share/man/cat1/git.1
FILE /usr/share/man/cat1/diff.1
FILE /usr/share/man/cat1/patch.1
