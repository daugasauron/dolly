DOLLY 7
PACKAGE git
REQUIRES HOST runtime@0
REQUIRES HOST http@0
REQUIRES HOST threads@0

# Git with its HTTP helpers, and Dolly's diff and patch, which run it. Git
# links zlib and its helpers libcurl too; both serve the build and are not
# installed with it. Git runs its asyncs, a side band's reader among them, as
# threads; without threads it would fork them.
FROM /v0.1.4/Dollyfile-system-build 7084706aae728d04739708cc9d820eb7b396e1abfe243a8c5555d7f61108f0a7
USE /v0.1.4/Dollyfile-zlib cfd9d7a74d809c2702017810d962c1c658fd55351492be3dc50ee97fb7b18ad9
USE /v0.1.4/Dollyfile-curl a24c19b1bfb7c1129f1d0c861a8988b07270356e41effff81144cf89d01f2d2f
REQUIRES HEADER libc
REQUIRES HEADER runtime
REQUIRES HEADER curl
REQUIRES HEADER zlib
REQUIRES LIB    curl
REQUIRES LIB    z
REQUIRES TOOL   ar
REQUIRES TOOL   cc
REQUIRES TOOL   make
REQUIRES TOOL   mkdir
REQUIRES TOOL   rm
REQUIRES TOOL   tar

SOURCE /v0.1.4/dist/static/default/git.tar 5c190c2a9301f54afab080b85341a8cd683bee1995b2d911e0bdea93f5eb845a /tmp/git.tar
SLOP tar \
  -xf /tmp/git.tar \
  -C /

# Automatic maintenance forks; the system configuration turns it off.
FILE /etc/gitconfig
    [maintenance]
        auto = false
FILE /home/dolly/.gitconfig
    [user]
        name = Dolly
        email = dolly@example.invalid
FILE /tmp/git/Makefile
    .RECIPEPREFIX := >
    SOURCES := $(file </usr/src/git/dolly-sources.txt)
    OBJECTS := $(addprefix /tmp/git/objects/,$(SOURCES:.c=.o))
    # NO_REGEX takes Git's regex, with GAWK and NO_MBSUPPORT as its Makefile
    # sets them: the sysroot's regex.h has no REG_STARTEND.
    # Git ends with status 128 when its pager cannot start, so the default one
    # is a command for Slop: less when it is installed, cat otherwise.
    CPPFLAGS := \
      -O2 \
      -std=gnu99 \
      -Wno-ignored-attributes \
      -D_DEFAULT_SOURCE \
      -DNO_GETTEXT \
      -DNO_ICONV \
      -DNO_EXPAT \
      -pthread \
      -DNO_UNIX_SOCKETS \
      -DNO_OPENSSL \
      -DNO_PERL \
      -DNO_PYTHON \
      -DNO_IPV6 \
      -DNO_MMAP \
      -DNO_REGEX \
      -DGAWK \
      -DNO_MBSUPPORT \
      -DNO_STRLCPY \
      -DSHA1_BLK \
      -DSHA256_BLK \
      -DHAVE_ALLOCA_H \
      -DHAVE_STRINGS_H \
      -DHAVE_CLOCK_GETTIME \
      -DHAVE_GETRANDOM \
      '-DGIT_VERSION_H="version-def.h"' \
      '-DBINDIR="/usr/bin"' \
      '-DGIT_EXEC_PATH="/usr/libexec/dolly"' \
      '-DDEFAULT_GIT_TEMPLATE_DIR="/usr/share/git-core/templates"' \
      '-DFALLBACK_RUNTIME_PREFIX="/usr"' \
      '-DGIT_HOST_CPU="wasm64"' \
      '-DGIT_LOCALE_PATH="/usr/share/locale"' \
      '-DSHELL_PATH="/bin/slop"' \
      '-DDEFAULT_PAGER="$$(command -v less || command -v cat)"' \
      '-DPAGER_ENV="LESS=FRX LV=-c"' \
      '-DETC_GITCONFIG="/etc/gitconfig"' \
      '-DETC_GITATTRIBUTES="/etc/gitattributes"' \
      '-DGIT_HTML_PATH="/usr/share/doc/git/html"' \
      '-DGIT_MAN_PATH="/usr/share/man"' \
      '-DGIT_INFO_PATH="/usr/share/info"' \
      -I /usr/src/git/compat/regex \
      -I /usr/src/git \
      -include dolly/runtime.h
    all: /usr/bin/git /usr/libexec/dolly/git-remote-http
    /tmp/git/objects/%.o: /usr/src/git/%.c
    >mkdir -p $(dir $@)
    >cc \
    >  $(CPPFLAGS) \
    >  -c $< \
    >  -o $@
    /usr/lib/libgit.a: $(OBJECTS)
    >ar rcs $@ $^
    /usr/bin/git: /usr/src/git/common-main.c /usr/src/git/git.c /usr/lib/libgit.a
    >cc \
    >  $(CPPFLAGS) \
    >  /usr/src/git/common-main.c \
    >  /usr/src/git/git.c \
    >  -lgit \
    >  -lz \
    >  -o $@
    /usr/libexec/dolly:
    >mkdir -p $@
    /usr/libexec/dolly/git-remote-http: /usr/src/git/common-main.c /usr/src/git/remote-curl.c /usr/src/git/http.c /usr/src/git/http-walker.c /usr/lib/libgit.a | /usr/libexec/dolly
    >cc \
    >  $(CPPFLAGS) \
    >  /usr/src/git/common-main.c \
    >  /usr/src/git/remote-curl.c \
    >  /usr/src/git/http.c \
    >  /usr/src/git/http-walker.c \
    >  -lgit \
    >  -lcurl \
    >  -lz \
    >  -o $@
SLOP CWD /usr/src/git make \
  -f /tmp/git/Makefile

EXPORTS TOOL git

SLOP git \
  --version
# The builtins a local transport runs by their dashed names (git clone PATH
# runs git-upload-pack on its other side), as upstream installs them, and
# the HTTPS helper, which upstream links to the HTTP one.
FILE /usr/libexec/dolly/git-upload-pack
    #!/bin/slop
    exec git upload-pack "$@"
FILE /usr/libexec/dolly/git-receive-pack
    #!/bin/slop
    exec git receive-pack "$@"
FILE /usr/libexec/dolly/git-upload-archive
    #!/bin/slop
    exec git upload-archive "$@"
FILE /usr/libexec/dolly/git-remote-https
    #!/bin/slop
    exec /usr/libexec/dolly/git-remote-http "$@"
SLOP git init -q /tmp/git-check/origin && git -C /tmp/git-check/origin commit -q --allow-empty -m one && \
  git clone -q /tmp/git-check/origin /tmp/git-check/clone && test "$(git -C /tmp/git-check/clone log --format=%s)" = one && \
  git -C /tmp/git-check/clone commit -q --allow-empty -m two && git -C /tmp/git-check/clone push -q origin HEAD:pushed && \
  test "$(git -C /tmp/git-check/origin log -1 --format=%s pushed)" = two
SLOP git --help > /usr/share/man/cat1/git.1

FILE /usr/libexec/dolly/git-remote-http
FOLDER /usr/share/git-core/templates
FILE /usr/share/licenses/git/COPYING
# git links libcurl statically and carries its licence.
FILE /usr/share/licenses/curl/COPYING
FILE /usr/share/man/cat1/git.1

# Dolly's diff and patch: git diff --no-index and git apply, for programs and
# build systems that run them.
SOURCE /v0.1.4/dist/static/default/commands/run-program.h e73415ba149e8dcb9944313c36d8d2319202d699c810e02a26d5a94caa8f3a9f /tmp/git-tools/run-program.h
SOURCE /v0.1.4/dist/static/default/commands/diff.c cda06a2a94c9d7c5f1ccab54f847011e35379f7cc452b7d4a0d7046ae61b7de9 /tmp/git-tools/diff.c
SOURCE /v0.1.4/dist/static/default/commands/patch.c bd5ec1cb0224099738b9f12f9b30896c134989dbebd7ecdb652e255c2ad29236 /tmp/git-tools/patch.c
SLOP cc -O2 /tmp/git-tools/diff.c -o /bin/diff
SLOP cc -O2 /tmp/git-tools/patch.c -o /bin/patch
EXPORTS TOOL diff
EXPORTS TOOL patch
SLOP diff --help > /usr/share/man/cat1/diff.1
SLOP patch --help > /usr/share/man/cat1/patch.1
FILE /usr/share/man/cat1/diff.1
FILE /usr/share/man/cat1/patch.1

SLOP rm \
  -rf \
  /tmp/git \
  /tmp/git.tar \
  /tmp/git-tools \
  /usr/src/git
