__INSTALL__

# Pi reads its instructions, skills, extensions and themes from /home/dolly/.pi/agent/
# (Pi's docs/configuration.md, in the image under /usr/lib/node_modules/@earendil-works/pi-coding-agent/docs/).
# A FILE row writes its body, each line indented four spaces, into the image.
# The skills are the directories of public/skills/, which the page writes at boot.

FILE /home/dolly/.pi/agent/AGENTS.md
    You are the coding agent of this project. Keep answers short, and run the
    project's tests after a change.

# An extension: /network in Pi lists the requests this sandbox may make, the HTTP rows above.
FILE /home/dolly/.pi/agent/extensions/network.js
    import { readFileSync } from "node:fs";
    export default function (pi) {
      pi.registerCommand("network", {
        description: "List the requests the page lets this sandbox make",
        handler: async (_, ctx) => ctx.ui.notify(readFileSync("/etc/dolly/Dollyfile", "utf8").split("\n")
          .filter(line => line.startsWith("HTTP ")).join("\n") || "None: the recipe has no HTTP row", "info"),
      });
    }

# A tool of your own, on the agent's PATH with EXPORTS TOOL: a script
# (#!/bin/slop, or #!/usr/bin/janis for JavaScript); with the cc package, a C
# program (FILE /tmp/NAME.c with its body, then SLOP cc /tmp/NAME.c -o /usr/bin/NAME);
# a file of an npm package, pinned by its SHA-256 (SOURCE https://unpkg.com/PACKAGE@VERSION/FILE
# SHA256 /usr/lib/FILE, then FILE /usr/lib/FILE to keep it; a script imports it by that path).
FILE /usr/bin/todo
    #!/bin/slop
    # todo [DIR]: lists the TODO and FIXME notes under DIR (default .).
    rg -n 'TODO|FIXME' "${1:-.}"
EXPORTS TOOL todo

# Pi's colours are public/theme.json, which the page writes at boot.

# How the sandbox starts: the commands of /etc/dolly/init.slop, in Slop, the shell. Pi
# starts as it does anywhere: /login signs in to a provider, /model chooses a model
# (Pi's docs/providers.md). --offline leaves out its update and catalog requests, which
# the rows above do not admit. Ctrl+D leaves Pi for a shell. Another program, or tmux
# with Pi and an editor, is the first line (docs/npm.md).
FILE /etc/dolly/init.slop
    /bin/foreground -i /usr/bin/pi --offline
    printf '\nPi exited; this is a Slop shell.\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
