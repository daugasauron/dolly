+use std::cell::RefCell;
+
+use super::*;
+
+pub(super) struct SerialCodegen<B: WriteBackendMethods> {
+    cgcx: CodegenContext,
+    prof: SelfProfilerRef,
+    emitter: SharedEmitter,
+    allocator_config: ModuleConfig,
+    allocator: Option<ModuleCodegen<B::Module>>,
+    modules: Vec<CompiledModule>,
+    fat: Vec<FatLtoInput<B>>,
+    thin: Vec<ThinLtoInput<B>>,
+    pub(super) imports: Vec<(PathBuf, WorkProduct)>,
+    exported_symbols: Vec<String>,
+}
+
+pub(super) fn start<B: WriteBackendMethods>(
+    backend: B,
+    tcx: TyCtxt<'_>,
+    mut allocator: Option<ModuleCodegen<B::Module>>,
+) -> OngoingCodegen<B> {
+    let no_builtins = find_attr!(tcx, crate, NoBuiltins);
+    let config = Arc::new(ModuleConfig::new(ModuleKind::Regular, tcx, no_builtins));
+    let allocator_config = ModuleConfig::new(ModuleKind::Allocator, tcx, no_builtins);
+    let cgcx = codegen_context(&backend, tcx, config);
+    let prof = tcx.sess.prof.clone();
+    let (mut emitter, shared_emitter_main) = SharedEmitter::new();
+    emitter.direct = Some(Arc::new(rustc_data_structures::sync::Lock::new(
+        rustc_session::default_emitter(&tcx.sess.opts, tcx.sess.psess.clone_source_map()),
+    )));
+    if let Some(module) = &mut allocator {
+        B::optimize(&cgcx, &prof, &emitter, module, &allocator_config);
+    }
+    let exported_symbols = if cgcx.lto == Lto::ThinLocal {
+        lto::exported_symbols_for_lto(tcx, &[])
+    } else {
+        vec![]
+    };
+    let serial = SerialCodegen {
+        cgcx, prof, emitter, allocator_config, allocator,
+        modules: vec![], fat: vec![], thin: vec![], imports: vec![], exported_symbols,
+    };
+    OngoingCodegen {
+        backend,
+        output_filenames: Arc::clone(tcx.output_filenames(())),
+        coordinator: Coordinator {
+            sender: channel().0,
+            future: None,
+            phantom: PhantomData,
+            serial: Some(RefCell::new(serial)),
+        },
+        codegen_worker_receive: channel().1,
+        shared_emitter_main,
+    }
+}
+
+impl<B: WriteBackendMethods> SerialCodegen<B> {
+    pub(super) fn submit(&mut self, work: WorkItem<B>) {
+        let result = match work {
+            WorkItem::Optimize(module) => execute_optimize_work_item::<B>(
+                &self.cgcx, &self.prof, self.emitter.clone(), module),
+            WorkItem::CopyPostLtoArtifacts(module) => WorkItemResult::Finished(
+                execute_copy_from_cache_work_item(
+                    &self.cgcx, &self.prof, self.emitter.clone(), module)),
+        };
+        match result {
+            WorkItemResult::Finished(module) => self.modules.push(module),
+            WorkItemResult::NeedsFatLto(input) => self.fat.push(input),
+            WorkItemResult::NeedsThinLto(name, buffer) => self.thin.push(ThinLtoInput::Red {
+                name, buffer: SerializedModule::Local(buffer),
+            }),
+        }
+    }
+
+    pub(super) fn finish(mut self, backend: &B, sess: &Session, info: &CrateInfo) -> CompiledModules {
+        let tm_factory = backend.target_machine_factory(sess, self.cgcx.opt_level, &self.cgcx.backend_features);
+        if !self.fat.is_empty() {
+            assert!(self.modules.is_empty() && self.thin.is_empty());
+            if let Some(module) = self.allocator.take() {
+                self.fat.push(FatLtoInput::InMemory(module));
+            }
+            for (bitcode_path, product) in self.imports {
+                self.fat.push(FatLtoInput::Serialized { name: product.cgu_name, bitcode_path });
+            }
+            return CompiledModules {
+                modules: vec![do_fat_lto(sess, &self.cgcx, self.emitter, tm_factory,
+                    &info.exported_symbols_for_lto, &info.each_linked_rlib_file_for_lto, self.fat)],
+                allocator_module: None,
+            };
+        }
+        if !self.thin.is_empty() || !self.imports.is_empty() {
+            assert!(self.modules.is_empty());
+            for (bitcode_path, wp) in self.imports {
+                self.thin.push(ThinLtoInput::Green { wp, bitcode_path });
+            }
+            let (exports, rlibs) = if self.cgcx.lto == Lto::ThinLocal {
+                (self.exported_symbols.as_slice(), &[][..])
+            } else {
+                if let Some(module) = self.allocator.take() {
+                    self.thin.push(ThinLtoInput::Red {
+                        name: module.name,
+                        buffer: SerializedModule::Local(B::serialize_module(module.module_llvm, true)),
+                    });
+                }
+                (info.exported_symbols_for_lto.as_slice(), info.each_linked_rlib_file_for_lto.as_slice())
+            };
+            let dcx = DiagCtxt::new(Box::new(self.emitter.clone()));
+            check_lto_allowed(&self.cgcx, dcx.handle());
+            for (work, _) in generate_thin_lto_work::<B>(
+                &self.cgcx, &self.prof, dcx.handle(), exports, rlibs, self.thin,
+            ) {
+                self.modules.push(match work {
+                    ThinLtoWorkItem::CopyPostLtoArtifacts(module) => execute_copy_from_cache_work_item(
+                        &self.cgcx, &self.prof, self.emitter.clone(), module),
+                    ThinLtoWorkItem::ThinLto(module) => B::optimize_and_codegen_thin(
+                        &self.cgcx, &self.prof, &self.emitter, tm_factory.clone(), module),
+                });
+            }
+        }
+        CompiledModules {
+            modules: self.modules,
+            allocator_module: self.allocator.map(|module| B::codegen(
+                &self.cgcx, &self.prof, &self.emitter, module, &self.allocator_config)),
+        }
+    }
+}
