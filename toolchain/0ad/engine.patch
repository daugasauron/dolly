+Handle Device::SamplerHandle(const Sampler::Desc& desc)
+{
+    auto address=[](Sampler::AddressMode mode)->unsigned
+    {
+        switch(mode)
+        {
+        case Sampler::AddressMode::REPEAT:return 1;
+        case Sampler::AddressMode::MIRRORED_REPEAT:return 2;
+        case Sampler::AddressMode::CLAMP_TO_BORDER:
+        case Sampler::AddressMode::CLAMP_TO_EDGE:return 0;
+        default:Require(false,"sampler border addressing unsupported");return 0;
+        }
+    };
+    Require(desc.mipLODBias==0,"sampler LOD bias unsupported");
+    std::array<uint32_t,8> key={unsigned(desc.minFilter),unsigned(desc.magFilter),unsigned(desc.mipFilter),
+        address(desc.addressModeU),address(desc.addressModeV),address(desc.addressModeW),
+        desc.compareEnabled?unsigned(desc.compareOp)+1:0,desc.anisotropyEnabled?uint32_t(desc.maxAnisotropy):1};
+    if(auto it=samplers.find(key);it!=samplers.end())return it->second;
+    Handle handle=queue.New();void* p=queue.Record(DOLLY_GPU_CREATE_SAMPLER,48);U64(p,8,handle);
+    for(size_t i=0;i<key.size();i++)U32(p,16+4*i,key[i]);
+    samplers.emplace(key,handle);return handle;
+}
+static unsigned VertexFormat(Format format)
+{
+    switch(format)
+    {
+    case Format::R32_SFLOAT:return 1;
+    case Format::R32G32_SFLOAT:return 2;
+    case Format::R32G32B32_SFLOAT:return 3;
+    case Format::R32G32B32A32_SFLOAT:return 4;
+    case Format::R8G8B8A8_UNORM:return 5;
+    case Format::R8G8B8A8_UINT:return 7;
+    case Format::R16G16_UNORM:return 9;
+    case Format::R16G16_UINT:return 11;
+    default:Require(false,"vertex format unsupported");return 0;
+    }
+}
+Handle Pipeline::Get(VertexLayout* layout,Framebuffer* framebuffer)
+{
+    const unsigned color=framebuffer->color.texture?TextureFormat(framebuffer->color.texture->GetFormat()):0,
+        depth=framebuffer->depth.texture?TextureFormat(framebuffer->depth.texture->GetFormat()):0;
+    auto key=std::tuple{layout->id,color,depth};
+    if(auto it=handles.find(key);it!=handles.end())return it->second;
+    Require(desc.rasterizationState.polygonMode==PolygonMode::FILL && !desc.depthStencilState.stencilTestEnabled,
+        "wireframe/stencil rendering unsupported");
+    auto* program=desc.shaderProgram->As<Program>();
+    std::vector<SVertexAttributeFormat> attributes;
+    unsigned buffers=0;
+    for(const auto& attribute:layout->attributes)
+    {
+        if(!program->streams.contains(attribute.stream))continue;
+        attributes.push_back(attribute);buffers=std::max(buffers,attribute.bindingSlot+1);
+    }
+    Require(attributes.size()==program->streams.size() && buffers<=8,"missing shader vertex streams");
+    Handle handle=device->queue.New();void* p=device->queue.Record(DOLLY_GPU_GRAPHICS_PIPELINE,112+16*(buffers+attributes.size()));
+    U64(p,8,handle);U64(p,16,program->vertex);U64(p,24,program->fragment);U32(p,32,color);U32(p,36,depth);
+    U32(p,44,unsigned(desc.rasterizationState.cullMode));U32(p,48,unsigned(desc.rasterizationState.frontFace));
+    U32(p,52,desc.depthStencilState.depthTestEnabled?unsigned(desc.depthStencilState.depthCompareOp)+1:8);
+    U32(p,56,desc.depthStencilState.depthWriteEnabled);
+    if(desc.rasterizationState.depthBiasEnabled)
+    {
+        U32(p,60,int32_t(desc.rasterizationState.depthBiasConstantFactor));
+        F32(p,64,desc.rasterizationState.depthBiasSlopeFactor);
+    }
+    U32(p,72,desc.blendState.colorWriteMask);U32(p,76,desc.blendState.enabled);
+    auto factor=[](BlendFactor factor)->unsigned
+    {
+        if(unsigned(factor)<=unsigned(BlendFactor::ONE_MINUS_DST_ALPHA))return unsigned(factor);
+        if(factor==BlendFactor::SRC_ALPHA_SATURATE)return 10;
+        Require(false,"constant/dual-source blend factors unsupported");return 0;
+    };
+    U32(p,80,unsigned(desc.blendState.colorBlendOp));U32(p,84,factor(desc.blendState.srcColorBlendFactor));U32(p,88,factor(desc.blendState.dstColorBlendFactor));
+    U32(p,92,unsigned(desc.blendState.alphaBlendOp));U32(p,96,factor(desc.blendState.srcAlphaBlendFactor));U32(p,100,factor(desc.blendState.dstAlphaBlendFactor));
+    U32(p,104,buffers);U32(p,108,attributes.size());
+    // Unused slots still have valid descriptors; the draw binds a small dummy buffer.
+    for(unsigned i=0;i<buffers;i++)U32(p,112+i*16,4);
+    for(size_t i=0;i<attributes.size();i++)
+    {
+        const auto& attribute=attributes[i];size_t at=112+(buffers+i)*16;
+        U32(p,112+attribute.bindingSlot*16,attribute.stride);U32(p,116+attribute.bindingSlot*16,unsigned(attribute.rate));
+        U32(p,at,attribute.bindingSlot);U32(p,at+4,program->streams.at(attribute.stream));
+        U32(p,at+8,VertexFormat(attribute.format));U32(p,at+12,attribute.offset);
+    }
+    handles.emplace(key,handle);return handle;
+}
+std::unique_ptr<IGraphicsPipelineState> Device::CreateGraphicsPipelineState(const SGraphicsPipelineStateDesc& desc)
+{ return std::make_unique<Pipeline>(this,desc); }
