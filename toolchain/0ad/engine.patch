+void Context::SetUniform(int32_t slot,std::span<const float> values)
+{
+    if(slot<0)return;
+    Require(pipeline!=nullptr,"uniform without pipeline");auto* program=pipeline->desc.shaderProgram->As<Program>();
+    Require(size_t(slot)<program->bindings.size(),"uniform slot");const auto& binding=program->bindings[slot];
+    Require(binding.group!=1,"uniform bounds");
+    auto* target=program->uniforms[binding.group].data()+binding.offset;
+    size_t bytes=std::min(values.size_bytes(),size_t(binding.size));
+    if(std::memcmp(target,values.data(),bytes))
