+	CSimulation2& simulation = *g_Game->GetSimulation2();
+	ScriptRequest rq(simulation.GetScriptInterface());
+	JS::RootedValue state(rq.cx);
+	if (!simulation.GetScriptInterface().Eval(R"JS((() => {
+		const state = Engine.QueryInterface(SYSTEM_ENTITY, IID_GuiInterface).GetSimulationState();
+		state.entities = {};
+		for (const id of Engine.GetEntitiesWithInterface(IID_AIProxy))
+		{
+			const proxy = Engine.QueryInterface(id, IID_AIProxy);
+			const needsFullGet = proxy.needsFullGet;
+			try { state.entities[id] = proxy.GetFullRepresentation(); }
+			finally { proxy.needsFullGet = needsFullGet; }
+		}
+		return state;
+	})())JS", &state))
+		throw std::runtime_error("Observation failed");
+	return Script::StringifyJSON(rq, &state, false);
+}
+
+void Start(const ScriptInterface& control, JS::HandleValue attributes,
+	int player, const std::string& savedState)
+{
+	EndGame();
+	g_Game = new CGame(true);
+	const ScriptInterface& script = g_Game->GetSimulation2()->GetScriptInterface();
+	ScriptRequest rq(script);
+	JS::RootedValue copy(rq.cx, Script::CloneValueFromOtherCompartment(script, control, attributes));
+	g_Game->SetPlayerID(player);
+	g_Game->StartGame(&copy, savedState);
+	LDR_NonprogressiveLoad();
+	if (g_Game->ReallyStartGame() != PSRETURN_OK)
+		throw std::runtime_error("Game loading failed");
+}
+
+std::string Execute(const ScriptInterface& control, const ScriptRequest& rq,
+	JS::HandleValue request, const std::string& operation)
+{
+	if (operation == "observe")
+		return State();
+	if (operation == "hash")
+	{
+		std::string hash;
+		if (!g_Game->GetSimulation2()->ComputeStateHash(hash, false))
+			throw std::runtime_error("State hashing failed");
+		return "\"" + Hexify(hash) + "\"";
+	}
+	if (operation == "step")
+	{
+		const int turns = Script::HasProperty(rq, request, "turns") ? Property<int>(rq, request, "turns") : 1;
+		if (turns < 1 || turns > 1000)
+			throw std::runtime_error("turns must be between 1 and 1000");
+		std::vector<std::pair<int, std::string>> commands;
+		if (Script::HasProperty(rq, request, "commands"))
+		{
+			JS::RootedValue array(rq.cx);
+			Script::GetProperty(rq, request, "commands", &array);
+			bool isArray = false;
+			if (!JS::IsArrayObject(rq.cx, array, &isArray) || !isArray)
+				throw std::runtime_error("commands must be an array");
+			JS::RootedObject object(rq.cx, &array.toObject());
+			uint32_t length;
+			if (!JS::GetArrayLength(rq.cx, object, &length) || length > 1000)
+				throw std::runtime_error("At most 1000 commands are allowed per step");
+			for (uint32_t i = 0; i < length; ++i)
+			{
+				JS::RootedValue entry(rq.cx), command(rq.cx);
+				if (!JS_GetElement(rq.cx, object, i, &entry) || !entry.isObject() ||
+					!Script::GetProperty(rq, entry, "command", &command) || !command.isObject())
+					throw std::runtime_error("Each command needs player and command properties");
+				commands.emplace_back(Property<int>(rq, entry, "player"), Script::StringifyJSON(rq, &command, false));
+			}
+		}
+		const ScriptInterface& script = g_Game->GetSimulation2()->GetScriptInterface();
+		ScriptRequest gameRequest(script);
+		auto* turnManager = static_cast<CLocalTurnManager*>(g_Game->GetTurnManager());
+		for (const auto& [player, json] : commands)
+		{
+			JS::RootedValue command(gameRequest.cx);
+			if (!Script::ParseJSON(gameRequest, json, &command))
+				throw std::runtime_error("Invalid game command");
+			turnManager->PostCommand(player, command);
+		}
+		for (int i = 0; i < turns; ++i)
+			turnManager->Update(DEFAULT_TURN_LENGTH, 1);
+		return State();
+	}
+	if (operation == "save" || operation == "load")
+	{
+		const std::string name = Property<std::string>(rq, request, "name");
+		if (name.empty() || name.size() > 100 || name.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-") != std::string::npos)
+			throw std::runtime_error("Save name must contain 1 to 100 letters, digits, underscores or hyphens");
+		if (operation == "save")
+		{
+			JS::RootedValue metadata(rq.cx);
+			Script::CreateObject(rq, &metadata);
+			if (SavedGames::Save(CStr(name).FromUTF8(), L"Dolly control", *g_Game->GetSimulation2(),
+				Script::WriteStructuredClone(rq, metadata)) < 0)
+				throw std::runtime_error("Saving failed");
+		}
+		else
+		{
+			auto saved = SavedGames::Load(control, CStr(name).FromUTF8());
+			if (!saved)
+				throw std::runtime_error("Loading failed");
+			JS::RootedValue metadata(rq.cx, saved->metadata), attributes(rq.cx);
+			if (!Script::GetProperty(rq, metadata, "initAttributes", &attributes))
+				throw std::runtime_error("Save has no initAttributes");
+			Start(control, attributes, Property<int>(rq, metadata, "playerID"), saved->savedState);
+		}
+		return "null";
+	}
+	if (operation == "reset")
+	{
+		JS::RootedValue attributes(rq.cx);
+		if (!Script::GetProperty(rq, request, "attributes", &attributes) || !attributes.isObject())
+			throw std::runtime_error("reset needs game attributes");
+		const int player = Script::HasProperty(rq, request, "player") ? Property<int>(rq, request, "player") : 1;
+		Start(control, attributes, player, "");
+		return State();
+	}
+	throw std::runtime_error("Unknown operation: " + operation);
+}
+}
+
+void DollyControl_Run(FILE* output)
+{
+	ScriptInterface control("Engine", "Dolly control", g_ScriptContext);
+	ScriptRequest rq(control);
+	for (;;)
+	{
+		std::string line;
+		bool oversized = false;
+		int c;
+		while ((c = fgetc(stdin)) != EOF && c != '\n')
+		{
+			if (line.size() < 1024 * 1024) line += static_cast<char>(c);
+			else oversized = true;
+		}
+		if (c == EOF && line.empty()) break;
+		JS::RootedValue request(rq.cx), id(rq.cx, JS::NullValue());
+		std::string result;
+		bool ok = true, quit = false;
+		try
+		{
+			if (oversized || !Script::ParseJSON(rq, line, &request) || !request.isObject())
+				throw std::runtime_error("Expected a JSON object of at most 1 MiB");
+			if (Script::HasProperty(rq, request, "id")) Script::GetProperty(rq, request, "id", &id);
+			const std::string operation = Property<std::string>(rq, request, "op");
+			quit = operation == "quit";
+			result = quit ? "null" : Execute(control, rq, request, operation);
+		}
+		catch (const std::exception& error)
+		{
+			JS_ClearPendingException(rq.cx);
+			JS::RootedValue message(rq.cx);
+			Script::ToJSVal(rq, &message, std::string(error.what()));
+			result = Script::StringifyJSON(rq, &message, false);
+			ok = false;
+		}
+		const std::string responseId = Script::StringifyJSON(rq, &id, false);
+		fprintf(output, "{\"id\":%s,\"ok\":%s,\"%s\":%s}\n", responseId.c_str(),
+			ok ? "true" : "false", ok ? "result" : "error", result.c_str());
+		if (fflush(output) || quit) break;
+	}
+}
