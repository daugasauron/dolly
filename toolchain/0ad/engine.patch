+
+OsPath sys_ExecutablePathname()
+{
+	char path[PATH_MAX];
+	const ssize_t size = readlink("/proc/self/exe", path, sizeof(path) - 1);
+	if (size < 0 || size == sizeof(path) - 1)
+		return OsPath();
+	path[size] = 0;
+	return OsPath(path);
+}
+
+void* debug_GetCaller(void*, const wchar_t*) { return nullptr; }
+Status debug_DumpStack(wchar_t* buf, size_t size, void*, const wchar_t*)
+{
+	if (size) buf[0] = 0;
+	return ERR::NOT_SUPPORTED;
+}
+Status debug_ResolveSymbol(void*, wchar_t* symbol, wchar_t* file, int* line)
+{
+	if (symbol) *symbol = 0;
+	if (file) *file = 0;
+	if (line) *line = 0;
+	return ERR::NOT_SUPPORTED;
+}
