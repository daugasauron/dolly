+std::unique_ptr<IShaderProgram> Device::CreateShaderProgram(const CStr& input,const CShaderDefines& defines)
+{
+    std::string name=input.c_str();
+    if(name.starts_with("spirv/"))name.replace(0,6,"wgsl/");
+    VfsPath index=L"shaders/"+wstring_from_utf8(name)+L".xml";
+    CXeromyces xml;
+    if(xml.Load(g_VFS,index)!=PSRETURN_OK)return {};
+    int fileAttr=xml.GetAttributeID("file"),nameAttr=xml.GetAttributeID("name"),valueAttr=xml.GetAttributeID("value");
+    VfsPath selected;
+    XERO_ITER_EL(xml.GetRoot(),variant)
+    {
+        CShaderDefines candidate;
+        XERO_ITER_EL(variant,defineList) XERO_ITER_EL(defineList,define)
+        {
+            auto attrs=define.GetAttributes();CStrIntern value(attrs.GetNamedItem(valueAttr));
+            if(value!=CStrIntern("UNDEFINED"))candidate.Add(CStrIntern(attrs.GetNamedItem(nameAttr)),value);
+        }
+        if(candidate==defines){selected=L"shaders/"+variant.GetAttributes().GetNamedItem(fileAttr).FromUTF8();break;}
+    }
+    if(selected.empty())
+    {
+        LOGERROR("No Dolly shader variant for '%s'",name);
+        for(auto& [key,value]:defines.GetMap())LOGERROR("  %s=%s",key.c_str(),value.c_str());
+        return {};
+    }
+    CXeromyces metadata;
+    if(metadata.Load(g_VFS,selected)!=PSRETURN_OK)return {};
+    auto result=std::make_unique<Program>(this);
+    result->files={index,selected};
+    auto attr=[&](const XMBElement& el,const char* key){return el.GetAttributes().GetNamedItem(metadata.GetAttributeID(key));};
+    auto is=[&](const XMBElement& el,const char* key){return el.GetNodeName()==metadata.GetElementID(key);};
+    XERO_ITER_EL(metadata.GetRoot(),stage)
+    {
+        VfsPath path=L"shaders/"+attr(stage,"file").FromUTF8();result->files.push_back(path);
+        Handle handle=queue.Shader(Read(path));
+        result->borderSampling|=attr(stage,"dolly_border")=="true";
+        if(is(stage,"vertex"))result->vertex=handle;
+        else { Require(is(stage,"fragment"),"graphics shader stage");result->fragment=handle; }
+        XERO_ITER_EL(stage,item)
+        {
+            if(is(item,"stream"))
+            {
+                const std::array<const char*,11> names={"pos","normal","color","uv0","uv1","uv2","uv3","uv4","uv5","uv6","uv7"};
+                auto found=std::find(names.begin(),names.end(),attr(item,"name"));
+                Require(found!=names.end(),"vertex stream name");
+                result->streams[static_cast<VertexAttributeStream>(found-names.begin())]=attr(item,"location").ToUInt();
+            }
+            else if(is(item,"push_constant"))result->Add(CStrIntern(attr(item,"name")),2,attr(item,"offset").ToUInt(),attr(item,"size").ToUInt());
+            else if(is(item,"descriptor_sets"))XERO_ITER_EL(item,set) XERO_ITER_EL(set,binding)
+            {
+                unsigned group=attr(set,"set").ToUInt(),index=attr(binding,"binding").ToUInt();
+                CStr type=attr(binding,"type");
+                if(type=="uniform")
+                {
+                    Require(group==0 && index==0,"material uniform block");
+                    result->uniforms[0].resize(Align(attr(binding,"size").ToUInt(),16));
+                    XERO_ITER_EL(binding,member)result->Add(CStrIntern(attr(member,"name")),0,attr(member,"offset").ToUInt(),attr(member,"size").ToUInt());
+                }
+                else
+                {
+                    Require(group==1 && (type=="sampler2D" || type=="samplerCube") && attr(binding,"sampler_binding").ToUInt()==index+1,"texture binding");
+                    result->Add(CStrIntern(attr(binding,"name")),1,index,0,type=="samplerCube");
+                }
+            }
+        }
+    }
+    return result;
+}
