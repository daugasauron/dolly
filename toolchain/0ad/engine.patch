+// Commands and all bookkeeping live in the guest. Flush ends the current pass;
+// the context may resume its persistent offscreen target with load operations.
+struct Queue
+{
+    std::unique_ptr<dolly_gpu> gpu = std::make_unique<dolly_gpu>();
+    Handle next = 0;
+    uint64_t submission = 1;
+    uint64_t frame = 1;
+    bool encoded = false;
+    std::vector<Handle> retired;
+    std::vector<Handle> uniformBuffers;
+    size_t uniformPosition = 0;
+    uint32_t uniformAlignment = 0;
+    std::function<void()> beforeFlush, afterFlush;
+    Handle New() { return ++next; }
+    void RawBatch()
+    {
+        if (gpu->count) Require(dolly_gpu_batch(gpu.get()) >= 0, "submit command packet");
+        dolly_gpu_begin(gpu.get());
+    }
+    void Flush()
+    {
+        if (beforeFlush) beforeFlush();
+        if (encoded) { dolly_gpu_submit(gpu.get()); encoded = false; ++submission; }
+        for (Handle handle : retired)
+        {
+            if (gpu->count >= 240 || gpu->length+16 > sizeof(gpu->packet)) RawBatch();
+            U64(dolly_gpu_record(gpu.get(), DOLLY_GPU_RELEASE, 16), 8, handle);
+        }
+        retired.clear();
+        RawBatch();
+        if (afterFlush) afterFlush();
+    }
+    void Reserve(size_t bytes, unsigned records = 1)
+    {
+        Require(bytes <= DOLLY_GPU_PACKET_BYTES-128 && records <= 240, "command capacity");
+        if (gpu->count+records > 240 || gpu->length+bytes > DOLLY_GPU_PACKET_BYTES-64) Flush();
+    }
+    void* Record(unsigned op, size_t bytes)
+    {
+        Reserve(Align(bytes,8));
+        return dolly_gpu_record(gpu.get(),op,bytes);
+    }
+    Handle Buffer(size_t bytes, unsigned usage)
+    {
+        Handle handle = New();
+        void* p = Record(DOLLY_GPU_CREATE_BUFFER,32);
+        U64(p,8,handle); U64(p,16,Align(bytes,4)); U32(p,24,usage);
+        return handle;
+    }
+    void Write(Handle handle, size_t offset, const void* data, size_t bytes)
+    {
+        Require(offset%4 == 0 && bytes%4 == 0, "buffer write alignment");
+        auto* source = static_cast<const uint8_t*>(data);
+        while (bytes)
+        {
+            size_t count = std::min(bytes, size_t(512*1024));
+            void* p = Record(DOLLY_GPU_WRITE_BUFFER,32+count);
+            U64(p,8,handle); U64(p,16,offset); U32(p,24,32); U32(p,28,count);
+            std::memcpy(static_cast<char*>(p)+32,source,count);
+            source += count; offset += count; bytes -= count;
+        }
+    }
+    std::pair<Handle,size_t> Uniform(const void* data,size_t bytes)
+    {
+        // Distinct aligned ranges survive every intermediate submission. Reuse
+        // starts only after Present submits all draws from the previous frame.
+        constexpr size_t chunkBytes = 1024*1024;
+        Require(uniformAlignment && bytes && bytes<=chunkBytes,"uniform allocation size");
+        uniformPosition=Align(uniformPosition,uniformAlignment);
+        if(uniformPosition%chunkBytes+bytes>chunkBytes)
+            uniformPosition=Align(uniformPosition,chunkBytes);
+        size_t chunk=uniformPosition/chunkBytes,offset=uniformPosition%chunkBytes;
+        if(chunk==uniformBuffers.size())uniformBuffers.push_back(Buffer(chunkBytes,72));
+        Handle handle=uniformBuffers[chunk];
+        Write(handle,offset,data,bytes);
+        uniformPosition+=bytes;
+        return {handle,offset};
+    }
+    Handle Shader(const std::string& code)
+    {
+        Handle handle = New();
+        void* p = Record(DOLLY_GPU_CREATE_SHADER,24+code.size());
+        U64(p,8,handle); U32(p,16,code.size()); std::memcpy(static_cast<char*>(p)+24,code.data(),code.size());
+        return handle;
+    }
+};
