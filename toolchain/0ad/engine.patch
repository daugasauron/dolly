+void Context::UploadTextureRegion(ITexture* resource,Format dataFormat,const void* data,size_t bytes,
+    uint32_t x,uint32_t y,uint32_t width,uint32_t height,uint32_t mip,uint32_t layer)
+{
+    auto* texture=resource->As<Texture>();
+    unsigned sourceBytes=0;
+    switch(dataFormat)
+    {
+    case Format::R8_UNORM:case Format::A8_UNORM:case Format::L8_UNORM:sourceBytes=1;break;
+    case Format::R8G8_UNORM:sourceBytes=2;break;
+    case Format::R8G8B8_UNORM:sourceBytes=3;break;
+    case Format::R8G8B8A8_UNORM:case Format::B8G8R8A8_UNORM:sourceBytes=4;break;
+    default:Require(false,"texture upload format unsupported");
+    }
+    unsigned targetBytes=TextureFormat(texture->format)==3?1:TextureFormat(texture->format)==4?2:4;
+    Require(bytes==size_t(width)*height*sourceBytes,"texture upload byte count");
+    Require(targetBytes==4 || dataFormat==texture->format,"texture conversion format");
+    resumeEnabled=false;device->queue.Flush();
+    const auto* source=static_cast<const uint8_t*>(data);
+    uint32_t rows=std::max(1u,512*1024/(width*targetBytes));
+    for(uint32_t row=0;row<height;row+=rows)
+    {
+        uint32_t count=std::min(rows,height-row);size_t length=size_t(width)*count*targetBytes;
+        void* p=device->queue.Record(DOLLY_GPU_WRITE_TEXTURE,48+length);
+        U64(p,8,texture->handle);U32(p,16,mip);U32(p,20,layer);U32(p,24,x);U32(p,28,y+row);
+        U32(p,32,width);U32(p,36,count);U32(p,40,length);
+        auto* target=static_cast<uint8_t*>(p)+48;
+        if(sourceBytes==targetBytes && dataFormat!=Format::B8G8R8A8_UNORM)std::memcpy(target,source+size_t(row)*width*sourceBytes,length);
+        else for(size_t i=0;i<size_t(width)*count;i++)
+        {
+            const auto* pixel=source+(size_t(row)*width+i)*sourceBytes;auto* out=target+i*4;
+            if(dataFormat==Format::A8_UNORM){out[0]=out[1]=out[2]=255;out[3]=pixel[0];}
+            else if(dataFormat==Format::L8_UNORM){out[0]=out[1]=out[2]=pixel[0];out[3]=255;}
+            else if(dataFormat==Format::B8G8R8A8_UNORM){out[0]=pixel[2];out[1]=pixel[1];out[2]=pixel[0];out[3]=pixel[3];}
+            else {Require(sourceBytes==3,"RGB conversion");out[0]=pixel[0];out[1]=pixel[1];out[2]=pixel[2];out[3]=255;}
+        }
+    }
+    resumeEnabled=true;Resume();
