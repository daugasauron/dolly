DOLLY 7
PACKAGE zig
REQUIRES HOST runtime@0

# Zig as zig-build bootstraps it, with its standard library. This zig has only
# the C backend (-ofmt=c) and no `zig build` or `zig cc`: cc compiles what it
# emits, so the package brings the compiler.
FROM /v0.1.4/Dollyfile-zig-build 4b729dd0a286610933810ae9ac8c040c85332b1612072b81d36ce26ee197ea76
INSTALL /v0.1.4/Dollyfile-cc 324a9b2d98a4fc860e55683a258b1954d302ffb98c519811afe8d828d7aa2906

EXPORTS TOOL   zig
EXPORTS FOLDER zig-lib     /usr/lib/zig
EXPORTS ENV    ZIG_LIB_DIR /usr/lib/zig
FILE /usr/share/licenses/zig/LICENSE
FILE /usr/share/man/cat1/zig.1
    zig: the Zig compiler with its C backend only. It writes C and cc compiles it.
    It has no zig build, zig cc, zig run, zig fmt, zig version or zig --help.
    
    A function for a C program:
      zig build-obj -ofmt=c -femit-bin=answer.c answer.zig
      cc -I /usr/lib/zig main.c answer.c -o answer
    
    A program that uses the standard library names the target, or zig looks
    for a libc by starting a compiler it does not know:
      zig build-exe -target wasm64-emscripten -fsingle-threaded -ofmt=c -lc \
        -femit-bin=hello.c hello.zig
      cc -Wno-incompatible-pointer-types '-Dzig_unimplemented()=(__builtin_trap(),0)' \
        -I /usr/lib/zig hello.c -o hello
