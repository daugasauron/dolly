+#[cfg(target_os = "emscripten")]
+pub struct CrosstermEventSource(Pin<Box<tokio::time::Sleep>>);
+
+#[cfg(target_os = "emscripten")]
+impl Default for CrosstermEventSource {
+    fn default() -> Self {
+        Self(Box::pin(tokio::time::sleep(std::time::Duration::ZERO)))
+    }
