+            .close => spawn.posix_spawn_file_actions_addclose(&actions, target),
+            .inherit => 0,
+            .ignore => spawn.posix_spawn_file_actions_adddup2(&actions, dev_null_fd, target),
+            .file => |file| spawn.posix_spawn_file_actions_adddup2(&actions, file.handle, target),
+        });
