+        .inherit => 0,
+        .dir => |cwd| spawn.posix_spawn_file_actions_addfchdir_np(&actions, cwd.handle),
+        .path => |cwd| spawn.posix_spawn_file_actions_addchdir_np(&actions, try arena.dupeSentinel(u8, cwd, 0)),
