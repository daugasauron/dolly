+/// has no fork; its file actions are dup2 and chdir.
+const emscripten_spawn = struct {
+    /// musl's posix_spawn_file_actions_t.
+    const FileActions = extern struct { pad0: [2]c_int, actions: ?*anyopaque, pad: [16]c_int };
+    const Argv = [*:null]const ?[*:0]const u8;
+    extern "c" fn posix_spawn_file_actions_init(actions: *FileActions) c_int;
+    extern "c" fn posix_spawn_file_actions_destroy(actions: *FileActions) c_int;
+    extern "c" fn posix_spawn_file_actions_adddup2(actions: *FileActions, source: posix.fd_t, target: posix.fd_t) c_int;
+    extern "c" fn posix_spawn_file_actions_addclose(actions: *FileActions, fd: posix.fd_t) c_int;
+    extern "c" fn posix_spawn_file_actions_addchdir_np(actions: *FileActions, path: [*:0]const u8) c_int;
+    extern "c" fn posix_spawn_file_actions_addfchdir_np(actions: *FileActions, fd: posix.fd_t) c_int;
+    extern "c" fn posix_spawn(pid: *posix.pid_t, path: [*:0]const u8, actions: *const FileActions, attributes: ?*const anyopaque, argv: Argv, envp: Argv) c_int;
+    extern "c" fn posix_spawnp(pid: *posix.pid_t, file: [*:0]const u8, actions: *const FileActions, attributes: ?*const anyopaque, argv: Argv, envp: Argv) c_int;
+};
