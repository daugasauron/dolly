+/// Emscripten's libc is the system's, and so is its link: the system's cc
+/// adds the libc, its start file and what the system records in a program.
+fn emscriptenLink(
+    lld: *Lld,
+    arena: Allocator,
+    full_out_path: []const u8,
+    zcu_obj_path: ?Cache.Path,
+    compiler_rt_path: ?Cache.Path,
+    ubsan_rt_path: ?Cache.Path,
+) !void {
+    const comp = lld.base.comp;
+    var argv: std.ArrayList([]const u8) = .empty;
+    try argv.appendSlice(arena, &.{ "cc", "-o", full_out_path });
+    if (comp.config.output_mode == .Lib) try argv.append(arena, "-shared");
+    if (comp.config.rdynamic) try argv.append(arena, "-rdynamic");
+    if (comp.config.any_non_single_threaded) try argv.append(arena, "-pthread");
+    for (comp.link_inputs) |link_input| switch (link_input) {
+        .object, .archive => |obj| {
+            const path = try obj.path.toString(arena);
+            try argv.appendSlice(arena, if (obj.must_link) &.{ "-Wl,--whole-archive", path, "-Wl,--no-whole-archive" } else &.{path});
+        },
+        .dso => |dso| try argv.append(arena, try dso.path.toString(arena)),
+        .dso_exact, .res => unreachable,
+    };
+    for (comp.c_object_table.keys()) |key| {
+        try argv.append(arena, try key.status.success.object_path.toString(arena));
+    }
+    for ([_]?Cache.Path{ zcu_obj_path, compiler_rt_path, ubsan_rt_path }) |optional| {
+        if (optional) |p| try argv.append(arena, try p.toString(arena));
+    }
+    try spawnLld(comp, arena, argv.items);
+}
