__flt_rounds
__fpclassify
__fpclassifyf
__fpclassifyl
__signbit
__signbitf
__signbitl
# LLVM rewrites printf, fprintf and sprintf calls without a floating-point
# conversion to Emscripten libc's __small_ variants, in a DSO's code too.
__small_fprintf
__small_printf
__small_sprintf
__stack_chk_fail
__stack_chk_guard
