+#ifdef DOLLY
+static bool
+jobrundolly(struct edge *e)
+{
+	struct node *n;
+	struct pool *p;
+	struct edge *new;
+	struct string *rspfile, *content, *cmd;
+	size_t i;
+	int input, child, waited, status;
+	char *argv[] = {"slop", "-c", NULL, NULL};
+
+	++nstarted;
+	for (i = 0; i < e->nout; ++i) {
+		n = e->out[i];
+		if (n->mtime == MTIME_MISSING && osmkdirs(n->path, true) < 0)
+			return false;
+	}
+	rspfile = edgevar(e, "rspfile", false);
+	if (rspfile) {
+		content = edgevar(e, "rspfile_content", true);
+		if (writefile(rspfile->s, content) < 0)
+			return false;
+	}
+	cmd = edgevar(e, "command", true);
+	argv[2] = cmd->s;
+	printstatus(e, cmd);
+	fflush(stdout);
+	fflush(stderr);
+
+	input = open("/dev/null", O_RDONLY);
+	if (input < 0) {
+		warn("open /dev/null:");
+		child = -1;
+		waited = -1;
+		status = 1;
+	} else {
+		dolly_interrupt_checkpoint();
+		child = dolly_spawn("/bin/slop", 3, argv, input,
+		                    STDOUT_FILENO, STDERR_FILENO);
+		waited = child < 0 ? child : dolly_wait(child, &status);
+		close(input);
+		dolly_interrupt_checkpoint();
+	}
+	++nfinished;
+
+	if (e->pool) {
+		p = e->pool;
+		if (p->work) {
+			new = p->work;
+			p->work = p->work->worknext;
+			new->worknext = work;
+			work = new;
+		} else {
+			--p->numjobs;
+		}
+	}
+	if (child < 0 || waited < 0 || status != 0) {
+		if (rspfile && !buildopts.keeprsp)
+			remove(rspfile->s);
+		if (status == 130)
+			dolly_exit(130);
+		if (child < 0 || waited < 0)
+			warn("Dolly could not start build command: %s", cmd->s);
+		else
+			warn("job failed with status %d: %s", status, cmd->s);
+		return false;
+	}
+	edgedone(e);
+	return true;
+}
