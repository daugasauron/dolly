 void
 build(void)
 {
+#ifdef DOLLY
+	size_t i;
+	struct edge *e;
+	size_t numfail = 0;
+
+	if (ntotal == 0) {
+		warn("nothing to do");
+		return;
+	}
+	clock_gettime(CLOCK_MONOTONIC, &starttime);
+	formatstatus(NULL, 0);
+	nstarted = 0;
+	nfinished = 0;
+	while (work && numfail < buildopts.maxfail) {
+		e = work;
+		work = work->worknext;
+		if (e->rule != &phonyrule && buildopts.dryrun) {
+			++nstarted;
+			printstatus(e, edgevar(e, "command", true));
+			++nfinished;
+		}
+		if (e->rule == &phonyrule || buildopts.dryrun) {
+			for (i = 0; i < e->nout; ++i)
+				nodedone(e->out[i], false);
+			continue;
+		}
+		if (!jobrundolly(e))
+			++numfail;
+	}
+	if (numfail > 0) {
+		if (numfail < buildopts.maxfail)
+			fatal("cannot make progress due to previous errors");
+		else if (numfail > 1)
+			fatal("subcommands failed");
+		else
+			fatal("subcommand failed");
+	}
+	ntotal = 0;
+#else
 	static const int sigs[] = {
 		SIGHUP,
 		SIGINT,
@@ -683,4 +800,5 @@ build(void)
 			fatal("subcommand failed");
 	}
 	ntotal = 0;  /* reset in case we just rebuilt the manifest */
+#endif
 }
