diff --git a/src/nvim/event/libuv_proc.c b/src/nvim/event/libuv_proc.c
--- a/src/nvim/event/libuv_proc.c
+++ b/src/nvim/event/libuv_proc.c
@@ -86,6 +86,8 @@ int libuv_proc_spawn(LibuvProc *uvproc)
   if (os_shell_is_cmdexe(proc->argv[0])) {
     uvproc->uvopts.flags |= UV_PROCESS_WINDOWS_VERBATIM_ARGUMENTS;
   }
+#endif
+#if defined(MSWIN) || defined(DOLLY)
   if (proc->detach) {
     uvproc->uvopts.flags |= UV_PROCESS_DETACHED;
   }
diff --git a/src/nvim/os/proc.c b/src/nvim/os/proc.c
--- a/src/nvim/os/proc.c
+++ b/src/nvim/os/proc.c
@@ -100,8 +100,13 @@ bool os_proc_tree_kill(int pid, int sig)
     // Never kill self (pid=0).
     return false;
   }
+#ifdef DOLLY
+  // Dolly reclaims descendants when their owning process exits.
+  return uv_kill(pid, sig) == 0;
+#else
   ILOG("sending %s to PID %d", sig == SIGTERM ? "SIGTERM" : "SIGKILL", -pid);
   return uv_kill(-pid, sig) == 0;
+#endif
 }
 #endif
 
