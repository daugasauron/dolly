+#ifdef DOLLY
+{
+	int fhin = 0, fhout = 1, fherr = 2, null_fd = -1;
+	char **childenv = NULL;
+	char *cwd = NULL, *path = NULL;
+	struct strvec argv = STRVEC_INIT;
+	dolly_process_fd_mapping mappings[3];
+	uint32_t inheritance = cmd->close_fd_above_stderr
+		? DOLLY_PROCESS_INHERIT_FDS_NONE : DOLLY_PROCESS_INHERIT_FDS_ALL;
+
+	cmd->pid = -1;
+	if (prepare_cmd(&argv, cmd) < 0)
+		goto dolly_spawn_done;
+	if (argv.nr > INT_MAX) {
+		errno = E2BIG;
+		goto dolly_spawn_done;
+	}
+	trace_argv_printf(&argv.v[1], "trace: start_command:");
+	if (cmd->no_stdin || cmd->no_stdout || cmd->no_stderr) {
+		null_fd = open("/dev/null", O_RDWR | O_CLOEXEC);
+		if (null_fd < 0)
+			goto dolly_spawn_done;
+	}
+	if (cmd->no_stdin)
+		fhin = null_fd;
+	else if (need_in)
+		fhin = fdin[0];
+	else if (cmd->in)
+		fhin = cmd->in;
+	if (cmd->no_stderr)
+		fherr = null_fd;
+	else if (need_err)
+		fherr = fderr[1];
+	else if (cmd->err > 1)
+		fherr = cmd->err;
+	if (cmd->no_stdout)
+		fhout = null_fd;
+	else if (cmd->stdout_to_stderr)
+		fhout = fherr;
+	else if (need_out)
+		fhout = fdout[1];
+	else if (cmd->out > 1)
+		fhout = cmd->out;
+
+	/* These owned descriptors are closed by the fork branch before exec. */
+	{
+		int owned[] = { need_in ? fdin[0] : -1,
+			need_out ? fdout[1] : -1, need_err ? fderr[1] : -1,
+			cmd->in, cmd->out, cmd->err, null_fd };
+		for (size_t i = 0; i < ARRAY_SIZE(owned); i++) {
+			if (owned[i] > 2) {
+				int flags = fcntl(owned[i], F_GETFD);
+				if (flags < 0 || fcntl(owned[i], F_SETFD, flags | FD_CLOEXEC) < 0)
+					goto dolly_spawn_done;
+			}
+		}
+	}
+	mappings[0] = (dolly_process_fd_mapping){fhin, 0};
+	mappings[1] = (dolly_process_fd_mapping){fhout, 1};
+	mappings[2] = (dolly_process_fd_mapping){fherr, 2};
+	childenv = prep_childenv(cmd->env.v);
+	if (cmd->dir)
+		cwd = absolute_pathdup(cmd->dir);
+	path = cwd && !is_absolute_path(argv.v[1])
+		? xstrfmt("%s/%s", cwd, argv.v[1])
+		: absolute_pathdup(argv.v[1]);
+	cmd->pid = dolly_spawn_mapped(path, argv.nr - 1,
+		(char **)argv.v + 1, childenv, cwd, inheritance, mappings, 3, -1);
+	if (cmd->pid == -ENOEXEC)
+		cmd->pid = dolly_spawn_mapped(argv.v[0], argv.nr,
+			(char **)argv.v, childenv, cwd, inheritance, mappings, 3, -1);
+	if (cmd->pid < 0) {
+		errno = -cmd->pid;
+		cmd->pid = -1;
+	}
+dolly_spawn_done:
+	failed_errno = errno;
+	if (cmd->pid < 0 && (!cmd->silent_exec_failure || errno != ENOENT))
+		error_errno("cannot spawn %s", cmd->args.v[0]);
+	if (cmd->pid >= 0 && cmd->clean_on_exit)
+		mark_child_for_cleanup(cmd->pid, cmd);
+	if (null_fd >= 0)
+		close(null_fd);
+	strvec_clear(&argv);
+	free(childenv);
+	free(cwd);
+	free(path);
+}
+#elif !defined(GIT_WINDOWS_NATIVE)
