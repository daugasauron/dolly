diff --git a/src/terminal/PageList.zig b/src/terminal/PageList.zig
--- a/src/terminal/PageList.zig
+++ b/src/terminal/PageList.zig
@@ -313,7 +313,9 @@ const std_size = Page.layout(std_capacity).total_size;
 ///
 /// Test builds use the std pool even on wasm so that pool memory goes
