DOLLY 8
PACKAGE cc
REQUIRES HOST runtime@0

# The C/C++ toolchain as system-build bootstraps it: the compiler and its
# drivers, the C and C++ headers and libraries and the host clients, with the
# make package.
FROM /Dollyfile-system-build 0c72e09eba84571d4f8634cf6e7507eb1be1b9b8aa1fae61f6b0ec884b26b6fb
INSTALL /Dollyfile-make 9e724f32b1d81a63eb17fc9abcb8aeb70bcd9190a86e7b48c206fac82fd78e5e

EXPORTS FILE   compiler      /usr/libexec/dolly/process-bin/compiler
EXPORTS FOLDER process-sdk   /usr/lib/dolly/process
EXPORTS FOLDER clang-headers /usr/lib/clang/24/include
EXPORTS HEADER libc          /usr/include
EXPORTS LIB    compiler-rt   /usr/lib/libclang_rt.builtins.a
EXPORTS FILE   kernel-plugin-abi /usr/lib/dolly/dolly-kernel-plugin-0.wasm
EXPORTS TOOL cc
EXPORTS TOOL c++
EXPORTS TOOL ld
EXPORTS TOOL ar
EXPORTS ENV CC  cc
EXPORTS ENV CXX c++
