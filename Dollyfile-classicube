DOLLY 3
IMAGE classicube

FROM HOST /Dollyfile-system a56a42dc9aaeb10b6dcb5bbfa17a07ffe685c919f63a81830817955162ff1ac8
COPY FROM HOST /Dollyfile-classicube-build e6bc33df5b510fe84025a3acf1aa280a473cecd6e7fb85f4c8c5e97ea794996e /usr/bin/classicube /usr/bin/classicube
COPY FROM HOST /Dollyfile-classicube-build e6bc33df5b510fe84025a3acf1aa280a473cecd6e7fb85f4c8c5e97ea794996e /usr/share/classicube /home/dolly/classicube
COPY FROM HOST /Dollyfile-classicube-build e6bc33df5b510fe84025a3acf1aa280a473cecd6e7fb85f4c8c5e97ea794996e /usr/share/licenses/classicube /usr/share/licenses/classicube
COPY FROM HOST /Dollyfile-sdl2-build 8d534d5778f2cff9de04f258f9f2094270976744f7118391026200296d90bf1f /usr/share/licenses/SDL2 /usr/share/licenses/SDL2

FILE /home/dolly/classicube/options.txt
    window-width=640
    window-height=480
    viewdist=32
    fpslimit=Limit60FPS
    gui-showfps=True
    musicvolume=0
    soundsvolume=0

FILE /etc/dolly/init.slop
    cd /home/dolly/classicube
    printf 'ClassiCube: click to capture the mouse. WASD moves; Space jumps.\n'
    printf 'Left click breaks blocks; right click places them. B opens the inventory; Escape opens the menu.\n'
    /bin/foreground /usr/bin/classicube --singleplayer
    printf '\nDolly: image entry exited; entering the recovery Slop shell.\n'
    printf 'Restart: cd /home/dolly/classicube; classicube --singleplayer\n'
    /bin/foreground -i /bin/slop

ENTRY /bin/foreground -i /bin/slop /etc/dolly/init.slop
