DOLLY 1
IMAGE python
EXTENDS default

# CPython 3.14.7, upstream commit 823f0323ee6ec1402088b73bce1a38473cac36dc.
# The archive contains upstream sources plus configure output and frozen-module
# headers generated by the matching host Python; every target object is built
# here by Dolly's wasm64 compiler. Source: https://github.com/python/cpython
SOURCE HOST BIN /static/python/cpython.tar /tmp/cpython.tar SHA256 222fc2ee20a525032118413ef46d2b213f10edeef544bc5b891df59616db2a28
SOURCE HOST TXT /static/python/cpython-platform.c /usr/src/python/Python/dolly_platform.c SHA256 284231f883e693d192e068782f909decfc8f64a99f5374373f5f65c3dbb1eaa1
SOURCE HOST TXT /static/python/cpython-main.c /usr/src/python/Programs/dolly_main.c SHA256 2d6b186c38912292dcc54bc9a6a8c8d62d1673d1856f36ee7223ffdf3cd46199
SOURCE HOST TXT /static/python/bonnie.c /usr/src/dolly/bonnie.c SHA256 45c2a5f1ae2d3091aab3f1ec437fe1dd987bd153b8d02674d1bcab41140bc9e8
RUN tar -xf /tmp/cpython.tar -C /

WORKDIR /usr/src/python
RUN touch Python/frozen_modules/*.h
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE Python/dolly_platform.c -o Python/dolly_platform.o
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE Modules/getbuildinfo.c -o Modules/getbuildinfo.o
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE -DDOLLY Python/sysmodule.c -o Python/sysmodule.o
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE Programs/dolly_main.c -o Programs/python.o
RUN make -o configure -o config.status -o Makefile.pre -o Makefile \
    -o Modules/config.c -o Modules/getbuildinfo.o -o Python/sysmodule.o \
    -o Programs/python.o python \
    SHELL=/bin/slop CC=cc LINKCC=cc AR=ar \
    DYNLOADFILE=dynload_stub.o \
    PY_CFLAGS='-O2 -std=c11 -fno-strict-aliasing -DDOLLY' \
    PY_CFLAGS_NODIST= \
    PY_CPPFLAGS='-IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I.' \
    CFLAGSFORSHARED= PY_CORE_LDFLAGS= LDFLAGS= LINKFORSHARED= \
    MODULE_MATH_LDFLAGS= MODULE_CMATH_LDFLAGS= \
    MODULE__STATISTICS_LDFLAGS= MODULE__DATETIME_LDFLAGS= \
    MODULE__DECIMAL_LDFLAGS=Modules/_decimal/libmpdec/libmpdec.a \
    MODULE_PYEXPAT_LDFLAGS=Modules/expat/libexpat.a \
    MODULE_POSIX_CFLAGS=-DDOLLY \
    MODULE_BINASCII_CFLAGS=-DUSE_ZLIB_CRC32 MODULE_BINASCII_LDFLAGS=-lz \
    MODULE_ZLIB_CFLAGS= MODULE_ZLIB_LDFLAGS=-lz \
    LIBS= SYSLIBS= MACHDEP_OBJS=Python/dolly_platform.o DTRACE=
RUN mv /usr/src/python/Lib /usr/lib/python3.14
RUN mv /usr/src/python/python /usr/bin/python
RUN cp /usr/bin/python /usr/bin/python3
RUN cc -O2 -std=c17 /usr/src/dolly/bonnie.c -o /usr/bin/bonnie -lcurl
CHECK python --version
CHECK bonnie --version
CHECK python -c 'import pathlib; p = pathlib.Path("/tmp/python-check.txt"); p.write_text("PYTHON-WASM64"); assert p.read_text() == "PYTHON-WASM64"'
CHECK python -c 'import pathlib; assert pathlib.Path("/tmp/python-check.txt").read_text() == "PYTHON-WASM64"'

KEEP /usr/bin/python
KEEP /usr/bin/python3
KEEP /usr/bin/bonnie
KEEP-TREE /usr/lib/python3.14
KEEP /usr/src/dolly/bonnie.c
KEEP /usr/share/licenses/cpython/LICENSE
