DOLLY 1
IMAGE python
EXTENDS default

# Keep import-time cache output out of the image identity. CPython's dedicated
# build-info object is compiled with fixed DATE/TIME values below.
ENV PYTHONDONTWRITEBYTECODE=1

# CPython 3.14.7, upstream commit 823f0323ee6ec1402088b73bce1a38473cac36dc.
# The archive contains upstream sources plus configure output and frozen-module
# headers generated by the matching host Python; every target object is built
# here by Dolly's wasm64 compiler. Source: https://github.com/python/cpython
SOURCE HOST BIN /static/python/cpython.tar /tmp/cpython.tar SHA256 cfc426d273e946d1d48002476951352a1c91f71bb5e4b8484ff45a172016f093
SOURCE HOST TXT /static/python/cpython-platform.c /usr/src/python/Python/dolly_platform.c SHA256 24229c45e38dc00dd9503b25fc9a4072cf3e8d6b75ffb8f42e073e05ed9f2694
SOURCE HOST TXT /static/python/cpython-main.c /usr/src/python/Programs/dolly_main.c SHA256 0fa1fea2ec7dbce3632e3d4450f6fbf277d96e6862e68b758f7fbb09cb3d20d4
SOURCE HOST TXT /static/python/cpython-extension-check.c /usr/src/python/Modules/dolly_extension_check.c SHA256 1763ec04e582beee6066af81c93fe20e8cf0d83ae7d41d935b395c5cb3cdf071
SOURCE HOST TXT /static/python/cpython-socket-stubs.c /usr/src/python/Modules/dolly_socket_stubs.c SHA256 67d1b1c77687335dea25c58a5b9fa29c7ecc911957392e2e5beaf0a19184cd0b
SOURCE HOST TXT /static/python/cpython-termios.c /usr/src/python/Modules/dolly_termios.c SHA256 b1241a673ceb4a34327a6245954acad23a4e77ce97d6817114b303ea32cd6cd0
SOURCE HOST TXT /static/python/cpython-mmap.c /usr/src/python/Modules/dolly_mmap.c SHA256 20131df490c683927b5cbfe953163f4d86965f06d8f54995ca1ca18db58b75b6
SOURCE HOST TXT /static/python/cpython-process.c /usr/src/python/Modules/dolly_process.c SHA256 a40c89ac78329cdda935eb427bbccdf108e641b44cf2830d8a2db1ca6e26be0e
SOURCE HOST TXT /static/python/cpython-subprocess.py /usr/src/python/Lib/_dolly_subprocess.py SHA256 967b3f764b62c9a2273351d1566514d1d796bc0f4c2ed02c710de2ab0d1ab259
SOURCE HOST TXT /static/python/bonnie.c /usr/src/dolly/bonnie.c SHA256 af38a2643b3b448de57e2a8cd73e573c3cc95c1548006e6a1d17c7fd2bef96e9
SOURCE HOST TXT /static/python/bonnie.py /usr/lib/bonnie/bonnie.py SHA256 f90df8839110678f37227309735f11a7fe8dcce2f86e93dcaa8f6bd8174d835c
RUN tar -xf /tmp/cpython.tar -C /

WORKDIR /usr/src/python
RUN touch Python/frozen_modules/*.h
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE Python/dolly_platform.c -o Python/dolly_platform.o
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE '-DDATE="Jan 01 1970"' '-DTIME="00:00:00"' \
    Modules/getbuildinfo.c -o Modules/getbuildinfo.o
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE '-DPLATFORM="dolly"' Python/getplatform.c -o Python/getplatform.o
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE -DDOLLY '-DABIFLAGS=""' \
    '-DMULTIARCH="dolly_0_wasm64"' Python/sysmodule.c -o Python/sysmodule.o
RUN cc -c -O2 -std=c11 \
    -IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I. \
    -DPy_BUILD_CORE Programs/dolly_main.c -o Programs/python.o
RUN cc -c -O2 -std=c17 Modules/dolly_socket_stubs.c -o Modules/dolly_socket_stubs.o
RUN cc -c -O2 -std=c17 Modules/dolly_termios.c -o Modules/dolly_termios.o
RUN cc -c -O2 -std=c17 Modules/dolly_mmap.c -o Modules/dolly_mmap.o
RUN make -o configure -o config.status -o Makefile.pre -o Makefile \
    -o Modules/config.c -o Modules/getbuildinfo.o -o Python/getplatform.o -o Python/sysmodule.o \
    -o Programs/python.o python libpython3.14.so \
    SHELL=/bin/slop CC=cc LINKCC=cc AR=ar 'BLDSHARED=cc -shared' \
    INSTSONAME=libpython3.14.so \
    DYNLOADFILE=dynload_shlib.o \
    PY_CFLAGS='-O2 -std=c11 -fno-strict-aliasing -DDOLLY' \
    PY_CFLAGS_NODIST= \
    PY_CPPFLAGS='-IInclude/internal -IInclude/internal/mimalloc -IObjects -IInclude -IPython -I.' \
    CFLAGSFORSHARED= PY_CORE_LDFLAGS= LDFLAGS= LINKFORSHARED= \
    MODULE_MATH_LDFLAGS= MODULE_CMATH_LDFLAGS= \
    MODULE__STATISTICS_LDFLAGS= MODULE__DATETIME_LDFLAGS= \
    MODULE__DECIMAL_LDFLAGS=Modules/_decimal/libmpdec/libmpdec.a \
    MODULE_PYEXPAT_LDFLAGS=Modules/expat/libexpat.a \
    MODULE_POSIX_CFLAGS=-DDOLLY \
    MODULE__SOCKET_CFLAGS='-Daccept=dolly_py_accept -Daccept4=dolly_py_accept4 -Dbind=dolly_py_bind -Dfreeaddrinfo=dolly_py_freeaddrinfo -Dgai_strerror=dolly_py_gai_strerror -Dgetaddrinfo=dolly_py_getaddrinfo -Dgethostbyaddr=dolly_py_gethostbyaddr -Dgethostname=dolly_py_gethostname -Dgetnameinfo=dolly_py_getnameinfo -Dgetpeername=dolly_py_getpeername -Dgetprotobyname=dolly_py_getprotobyname -Dgetservbyport=dolly_py_getservbyport -Dgetsockname=dolly_py_getsockname -Dgetsockopt=dolly_py_getsockopt -Dhtonl=dolly_py_htonl -Dif_freenameindex=dolly_py_if_freenameindex -Dif_indextoname=dolly_py_if_indextoname -Dif_nameindex=dolly_py_if_nameindex -Dif_nametoindex=dolly_py_if_nametoindex -Dinet_aton=dolly_py_inet_aton -Dinet_ntop=dolly_py_inet_ntop -Dinet_pton=dolly_py_inet_pton -Dlisten=dolly_py_listen -Dntohl=dolly_py_ntohl -Dpoll=dolly_py_poll -Drecvfrom=dolly_py_recvfrom -Drecvmsg=dolly_py_recvmsg -Dsend=dolly_py_send -Dsendmsg=dolly_py_sendmsg -Dsendto=dolly_py_sendto' \
    MODULE_TERMIOS_CFLAGS='-Dcfgetispeed=dolly_py_cfgetispeed -Dcfgetospeed=dolly_py_cfgetospeed -Dcfsetispeed=dolly_py_cfsetispeed -Dcfsetospeed=dolly_py_cfsetospeed -Dioctl=dolly_py_ioctl -Dtcdrain=dolly_py_tcdrain -Dtcflow=dolly_py_tcflow -Dtcflush=dolly_py_tcflush -Dtcgetattr=dolly_py_tcgetattr -Dtcsetattr=dolly_py_tcsetattr -Dtcsendbreak=dolly_py_tcsendbreak' \
    MODULE_MMAP_CFLAGS='-Dmsync=dolly_py_msync -Dmadvise=dolly_py_madvise -Dmremap=dolly_py_mremap' \
    MODULE_BINASCII_CFLAGS=-DUSE_ZLIB_CRC32 MODULE_BINASCII_LDFLAGS=-lz \
    MODULE_ZLIB_CFLAGS= MODULE_ZLIB_LDFLAGS=-lz \
    LIBS= SYSLIBS= LIBM= LIBC= SHLIBS= \
    MACHDEP_OBJS='Python/dolly_platform.o Modules/dolly_socket_stubs.o Modules/dolly_termios.o Modules/dolly_mmap.o' DTRACE=
RUN mv /usr/src/python/Lib /usr/lib/python3.14
RUN cp /usr/src/python/libpython3.14.so /usr/lib/libpython3.14.so
RUN cc /usr/src/python/Programs/python.o -L/usr/lib -lpython3.14 -o /usr/bin/python
RUN cp /usr/bin/python /usr/bin/python3
RUN mkdir -p /usr/include/python3.14
RUN cp -R /usr/src/python/Include/. /usr/include/python3.14
RUN cp /usr/src/python/pyconfig.h /usr/include/python3.14/pyconfig.h
RUN env _PYTHON_PROJECT_BASE=/usr/src/python \
    python -m sysconfig --generate-posix-vars
RUN cp /usr/src/python/build/lib.dolly_0-wasm64-3.14/_sysconfigdata__dolly_dolly_0_wasm64.py \
    /usr/lib/python3.14/_sysconfigdata__dolly_dolly_0_wasm64.py
RUN mkdir -p /usr/lib/python3.14/config-3.14-dolly_0_wasm64
RUN cp /usr/src/python/Makefile \
    /usr/lib/python3.14/config-3.14-dolly_0_wasm64/Makefile
RUN cc -shared -O2 -std=c17 -I/usr/include/python3.14 \
    /usr/src/python/Modules/dolly_extension_check.c \
    -L/usr/lib -lpython3.14 \
    -o /usr/lib/python3.14/dolly_extension_check.cpython-314-dolly_0_wasm64.so
RUN cc -O2 -std=c17 /usr/src/dolly/bonnie.c -o /usr/bin/bonnie -lcurl
CHECK python --version
CHECK bonnie --version
CHECK bonnie list
CHECK bonnie freeze
CHECK bonnie check
CHECK test -f /usr/lib/bonnie/bonnie.py
CHECK python -c 'import pathlib; p = pathlib.Path("/tmp/python-check.txt"); p.write_text("PYTHON-WASM64"); assert p.read_text() == "PYTHON-WASM64"'
CHECK python -c 'import pathlib; assert pathlib.Path("/tmp/python-check.txt").read_text() == "PYTHON-WASM64"'
CHECK python -c 'import dolly_extension_check; assert dolly_extension_check.answer() == 42'
CHECK python -c 'import mmap, pathlib; p = pathlib.Path("/tmp/mmap-check"); p.write_bytes(b"DOLLY"); f = p.open("rb"); m = mmap.mmap(f.fileno(), 5, access=mmap.ACCESS_READ); assert m[:] == b"DOLLY"; m.madvise(mmap.MADV_SEQUENTIAL); m.close(); f.close()'
CHECK python -c 'import sysconfig; assert sysconfig.get_platform() == "dolly_0-wasm64"; assert sysconfig.get_config_var("EXT_SUFFIX") == ".cpython-314-dolly_0_wasm64.so"'
CHECK python -c 'import site, subprocess, sys; assert sys.platform == "dolly"; assert sys.executable == "/usr/bin/python"; assert subprocess._can_fork_exec; assert site.USER_BASE == "/home/dolly/.local"'
CHECK env DOLLY_C_ENV=visible python -c 'import os; assert os.environ["DOLLY_C_ENV"] == "visible"'
CHECK python -c 'import os; assert "DOLLY_C_ENV" not in os.environ'
CHECK python -c 'import os, subprocess; assert subprocess.check_output(["echo", "spawn-ok"], text=True).strip() == "spawn-ok"; assert subprocess.check_output("printf shell-ok", shell=True, text=True) == "shell-ok"; assert subprocess.check_output(["pwd"], cwd="/tmp", text=True).strip() == "/tmp"; assert subprocess.run(["cat"], input="pipe-ok", capture_output=True, text=True, check=True).stdout == "pipe-ok"; assert subprocess.check_output(["python", "-c", "print(6 * 7)"], text=True).strip() == "42"; child_env = dict(os.environ, DOLLY_CHILD_ENV="child-ok"); assert subprocess.check_output(["python", "-c", "import os; print(os.environ[\"DOLLY_CHILD_ENV\"])"], env=child_env, text=True).strip() == "child-ok"; assert "DOLLY_CHILD_ENV" not in os.environ'
CHECK python -c 'import os, subprocess; assert subprocess.run(["true"], env=os.environ.copy()).returncode == 0'
CHECK python -c 'import subprocess; print("parent-buffer", end=""); assert subprocess.check_output(["printf", "child"], text=True) == "child"; print()'
CHECK python -c 'import faulthandler, socket, pdb; assert socket.socket; faulthandler.enable(); assert faulthandler.is_enabled(); faulthandler.disable()'
CHECK python -c 'import faulthandler, pathlib; output = open("/tmp/faulthandler.txt", "w"); faulthandler.dump_traceback(file=output); output.close(); assert "Current thread" in pathlib.Path("/tmp/faulthandler.txt").read_text()'
CHECK python -c 'import os, termios, tty; before = termios.tcgetattr(0); assert len(termios.tcgetwinsize(0)) == 2; tty.setraw(0); after = termios.tcgetattr(0); assert after[3] & termios.ICANON == 0; termios.tcsetattr(0, termios.TCSANOW, before); assert os.isatty(0)'
CHECK test ! -d /usr/lib/python3.14/__pycache__

KEEP /usr/bin/python
KEEP /usr/bin/python3
KEEP /usr/bin/bonnie
KEEP /usr/lib/libpython3.14.so
KEEP /usr/lib/bonnie/bonnie.py
KEEP-TREE /usr/lib/python3.14
KEEP-TREE /usr/include/python3.14
KEEP /usr/src/dolly/bonnie.c
KEEP /usr/share/licenses/cpython/LICENSE
